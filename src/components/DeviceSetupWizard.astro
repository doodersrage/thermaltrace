---
/** Post-first-ingest checklist on Devices. */
interface Props {
  show: boolean;
  alertsDone?: boolean;
}

const { show, alertsDone = false } = Astro.props;
---

{show && (
  <section class="card alert-success" id="post-setup-funnel">
    <h2 class="card-title">You're receiving data</h2>
    <ol class="waiting-ingest-checklist mb-4">
      <li class="waiting-ingest-done">First POST received</li>
      <li class:list={[alertsDone && "waiting-ingest-done", !alertsDone && "waiting-ingest-pending"]}>
        {alertsDone ? "Freeze alert configured" : "Set freeze °F + email (below)"}
      </li>
      <li class="waiting-ingest-pending">
        <a class="text-link" href="/dashboard/share/links">Share a live link with family</a>
        <span class="text-[var(--color-text-muted)]">: optional</span>
      </li>
    </ol>
    <p class="mb-3 text-sm text-[var(--color-text-muted)]">
      Sensor names look fine as-is. Rename anytime on the device card.      <a class="text-link" href="/dashboard/devices?rename_sensors=1">rename later</a>.
    </p>
    <div class="flex flex-wrap gap-3">
      {!alertsDone && (
        <a class="btn-primary" href="#first-alert-setup">Set freeze + email</a>
      )}
      <a class="btn-secondary" href="/dashboard">Overview</a>
      <a class="btn-ghost" href="/about/kit-qr-onboarding">Kit QR guide</a>
      <a class="btn-ghost" href="/about/esp32-freeze-kit">ESP32 parts</a>
      <a class="btn-ghost" href="/about/pico-w-ingest">Pico W</a>
      <a class="btn-ghost" href="/about/stm32-zephyr-ingest">STM32 Zephyr</a>
      <a class="btn-ghost" href="/about/ch32v-riscv-ingest">CH32V RISC-V</a>
      <a class="btn-ghost" href="/about/avr-asm-ingest">AVR assembly</a>
      <a class="btn-ghost" href="/about/teensy41-ingest">Teensy 4.1</a>
      <a class="btn-ghost" href="/about/pic18-ethernet-ingest">PIC18 Ethernet</a>
      <a class="btn-ghost" href="/about/cellular-ingest">Cellular</a>
    </div>
  </section>
)}
