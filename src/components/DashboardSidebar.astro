---
import { Image } from "astro:assets";
import Building2 from "@lucide/astro/icons/building-2";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import Cpu from "@lucide/astro/icons/cpu";
import Bell from "@lucide/astro/icons/bell";
import History from "@lucide/astro/icons/history";
import Users from "@lucide/astro/icons/users";
import Share2 from "@lucide/astro/icons/share-2";
import CreditCard from "@lucide/astro/icons/credit-card";
import Settings from "@lucide/astro/icons/settings";
import Activity from "@lucide/astro/icons/activity";
import Radio from "@lucide/astro/icons/radio";
import Timer from "@lucide/astro/icons/timer";
import UserCog from "@lucide/astro/icons/user-cog";
import Mail from "@lucide/astro/icons/mail";
import Ban from "@lucide/astro/icons/ban";
import logo from "../assets/gtm.svg";

interface Props {
  currentPath: string;
  isAdmin: boolean;
  email?: string | null;
  planLabel?: string;
}

const { currentPath, isAdmin, email, planLabel } = Astro.props;

type NavItem = {
  href: string;
  label: string;
  isActive: boolean;
  Icon: typeof LayoutDashboard;
};

const monitorItems: NavItem[] = [
  {
    href: "/dashboard",
    label: "Overview",
    isActive: currentPath === "/dashboard",
    Icon: LayoutDashboard,
  },
  {
    href: "/dashboard/portfolio",
    label: "Portfolio",
    isActive: currentPath.startsWith("/dashboard/portfolio"),
    Icon: Building2,
  },
  {
    href: "/dashboard/devices",
    label: "Devices",
    isActive:
      currentPath.startsWith("/dashboard/devices") ||
      currentPath.startsWith("/dashboard/temperature"),
    Icon: Cpu,
  },
  {
    href: "/dashboard/alerts",
    label: "Alerts",
    isActive: currentPath.startsWith("/dashboard/alerts"),
    Icon: Bell,
  },
  {
    href: "/dashboard/history",
    label: "History",
    isActive: currentPath.startsWith("/dashboard/history"),
    Icon: History,
  },
];

const accountItems: NavItem[] = [
  {
    href: "/dashboard/household",
    label: "Household",
    isActive: currentPath.startsWith("/dashboard/household"),
    Icon: Users,
  },
  {
    href: "/dashboard/share",
    label: "Share",
    isActive: currentPath.startsWith("/dashboard/share"),
    Icon: Share2,
  },
  {
    href: "/dashboard/plans",
    label: "Plans",
    isActive: currentPath.startsWith("/dashboard/plans"),
    Icon: CreditCard,
  },
  {
    href: "/dashboard/settings",
    label: "Settings",
    isActive: currentPath.startsWith("/dashboard/settings"),
    Icon: Settings,
  },
];

const adminItems: NavItem[] = isAdmin
  ? [
      {
        href: "/dashboard/ops",
        label: "Ops",
        isActive: currentPath.startsWith("/dashboard/ops"),
        Icon: Activity,
      },
      {
        href: "/dashboard/feeds",
        label: "Feed health",
        isActive: currentPath.startsWith("/dashboard/feeds"),
        Icon: Radio,
      },
      {
        href: "/dashboard/jobs",
        label: "Jobs",
        isActive: currentPath.startsWith("/dashboard/jobs"),
        Icon: Timer,
      },
      {
        href: "/dashboard/email-suppressions",
        label: "Email suppressions",
        isActive: currentPath.startsWith("/dashboard/email-suppressions"),
        Icon: Ban,
      },
      {
        href: "/dashboard/users",
        label: "Users",
        isActive: currentPath.startsWith("/dashboard/users"),
        Icon: UserCog,
      },
      {
        href: "/dashboard/contacts",
        label: "Contacts",
        isActive: currentPath.startsWith("/dashboard/contacts"),
        Icon: Mail,
      },
    ]
  : [];

const allItems = [...monitorItems, ...accountItems, ...adminItems];
const activeLabel =
  allItems.find((item) => item.isActive)?.label ?? "Dashboard";

const groups = [
  { label: "Monitor", items: monitorItems },
  { label: "Account", items: accountItems },
  ...(adminItems.length > 0 ? [{ label: "Admin", items: adminItems }] : []),
];
---

<aside class="dashboard-sidebar">
  <nav class="dashboard-sidebar-inner" aria-label="Dashboard" id="dashboard-nav">
    <div class="dashboard-sidebar-top">
      <a href="/dashboard" class="dashboard-sidebar-brand">
        <Image src={logo} height={32} width={190} alt="ThermalTrace" class="dashboard-sidebar-logo" />
      </a>
      <div class="dashboard-sidebar-top-meta">
        {planLabel && <span class="plan-badge plan-badge--sidebar">{planLabel}</span>}
        <button
          type="button"
          class="dashboard-nav-toggle btn-secondary lg:hidden"
          id="dashboard-nav-toggle"
          aria-expanded="false"
          aria-controls="dashboard-nav-panel"
        >
          <span class="dashboard-nav-toggle-label">Menu</span>
          <span class="dashboard-nav-toggle-page">{activeLabel}</span>
        </button>
      </div>
    </div>
    <div id="dashboard-nav-panel" class="dashboard-nav-panel">
      {email && (
        <p class="dashboard-sidebar-email" title={email}>{email}</p>
      )}
      {groups.map((group) => (
        <div class="dashboard-nav-group">
          <p class="dashboard-nav-group-label">{group.label}</p>
          <ul class="dashboard-nav-list">
            {group.items.map(({ href, label, isActive, Icon }) => (
              <li>
                <a
                  href={href}
                  class:list={["dashboard-nav-link", isActive && "dashboard-nav-link-active"]}
                  aria-current={isActive ? "page" : undefined}
                >
                  <Icon class="dashboard-nav-icon" size={16} strokeWidth={2} aria-hidden="true" />
                  <span>{label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="dashboard-sidebar-footer">
        <a class="dashboard-nav-link" href="/">Back to site</a>
        <a class="dashboard-nav-link" href="/api/auth/signout">Sign out</a>
      </div>
    </div>
  </nav>
</aside>

<script is:inline>
  (() => {
    const toggle = document.getElementById("dashboard-nav-toggle");
    const panel = document.getElementById("dashboard-nav-panel");
    if (!toggle || !panel) return;

    const setOpen = (open) => {
      panel.classList.toggle("dashboard-nav-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    };

    toggle.addEventListener("click", () => {
      setOpen(!panel.classList.contains("dashboard-nav-open"));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!panel.contains(target) && !toggle.contains(target)) {
        setOpen(false);
      }
    });
  })();
</script>
