---
import type { PaginatedGarageTemps, ChartPoint } from "../lib/garageTempsHistory";
import HistoryChart from "./HistoryChart";
import {
  formatReadingTimestamp,
  getReadingFeedName,
  getReadingProbeLabel,
} from "../lib/garageTempsHistory";
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  history: PaginatedGarageTemps;
  chartPoints: ChartPoint[];
  priorYearPoints?: ChartPoint[];
  compareYoy?: boolean;
  overlayColdest?: boolean;
  overlayLegend?: string | null;
  basePath?: string;
  canDownloadCsv?: boolean;
  feedFilter?: string;
  probeFilter?: string;
  fromDate?: string;
  toDate?: string;
  days?: number;
  anomalies?: { probeLabel: string; message: string; severity: string }[];
  filterOptions?: {
    feeds: string[];
    probes: { key: string; label: string }[];
  };
  housePoints?: ChartPoint[];
  houseLegend?: string | null;
  freezeThresholdF?: number | null;
  maxHistoryDays?: number;
  canCompareYoy?: boolean;
  viewMode?: "all" | "chart" | "table";
  hideTitle?: boolean;
  tab?: string;
  alertMarkers?: import("../lib/chartAlertMarkers").ChartAlertMarker[];
  highlightAlertId?: number | null;
  canUseClaimsPack?: boolean;
  compareFrom?: string;
  compareTo?: string;
  savedViews?: import("../lib/historySavedViews").HistorySavedView[];
  canShareChart?: boolean;
}

const {
  history,
  chartPoints,
  priorYearPoints = [],
  compareYoy = false,
  overlayColdest = false,
  overlayLegend = null,
  basePath = "/dashboard/history",
  canDownloadCsv = false,
  feedFilter = "",
  probeFilter = "",
  fromDate = "",
  toDate = "",
  days = 7,
  anomalies = [],
  filterOptions = { feeds: [], probes: [] },
  housePoints = [],
  houseLegend = null,
  freezeThresholdF = null,
  maxHistoryDays = 7,
  canCompareYoy = false,
  viewMode = "all",
  hideTitle = false,
  tab = "",
  alertMarkers = [],
  highlightAlertId = null,
  canUseClaimsPack = false,
  compareFrom = "",
  compareTo = "",
  savedViews = [],
  canShareChart = false,
} = Astro.props;
const { readings, page, pageSize, totalCount, totalPages, error } = history;

const showingFrom = totalCount === 0 ? 0 : (page - 1) * pageSize + 1;
const showingTo = totalCount === 0 ? 0 : Math.min(page * pageSize, totalCount);
const prevPage = page > 1 ? page - 1 : null;
const nextPage = page < totalPages ? page + 1 : null;

function buildFilterUrl(nextFeed: string, nextProbe: string, nextPage = 1): string {
  const params = new URLSearchParams();
  params.set("page", String(nextPage));
  if (tab) params.set("tab", tab);
  if (nextFeed) params.set("feed", nextFeed);
  if (nextProbe) params.set("probe", nextProbe);
  if (fromDate) params.set("from", fromDate);
  if (toDate) params.set("to", toDate);
  if (days && days !== 7) params.set("days", String(days));
  if (compareYoy) params.set("yoy", "1");
  if (overlayColdest) params.set("overlay", "coldest");
  if (compareFrom) params.set("compare_from", compareFrom);
  if (compareTo) params.set("compare_to", compareTo);
  return `${basePath}?${params.toString()}`;
}

function buildExportUrl(): string {
  const params = new URLSearchParams();
  if (feedFilter) params.set("feed", feedFilter);
  if (probeFilter) params.set("probe", probeFilter);
  if (fromDate) params.set("from", fromDate);
  if (toDate) params.set("to", toDate);
  const query = params.toString();
  return query ? `/api/garage-temps/export.csv?${query}` : "/api/garage-temps/export.csv";
}

const chartTitle =
  fromDate || toDate
    ? "Temperature trend (selected dates)"
    : `Temperature trend (last ${days} days)`;

const hasActiveFilters = Boolean(
  feedFilter || probeFilter || fromDate || toDate || compareFrom || compareTo,
);
const clearFiltersHref = tab ? `${basePath}?tab=${tab}` : basePath;
const currentParamsQs = (() => {
  const params = new URLSearchParams();
  if (tab) params.set("tab", tab);
  if (feedFilter) params.set("feed", feedFilter);
  if (probeFilter) params.set("probe", probeFilter);
  if (fromDate) params.set("from", fromDate);
  if (toDate) params.set("to", toDate);
  if (days && days !== 7) params.set("days", String(days));
  if (compareYoy) params.set("yoy", "1");
  if (overlayColdest) params.set("overlay", "coldest");
  if (compareFrom) params.set("compare_from", compareFrom);
  if (compareTo) params.set("compare_to", compareTo);
  return params.toString();
})();
---

<DashboardCard>
  <div class="card-header-row">
    {!hideTitle && (
      <div>
        <h2 class="card-title">Historic probe readings</h2>
        <p class="card-subtitle">
          Temperature and humidity snapshots saved hourly in the background and when you refresh live readings while signed in.
          Door, flood, power, and CO₂ live on <a class="text-link" href="/">Home</a>.
        </p>
      </div>
    )}
    {!error && totalCount > 0 && canDownloadCsv && viewMode !== "chart" && (
      <a class="btn-secondary" href={buildExportUrl()} download>
        Download CSV
      </a>
    )}
  </div>

  {(savedViews.length > 0 || true) && (
    <div class="mb-4 flex flex-wrap items-center gap-2">
      {savedViews.map((view) => {
        const qs = (() => {
          const sp = new URLSearchParams();
          const p = view.params;
          if (p.feed) sp.set("feed", p.feed);
          if (p.probe) sp.set("probe", p.probe);
          if (p.from) sp.set("from", p.from);
          if (p.to) sp.set("to", p.to);
          if (p.days && p.days !== 7) sp.set("days", String(p.days));
          if (p.tab) sp.set("tab", p.tab);
          if (p.yoy) sp.set("yoy", "1");
          if (p.overlay) sp.set("overlay", p.overlay);
          if (p.compare_from) sp.set("compare_from", p.compare_from);
          if (p.compare_to) sp.set("compare_to", p.compare_to);
          return sp.toString();
        })();
        return (
          <span class="inline-flex items-center gap-1 rounded border border-[var(--color-border)] px-2 py-1 text-sm">
            <a class="text-link" href={`${basePath}?${qs}`}>{view.name}</a>
            <form action="/api/user/history-views" method="post" class="inline">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={view.id} />
              <input type="hidden" name="redirect" value={Astro.url.pathname + Astro.url.search} />
              <button type="submit" class="btn-ghost text-xs px-1" aria-label={`Delete ${view.name}`}>×</button>
            </form>
          </span>
        );
      })}
      <form action="/api/user/history-views" method="post" class="inline-flex flex-wrap items-center gap-2">
        <input type="hidden" name="action" value="create" />
        <input type="hidden" name="params" value={currentParamsQs} />
        <input type="hidden" name="redirect" value={Astro.url.pathname + Astro.url.search} />
        <input
          class="form-input text-sm"
          type="text"
          name="name"
          placeholder="Save current view"
          required
          maxlength="80"
        />
        <button type="submit" class="btn-ghost btn-sm">Save view</button>
      </form>
    </div>
  )}

  {anomalies.length > 0 && (
    <div class="alert-warning mb-4">
      <p class="m-0 font-medium">Unusual patterns detected in the chart window</p>
      <ul class="mb-0 mt-2 pl-5">
        {anomalies.map((notice) => (
          <li>{notice.message}</li>
        ))}
      </ul>
    </div>
  )}

  <form class="history-filters" method="get" action={basePath}>
    {tab && <input type="hidden" name="tab" value={tab} />}
    {(filterOptions.feeds.length > 0 || filterOptions.probes.length > 0) && (
      <>
        <div class="form-field mb-0">
          <label class="form-label" for="feed-filter">Feed</label>
          <select class="form-input" id="feed-filter" name="feed">
            <option value="">All feeds</option>
            {filterOptions.feeds.map((feed) => (
              <option value={feed} selected={feedFilter === feed}>{feed}</option>
            ))}
          </select>
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="probe-filter">Probe</label>
          <select class="form-input" id="probe-filter" name="probe">
            <option value="">All probes</option>
            {filterOptions.probes.map((probe) => (
              <option value={probe.key} selected={probeFilter === probe.key}>{probe.label}</option>
            ))}
          </select>
        </div>
      </>
    )}
    <div class="form-field mb-0">
      <label class="form-label" for="from-date">From</label>
      <input class="form-input" type="date" id="from-date" name="from" value={fromDate} />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="to-date">To</label>
      <input class="form-input" type="date" id="to-date" name="to" value={toDate} />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="compare-from">Compare from</label>
      <input class="form-input" type="date" id="compare-from" name="compare_from" value={compareFrom} />
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="compare-to">Compare to</label>
      <input class="form-input" type="date" id="compare-to" name="compare_to" value={compareTo} />
      <p class="form-hint">Optional second window (disables YoY).</p>
    </div>
    <div class="form-field mb-0">
      <label class="form-label" for="days-filter">Chart range</label>
      <select class="form-input" id="days-filter" name="days">
        <option value="7" selected={days === 7}>Last 7 days</option>
        {maxHistoryDays >= 30 && (
          <option value="30" selected={days === 30}>Last 30 days</option>
        )}
        {maxHistoryDays >= 90 && (
          <option value="90" selected={days === 90}>Last 90 days</option>
        )}
      </select>
      <p class="form-hint">Used when From/To are empty. Plan window: {maxHistoryDays} days.</p>
    </div>
    {canCompareYoy && (
      <div class="form-field mb-0 flex flex-col gap-2 justify-end">
        <label class="checkbox-row mb-0">
          <input type="checkbox" name="yoy" value="1" checked={compareYoy && !overlayColdest} />
          <span>Compare to last year (aligned window)</span>
        </label>
        <label class="checkbox-row mb-0">
          <input
            type="checkbox"
            name="overlay"
            value="coldest"
            checked={overlayColdest}
          />
          <span>Overlay last year’s coldest day</span>
        </label>
      </div>
    )}
    <button type="submit" class="btn-secondary self-end">Apply</button>
    {hasActiveFilters && (
      <a class="btn-ghost self-end" href={clearFiltersHref}>Clear filters</a>
    )}
  </form>

  {viewMode !== "table" && (
    <HistoryChart
      client:visible
      points={chartPoints}
      priorYearPoints={priorYearPoints}
      priorYearLegend={overlayLegend}
      housePoints={housePoints}
      houseLegend={houseLegend}
      title={chartTitle}
      freezeThresholdF={freezeThresholdF}
      showHumidity
      alertMarkers={alertMarkers}
      highlightAlertId={highlightAlertId}
      canUseClaimsPack={canUseClaimsPack}
      canShareChart={canShareChart}
    />
  )}

  {viewMode !== "chart" && (
    error ? (
      <div class="empty-state">
        <p>Unable to load historic readings: {error}</p>
      </div>
    ) : readings.length === 0 ? (
      <div class="empty-state">
        {hasActiveFilters ? (
          <>
            <p class="mb-4">No readings match these filters. Try a wider date range or clear filters.</p>
            <a class="btn-primary" href={clearFiltersHref}>Clear filters</a>
          </>
        ) : (
          <>
            <p class="mb-4">
              No climate history yet. Snapshots collect when devices are online and when you open Home while signed in.
            </p>
            <ol class="mb-4 pl-5 text-sm text-left max-w-md mx-auto space-y-1 text-[var(--color-text-muted)]">
              <li>
                <a class="text-link" href="/dashboard/devices">Add a device or feed</a>
              </li>
              <li>Verify ingest on the Devices page</li>
              <li>
                <a class="text-link" href="/">Open Home</a> to confirm live readings
              </li>
            </ol>
            <a class="btn-primary" href="/dashboard/devices">Go to Devices</a>
          </>
        )}
      </div>
    ) : (
      <>
        <div class="history-mobile-list">
          {readings.map((reading) => (
            <article class="history-mobile-card">
              <p class="history-mobile-time m-0">{formatReadingTimestamp(reading.timestamp)}</p>
              <p class="m-0 font-medium">{getReadingProbeLabel(reading)}</p>
              <p class="m-0 text-sm text-[var(--color-text-muted)]">{getReadingFeedName(reading)}</p>
              <p class="m-0 mt-2">
                {Number(reading.tempf).toFixed(1)}°F
                <span class="text-[var(--color-text-muted)]">
                  {" "}({Number(reading.tempc).toFixed(1)}°C) · {Number(reading.humidity).toFixed(1)}% RH
                </span>
              </p>
            </article>
          ))}
        </div>

        <div class="table-wrap history-desktop-table">
          <table class="data-table data-table-history">
            <thead>
              <tr>
                <th scope="col">Recorded</th>
                <th scope="col">Feed</th>
                <th scope="col">Probe</th>
                <th scope="col">Temperature (°F)</th>
                <th scope="col">Temperature (°C)</th>
                <th scope="col">Humidity</th>
              </tr>
            </thead>
            <tbody>
              {readings.map((reading) => (
                <tr>
                  <td>{formatReadingTimestamp(reading.timestamp)}</td>
                  <td>{getReadingFeedName(reading)}</td>
                  <td>{getReadingProbeLabel(reading)}</td>
                  <td>{Number(reading.tempf).toFixed(1)}</td>
                  <td>{Number(reading.tempc).toFixed(1)}</td>
                  <td>{Number(reading.humidity).toFixed(1)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <p class="pagination-summary">
            Showing {showingFrom}–{showingTo} of {totalCount} readings
          </p>
          <div class="pagination-controls">
            {prevPage ? (
              <a class="btn-secondary" href={buildFilterUrl(feedFilter, probeFilter, prevPage)}>Previous</a>
            ) : (
              <span class="btn-secondary pagination-disabled">Previous</span>
            )}
            <span class="pagination-current">Page {page} of {totalPages}</span>
            {nextPage ? (
              <a class="btn-secondary" href={buildFilterUrl(feedFilter, probeFilter, nextPage)}>Next</a>
            ) : (
              <span class="btn-secondary pagination-disabled">Next</span>
            )}
          </div>
        </div>
      </>
    )
  )}
</DashboardCard>
