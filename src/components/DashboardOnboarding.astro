---
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  hasDevices: boolean;
  hasSensors: boolean;
  hasHistory: boolean;
  hasAlertsEnabled?: boolean;
  hasEmailAlerts?: boolean;
  hasTestAlert?: boolean;
  hasHouseholdMembers?: boolean;
  hasLiveSensors?: boolean;
  hasHousehold?: boolean;
  hasFloodSensor?: boolean;
  dismissed?: boolean;
  showDemoFeed?: boolean;
}

const {
  hasDevices,
  hasSensors,
  hasHistory,
  hasAlertsEnabled = false,
  hasEmailAlerts = false,
  hasTestAlert = false,
  hasHouseholdMembers = false,
  hasLiveSensors = false,
  hasHousehold = false,
  hasFloodSensor = false,
  dismissed = false,
  showDemoFeed = false,
} = Astro.props;

const showFreezeMapCta = hasLiveSensors && hasHousehold;
const ingestVerified = hasLiveSensors || hasHistory;

/** Path most users need before winter. */
const essentialSteps = [
  {
    done: hasDevices,
    href: "/dashboard/devices?view=setup",
    title: "Connect a push device",
    detail: "Step 1 of 3: create a push ingest URL for ESP/Arduino (or open Devices for demo/HA paths).",
  },
  {
    done: hasAlertsEnabled && hasEmailAlerts,
    href: "/dashboard/alerts?tab=settings#alert-section-essentials",
    title: "Set freeze °F + email",
    detail: "Step 2 of 3: freeze threshold, email, and optional sensor-dead alerts, then save.",
  },
  {
    done: hasTestAlert,
    href: "/dashboard/alerts?tab=settings#send-test-alert",
    title: "Send a test alert",
    detail: "Step 3 of 3: confirm delivery once so you trust the path before a real freeze night.",
  },
];

const kitSteps = [
  {
    done: hasLiveSensors || hasSensors,
    href: "/dashboard/devices?view=setup",
    title: "Verify first POST",
    detail: "Create a push device, POST JSON once, and confirm sensors auto-import on the Devices page.",
  },
  {
    done: ingestVerified,
    href: "/dashboard/devices#verify-ingest-step",
    title: "Rename imported sensors",
    detail: "Accept suggested names on the device card so Home and alerts read clearly.",
  },
  {
    done: hasSensors,
    href: "/about/kit-qr-onboarding",
    title: "Optional: QR sticker",
    detail: "Print the in-app ingest QR from Devices for one-scan phone setup.",
  },
];

const nextSteps = [
  {
    done: hasFloodSensor,
    required: false,
    href: "/dashboard/devices",
    title: "Add a flood / leak contact",
    detail: "Wet/dry under a water heater or sump auto-alerts when wet, same ingest path as your temp probe.",
  },
  {
    done: hasHistory,
    required: true,
    href: "/dashboard/history",
    title: "Review saved history",
    detail: "Snapshots collect while feeds or devices are online.",
  },
  {
    done: hasHouseholdMembers,
    required: true,
    href: "/dashboard/household",
    title: "Invite your household",
    detail: "Share devices and alerts with family by email.",
  },
  {
    done: false,
    required: false,
    href: "/about/install-pwa",
    title: "Install on your phone",
    detail: "Add ThermalTrace to your home screen for faster access and optional push alerts.",
  },
  {
    done: false,
    required: false,
    href: "/android",
    title: "Android companion",
    detail: "Optional phone app for live probes and alerts: phone is not a sensor.",
  },
  {
    done: false,
    required: false,
    href: "/bay-buddy",
    title: "Bay Buddy (desktop)",
    detail: "Optional desktop glance for freeze and flood moods on one space.",
  },
  {
    done: false,
    required: false,
    href: "/claim-puck",
    title: "Claim puck",
    detail: "Optional RP2040-Zero presence key and LED mood light for a claimed bay.",
  },
];

const essentialDone = essentialSteps.every((step) => step.done);
const kitDone = kitSteps.every((step) => step.done);
const optionalDone = nextSteps.filter((step) => step.required).every((step) => step.done);
const fullyDone = essentialDone && kitDone && optionalDone;

const activeSteps = !essentialDone ? essentialSteps : !kitDone ? kitSteps : nextSteps;
const completedCount = activeSteps.filter((step) => step.done).length;
const progressPct = activeSteps.length
  ? Math.round((completedCount / activeSteps.length) * 100)
  : 100;

const sectionTitle = !essentialDone
  ? "Getting started"
  : !kitDone
    ? "Hardware setup"
    : "Next steps";
const sectionSubtitle = !essentialDone
  ? `${completedCount} of ${essentialSteps.length} essentials: device, freeze+email, test (unlocks Insights)`
  : !kitDone
    ? `${completedCount} of ${kitSteps.length} hardware steps`
    : `${completedCount} of ${nextSteps.length} optional steps`;

if (dismissed || fullyDone) {
  return null;
}
---
<DashboardCard>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="card-title">{sectionTitle}</h2>
      <p class="card-subtitle mb-0">{sectionSubtitle}</p>
      <div
        class="onboarding-progress mt-3"
        role="progressbar"
        aria-label={`Setup progress: ${completedCount} of ${activeSteps.length} steps complete`}
        aria-valuenow={progressPct}
        aria-valuemin={0}
        aria-valuemax={100}
      >
        <div class="onboarding-progress-bar" style={`width: ${progressPct}%`}></div>
      </div>
    </div>
    {essentialDone && (
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value="dismiss" />
        <input type="hidden" name="redirect" value="/dashboard" />
        <button class="btn-ghost" type="submit">Dismiss</button>
      </form>
    )}
  </div>
  <div class="dashboard-onboarding mt-4">
    {activeSteps.map((step, index) => (
      <a class="dashboard-onboarding-item" href={step.href}>
        <span class="dashboard-onboarding-step">
          {step.done ? "✓" : index + 1}
        </span>
        <span>
          <strong>{step.title}</strong>
          <span class="block text-sm text-[var(--color-text-muted)]">{step.detail}</span>
        </span>
      </a>
    ))}
  </div>
  {!essentialDone && (
    <div class="mt-4 flex flex-wrap gap-2">
      {!hasLiveSensors && (
        <>
          <a class="btn-secondary btn-sm" href="/dashboard/devices?view=setup">Open Devices</a>
          {showDemoFeed && (
            <a class="btn-secondary btn-sm" href="#demo-pull-nudge">Try demo feed</a>
          )}
          {!hasDevices && (
            <a class="btn-ghost btn-sm" href="/about/esp32-freeze-kit">ESP32 parts list</a>
          )}
          <a class="btn-ghost btn-sm" href="/about/probe-demo">Probe simulator</a>
        </>
      )}
      {hasLiveSensors && !hasEmailAlerts && (
        <a class="btn-secondary btn-sm" href="/dashboard/alerts?tab=settings#alert-section-essentials">
          Alert essentials
        </a>
      )}
      {hasLiveSensors && hasEmailAlerts && !hasTestAlert && (
        <a class="btn-secondary btn-sm" href="/dashboard/alerts?tab=settings#send-test-alert">
          Send test alert
        </a>
      )}
    </div>
  )}
  {essentialDone && (
    <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
      Guides:
      <a class="text-link" href="/about/esp32-ota-firmware">ESP32 OTA</a> ·
      <a class="text-link" href="/about/kit-qr-onboarding">Kit QR</a> ·
      <a class="text-link" href="/about/ingest-and-webhooks">Ingest API</a> ·
      <a class="text-link" href="/freeze-map">Freeze map</a>
      {showFreezeMapCta && (
        <>
          {" · "}
          <a class="text-link" href="/dashboard/household">Opt in on map</a>
        </>
      )}
    </p>
  )}
</DashboardCard>
