---
import DashboardCard from "./DashboardCard.astro";
import type { FreezeReadinessResult } from "../../lib/freezeReadiness";

interface Props {
  readiness: FreezeReadinessResult;
}

const { readiness } = Astro.props;
const tone =
  readiness.score >= 85 ? "text-[var(--color-success)]" : readiness.score >= 60 ? "text-[var(--color-warning)]" : "text-[var(--color-danger)]";
const failed = readiness.checks.filter((c) => !c.ok);
---
<DashboardCard id="freeze-readiness">
  <h2 class="card-title">Property readiness</h2>
  <p class="card-subtitle mb-3">
    Score from freeze alerts, flood contacts, vacation mute, batteries, and weather: run this before cold season or a wet season.
  </p>
  <p class:list={["text-2xl font-bold mb-3", tone]}>{readiness.score}%</p>
  <ul class="text-sm space-y-1 mb-4">
    {readiness.checks.map((check) => (
      <li class:list={[check.ok ? "text-[var(--color-text-muted)]" : ""]}>
        {check.ok ? "✓" : "○"} {check.label}
        {!check.ok && check.hint && (
          <span class="block text-xs text-[var(--color-text-muted)] ml-4">{check.hint}</span>
        )}
      </li>
    ))}
  </ul>
  <div class="flex flex-wrap gap-2">
    {!readiness.ready && (
      <a class="btn-secondary" href={failed.find((c) => c.id === "vacation_clear") ? "/dashboard/alerts?tab=settings" : "/dashboard/alerts?tab=settings#send-test-alert"}>
        {failed.find((c) => c.id === "vacation_clear") ? "Clear vacation mode" : "Send test alert"}
      </a>
    )}
    <a class="btn-ghost" href="/freeze-season">Seasonal checklist</a>
  </div>
</DashboardCard>
