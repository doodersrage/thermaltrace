---
interface Props {
  count: number;
  quietActive?: boolean;
  quietUntil?: string | null;
  title?: string;
  storageKey?: string;
  /** When true, details start open unless the user previously collapsed. */
  defaultOpen?: boolean;
  showQuietControls?: boolean;
}

const {
  count,
  quietActive = false,
  quietUntil = null,
  title = "Attention needed",
  storageKey = "tt-attention-collapsed",
  defaultOpen = false,
  showQuietControls = true,
} = Astro.props;

const quietLabel =
  quietActive && quietUntil
    ? `Quiet until ${new Date(quietUntil).toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
      })}`
    : null;
---

{(count > 0 || (showQuietControls && quietActive)) && (
  <div class="attention-needed card" data-attention-root data-storage-key={storageKey}>
    <div class="attention-needed-row">
      {count > 0 ? (
        <details
          class="attention-needed-details"
          data-attention-details
          open={defaultOpen || undefined}
        >
          <summary class="attention-needed-summary">
            {title} ({count})
          </summary>
          <div class="attention-needed-body" data-attention-slot>
            <slot />
          </div>
        </details>
      ) : (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          Recommendations quieted. Critical alerts still show above.
        </p>
      )}
      {showQuietControls && (
        <div class="attention-needed-actions">
          {quietActive ? (
            <form action="/api/user/dashboard-quiet" method="post">
              <input type="hidden" name="redirect" value="/dashboard" />
              <input type="hidden" name="action" value="clear" />
              <button type="submit" class="btn-ghost btn-sm">
                {quietLabel ?? "End quiet"}
              </button>
            </form>
          ) : (
            <form action="/api/user/dashboard-quiet" method="post">
              <input type="hidden" name="redirect" value="/dashboard" />
              <input type="hidden" name="action" value="quiet_7d" />
              <button type="submit" class="btn-ghost btn-sm">Hide tips 7d</button>
            </form>
          )}
        </div>
      )}
    </div>
  </div>
)}

<script>
  document.querySelectorAll("[data-attention-root]").forEach((root) => {
    const KEY = root.getAttribute("data-storage-key") || "tt-attention-collapsed";
    const details = root.querySelector("[data-attention-details]");
    if (!(details instanceof HTMLDetailsElement)) return;
    try {
      const stored = localStorage.getItem(KEY);
      if (stored === "1") details.open = false;
      else if (stored === "0") details.open = true;
    } catch {
      // ignore
    }
    details.addEventListener("toggle", () => {
      try {
        localStorage.setItem(KEY, details.open ? "0" : "1");
      } catch {
        // ignore
      }
    });
  });
</script>

<style>
  .attention-needed-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .attention-needed-details {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .attention-needed-summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .attention-needed-summary::-webkit-details-marker {
    display: none;
  }

  .attention-needed-body {
    margin-top: 0.75rem;
  }

  .attention-needed-actions {
    flex: 0 0 auto;
  }
</style>
