---
import type { DeviceWithSensors } from "../../lib/devices";
import { formatBoolSensorValue, SENSOR_KIND_LABELS } from "../../lib/devices";
import type { FeedHealthStatus } from "../../lib/collectHistory";
import type { LatestSensorRow } from "../../lib/sensorReadings";
import { formatRelativeAge, freshnessDetail } from "../../lib/relativeTime";
import { freshnessDetailForSource } from "../../lib/sensorFreshness";
import { batterySparklinePath, parseBatteryHistory } from "../../lib/batterySparkline";
import {
  formatBatteryEta,
  scoreDeviceHealth,
} from "../../lib/deviceHealthScore";
import ReadingAgeBadge from "./ReadingAgeBadge.astro";

/**
 * Devices tab: device health table, latest sensor values grid, and pull-feed
 * health grid.
 */
interface Props {
  devices: DeviceWithSensors[];
  latest: LatestSensorRow[];
  feedHealth: { statuses: FeedHealthStatus[]; error: string | null };
}

const { devices, latest, feedHealth } = Astro.props;

const kindLabels = SENSOR_KIND_LABELS;

function formatDeviceBattery(meta: unknown): string {
  if (!meta || typeof meta !== "object" || Array.isArray(meta)) return "—";
  const battery = (meta as Record<string, unknown>).battery_pct;
  return typeof battery === "number" && Number.isFinite(battery)
    ? `${battery}%`
    : "—";
}

function formatDeviceRssi(meta: unknown): string {
  if (!meta || typeof meta !== "object" || Array.isArray(meta)) return "—";
  const rssi = (meta as Record<string, unknown>).rssi;
  return typeof rssi === "number" && Number.isFinite(rssi) ? `${rssi} dBm` : "—";
}

function formatLatestValue(row: LatestSensorRow): string {
  if (row.value_bool != null) {
    return formatBoolSensorValue(row.sensor.kind, row.value_bool);
  }
  if (row.value_num != null) {
    return `${row.value_num.toFixed(1)}${row.sensor.unit ? ` ${row.sensor.unit}` : ""}`;
  }
  return row.value_text ?? "—";
}

const healthTone: Record<string, string> = {
  healthy: "text-[var(--color-success,#16a34a)]",
  watch: "text-amber-600 dark:text-amber-300",
  at_risk: "text-[var(--color-danger)]",
  offline: "text-[var(--color-text-muted)]",
};
---
<section class="card" id="device-health">
  <h2 class="card-title">Device health</h2>
  <p class="card-subtitle mb-4">
    Health score, last seen, battery ETA, and optional RSSI from ingest payloads.
  </p>
  {devices.length === 0 ? (
    <p class="mb-0 text-sm text-[var(--color-text-muted)]">
      Health appears after you create a device.
      {" "}
      <a class="text-link" href="#devices-first-run">Connect your first probe</a>
    </p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-[var(--color-text-muted)]">
            <th class="py-2 pr-3">Device</th>
            <th class="py-2 pr-3">Health</th>
            <th class="py-2 pr-3">Space</th>
            <th class="py-2 pr-3">Source</th>
            <th class="py-2 pr-3">Last seen</th>
            <th class="py-2 pr-3">Sensors</th>
            <th class="py-2 pr-3">Battery</th>
            <th class="py-2 pr-3">ETA</th>
            <th class="py-2">RSSI</th>
          </tr>
        </thead>
        <tbody>
          {devices.map((device) => {
            const age = formatRelativeAge(device.last_seen_at);
            const battery = formatDeviceBattery(device.meta);
            const rssi = formatDeviceRssi(device.meta);
            const sparkPath = batterySparklinePath(parseBatteryHistory(device.meta));
            const pullHealth = feedHealth.statuses.find((f) => f.feedId === device.id);
            const health = scoreDeviceHealth(device, latest);
            return (
              <tr class="border-t border-[var(--color-border)]">
                <td class="py-2 pr-3">
                  <strong>{device.name}</strong>
                  {device.ingest_key_prefix && (
                    <span class="block text-xs text-[var(--color-text-muted)]">
                      key {device.ingest_key_prefix}…
                    </span>
                  )}
                </td>
                <td class="py-2 pr-3">
                  <span class:list={["font-semibold", healthTone[health.label]]}>
                    {health.score}
                  </span>
                  <span class="block text-xs text-[var(--color-text-muted)]">
                    {health.label.replace("_", " ")} · {health.detail}
                  </span>
                </td>
                <td class="py-2 pr-3">{device.space || "—"}</td>
                <td class="py-2 pr-3">
                  {device.source === "push" ? "Push" : "Pull"}
                  {pullHealth && (
                    <span class="block text-xs text-[var(--color-text-muted)]">
                      {pullHealth.ok ? "Reachable" : pullHealth.message}
                    </span>
                  )}
                </td>
                <td class:list={["py-2 pr-3", age.lagging && "text-[var(--color-danger)]"]}>
                  <ReadingAgeBadge iso={device.last_seen_at} emptyLabel="Never" />
                  <span class="block text-xs text-[var(--color-text-muted)] mt-1">
                    {device.last_seen_at ? freshnessDetail(age) : "No readings yet"}
                  </span>
                </td>
                <td class="py-2 pr-3">{device.sensors.length}</td>
                <td class="py-2 pr-3">
                  {battery}
                  {sparkPath && (
                    <svg
                      class="block mt-1 text-[var(--color-accent)]"
                      width="64"
                      height="20"
                      viewBox="0 0 64 20"
                      aria-hidden="true"
                    >
                      <path d={sparkPath} fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}
                </td>
                <td class="py-2 pr-3">{formatBatteryEta(health.daysRemaining)}</td>
                <td class="py-2">{rssi}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</section>

{latest.length > 0 && (
  <section class="card">
    <h2 class="card-title">Latest sensor values</h2>
    <div class="feed-health-grid">
      {latest.map((row) => {
        const device = devices.find((d) => d.id === row.sensor.device_id);
        const age = formatRelativeAge(row.recorded_at);
        return (
          <div class="feed-health-item">
            <div>
              <strong>{row.sensor.label}</strong>
              <p class="m-0 text-sm text-[var(--color-text-muted)]">
                {row.deviceName} · {kindLabels[row.sensor.kind] ?? row.sensor.kind}
                {device?.source === "pull_url" ? " · pull" : device?.source === "push" ? " · push" : ""}
              </p>
              <p class:list={["m-0 mt-1 text-sm", age.lagging && "text-amber-300"]}>
                <ReadingAgeBadge iso={row.recorded_at} />
                {" · "}
                {freshnessDetailForSource(row.recorded_at, device?.source ?? null)}
              </p>
            </div>
            <span>{formatLatestValue(row)}</span>
          </div>
        );
      })}
    </div>
  </section>
)}

{feedHealth.statuses.length > 0 && (
  <section class="card">
    <h2 class="card-title">Feed health</h2>
    <p class="card-subtitle">Latest status check for your enabled pull feeds.</p>
    <div class="feed-health-grid">
      {feedHealth.statuses.map((status) => (
        <div class="feed-health-item">
          <div>
            <strong>{status.feedName}</strong>
            <p class="m-0 text-sm text-[var(--color-text-muted)]">{status.message}</p>
          </div>
          <span class={status.ok ? "feed-health-ok" : "feed-health-error"}>
            {status.ok ? "Online" : "Issue"}
          </span>
        </div>
      ))}
    </div>
  </section>
)}
