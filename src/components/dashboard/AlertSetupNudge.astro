---
interface Props {
  hasAlertsEnabled: boolean;
  hasEmailAlerts: boolean;
  canEdit?: boolean;
  show?: boolean;
}

const { hasAlertsEnabled, hasEmailAlerts, canEdit = true, show = true } = Astro.props;

if (!show || !canEdit || (hasAlertsEnabled && hasEmailAlerts)) {
  return null;
}

const step = !hasAlertsEnabled ? "threshold" : "email";
---
<aside class="card alert-setup-nudge" data-nudge-key="alert_setup_nudge" role="note">
  <div class="alert-setup-nudge-body">
    <p class="alert-setup-nudge-title">Finish alert setup</p>
    {step === "threshold" ? (
      <p class="alert-setup-nudge-text">
        Alerts are off or missing a freeze threshold. Set one before cold weather hits so you get warned in time.
      </p>
    ) : (
      <p class="alert-setup-nudge-text">
        Alerts are on but email is not configured. Enable the email channel and save so freeze warnings reach your inbox.
      </p>
    )}
  </div>
  <div class="alert-setup-nudge-actions">
    {step === "threshold" ? (
      <a class="btn-primary" href="/dashboard/alerts?tab=settings#alert-section-essentials">Set freeze + email</a>
    ) : (
      <a class="btn-primary" href="/dashboard/alerts?tab=settings#alert-section-channels">Enable email alerts</a>
    )}
    <a class="btn-secondary" href="/dashboard/alerts?tab=settings">Open alerts</a>
    <button type="button" class="btn-ghost" data-dismiss="alert_setup_nudge">
      Dismiss
    </button>
  </div>
</aside>
