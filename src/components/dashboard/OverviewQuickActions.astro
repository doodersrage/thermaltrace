---
interface Props {
  canEdit: boolean;
  unackedCount: number;
  snoozeUntil: string | null;
  spaceCheckedAt: string | null;
  householdId?: string | null;
  deviceSpaces?: string[];
}

const {
  canEdit,
  unackedCount,
  snoozeUntil,
  spaceCheckedAt,
  householdId = null,
  deviceSpaces = [],
} = Astro.props;
const snoozeActive =
  snoozeUntil != null && Number.isFinite(Date.parse(snoozeUntil))
    ? Date.parse(snoozeUntil) > Date.now()
    : false;
const spaces = deviceSpaces.filter(Boolean);
---

{canEdit && (
  <section class="card overview-quick-actions" aria-labelledby="overview-quick-actions-title">
    <div class="overview-quick-actions-head">
      <h2 class="card-title mb-0" id="overview-quick-actions-title">Quick actions</h2>
      <p class="card-subtitle mb-0">
        Acknowledge, snooze alerts, or mark that you checked a space.
      </p>
    </div>
    <div class="overview-quick-actions-row">
      {unackedCount > 0 ? (
        <>
          <form action="/api/user/alert-events/ack" method="post">
            <input type="hidden" name="redirect" value="/dashboard" />
            <input type="hidden" name="action" value="ack_latest" />
            <button type="submit" class="btn-secondary btn-sm">
              Acknowledge latest
            </button>
          </form>
          {unackedCount > 1 && (
            <form
              action="/api/user/alert-events/ack"
              method="post"
              onsubmit={`return confirm('Mark all ${unackedCount} unhandled alerts as handled?');`}
            >
              <input type="hidden" name="redirect" value="/dashboard" />
              <input type="hidden" name="action" value="ack_all" />
              <button type="submit" class="btn-ghost btn-sm">
                Handle remaining ({unackedCount})
              </button>
            </form>
          )}
        </>
      ) : (
        <a class="btn-ghost btn-sm" href="/dashboard/alerts">Alerts clear</a>
      )}

      {snoozeActive ? (
        <form action="/api/user/alert-snooze" method="post">
          <input type="hidden" name="redirect" value="/dashboard" />
          <input type="hidden" name="action" value="clear_snooze" />
          <button type="submit" class="btn-ghost btn-sm" id="overview-snooze-action">
            Clear snooze
          </button>
        </form>
      ) : (
        <div class="overview-snooze-presets inline-flex flex-wrap items-center gap-1">
          <span class="text-sm text-[var(--color-text-muted)]">Snooze</span>
          {[1, 4, 24].map((hours) => (
            <form action="/api/user/alert-snooze" method="post">
              <input type="hidden" name="redirect" value="/dashboard" />
              <input type="hidden" name="action" value="snooze" />
              <input type="hidden" name="hours" value={String(hours)} />
              <button
                type="submit"
                class="btn-secondary btn-sm"
                id={hours === 24 ? "overview-snooze-action" : undefined}
              >
                {hours}h
              </button>
            </form>
          ))}
        </div>
      )}

      <form action="/api/user/space-checked" method="post" class="inline-flex flex-wrap items-center gap-2">
        <input type="hidden" name="redirect" value="/dashboard" />
        {householdId && <input type="hidden" name="household_id" value={householdId} />}
        {spaces.length > 0 && (
          <select class="form-input text-sm py-1" name="space" aria-label="Space checked">
            <option value="">Whole property</option>
            {spaces.map((space) => (
              <option value={space}>{space}</option>
            ))}
          </select>
        )}
        <button type="submit" class="btn-ghost btn-sm" id="overview-checked-space">
          I checked the space
        </button>
      </form>
      <span
        class="overview-checked-status text-sm text-[var(--color-text-muted)]"
        id="overview-checked-status"
        data-checked-at={spaceCheckedAt ?? ""}
        data-overview-field="spaceCheckedAt"
        hidden={!spaceCheckedAt}
      ></span>
    </div>
  </section>
)}

<script>
  const status = document.getElementById("overview-checked-status");
  function renderChecked() {
    if (!status) return;
    const raw = status.getAttribute("data-checked-at") || "";
    if (!raw) {
      status.hidden = true;
      status.textContent = "";
      return;
    }
    const ts = Date.parse(raw);
    if (!Number.isFinite(ts)) {
      status.hidden = true;
      return;
    }
    const mins = Math.max(0, Math.round((Date.now() - ts) / 60000));
    status.hidden = false;
    status.textContent =
      mins < 1
        ? "Checked just now"
        : mins < 60
          ? `Checked ${mins}m ago`
          : `Checked ${Math.round(mins / 60)}h ago`;
  }
  renderChecked();
</script>

<style>
  .overview-quick-actions-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .overview-quick-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
</style>
