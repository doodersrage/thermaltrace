---
/**
 * Empty / first-device path on Devices — guided ESP → reading → freeze/leak alert,
 * with other connect paths available but de-emphasized.
 */
interface Props {
  canEdit: boolean;
  atDeviceLimit: boolean;
  redirectTo: string;
  nestEntitled: boolean;
}

const { canEdit, atDeviceLimit, redirectTo, nestEntitled } = Astro.props;
---
<section class="card devices-first-run" id="devices-first-run" aria-labelledby="devices-first-run-title">
  <h2 class="card-title" id="devices-first-run-title">Get your first freeze or leak alert</h2>
  <p class="card-subtitle mb-4">
    Three steps: create a push device, POST one reading, set freeze °F + email. A flood/leak contact on the same device auto-alerts when wet. Other paths are below.
  </p>

  <ol class="devices-guide" aria-label="Guided first-run">
    <li class="devices-guide-step">
      <span class="devices-guide-num" aria-hidden="true">1</span>
      <div>
        <h3 class="devices-guide-title">Create an ESP / Pico / Arduino push device</h3>
        <p class="devices-guide-copy">
          We pre-fill a sketch with your ingest URL. Flash Wi‑Fi, power the board, and POST once: sensors auto-import.
        </p>
        {canEdit && !atDeviceLimit ? (
          <div class="flex flex-wrap gap-2 mt-2">
            <form action="/api/devices" method="post">
              <input type="hidden" name="action" value="create_push" />
              <input type="hidden" name="redirect" value={redirectTo} />
              <input type="hidden" name="name" value="Workshop probe" />
              <button class="btn-primary" type="submit">Create push device</button>
            </form>
            <a class="btn-ghost" href="/about/esp32-freeze-kit">Parts list</a>
          </div>
        ) : atDeviceLimit ? (
          <div class="flex flex-wrap gap-2 mt-2">
            <a class="btn-secondary" href="/dashboard/plans">Upgrade for more devices</a>
            <a class="btn-ghost" href="/about/esp32-freeze-kit">Parts list</a>
          </div>
        ) : (
          <p class="mb-0 mt-2 text-sm text-[var(--color-text-muted)]">View-only, ask an owner to create a device.</p>
        )}
      </div>
    </li>
    <li class="devices-guide-step">
      <span class="devices-guide-num" aria-hidden="true">2</span>
      <div>
        <h3 class="devices-guide-title">Verify the first reading</h3>
        <p class="devices-guide-copy">
          After the first POST, rename imported sensors on the device card so Overview and alerts read clearly.
        </p>
        <div class="flex flex-wrap gap-2 mt-2">
          <a class="btn-ghost inline-flex" href="/about/esp32-web-flash">ESP32 flash guide</a>
          <a class="btn-ghost inline-flex" href="/about/pico-w-ingest">Pico W guide</a>
          <a class="btn-ghost inline-flex" href="/about/stm32-zephyr-ingest">STM32 Zephyr guide</a>
          <a class="btn-ghost inline-flex" href="/about/ch32v-riscv-ingest">CH32V RISC-V guide</a>
          <a class="btn-ghost inline-flex" href="/about/avr-asm-ingest">AVR assembly guide</a>
          <a class="btn-ghost inline-flex" href="/about/teensy41-ingest">Teensy 4.1 guide</a>
          <a class="btn-ghost inline-flex" href="/about/pic18-ethernet-ingest">PIC18 Ethernet guide</a>
          <a class="btn-ghost inline-flex" href="/about/cellular-ingest">Cellular guide</a>
        </div>
      </div>
    </li>
    <li class="devices-guide-step">
      <span class="devices-guide-num" aria-hidden="true">3</span>
      <div>
        <h3 class="devices-guide-title">Set freeze °F + email, then send a test</h3>
        <p class="devices-guide-copy">
          Essentials: threshold a few degrees above 32°F, your email, then one test. Flood/leak contacts auto-alert when wet once alerts are on, no separate rule required.
        </p>
        <a class="btn-secondary mt-2 inline-flex" href="/dashboard/alerts?tab=settings#alert-section-essentials">Open alert essentials</a>
      </div>
    </li>
  </ol>

  <details class="devices-other mt-5">
    <summary class="devices-other-summary">Other ways to connect</summary>
    <div class="devices-intent-grid mt-3" role="list">
      <div class="devices-intent" role="listitem">
        <h3 class="devices-intent-title">Claim puck</h3>
        <p class="devices-intent-copy">
          RP2040-Zero presence key: claim a bay with a button press, then light freeze/flood moods on the LED via Bay Buddy.
        </p>
        <div class="flex flex-wrap gap-2">
          <a class="btn-secondary" href="/claim-puck">Setup guide</a>
          <a class="btn-ghost" href="/bay-buddy">Bay Buddy</a>
          <a class="btn-ghost" href="/accessories">All accessories</a>
        </div>
      </div>
      <div class="devices-intent" role="listitem">
        <h3 class="devices-intent-title">Flood / leak contact</h3>
        <p class="devices-intent-copy">
          Same push device can POST a <code>flood</code> bool: wet auto-alerts (bypasses snooze). Optional <code>level</code> for sump %.
          Dedicated leak pads:
          <a class="text-link" href="/leak-puck">leak puck</a>.
        </p>
        <a class="btn-secondary" href="/about/ingest-and-webhooks">Ingest kinds</a>
      </div>
      <div class="devices-intent" role="listitem">
        <h3 class="devices-intent-title">Demo feed</h3>
        <p class="devices-intent-copy">No hardware yet? Pull our public example HTTPS JSON.</p>
        <a class="btn-secondary" href="#demo-pull-nudge">Try demo feed</a>
      </div>
      <div class="devices-intent" role="listitem">
        <h3 class="devices-intent-title">Home Assistant</h3>
        <p class="devices-intent-copy">HACS polls a share link, or push from HA automations.</p>
        <div class="flex flex-wrap gap-2">
          <a class="btn-secondary" href="/dashboard/share/links">Create share link</a>
          <a class="btn-ghost" href="/integrations/home-assistant">HACS guide</a>
        </div>
      </div>
      <div class="devices-intent" role="listitem">
        <h3 class="devices-intent-title">MQTT bridge</h3>
        <p class="devices-intent-copy">Keep Mosquitto on the LAN; mirror topics over HTTPS.</p>
        <a class="btn-secondary" href="/about/mqtt-bridge">MQTT recipe</a>
      </div>
      <div class="devices-intent" role="listitem">
        <h3 class="devices-intent-title">Nest / Ecobee</h3>
        <p class="devices-intent-copy">
          {nestEntitled
            ? "Connect house thermostat context on the Pull feeds tab (Pro)."
            : "Indoor house context via Nest/Ecobee OAuth is on Pro, or push climate temp from HA."}
        </p>
        <div class="flex flex-wrap gap-2">
          <a class="btn-secondary" href="/dashboard/devices?tab=pull#thermostat-connect">
            Pull feeds &amp; thermostats
          </a>
          {!nestEntitled && (
            <a class="btn-ghost" href="/dashboard/plans">View Pro</a>
          )}
        </div>
      </div>
    </div>
  </details>

  <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
    Still exploring placement?
    {" "}
    <a class="text-link" href="/about/probe-demo">Open the interactive probe simulator</a>
    {" · "}
    <a class="text-link" href="/about/esp32-freeze-kit">ESP32 freeze kit BOM</a>
    {" · "}
    <a class="text-link" href="/docs/api">HTTP API quick reference</a>
  </p>
</section>

<style>
  .devices-guide {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .devices-guide-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1rem;
    align-items: start;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 88%, var(--color-accent) 12%);
  }

  .devices-guide-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.875rem;
    background: var(--color-accent);
    color: #fff;
  }

  .devices-guide-title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 650;
  }

  .devices-guide-copy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .devices-other-summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
  }

  .devices-intent-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .devices-intent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .devices-intent {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .devices-intent-title {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    font-weight: 650;
  }

  .devices-intent-copy {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
