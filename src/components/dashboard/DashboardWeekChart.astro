---
import DashboardCard from "./DashboardCard.astro";
import ChartSkeleton from "./ChartSkeleton.astro";
import HistoryChart from "../HistoryChart";
import type { ChartPoint } from "../../lib/garageTempsHistory";

interface Props {
  points: ChartPoint[];
  housePoints?: ChartPoint[];
  houseLegend?: string | null;
  title?: string;
  freezeThresholdF?: number | null;
  canExport?: boolean;
  exportFrom?: string;
  exportTo?: string;
  showHumidity?: boolean;
  days?: number;
  alertMarkers?: import("../../lib/chartAlertMarkers").ChartAlertMarker[];
}

const {
  points,
  housePoints = [],
  houseLegend = null,
  title,
  freezeThresholdF = null,
  canExport = false,
  exportFrom = "",
  exportTo = "",
  showHumidity = true,
  days = 7,
  alertMarkers = [],
} = Astro.props;

const chartTitle = title ?? `Temperature trend (${days} days)`;
const cardTitle = `Probe curves (${days} days)`;

const exportParams = new URLSearchParams();
if (exportFrom) exportParams.set("from", exportFrom);
if (exportTo) exportParams.set("to", exportTo);
const exportCsvHref = exportParams.toString()
  ? `/api/garage-temps/export.csv?${exportParams}`
  : "/api/garage-temps/export.csv";
---
<DashboardCard>
  <div class="card-header-row">
    <div>
      <h2 class="card-title">{cardTitle}</h2>
      <p class="card-subtitle mb-0">
        Temperature traces with freeze / target / high guide lines
        {showHumidity ? ", plus optional humidity and dew point" : ""}.
        Open History for filters and year-over-year.
      </p>
    </div>
    {canExport && (
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href={exportCsvHref} download>Export run (CSV)</a>
        <a class="btn-ghost" href="/api/user/export">Export JSON</a>
      </div>
    )}
  </div>
  {points.length < 2 ? (
    <div class="empty-state mt-4 mb-0 text-left">
      <p class="mb-3">
        No probe curves yet. Connect hardware, confirm a reading on Home, then this chart fills from hourly snapshots.
      </p>
      <ol class="mb-4 pl-5 text-sm text-[var(--color-text-muted)] space-y-1">
        <li>
          <a class="text-link" href="/dashboard/temperature">Add a push device or pull feed</a>
        </li>
        <li>Verify ingest (or wait for the next pull)</li>
        <li>
          <a class="text-link" href="/">Open Home</a> to confirm live values
        </li>
      </ol>
      <a class="btn-primary" href="/dashboard/temperature">Go to Devices</a>
    </div>
  ) : (
    <div class="relative mt-4 history-chart-host">
      <HistoryChart
        client:visible
        points={points}
        housePoints={housePoints}
        houseLegend={houseLegend}
        title={chartTitle}
        freezeThresholdF={freezeThresholdF}
        showHumidity={showHumidity}
        alertMarkers={alertMarkers}
      >
        <ChartSkeleton slot="fallback" />
      </HistoryChart>
    </div>
  )}
  <p class="mt-4 mb-0 text-sm">
    <a class="text-link" href="/dashboard/history">Open full history</a>
  </p>
</DashboardCard>
