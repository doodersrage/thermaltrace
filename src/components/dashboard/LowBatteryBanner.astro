---
interface Props {
  message: string;
}

const { message } = Astro.props;
---
{message && (
  <div class="alert-warning mb-0" role="status">
    {message}
    {" "}
    <a href="/dashboard/devices?view=ops#device-health" class="text-link">Device health</a>
    {" · "}
    <a href="/dashboard/alerts" class="text-link">Alert settings</a>
  </div>
)}
