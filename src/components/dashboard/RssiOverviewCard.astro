---
import DashboardCard from "./DashboardCard.astro";
import BatteryTrendChart from "../BatteryTrendChart";
import type { RssiOverviewRow } from "../../lib/overviewExtras";

interface Props {
  rows: RssiOverviewRow[];
}

const { rows } = Astro.props;
const chartSeries = rows
  .filter((row) => row.samples.length >= 2)
  .map((row) => ({
    label: row.deviceName,
    samples: row.samples.map((sample) => ({ value: sample.dbm, at: sample.at })),
  }));
---
{rows.length > 0 && (
  <DashboardCard>
    <h2 class="card-title">Signal strength</h2>
    <p class="card-subtitle mb-4">RSSI from recent device meta: weak links drop readings first.</p>
    <ul class="space-y-2 mb-0">
      {rows.map((row) => (
        <li class="text-sm flex flex-wrap justify-between gap-2">
          <strong>{row.deviceName}</strong>
          <span class:list={[row.weak && "text-[var(--color-warning-text)]"]}>
            {row.rssi} dBm
            {row.samples.length >= 2 ? ` · ${row.samples.length} samples` : ""}
          </span>
        </li>
      ))}
    </ul>
    {chartSeries.length > 0 && (
      <div class="mt-4">
        <BatteryTrendChart
          client:visible
          series={chartSeries}
          title="RSSI over recent samples"
          unitSuffix=" dBm"
          valuePad={3}
          canvasClassName="history-chart-canvas--battery"
        />
      </div>
    )}
    {chartSeries.length === 0 && (
      <p class="mt-3 mb-0 text-xs text-[var(--color-text-muted)]">
        Trend appears after a few push/pull readings include <code>rssi</code>.
      </p>
    )}
    <p class="mt-4 mb-0 text-sm">
      <a class="text-link" href="/dashboard/temperature">Open Devices</a>
    </p>
  </DashboardCard>
)}
