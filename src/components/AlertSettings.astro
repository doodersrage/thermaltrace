---
import type { AlertSettings } from "../lib/alerts";
import type { Entitlements } from "../lib/entitlements";
import { CONDITION_OPTIONS } from "../lib/alertRules";
import AlertSettingsNav from "./alerts/AlertSettingsNav.astro";
import AlertSettingsPanel from "./alerts/AlertSettingsPanel.astro";
import AlertSettingsFormSubmit from "./alerts/AlertSettingsFormSubmit.astro";
import AlertSettingsRulesScript from "./alerts/AlertSettingsRulesScript.astro";
import AlertSettingsPlaybooksScript from "./alerts/AlertSettingsPlaybooksScript.astro";
import AlertSettingsPushScript from "./alerts/AlertSettingsPushScript.astro";

interface Props {
  userEmail: string;
  settings: AlertSettings;
  entitlements: Entitlements;
  vapidPublicKey?: string;
  twilioConfigured?: boolean;
  redirectTo?: string;
  canEdit?: boolean;
  /** Collapse advanced sections until a test alert has been sent. */
  essentialsFirst?: boolean;
  deviceSpaces?: string[];
  thresholdSensors?: Array<{
    id: string;
    label: string;
    deviceName: string;
    space?: string | null;
  }>;
}

const {
  userEmail,
  settings,
  entitlements,
  vapidPublicKey = "",
  twilioConfigured = true,
  redirectTo = "/dashboard/alerts",
  canEdit = true,
  essentialsFirst = false,
  deviceSpaces = [],
  thresholdSensors = [],
} = Astro.props;

const includedIds = new Set(settings.thresholdSensorScope.includedSensorIds);
const scopeAllSensors = settings.thresholdSensorScope.includedSensorIds.length === 0;

const QUIET_TIMEZONES = [
  "America/New_York",
  "America/Chicago",
  "America/Denver",
  "America/Los_Angeles",
  "America/Phoenix",
  "America/Anchorage",
  "Pacific/Honolulu",
  "America/Toronto",
  "America/Vancouver",
  "Europe/London",
  "Europe/Paris",
  "Europe/Berlin",
  "UTC",
];

function toTimeInputValue(raw: string | null | undefined, fallback: string): string {
  const value = (raw ?? "").trim();
  if (/^\d{2}:\d{2}$/.test(value)) return value;
  if (/^\d{1}:\d{2}$/.test(value)) return `0${value}`;
  return fallback;
}

const quietStartValue = toTimeInputValue(settings.quietHoursStart, "22:00");
const quietEndValue = toTimeInputValue(settings.quietHoursEnd, "07:00");

const ALERT_CHANNELS = [
  { id: "email", label: "Email" },
  { id: "sms", label: "SMS" },
  { id: "discord", label: "Discord" },
  { id: "push", label: "Push" },
  { id: "webhook", label: "Webhook" },
  { id: "telegram", label: "Telegram" },
  { id: "slack", label: "Slack" },
  { id: "teams", label: "Teams" },
  { id: "ntfy", label: "ntfy" },
  { id: "pushover", label: "Pushover" },
  { id: "whatsapp", label: "WhatsApp" },
] as const;

/** Space routing matrix kinds (subset of NotifyKind; preserve others on merge). */
const SPACE_ROUTING_KINDS = [
  { id: "threshold", label: "Threshold" },
  { id: "flood", label: "Flood / leak" },
  { id: "runway", label: "Time to freeze" },
  { id: "forecast", label: "Forecast" },
  { id: "nws", label: "NWS" },
  { id: "rule", label: "Rule" },
  { id: "outage", label: "Outage" },
  { id: "rate", label: "Rate drop" },
] as const;

const templateKinds = [
  "threshold",
  "flood",
  "runway",
  "forecast",
  "nws",
  "rate",
  "outage",
  "rule",
  "battery",
  "rssi",
] as const;

const needsPro =
  !entitlements.canUseSms ||
  !entitlements.canUsePush ||
  !entitlements.canUseOutboundWebhook;

const PLAYBOOK_KINDS = [
  { id: "threshold", label: "Threshold" },
  { id: "flood", label: "Flood / leak" },
  { id: "runway", label: "Time to freeze" },
  { id: "forecast", label: "Forecast" },
  { id: "nws", label: "NWS" },
  { id: "rate", label: "Rate drop" },
  { id: "outage", label: "Outage" },
  { id: "rule", label: "Rule" },
  { id: "battery", label: "Battery" },
  { id: "rssi", label: "Signal" },
  { id: "generic", label: "Generic" },
] as const;

const rulesJson = JSON.stringify(settings.alertRules ?? []);
---
{!canEdit && (
  <p class="alert-warning mb-4" role="status">
    View-only: alert settings cannot be changed on this account.
  </p>
)}
<p class="alert-success mt-0 mb-4 hidden" id="alert-action-status" role="status"></p>
<p class="alert-warning mt-0 mb-4 hidden" id="alert-action-error" role="alert"></p>
<form method="POST" id="alert-settings-form" data-alert-settings-form class="alert-settings-form">
  <fieldset disabled={!canEdit} class="border-0 p-0 m-0 min-w-0 space-y-4">
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="alert_rules_json" id="alert_rules_json" value={rulesJson} />
  <input type="hidden" name="alert_playbooks_json" id="alert_playbooks_json" value={JSON.stringify(settings.alertPlaybooks ?? [])} />
  <input type="hidden" name="alert_templates_json" id="alert_templates_json" value={JSON.stringify(settings.alertTemplates ?? {})} />

  <AlertSettingsNav essentialsFirst={essentialsFirst} />

  {essentialsFirst && (
    <p class="alert-success mt-0 mb-4" role="status">
      Start with <strong>Essentials</strong> (freeze °F + email), save, then send a test alert.
      More channels and automation unlock in the sections below after that, or expand them anytime.
    </p>
  )}

  <AlertSettingsPanel
    id="alert-section-essentials"
    title="Essentials"
    subtitle="Freeze threshold, email, sensor-dead alerts, and a weekly summary, enough for most homes."
    collapsible
    open
  >
    <label class="checkbox-row mb-4">
      <input type="checkbox" name="alerts_enabled" value="true" checked={settings.enabled} />
      <span>Turn on alerts</span>
    </label>

    <div class="config-row-grid mb-4">
      <div class="form-field mb-0">
        <label class="form-label" for="freeze_threshold_f">Freeze below (°F)</label>
        <input class="form-input" type="number" step="0.5" id="freeze_threshold_f" name="freeze_threshold_f" value={settings.freezeThresholdF} />
        <p class="form-hint mb-0">Alert when a probe is at or below this temperature.</p>
      </div>
      <div class="form-field">
        <label class="form-label" for="freeze_dwell_minutes">Below for (minutes)</label>
        <input
          class="form-input"
          type="number"
          min="0"
          max="120"
          step="1"
          id="freeze_dwell_minutes"
          name="freeze_dwell_minutes"
          value={settings.freezeDwellMinutes}
        />
        <p class="form-hint mb-0">
          Require the probe to stay at/below freeze for this many minutes before alerting.
          Use 5–15 to ignore brief door-open blips. 0 = alert on the first reading.
        </p>
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="alert_email">Alert email</label>
        <input
          class="form-input"
          type="email"
          id="alert_email"
          name="alert_email"
          value={settings.email ?? userEmail}
          placeholder={userEmail}
        />
      </div>
    </div>

    <label class="checkbox-row mb-4">
      <input
        type="checkbox"
        name="channel_email"
        value="true"
        checked={settings.channelEmail}
        data-channel-toggle="email"
      />
      <span>Send alerts by email</span>
    </label>

    <label class="checkbox-row mb-2">
      <input
        type="checkbox"
        name="outage_alerts_enabled"
        value="true"
        checked={settings.outageHours > 0}
      />
      <span>Alert if a sensor stops reporting</span>
    </label>
    <div class="form-field mb-4 max-w-xs">
      <label class="form-label" for="outage_hours">Quiet for (hours)</label>
      <input
        class="form-input"
        type="number"
        step="0.5"
        min="0.5"
        id="outage_hours"
        name="outage_hours"
        value={settings.outageHours > 0 ? settings.outageHours : 2}
      />
      <p class="form-hint mb-0">Fires when a device goes silent, often more urgent than a slow temp drop.</p>
    </div>

    <label class="checkbox-row mb-2">
      <input
        type="checkbox"
        name="forecast_freeze_enabled"
        value="true"
        checked={settings.forecastFreezeEnabled}
        disabled={!entitlements.canUseForecastAlerts}
      />
      <span>
        Cold-snap mode: warn when outdoor forecast may hit freeze
        {!entitlements.canUseForecastAlerts && (
          <span class="text-[var(--color-text-muted)]"> (Member)</span>
        )}
      </span>
    </label>
    <div class="form-field mb-4 max-w-xs">
      <label class="form-label" for="forecast_hours_ahead">Look-ahead hours</label>
      <input
        class="form-input"
        type="number"
        min="3"
        max="48"
        step="1"
        id="forecast_hours_ahead"
        name="forecast_hours_ahead"
        value={settings.forecastHoursAhead}
      />
      <p class="form-hint mb-0">Window for outdoor cold-snap warnings (Member) and indoor time-to-freeze remaining-hours alerts.</p>
    </div>

    <label class="checkbox-row mb-2">
      <input
        type="checkbox"
        name="runway_alert_enabled"
        value="true"
        checked={settings.runwayAlertEnabled}
      />
      <span>Time-to-freeze remaining-hours: alert before the probe crosses freeze</span>
    </label>
    <p class="form-hint mb-4">
      Uses this space’s lag vs the outdoor forecast when weather location is set; otherwise a cooling-rate clock.
      Fires inside the look-ahead window above so you can drip faucets or turn on heat while you still have time.
    </p>

    <label class="checkbox-row mb-4">
      <input
        type="checkbox"
        name="digest_enabled"
        value="true"
        checked={settings.digestEnabled}
      />
      <span>Weekly email digest (Mondays): coldest night, leaks, and outages</span>
    </label>

    {entitlements.canUsePortfolio && (
      <label class="checkbox-row mb-4">
        <input
          type="checkbox"
          name="portfolio_alerts_enabled"
          value="true"
          checked={settings.portfolioAlertsEnabled}
        />
        <span>Properties-at-risk digest: email when any property crosses freeze</span>
      </label>
    )}

    <p class="form-hint mb-4">
      Flood / leak sensors notify automatically when wet. Save, then
      <a class="text-link" href="#send-test-alert">send a test alert</a>.
    </p>

    <details class="alert-settings-nested mb-4">
      <summary>Snooze & vacation</summary>
      <div class="alert-settings-nested-body">
        <p class="form-hint mb-3">
          Snooze pauses most alerts (outage and flood still fire). Vacation suppresses non-critical alerts until a return date or for a set number of days.
          {settings.snoozeUntil && (
            <span class="block mt-1">Snoozed until {new Date(settings.snoozeUntil).toLocaleString()}.</span>
          )}
          {settings.vacationUntil && (
            <span class="block mt-1">Vacation until {new Date(settings.vacationUntil).toLocaleString()}.</span>
          )}
        </p>
        <div class="flex flex-wrap gap-2 items-end mb-3">
          <button type="button" class="btn-secondary" data-snooze-action="snooze_24">Snooze 24h</button>
          <button type="button" class="btn-secondary" data-snooze-action="vacation_7">Vacation 7d</button>
          {settings.snoozeUntil && (
            <button type="button" class="btn-secondary" data-snooze-action="clear_snooze">Clear snooze</button>
          )}
          {settings.vacationUntil && (
            <button type="button" class="btn-secondary" data-snooze-action="clear_vacation">End vacation</button>
          )}
        </div>
        <div class="flex flex-wrap gap-2 items-end">
          <div class="form-field mb-0">
            <label class="form-label" for="vacation_until_date">Vacation until</label>
            <input
              class="form-input"
              type="date"
              id="vacation_until_date"
              data-vacation-until-date
              min={new Date().toISOString().slice(0, 10)}
            />
          </div>
          <button type="button" class="btn-secondary" data-snooze-action="vacation_until">
            Set vacation until date
          </button>
        </div>
      </div>
    </details>

    <details class="alert-settings-nested mb-4">
      <summary>More triggers (humidity, rate, NWS)</summary>
      <div class="alert-settings-nested-body">
        <div class="config-row-grid mb-4">
          <div class="form-field mb-0">
            <label class="form-label" for="humidity_threshold">Humidity above (%)</label>
            <input class="form-input" type="number" step="1" id="humidity_threshold" name="humidity_threshold" value={settings.humidityThreshold} />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for="rate_change_f">Rate drop (°F / hour)</label>
            <input class="form-input" type="number" step="0.5" id="rate_change_f" name="rate_change_f" value={settings.rateChangeF} />
          </div>
        </div>
        <label class="checkbox-row mb-0">
          <input type="checkbox" name="nws_freeze_alerts_enabled" value="true" checked={settings.nwsFreezeAlertsEnabled} disabled={!entitlements.canUseNwsAlerts} />
          <span>NWS official freeze / cold alerts {!entitlements.canUseNwsAlerts && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
        </label>
      </div>
    </details>

    {thresholdSensors.length > 0 && (
      <details class="alert-settings-nested mb-4">
        <summary>Per-sensor threshold scope</summary>
        <div class="alert-settings-nested-body">
          <p class="form-hint mb-3">
            By default every temperature sensor uses the household freeze and humidity thresholds above.
            Check specific sensors to limit threshold alerts, or set an optional override per sensor.
          </p>
          <label class="checkbox-row mb-3">
            <input
              type="checkbox"
              id="threshold_scope_all"
              checked={scopeAllSensors}
              disabled={!canEdit}
            />
            <span>All temperature sensors (default)</span>
          </label>
          <div class="space-y-3" id="threshold-sensor-scope-editor">
            {thresholdSensors.map((sensor) => {
              const override = settings.thresholdSensorScope.overrides[sensor.id];
              return (
                <div class="rounded border border-[var(--color-border)] p-3">
                  <label class="checkbox-row mb-2">
                    <input
                      type="checkbox"
                      class="threshold-sensor-checkbox"
                      data-sensor-id={sensor.id}
                      checked={scopeAllSensors || includedIds.has(sensor.id)}
                      disabled={!canEdit}
                    />
                    <span>
                      <strong>{sensor.label}</strong>
                      <span class="text-sm text-[var(--color-text-muted)]">
                        {" "}
                        · {sensor.deviceName}
                        {sensor.space ? ` · ${sensor.space}` : ""}
                      </span>
                    </span>
                  </label>
                  <div class="form-field mb-0">
                    <label class="form-label" for={`sensor-freeze-${sensor.id}`}>
                      Optional freeze override (°F)
                    </label>
                    <input
                      class="form-input threshold-sensor-override"
                      type="number"
                      step="0.5"
                      id={`sensor-freeze-${sensor.id}`}
                      data-sensor-id={sensor.id}
                      data-override-kind="freezeThresholdF"
                      value={override?.freezeThresholdF ?? ""}
                      placeholder={`Default ${settings.freezeThresholdF}`}
                      disabled={!canEdit}
                    />
                  </div>
                  <div class="form-field mb-0">
                    <label class="form-label" for={`sensor-humidity-${sensor.id}`}>
                      Optional humidity override (%)
                    </label>
                    <input
                      class="form-input threshold-sensor-override"
                      type="number"
                      step="1"
                      id={`sensor-humidity-${sensor.id}`}
                      data-sensor-id={sensor.id}
                      data-override-kind="humidityThreshold"
                      value={override?.humidityThreshold ?? ""}
                      placeholder={`Default ${settings.humidityThreshold}`}
                      disabled={!canEdit}
                    />
                  </div>
                </div>
              );
            })}
          </div>
          <textarea
            class="form-textarea font-mono text-xs sr-only"
            id="threshold_sensor_scope_json"
            name="threshold_sensor_scope_json"
            rows={4}
            aria-hidden="true"
          >{JSON.stringify(settings.thresholdSensorScope ?? {}, null, 2)}</textarea>
        </div>
      </details>
    )}

    <details class="alert-settings-nested">
      <summary>Device & feed health</summary>
      <div class="alert-settings-nested-body">
        <div class="config-row-grid mb-4">
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="battery_alerts_enabled" value="true" checked={settings.batteryAlertsEnabled} />
            <span>Low battery alerts</span>
          </label>
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="battery_trend_alerts_enabled" value="true" checked={settings.batteryTrendAlertsEnabled} />
            <span>Battery trend drop</span>
          </label>
          <div class="form-field mb-0">
            <label class="form-label" for="battery_threshold_pct">Battery below (%)</label>
            <input class="form-input" type="number" id="battery_threshold_pct" name="battery_threshold_pct" value={settings.batteryThresholdPct} />
          </div>
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="rssi_alerts_enabled" value="true" checked={settings.rssiAlertsEnabled} />
            <span>Weak WiFi signal</span>
          </label>
          <div class="form-field mb-0">
            <label class="form-label" for="rssi_threshold">RSSI below (dBm)</label>
            <input class="form-input" type="number" id="rssi_threshold" name="rssi_threshold" value={settings.rssiThreshold} />
          </div>
        </div>
        <label class="checkbox-row mb-0">
          <input type="checkbox" name="feed_uptime_alerts_enabled" value="true" checked={settings.feedUptimeAlertsEnabled} />
          <span>Feed unreachable (hourly check on pull JSON feeds)</span>
        </label>
      </div>
    </details>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-channels"
    title="More channels"
    subtitle="Add chat apps, SMS, push, or webhooks. Email is configured under Essentials."
    collapsible
  >
    <p class="form-hint mb-3">
      Email is under Essentials. Here: Discord, Telegram, Slack, Teams, ntfy, Pushover. Pro: SMS, WhatsApp, browser push, outbound webhooks.
    </p>
    <div class="alert-channel-grid mb-4">
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_discord" value="true" checked={settings.channelDiscord} data-channel-toggle="discord" />
        <span>Discord</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_telegram" value="true" checked={settings.channelTelegram} data-channel-toggle="telegram" />
        <span>Telegram</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_slack" value="true" checked={settings.channelSlack} data-channel-toggle="slack" />
        <span>Slack</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_teams" value="true" checked={settings.channelTeams} data-channel-toggle="teams" />
        <span>Teams</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_ntfy" value="true" checked={settings.channelNtfy} data-channel-toggle="ntfy" />
        <span>ntfy</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_pushover" value="true" checked={settings.channelPushover} data-channel-toggle="pushover" />
        <span>Pushover</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_whatsapp" value="true" checked={settings.channelWhatsapp} disabled={!entitlements.canUseSms} data-channel-toggle="whatsapp" />
        <span>WhatsApp {!entitlements.canUseSms && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_sms" value="true" checked={settings.channelSms} disabled={!entitlements.canUseSms} data-channel-toggle="sms" />
        <span>SMS {!entitlements.canUseSms && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_push" value="true" checked={settings.channelPush} disabled={!entitlements.canUsePush} data-channel-toggle="push" />
        <span>Push (browser + Android) {!entitlements.canUsePush && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="channel_webhook" value="true" checked={settings.channelWebhook} disabled={!entitlements.canUseOutboundWebhook} data-channel-toggle="webhook" />
        <span>Outbound webhook {!entitlements.canUseOutboundWebhook && <span class="text-[var(--color-text-muted)]">(Pro)</span>}</span>
      </label>
    </div>

    {entitlements.canUseSms && !twilioConfigured && (
      <p class="alert-warning mb-4 text-sm" role="status">
        SMS is on your plan but Twilio is not configured on this server. Messages will be skipped until `TWILIO_*` secrets are set.
      </p>
    )}

    {needsPro && (
      <p class="mb-4 text-sm text-[var(--color-text-muted)]">
        Unlock SMS, push, and webhooks with <a class="text-link" href="/dashboard/plans">Pro</a>.
      </p>
    )}

    <div class="alert-channel-panels">
      <div class="alert-channel-panel" data-channel-panel="discord" hidden={!settings.channelDiscord}>
        <p class="alert-channel-panel-label">Discord</p>
        <div class="form-field mb-0">
          <label class="form-label" for="discord_webhook_url">Webhook URL</label>
          <input class="form-input" type="url" id="discord_webhook_url" name="discord_webhook_url" value={settings.discordWebhookUrl ?? ""} placeholder="https://discord.com/api/webhooks/..." />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="telegram" hidden={!settings.channelTelegram}>
        <p class="alert-channel-panel-label">Telegram</p>
        <div class="form-field">
          <label class="form-label" for="telegram_bot_token">Bot token</label>
          <input class="form-input" type="text" id="telegram_bot_token" name="telegram_bot_token" value={settings.telegramBotToken ?? ""} placeholder="123456:ABC..." autocomplete="off" />
        </div>
        <div class="form-field">
          <label class="form-label" for="telegram_chat_id">Chat ID (required for commands)</label>
          <input class="form-input" type="text" id="telegram_chat_id" name="telegram_chat_id" value={settings.telegramChatId ?? ""} placeholder="-100..." />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="telegram_command_secret">Webhook secret (optional)</label>
          <input class="form-input" type="text" id="telegram_command_secret" name="telegram_command_secret" value={settings.telegramCommandSecret ?? ""} placeholder="random-secret" autocomplete="off" />
          <p class="form-hint mb-0">
            Use Telegram <code>setWebhook</code> with <code>secret_token</code> so Telegram sends
            <code>X-Telegram-Bot-Api-Secret-Token</code> (query <code>?secret=</code> is not accepted).
            Save a Chat ID above: commands only run from that chat (/status [name], /snooze [hours], /vacation [days]).
          </p>
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="slack" hidden={!settings.channelSlack}>
        <p class="alert-channel-panel-label">Slack</p>
        <div class="form-field mb-0">
          <label class="form-label" for="slack_webhook_url">Incoming webhook URL</label>
          <input class="form-input" type="url" id="slack_webhook_url" name="slack_webhook_url" value={settings.slackWebhookUrl ?? ""} placeholder="https://hooks.slack.com/services/..." />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="teams" hidden={!settings.channelTeams}>
        <p class="alert-channel-panel-label">Microsoft Teams</p>
        <div class="form-field mb-0">
          <label class="form-label" for="teams_webhook_url">Webhook URL</label>
          <input class="form-input" type="url" id="teams_webhook_url" name="teams_webhook_url" value={settings.teamsWebhookUrl ?? ""} placeholder="https://outlook.office.com/webhook/..." />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="ntfy" hidden={!settings.channelNtfy}>
        <p class="alert-channel-panel-label">ntfy</p>
        <div class="form-field">
          <label class="form-label" for="ntfy_topic">Topic</label>
          <input class="form-input" type="text" id="ntfy_topic" name="ntfy_topic" value={settings.ntfyTopic ?? ""} placeholder="space-freeze-alerts" />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="ntfy_server">Server (optional)</label>
          <input class="form-input" type="url" id="ntfy_server" name="ntfy_server" value={settings.ntfyServer} placeholder="https://ntfy.sh" />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="pushover" hidden={!settings.channelPushover}>
        <p class="alert-channel-panel-label">Pushover</p>
        <div class="form-field">
          <label class="form-label" for="pushover_user_key">User key</label>
          <input class="form-input" type="text" id="pushover_user_key" name="pushover_user_key" value={settings.pushoverUserKey ?? ""} />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="pushover_app_token">App token</label>
          <input class="form-input" type="text" id="pushover_app_token" name="pushover_app_token" value={settings.pushoverAppToken ?? ""} autocomplete="off" />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="whatsapp" hidden={!settings.channelWhatsapp}>
        <p class="alert-channel-panel-label">WhatsApp</p>
        <div class="form-field mb-0">
          <label class="form-label" for="whatsapp_phone">Phone number</label>
          <input class="form-input" type="tel" id="whatsapp_phone" name="whatsapp_phone" value={settings.whatsappPhone ?? ""} placeholder="+15551234567" disabled={!entitlements.canUseSms} />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="sms" hidden={!settings.channelSms}>
        <p class="alert-channel-panel-label">SMS</p>
        <div class="form-field mb-0">
          <label class="form-label" for="sms_phone">Phone number</label>
          <input class="form-input" type="tel" id="sms_phone" name="sms_phone" value={settings.smsPhone ?? ""} placeholder="+15551234567" disabled={!entitlements.canUseSms} />
          <p class="form-hint mb-0">International format, e.g. +1 for US numbers.</p>
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="webhook" hidden={!settings.channelWebhook}>
        <p class="alert-channel-panel-label">Outbound webhook</p>
        <div class="form-field">
          <label class="form-label" for="outbound_webhook_url">URL</label>
          <input class="form-input" type="url" id="outbound_webhook_url" name="outbound_webhook_url" value={settings.outboundWebhookUrl ?? ""} placeholder="https://hooks.example.com/..." disabled={!entitlements.canUseOutboundWebhook} />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="outbound_webhook_secret">Signing secret (optional)</label>
          <input class="form-input" type="text" id="outbound_webhook_secret" name="outbound_webhook_secret" value={settings.outboundWebhookSecret ?? ""} disabled={!entitlements.canUseOutboundWebhook} />
        </div>
      </div>

      <div class="alert-channel-panel" data-channel-panel="push" hidden={!settings.channelPush}>
        <p class="alert-channel-panel-label">Push (browser + Android)</p>
        <p class="form-hint mb-3">
          One channel covers <strong>this browser</strong> (Web Push) and the
          <strong>ThermalTrace Android app</strong> (FCM). Enable below for this browser; the Android app registers automatically when you sign in on Pro.
        </p>
        {!vapidPublicKey ? (
          <p class="form-hint mb-2">Browser push is not configured on the server yet (missing VAPID keys).</p>
        ) : (
          <>
            <p class="form-hint mb-3" id="push-status">Checking push status…</p>
            <button type="button" class="btn-secondary" id="enable-push-btn" data-vapid={vapidPublicKey}>
              Enable browser push on this device
            </button>
            <p class="form-hint mt-2 mb-0" id="push-hint"></p>
          </>
        )}
      </div>
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-quiet"
    title="Alert quiet hours"
    subtitle="Pause overnight delivery of non-critical alerts. Separate from Overview “hide recommendations,” which only quiets dashboard nudges."
    collapsible
    open={essentialsFirst}
  >
    <label class="checkbox-row mb-2">
      <input type="checkbox" name="quiet_hours_enabled" value="true" checked={settings.quietHoursEnabled} />
      <span>Enable alert quiet hours</span>
    </label>
    <label class="checkbox-row mb-3">
      <input type="checkbox" name="quiet_hours_bypass_freeze" value="true" checked={settings.quietHoursBypassFreeze} />
      <span>Always deliver freeze, flood, and forecast alerts</span>
    </label>
    <label class="checkbox-row mb-4">
      <input type="checkbox" name="quiet_hours_sms_critical" value="true" checked={settings.quietHoursSmsCritical} disabled={!entitlements.canUseSms} />
      <span>
        Still send critical freeze/flood/forecast via SMS (Pro)
        {!entitlements.canUseSms && (
          <>: <a class="text-link" href="/dashboard/plans">Upgrade</a></>
        )}
      </span>
    </label>
    <div class="config-row-grid">
      <div class="form-field mb-0">
        <label class="form-label" for="quiet_hours_start">Start</label>
        <input class="form-input" type="time" id="quiet_hours_start" name="quiet_hours_start" value={quietStartValue} />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="quiet_hours_end">End</label>
        <input class="form-input" type="time" id="quiet_hours_end" name="quiet_hours_end" value={quietEndValue} />
      </div>
      <div class="form-field mb-0">
        <label class="form-label" for="quiet_hours_timezone">Timezone</label>
        <select class="form-input" id="quiet_hours_timezone" name="quiet_hours_timezone">
          {QUIET_TIMEZONES.map((tz) => (
            <option value={tz} selected={settings.quietHoursTimezone === tz}>
              {tz.replace(/_/g, " ")}
            </option>
          ))}
          {settings.quietHoursTimezone &&
            !QUIET_TIMEZONES.includes(settings.quietHoursTimezone) && (
              <option value={settings.quietHoursTimezone} selected>
                {settings.quietHoursTimezone}
              </option>
            )}
        </select>
      </div>
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-automation"
    title="Rules & escalation"
    subtitle="Composite AND rules, timed playbooks, and SMS re-send if a condition persists."
    collapsible
  >
    <h3 class="alert-settings-subheading">Composite rules (AND)</h3>
    <p class="form-hint mb-3">Fire when every condition in a rule is true (e.g. door open AND temperature drop). Flood already alerts when wet; add a flood condition here only to combine it with other checks.</p>
    <div id="alert-rules-list" class="space-y-3 mb-3"></div>
    <button type="button" class="btn-secondary mb-4" id="add-alert-rule">Add rule</button>

    <h3 class="alert-settings-subheading">Alert playbooks</h3>
    <p class="form-hint mb-3">Follow-up steps after the initial alert: e.g. SMS 15 minutes later if still unacknowledged.</p>
    <div id="alert-playbooks-list" class="space-y-3 mb-3"></div>
    <button type="button" class="btn-secondary mb-4" id="add-playbook-step">Add step</button>
    <textarea
      class="form-textarea font-mono text-xs sr-only"
      id="alert_playbooks_editor"
      data-playbooks-editor
      aria-hidden="true"
    >{JSON.stringify(settings.alertPlaybooks ?? [], null, 2)}</textarea>

    <h3 class="alert-settings-subheading">SMS escalation</h3>
    <div class="config-row-grid">
      <label class="checkbox-row mb-0">
        <input type="checkbox" name="escalation_enabled" value="true" checked={settings.escalationEnabled} />
        <span>Re-send threshold alerts via SMS</span>
      </label>
      <div class="form-field mb-0">
        <label class="form-label" for="escalation_minutes">After (minutes)</label>
        <input class="form-input" type="number" id="escalation_minutes" name="escalation_minutes" value={settings.escalationMinutes} min="5" />
      </div>
    </div>
  </AlertSettingsPanel>

  <AlertSettingsPanel
    id="alert-section-advanced"
    title="Advanced routing & reports"
    subtitle="Per-kind channel overrides, space routing, custom messages, digests, and reading webhooks."
    collapsible
  >
    <details class="alert-settings-nested">
      <summary>Severity routing (optional)</summary>
      <div class="alert-settings-nested-body">
        <p class="form-hint mb-3">Leave empty to use global channel checkboxes. Otherwise only selected channels fire for that kind.</p>
        <input type="hidden" name="channel_severity_json" id="channel_severity_json" value={JSON.stringify(settings.channelSeverity ?? {})} />
        <div class="space-y-3" id="severity-routing">
          {(["threshold", "flood", "forecast", "rate", "outage", "rule", "battery", "rssi"] as const).map((kind) => {
            const selected = settings.channelSeverity?.[kind] ?? [];
            return (
              <div class="form-field mb-0">
                <label class="form-label capitalize">{kind}</label>
                <div class="flex flex-wrap gap-2">
                  {(["email", "discord", "telegram", "slack", "sms", "push", "webhook"] as const).map((ch) => (
                    <label class="checkbox-row mb-0 text-sm">
                      <input
                        type="checkbox"
                        data-severity-kind={kind}
                        data-severity-channel={ch}
                        checked={selected.includes(ch)}
                      />
                      <span>{ch}</span>
                    </label>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </details>

    <details class="alert-settings-nested">
      <summary>Per-space channel routing</summary>
      <div class="alert-settings-nested-body">
        {deviceSpaces.length === 0 ? (
          <p class="form-hint mb-0">
            Assign a space label on devices (Dashboard → Devices) to route alerts by location.
          </p>
        ) : (
          <div class="space-y-4">
            <p class="form-hint mb-0">
              Pick channels per space and alert kind. Unchecked kinds use global / severity routing.
            </p>
            {deviceSpaces.map((space) => {
              const key = space.toLowerCase();
              const spaceMap = settings.spaceChannelRouting?.[key] ?? {};
              return (
                <fieldset class="border border-[var(--color-border)] rounded-lg p-3">
                  <legend class="text-sm font-semibold px-1 capitalize">{space}</legend>
                  <div class="space-y-3">
                    {SPACE_ROUTING_KINDS.map((kind) => {
                      const selected = new Set(spaceMap[kind.id] ?? []);
                      return (
                        <div>
                          <p class="form-hint mb-1">{kind.label}</p>
                          <div class="flex flex-wrap gap-2">
                            {ALERT_CHANNELS.map((channel) => (
                              <label class="inline-flex items-center gap-2 text-sm">
                                <input
                                  type="checkbox"
                                  class="space-routing-checkbox"
                                  data-space={key}
                                  data-kind={kind.id}
                                  data-channel={channel.id}
                                  checked={selected.has(channel.id)}
                                  disabled={!canEdit}
                                />
                                {channel.label}
                              </label>
                            ))}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </fieldset>
              );
            })}
          </div>
        )}
        <textarea
          class="form-textarea font-mono text-xs sr-only"
          id="space_channel_routing_json"
          name="space_channel_routing_json"
          rows={4}
          aria-hidden="true"
        >{JSON.stringify(settings.spaceChannelRouting ?? {}, null, 2)}</textarea>
      </div>
    </details>

    <details class="alert-settings-nested">
      <summary>Custom alert messages</summary>
      <div class="alert-settings-nested-body">
        <p class="form-hint mb-3">
          Override title/body per alert kind. Variables: <code>{`{{kind}}`}</code>, <code>{`{{title}}`}</code>, <code>{`{{body}}`}</code>.
        </p>
        <div class="space-y-3" id="alert-templates-editor">
          {templateKinds.map((kind) => {
            const tpl = settings.alertTemplates?.[kind] ?? {};
            return (
              <div class="rounded border border-[var(--color-border)] p-3">
                <p class="text-sm font-semibold mb-2 capitalize">{kind}</p>
                <div class="form-field mb-2">
                  <label class="form-label" for={`tpl-title-${kind}`}>Title</label>
                  <input
                    class="form-input"
                    type="text"
                    id={`tpl-title-${kind}`}
                    data-template-kind={kind}
                    data-template-field="title"
                    value={tpl.title ?? ""}
                    placeholder="Leave blank for default"
                  />
                </div>
                <div class="form-field mb-0">
                  <label class="form-label" for={`tpl-body-${kind}`}>Body</label>
                  <input
                    class="form-input"
                    type="text"
                    id={`tpl-body-${kind}`}
                    data-template-kind={kind}
                    data-template-field="body"
                    value={tpl.body ?? ""}
                    placeholder="Leave blank for default"
                  />
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </details>

    <details class="alert-settings-nested">
      <summary>More email reports</summary>
      <div class="alert-settings-nested-body">
        <p class="form-hint mb-3">
          Weekly digest lives under Essentials. These are optional longer reports.
        </p>
        <label class="checkbox-row mb-3">
          <input type="checkbox" name="monthly_report_enabled" value="true" checked={settings.monthlyReportEnabled} />
          <span>Monthly freeze report (1st of month, HTML attachment)</span>
        </label>
        <label class="checkbox-row mb-3">
          <input type="checkbox" name="quarterly_report_enabled" value="true" checked={settings.quarterlyReportEnabled} />
          <span>Quarterly seasonal report (Jan, Apr, Jul, Oct)</span>
        </label>
        <label class="checkbox-row mb-3">
          <input type="checkbox" name="drip_emails_enabled" value="true" checked={settings.dripEmailsEnabled} />
          <span>Onboarding tips (days 1, 3, and 7 after signup)</span>
        </label>
        <label class="checkbox-row mb-0">
          <input type="checkbox" name="freeze_drill_enabled" value="true" checked={settings.freezeDrillEnabled} />
          <span>Pre-season freeze drill (Sep–Nov email with readiness score)</span>
        </label>
      </div>
    </details>

    <details class="alert-settings-nested">
      <summary>Reading webhooks (Pro)</summary>
      <div class="alert-settings-nested-body">
        <div class="form-field">
          <label class="form-label" for="reading_webhook_url">Reading webhook URL</label>
          <input class="form-input" type="url" id="reading_webhook_url" name="reading_webhook_url" value={settings.readingWebhookUrl ?? ""} placeholder="https://hooks.example.com/readings" disabled={!entitlements.canUseOutboundWebhook} />
          <p class="form-hint">POST on every successful device ingest with latest readings JSON.</p>
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="reading_webhook_secret">Signing secret (optional)</label>
          <input class="form-input" type="text" id="reading_webhook_secret" name="reading_webhook_secret" value={settings.readingWebhookSecret ?? ""} disabled={!entitlements.canUseOutboundWebhook} />
        </div>
      </div>
    </details>
  </AlertSettingsPanel>

  <section class="card alert-settings-save sticky-alert-save" hidden={!canEdit}>
    <div class="sticky-alert-save-inner">
      <button type="submit" class="btn-primary" id="alert-settings-submit">
        Save alert settings
      </button>
      <p class="form-hint mt-0 mb-0" id="channel-incomplete-hint" hidden>
        A checked channel needs its destination filled in, or it will be skipped when alerts fire.
      </p>
      <p class="form-hint mt-0 mb-0 text-[var(--color-text-muted)] sticky-alert-save-hint">
        Changes are not applied until you save.
      </p>
    </div>
  </section>
  </fieldset>
</form>

<style>
  .sticky-alert-save {
    position: sticky;
    bottom: 0.75rem;
    z-index: 30;
    margin-top: 1rem;
    box-shadow: 0 -8px 24px color-mix(in srgb, var(--color-bg, #0b0b0b) 70%, transparent);
  }

  .sticky-alert-save-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .sticky-alert-save-hint {
    flex: 1 1 12rem;
  }
</style>

<AlertSettingsFormSubmit />
<AlertSettingsRulesScript initialRules={settings.alertRules} />
<AlertSettingsPlaybooksScript
  initialPlaybooks={settings.alertPlaybooks ?? []}
  alertChannels={ALERT_CHANNELS}
  playbookKinds={PLAYBOOK_KINDS}
/>
{entitlements.canUsePush && vapidPublicKey && (
  <AlertSettingsPushScript vapidPublicKey={vapidPublicKey} />
)}
