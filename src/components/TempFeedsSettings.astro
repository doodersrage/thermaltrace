---
import type { TempFeedConfig } from "../lib/tempFeedConfig";
import { MAX_TEMP_FEEDS } from "../lib/tempFeedConfig";
import FeedTestButton from "./FeedTestButton";

interface Props {
  feeds: TempFeedConfig[];
}

const { feeds } = Astro.props;

const existingFeeds = feeds.filter((feed) => Boolean(feed.url));
const canAddMore = existingFeeds.length < MAX_TEMP_FEEDS;
---

<div id="pull-feeds-form" class="space-y-4">
  <div>
    <h3 class="text-base font-semibold m-0">Feed URLs</h3>
    <p class="card-subtitle mb-0 mt-1">
      HTTPS JSON endpoints we pull on a schedule. Probe objects live under a root key
      (default <code>temp</code>).      <a class="text-link" href="/about/json-probe-output-schema">schema docs</a>.
    </p>
  </div>

  <div class="flex flex-col gap-3">
    {existingFeeds.map((feed, index) => (
      <div class="sensor-map-row">
        <input type="hidden" name={`feed_${index}_id`} value={feed.id} />
        <div class="sensor-map-primary">
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${index}_name`}>Name</label>
            <input
              class="form-input"
              type="text"
              id={`feed_${index}_name`}
              name={`feed_${index}_name`}
              value={feed.name}
              placeholder="Workshop"
            />
          </div>
          <div class="form-field mb-0 sm:col-span-2">
            <label class="form-label" for={`feed_${index}_url`}>HTTPS URL</label>
            <input
              class="form-input font-mono text-sm"
              type="url"
              id={`feed_${index}_url`}
              name={`feed_${index}_url`}
              value={feed.url}
              placeholder="https://thermaltrace.dev/api/feeds/example"
              required
            />
            <FeedTestButton
              client:visible
              inputId={`feed_${index}_url`}
              rootInputId={`feed_${index}_json_root`}
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${index}_json_root`}>JSON root key</label>
            <input
              class="form-input font-mono"
              type="text"
              id={`feed_${index}_json_root`}
              name={`feed_${index}_json_root`}
              value={feed.jsonRoot || "temp"}
              placeholder="temp"
              pattern="[A-Za-z_][A-Za-z0-9_]*"
              title="Letter or underscore, then letters, numbers, or underscores"
            />
            <p class="form-hint mb-0">Object that holds probe keys (usually <code>temp</code>).</p>
          </div>
          <div class="sensor-map-actions">
            <label class="checkbox-row mb-0">
              <input
                type="checkbox"
                name={`feed_${index}_enabled`}
                value="true"
                checked={feed.enabled}
              />
              <span>Enabled</span>
            </label>
            <span
              class="text-sm text-[var(--color-text-muted)]"
              data-pull-fetch-status={feed.id}
              aria-live="polite"
            />
            <form action="/api/user/pull-setup/delete" method="post">
              <input type="hidden" name="feed_id" value={feed.id} />
              <input type="hidden" name="redirect" value="/dashboard/devices?tab=pull" />
              <button
                type="submit"
                class="btn-ghost"
                onclick="return confirm('Delete this feed?');"
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    ))}

    {canAddMore && (
      <div class="sensor-map-row sensor-quick-pair">
        <p class="m-0 mb-3 text-sm font-medium">Add a pull feed</p>
        <input type="hidden" name={`feed_${existingFeeds.length}_id`} value="" />
        <div class="sensor-map-primary">
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${existingFeeds.length}_name`}>Name</label>
            <input
              class="form-input"
              type="text"
              id={`feed_${existingFeeds.length}_name`}
              name={`feed_${existingFeeds.length}_name`}
              placeholder="Workshop"
            />
          </div>
          <div class="form-field mb-0 sm:col-span-2">
            <label class="form-label" for={`feed_${existingFeeds.length}_url`}>HTTPS URL</label>
            <input
              class="form-input font-mono text-sm"
              type="url"
              id={`feed_${existingFeeds.length}_url`}
              name={`feed_${existingFeeds.length}_url`}
              placeholder="https://thermaltrace.dev/api/feeds/example"
            />
          </div>
          <div class="form-field mb-0">
            <label class="form-label" for={`feed_${existingFeeds.length}_json_root`}>JSON root key</label>
            <input
              class="form-input font-mono"
              type="text"
              id={`feed_${existingFeeds.length}_json_root`}
              name={`feed_${existingFeeds.length}_json_root`}
              value="temp"
              placeholder="temp"
            />
          </div>
          <div class="sensor-map-actions">
            <label class="checkbox-row mb-0">
              <input
                type="checkbox"
                name={`feed_${existingFeeds.length}_enabled`}
                value="true"
                checked
              />
              <span>Enabled</span>
            </label>
          </div>
        </div>
      </div>
    )}
  </div>
</div>
