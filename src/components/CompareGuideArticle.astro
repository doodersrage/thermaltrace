---
import Layout from "../layouts/Layout.astro";
import PageHeader from "./PageHeader.astro";
import AboutCcFigure from "./AboutCcFigure.astro";
import FaqSection from "./FaqSection.astro";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import type { CompareGuide } from "../lib/compareGuides";
import "../styles/about.css";

interface Props {
  guide: CompareGuide;
}

const { guide } = Astro.props;
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, guide.path);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Compare", path: "/compare" },
    { name: guide.title, path: guide.path },
  ]),
  getFaqPageSchema(pageUrl, guide.faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={guide.title}
  description={guide.description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Compare"
      title={guide.headline}
      lede={guide.lede}
    >
      <a slot="actions" class="btn-primary" href="/pricing">See plans &amp; pricing</a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/devices">Start free</a>
    </PageHeader>

    {guide.photoId && <AboutCcFigure photoId={guide.photoId} />}

    <section class="card">
      <h2 class="card-title">ThermalTrace vs {guide.competitor}</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">{guide.headline} capability comparison</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">ThermalTrace</th>
              <th scope="col">{guide.competitor}</th>
            </tr>
          </thead>
          <tbody>
            {guide.rows.map((row) => (
              <tr>
                <th scope="row">{row.capability}</th>
                <td>{row.thermaltrace}</td>
                <td>{row.other}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">When to choose which</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-base font-semibold mb-2">Choose ThermalTrace when</h3>
          <ul class="text-sm space-y-2 mb-0">
            {guide.whenThermalTrace.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-base font-semibold mb-2">Choose {guide.competitor} when</h3>
          <ul class="text-sm space-y-2 mb-0">
            {guide.whenOther.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <FaqSection
      faqs={guide.faqs}
      lede={`Straight answers for people comparing ThermalTrace to ${guide.competitor}.`}
    />

    <section class="card">
      <h2 class="card-title">Next steps</h2>
      <p class="card-subtitle mb-4">
        Start free with live charts, email alerts, and a family live share link, or compare plans when you need SMS, CSV history, and expanded Pro share scopes.
      </p>
      <div class="flex flex-wrap gap-3 mb-4">
        <a class="btn-primary" href="/pricing">See plans &amp; pricing</a>
        <a class="btn-secondary" href="/register?next=/dashboard/devices">Start free</a>
        {guide.slug === "diy-mqtt" && (
          <a class="btn-secondary" href="/integrations/home-assistant">Home Assistant (HACS)</a>
        )}
        {guide.slug === "diy-mqtt" && (
          <a class="btn-secondary" href="/about/mqtt-bridge">MQTT bridge recipe</a>
        )}
        {(guide.slug === "nest" || guide.slug === "ecobee") && (
          <a class="btn-secondary" href="/dashboard/devices?view=setup&tab=pull#thermostat-integration">
            Connect your {guide.competitor.replace(" Thermostat", "")} (Pro)
          </a>
        )}
        {guide.slug === "tempstick" && (
          <a class="btn-secondary" href="/freeze-season">Freeze-season checklist</a>
        )}
        {guide.slug === "tempstick" && (
          <a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 freeze kit BOM</a>
        )}
      </div>
      <p class="mb-0 text-sm">
        <a class="text-link" href="/compare">← Back to all comparisons</a>
        {guide.slug === "diy-mqtt" && (
          <>
            {" · "}
            <a class="text-link" href="/integrations/home-assistant">HACS integration</a>
            {" · "}
            <a class="text-link" href="/nodered/mqtt-to-thermaltrace.json" download>Node-RED flow</a>
          </>
        )}
      </p>
    </section>
  </div>
</Layout>
