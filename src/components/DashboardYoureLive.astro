---
import DashboardCard from "./dashboard/DashboardCard.astro";

interface Props {
  show: boolean;
  hasAlertsEnabled: boolean;
  hasEmailAlerts: boolean;
  hasTestAlert: boolean;
}

const { show, hasAlertsEnabled, hasEmailAlerts, hasTestAlert } = Astro.props;
if (!show) return null;

const nextHref =
  !hasAlertsEnabled || !hasEmailAlerts
    ? "/dashboard/alerts?tab=settings#alert-section-channels"
    : !hasTestAlert
      ? "/dashboard/alerts?tab=settings#send-test-alert"
      : "/dashboard/history";
const nextLabel =
  !hasAlertsEnabled || !hasEmailAlerts
    ? "Finish alert setup"
    : !hasTestAlert
      ? "Send a test alert"
      : "Review history";
---
<div data-nudge-key="live_coach">
  <DashboardCard>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="card-title">Probe cards live on Live</h2>
        <p class="card-subtitle mb-0">
          Glanceable readings moved to Dashboard → Live. Overview stays for risk and what to do next.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-primary" href="/dashboard/live">Open Live</a>
        <a class="btn-secondary" href={nextHref}>{nextLabel}</a>
        <button type="button" class="btn-ghost btn-sm" data-dismiss="live_coach">Dismiss</button>
      </div>
    </div>
  </DashboardCard>
</div>
