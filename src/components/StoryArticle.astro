---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import FaqSection from "./FaqSection.astro";
import type { Story } from "../lib/stories";
import { getAnswersRelatedTo } from "../lib/answers";
import { getAboutPhoto } from "../lib/aboutPhotos";
import {
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import "../styles/about.css";

interface Props {
  story: Story;
  heroImage?: ImageMetadata;
  heroCaption?: string;
  heroCredit?: string;
  heroCreditHref?: string;
}

const { story, heroImage, heroCaption, heroCredit, heroCreditHref } = Astro.props;
const ccHero = !heroImage && story.photoId ? getAboutPhoto(story.photoId) : undefined;
const resolvedImage = heroImage ?? ccHero?.image;
const resolvedCaption = heroCaption ?? ccHero?.caption;
const resolvedCredit = heroCredit ?? ccHero?.credit;
const resolvedCreditHref = heroCreditHref ?? ccHero?.sourceUrl;
const resolvedAlt = ccHero?.alt ?? `Illustration for ${story.headline}`;

const relatedAnswers = getAnswersRelatedTo(story.path, [
  "how-long-for-pipes-to-freeze",
  "freeze-alarm-temperature-setting",
  "water-leak-sensor-placement",
]);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, story.path);
const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: story.headline,
    description: story.description,
    articleSection: "Scenarios",
    datePublished: story.datePublished,
    dateModified: story.dateModified,
    imageUrl: `${siteUrl}${story.ogImage}`,
  }),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Scenarios", path: "/stories" },
    { name: story.headline, path: story.path },
  ]),
  getFaqPageSchema(pageUrl, story.faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={story.headline}
  description={story.description}
  schema={schema}
  ogType="article"
  ogImage={story.ogImage}
  ogPublishedTime={story.datePublished}
  ogModifiedTime={story.dateModified}
  ogSection="Scenarios"
  speakableSelectors={[".card-title", ".card-subtitle", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <section class="card animate-slide-in-left">
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        Scenario · {story.setting}
      </p>
      <h1 class="card-title">{story.title}</h1>
      <p class="card-subtitle">{story.description}</p>
      <p class="scenario-note mt-4 mb-0 text-sm" role="note">
        <strong>Illustrative scenario.</strong> This is a walkthrough of how ThermalTrace behaves in a common
        failure, not an account from a real customer. The features, thresholds, and plan limits are real.
      </p>
    </section>

    {
      resolvedImage && (
        <figure class="card overflow-hidden p-0 mb-0">
          <Image
            src={resolvedImage}
            alt={resolvedAlt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 960px) 100vw, 900px"
            class="w-full h-auto block"
            fetchpriority="high"
          />
          {(resolvedCaption || resolvedCredit) && (
            <figcaption class="px-4 py-3 text-sm text-[var(--color-text-muted)] flex flex-col gap-1">
              {resolvedCaption && <span>{resolvedCaption}</span>}
              {resolvedCredit && resolvedCreditHref ? (
                <a class="about-figure-credit" href={resolvedCreditHref} rel="noopener noreferrer" target="_blank">
                  {resolvedCredit}
                </a>
              ) : resolvedCredit ? (
                <span class="about-figure-credit">{resolvedCredit}</span>
              ) : null}
            </figcaption>
          )}
        </figure>
      )
    }

    <section class="card">
      <h2 class="card-title">The setup</h2>
      <ul class="text-sm space-y-2 mb-0">
        {story.setup.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">How it plays out</h2>
      <ol class="text-sm space-y-3 mb-0 list-decimal pl-5">
        {
          story.timeline.map((step) => (
            <li>
              <strong>{step.time}:</strong> {step.detail}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">Why it matters</h2>
      <p class="mb-4">{story.outcome}</p>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        Real outcomes depend on sensor placement, thresholds, and how quickly someone can respond.
      </p>
    </section>

    <FaqSection faqs={story.faqs} title="FAQ" />

    <section class="card">
      <h2 class="card-title">Related answers</h2>
      <ul class="text-sm space-y-1 mb-0">
        {relatedAnswers.map((answer) => (
          <li><a class="text-link" href={answer.path}>{answer.question}</a></li>
        ))}
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Try it on your space</h2>
      <p class="mb-4">
        Start free with live charts, email alerts, and one family live share link. Upgrade when you want CSV history (Member)
        or SMS and expanded share scopes (Pro: 14-day trial).
      </p>
      <p class="mb-0">
        <a class="btn-primary" href="/pricing">See plans &amp; pricing</a>
        {" "}
        <a class="btn-secondary" href="/register?next=/dashboard/devices">Create free account</a>
        {" "}
        <a class="text-link" href="/compare">Compare vs DIY</a>
        {" · "}
        <a class="text-link" href="/stories">All scenarios</a>
      </p>
    </section>
  </div>
</Layout>

<style>
  .scenario-note {
    padding: 0.6rem 0.8rem;
    border-left: 3px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-surface) 85%, var(--color-accent) 15%);
    border-radius: 0.4rem;
  }
</style>
