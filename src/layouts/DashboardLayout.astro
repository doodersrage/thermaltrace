---
import Layout from "./Layout.astro";
import DashboardSidebar from "../components/DashboardSidebar.astro";
import KioskModeToggle from "../components/KioskModeToggle";
import {
  loadDashboardShell,
  planLabelForEntitlements,
  type DashboardShell,
} from "../lib/dashboardShell";

interface Props {
  title?: string;
  requireAdmin?: boolean;
  /** Override shell live-lag when the page already computed it. */
  liveLagging?: boolean;
}

const { title = "Dashboard", requireAdmin = false, liveLagging } = Astro.props;

let shell: DashboardShell | null = Astro.locals.dashboardShell ?? null;
if (!shell) {
  shell = await loadDashboardShell(Astro.cookies, { includeLiveLag: true });
}

if (!shell) {
  return Astro.redirect("/signin");
}

if (requireAdmin && !shell.isAdmin) {
  return Astro.redirect("/dashboard");
}

const planLabel = planLabelForEntitlements(shell.entitlements);
const currentPath = Astro.url.pathname;
const lag = typeof liveLagging === "boolean" ? liveLagging : shell.liveLagging;
---
<Layout title={title}>
  <div class="dashboard-shell">
    <DashboardSidebar
      currentPath={currentPath}
      isAdmin={shell.isAdmin}
      email={shell.user.email}
      planLabel={planLabel}
      unackedAlerts={shell.unackedAlerts}
      liveLagging={lag}
      showPortfolioInMonitor={shell.showPortfolioInMonitor}
    />
    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="dashboard-topbar-text">
          <h1 class="dashboard-topbar-title">{title}</h1>
        </div>
        <div class="dashboard-topbar-actions">
          <KioskModeToggle client:idle />
        </div>
      </header>
      <slot />
    </div>
  </div>
  <script src="/remember-dashboard-tabs.js" defer is:inline />
  <script src="/dashboard-shortcuts.js" defer is:inline />
  <script src="/reading-age-tick.js" defer is:inline />
</Layout>
