---
import Layout from "./Layout.astro";
import DashboardSidebar from "../components/DashboardSidebar.astro";
import KioskModeToggle from "../components/KioskModeToggle";
import { getAuthFromCookies } from "../lib/auth";
import { isUserAdmin } from "../lib/adminAccess";
import { getUserEntitlements } from "../lib/entitlements";
import { countUnacknowledgedAlerts } from "../lib/alertEvents";
import { listUserHouseholds } from "../lib/households";

interface Props {
  title?: string;
  requireAdmin?: boolean;
  /** Optional lag hint for Live nav (Overview/Live can pass). */
  liveLagging?: boolean;
}

const { title = "Dashboard", requireAdmin = false, liveLagging = false } = Astro.props;

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const admin = await isUserAdmin(user.id);

if (requireAdmin && !admin) {
  return Astro.redirect("/dashboard");
}

const entitlements = await getUserEntitlements(user.id);
const currentPath = Astro.url.pathname;
const planLabel =
  entitlements.tier === "admin"
    ? "Admin"
    : entitlements.tier.charAt(0).toUpperCase() + entitlements.tier.slice(1);

const [unackedAlerts, userHouseholds] = await Promise.all([
  countUnacknowledgedAlerts(user.id),
  listUserHouseholds(user.id),
]);

const householdCount = userHouseholds.households.length;
const showPortfolioInMonitor =
  entitlements.canUsePortfolio || householdCount >= 2;
---
<Layout title={title}>
  <div class="dashboard-shell">
    <DashboardSidebar
      currentPath={currentPath}
      isAdmin={admin}
      email={user.email}
      planLabel={planLabel}
      unackedAlerts={unackedAlerts}
      liveLagging={liveLagging}
      showPortfolioInMonitor={showPortfolioInMonitor}
    />
    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="dashboard-topbar-text">
          <h1 class="dashboard-topbar-title">{title}</h1>
          {user.email && (
            <p class="dashboard-topbar-meta">{user.email}</p>
          )}
        </div>
        <div class="dashboard-topbar-actions">
          <span class:list={["plan-badge", `plan-badge--${entitlements.tier}`]}>
            {planLabel}
          </span>
          <KioskModeToggle client:idle />
          <a class="btn-ghost dashboard-topbar-home" href="/dashboard/live">Live</a>
        </div>
      </header>
      <slot />
    </div>
  </div>
  <script src="/remember-dashboard-tabs.js" defer is:inline />
  <script src="/dashboard-shortcuts.js" defer is:inline />
  <script src="/reading-age-tick.js" defer is:inline />
</Layout>
