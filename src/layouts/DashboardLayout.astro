---
import Layout from "./Layout.astro";
import DashboardSidebar from "../components/DashboardSidebar.astro";
import HouseholdSwitcher from "../components/HouseholdSwitcher.astro";
import ReadingAgeBadge from "../components/dashboard/ReadingAgeBadge.astro";
import KioskModeToggle from "../components/KioskModeToggle";
import {
  loadDashboardShell,
  planLabelForEntitlements,
  type DashboardShell,
} from "../lib/dashboardShell";
import { newestRecordedAt } from "../lib/dashboardNav";

interface Props {
  title?: string;
  subtitle?: string;
  requireAdmin?: boolean;
  /** Override shell live-lag when the page already computed it. */
  liveLagging?: boolean;
}

const { title = "Dashboard", subtitle, requireAdmin = false, liveLagging } = Astro.props;

let shell: DashboardShell | null = Astro.locals.dashboardShell ?? null;
if (!shell) {
  shell = await loadDashboardShell(Astro.cookies, { includeLiveLag: true });
}

if (!shell) {
  return Astro.redirect("/signin");
}

if (requireAdmin && !shell.isAdmin) {
  return Astro.redirect("/dashboard");
}

const planLabel = planLabelForEntitlements(shell.entitlements);
const currentPath = Astro.url.pathname;
const lag = typeof liveLagging === "boolean" ? liveLagging : shell.liveLagging;
const lastReadingAt =
  shell.lastReadingAt ?? newestRecordedAt(shell.latest ?? []);
const switchRedirect = `${Astro.url.pathname}${Astro.url.search}`;
const paletteHouseholds = shell.households.map((row) => ({
  id: row.household_id,
  name: row.name,
}));
const householdSwitched = Astro.url.searchParams.get("household_switched") === "1";
const householdError = Astro.url.searchParams.get("household_error") === "1";
---
<Layout title={title}>
  <div class="dashboard-shell">
    <DashboardSidebar
      currentPath={currentPath}
      isAdmin={shell.isAdmin}
      email={shell.user.email}
      planLabel={planLabel}
      unackedAlerts={shell.unackedAlerts}
      liveLagging={lag}
      showPortfolioInMonitor={shell.showPortfolioInMonitor}
    />
    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="dashboard-topbar-text">
          <h1 class="dashboard-topbar-title">{title}</h1>
          {subtitle && <p class="dashboard-topbar-meta">{subtitle}</p>}
        </div>
        <div class="dashboard-topbar-actions">
          <HouseholdSwitcher
            households={shell.households}
            activeHouseholdId={shell.activeHouseholdId}
            redirectTo={switchRedirect}
            variant="chrome"
          />
          <div class="dashboard-topbar-freshness">
            <ReadingAgeBadge iso={lastReadingAt} emptyLabel="No reading" />
            <button
              type="button"
              class="btn-ghost btn-sm"
              id="dashboard-refresh-btn"
              data-dashboard-refresh
            >
              Refresh
            </button>
          </div>
          <div class="dashboard-topbar-tools">
            <button
              type="button"
              class="dashboard-shortcut-hint btn-secondary btn-sm"
              data-tt-shortcut-help
              title="Search dashboard"
              aria-label="Search dashboard"
            >
              <kbd>/</kbd>
            </button>
            <KioskModeToggle client:idle />
          </div>
        </div>
      </header>
      {householdSwitched && (
        <p class="alert-success mt-0 mb-4" role="status">Active property switched.</p>
      )}
      {householdError && (
        <p class="alert-warning mt-0 mb-4" role="alert">Could not switch property. Try again.</p>
      )}
      <slot />
    </div>
  </div>
  <div
    id="tt-dashboard-command-data"
    hidden
    data-payload={JSON.stringify({
      isAdmin: shell.isAdmin,
      showPortfolio: shell.showPortfolioInMonitor,
      households: paletteHouseholds,
      activeHouseholdId: shell.activeHouseholdId,
    })}
  ></div>
  <script src="/remember-dashboard-tabs.js" defer is:inline />
  <script src="/dashboard-shortcuts.js" defer is:inline />
  <script src="/reading-age-tick.js" defer is:inline />
  <script is:inline>
    (() => {
      const refreshButtons = document.querySelectorAll("[data-dashboard-refresh]");
      refreshButtons.forEach((el) => {
        el.addEventListener("click", () => {
          const path = location.pathname;
          if (path === "/dashboard") {
            window.dispatchEvent(new CustomEvent("overview:soft-refresh"));
            return;
          }
          if (path === "/dashboard/live") {
            if (el instanceof HTMLButtonElement) el.disabled = true;
            window.dispatchEvent(new CustomEvent("tt:live-refresh"));
            window.setTimeout(() => {
              if (el instanceof HTMLButtonElement) el.disabled = false;
            }, 800);
            return;
          }
          if (el instanceof HTMLButtonElement) el.disabled = true;
          location.reload();
        });
      });

      window.addEventListener("tt:live-readings", (event) => {
        const detail = event instanceof CustomEvent ? event.detail : null;
        const count = typeof detail?.sensorCount === "number" ? detail.sensorCount : 0;
        document.querySelectorAll("[data-live-waiting]").forEach((node) => {
          if (node instanceof HTMLElement) node.hidden = count > 0;
        });
      });

      const bindKioskProxy = (real) => {
        const proxies = document.querySelectorAll("[data-tt-kiosk-proxy]");
        if (!proxies.length) return;
        const sync = () => {
          const pressed = real.getAttribute("aria-pressed") === "true";
          const label = pressed ? "Exit kiosk" : "Kiosk mode";
          proxies.forEach((proxy) => {
            proxy.textContent = label;
            proxy.setAttribute("aria-pressed", pressed ? "true" : "false");
          });
        };
        proxies.forEach((proxy) => {
          proxy.addEventListener("click", () => real.click());
        });
        sync();
        new MutationObserver(sync).observe(real, {
          attributes: true,
          attributeFilter: ["aria-pressed"],
        });
      };
      const existing = document.querySelector(".dashboard-kiosk-toggle");
      if (existing) {
        bindKioskProxy(existing);
      } else {
        const mo = new MutationObserver(() => {
          const found = document.querySelector(".dashboard-kiosk-toggle");
          if (!found) return;
          mo.disconnect();
          bindKioskProxy(found);
        });
        mo.observe(document.body, { childList: true, subtree: true });
        window.setTimeout(() => mo.disconnect(), 8000);
      }

      const url = new URL(window.location.href);
      let changed = false;
      ["household_switched", "household_error"].forEach((key) => {
        if (url.searchParams.has(key)) {
          url.searchParams.delete(key);
          changed = true;
        }
      });
      if (changed) {
        window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
      }
    })();
  </script>
</Layout>
