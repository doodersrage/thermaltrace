---
import { Image, Font } from 'astro:assets';
import '../styles/global.css'
const currentYear = new Date().getFullYear();
import logo from '../assets/gtm.svg';
import { getAuthFromCookies } from "../lib/auth";
import { resolveTheme } from "../lib/userPreferences";
import SchemaMarkup from "../components/SchemaMarkup.astro";
import {
  getDefaultDescription,
  getSiteSchemas,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { BRAND_NAME, BRAND_TAGLINE } from "../lib/brand";
import BrandMark from "../components/BrandMark.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import AhrefsAnalytics from "../components/AhrefsAnalytics.astro";
import AnalyticsDisclosure from "../components/AnalyticsDisclosure.astro";
import { shouldLoadGoogleAnalytics } from "../lib/analytics";
import {
  absoluteOgImageUrl,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_TYPE,
  OG_IMAGE_WIDTH,
  resolveOgImageAlt,
  resolveOgImagePath,
} from "../lib/ogMeta";

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute URL or site-relative path; defaults from pathname. */
  ogImage?: string;
  /** Override auto alt text for the share image. */
  ogImageAlt?: string;
  skipAuth?: boolean;
  /** When true, emit noindex,nofollow (error pages, private-ish surfaces). */
  noindex?: boolean;
  /** Optional Referrer-Policy meta (e.g. no-referrer for token handoff pages). */
  referrerPolicy?: string;
  /** Include SoftwareApplication JSON-LD (home / product pages). */
  softwareApplication?: boolean;
  /** CSS selectors for SpeakableSpecification on the WebPage schema. */
  speakableSelectors?: string[];
  /** Open Graph type — article for stories/guides. */
  ogType?: "website" | "article";
  /** Article OG fields (ISO dates / section). */
  ogPublishedTime?: string;
  ogModifiedTime?: string;
  ogSection?: string;
}

const {
  title,
  description,
  schema,
  ogImage,
  ogImageAlt,
  skipAuth = false,
  noindex = false,
  referrerPolicy,
  softwareApplication = false,
  speakableSelectors,
  ogType = "website",
  ogPublishedTime,
  ogModifiedTime,
  ogSection,
} = Astro.props;
const pageTitle = title ? `${title} · ${BRAND_NAME}` : BRAND_NAME;
const metaDescription = description ?? getDefaultDescription();
const siteUrl = resolveSiteUrl(Astro.site);
const currentPath = Astro.url.pathname;
const pageUrl = resolvePageUrl(siteUrl, currentPath);
const resolvedOgPath = ogImage ?? resolveOgImagePath(currentPath);
const ogImageUrl = absoluteOgImageUrl(siteUrl, resolvedOgPath);
const resolvedOgAlt = ogImageAlt ?? resolveOgImageAlt(currentPath);

const { user } = skipAuth
  ? { user: null }
  : await getAuthFromCookies(Astro.cookies);

const themeCookie = Astro.cookies.get("theme")?.value;
const userTheme = (user?.user_metadata as Record<string, unknown> | undefined)?.theme;
const themePref =
  themeCookie === "light" || themeCookie === "system" || themeCookie === "dark"
    ? themeCookie
    : userTheme === "light" || userTheme === "system"
      ? userTheme
      : "dark";
const resolvedTheme = resolveTheme(themePref);

const extraSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const schemas = getSiteSchemas({
  siteUrl,
  pageUrl,
  pageName: pageTitle,
  pageDescription: metaDescription,
  extraSchemas,
  includeSoftwareApplication: softwareApplication,
  speakableCssSelectors: speakableSelectors,
});

const navItems = [
  { href: "/pricing", label: "Pricing", match: (path: string) => path.startsWith("/pricing") },
  { href: "/compare", label: "Compare", match: (path: string) => path.startsWith("/compare") },
  {
    href: "/freeze-map",
    label: "Freeze map",
    match: (path: string) => path.startsWith("/freeze-map"),
  },
  {
    href: "/property-management",
    label: "Landlords",
    match: (path: string) => path.startsWith("/property-management"),
  },
  {
    href: "/guides",
    label: "Guides",
    match: (path: string) =>
      path === "/guides" || path.startsWith("/guides/") || path === "/about" || path.startsWith("/about/"),
  },
  { href: "/contact", label: "Contact", match: (path: string) => path.startsWith("/contact") },
];
const isDashboard = currentPath.startsWith("/dashboard");
const loadAnalytics = shouldLoadGoogleAnalytics(currentPath, {
  search: Astro.url.searchParams,
});
const loadTurnstile =
  currentPath.startsWith("/contact") ||
  currentPath.startsWith("/signin") ||
  currentPath.startsWith("/register") ||
  currentPath.startsWith("/forgot-password");
const registerServiceWorker =
  currentPath.startsWith("/dashboard") || currentPath.startsWith("/signin");
---
<!doctype html>
<html lang="en" data-theme={resolvedTheme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={metaDescription} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content={resolvedTheme === "light" ? "#f1f5f9" : "#090b0f"} />
		<link rel="canonical" href={pageUrl} />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={BRAND_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content={OG_IMAGE_TYPE} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:alt" content={resolvedOgAlt} />
		{ogType === "article" && ogPublishedTime && (
			<meta property="article:published_time" content={ogPublishedTime} />
		)}
		{ogType === "article" && ogModifiedTime && (
			<meta property="article:modified_time" content={ogModifiedTime} />
		)}
		{ogType === "article" && ogSection && (
			<meta property="article:section" content={ogSection} />
		)}
		{ogType === "article" && (
			<meta property="article:author" content={BRAND_NAME} />
		)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={resolvedOgAlt} />
		<meta name="twitter:url" content={pageUrl} />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-display" preload />
		<SchemaMarkup schemas={schemas} />
		{loadAnalytics && (
			<>
				<GoogleAnalytics
					pageTitle={pageTitle}
					pageUrl={pageUrl}
					hostname={Astro.url.hostname}
				/>
				<AhrefsAnalytics />
			</>
		)}
	</head>
	<body class:list={[isDashboard && "is-dashboard"]}>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="flex min-h-screen flex-col">
			{!isDashboard && (
			<header class="site-header">
				<div class="site-header-inner">
					<a href="/" class="site-logo-link">
						<Image src={logo} height={44} width={344} alt="ThermalTrace" class="site-logo" />
					</a>
					<button
						type="button"
						class="site-nav-toggle btn-ghost lg:hidden"
						aria-expanded="false"
						aria-controls="site-nav"
						id="site-nav-toggle"
					>
						Menu
					</button>
					<nav id="site-nav" class="site-nav" aria-label="Main">
						<div class="site-nav-primary">
							{navItems.map(({ href, label, match }) => (
								<a
									href={href}
									class:list={["nav-link", match(currentPath) && "nav-link-active"]}
								>
									{label}
								</a>
							))}
						</div>
						<div class="site-nav-actions">
							{user ? (
								<>
									<a
										href="/dashboard"
										class:list={[
											"nav-link",
											(currentPath === "/dashboard" ||
												currentPath.startsWith("/dashboard/")) &&
												"nav-link-active",
										]}
									>
										Dashboard
									</a>
									<a href="/api/auth/signout" class="nav-link">Sign out</a>
								</>
							) : (
								<>
									<a
										href="/signin"
										class:list={[
											"nav-link",
											currentPath === "/signin" && "nav-link-active",
										]}
									>
										Sign in
									</a>
									<a href="/register?next=/dashboard/devices" class="nav-cta">Start free</a>
								</>
							)}
						</div>
					</nav>
				</div>
			</header>
			)}
			<main id="main-content" class="flex-grow">
				<slot />
			</main>
			{!isDashboard && (
				<footer class="site-footer">
					<div class="site-footer-inner">
						<div class="site-footer-grid">
							<div>
								<p class="site-footer-brand"><BrandMark mark /></p>
								<p class="site-footer-copy">
									{BRAND_TAGLINE} Freeze and flood alerts plus history, so you can track conditions before cold snaps or wet pads do damage.
								</p>
								<p class="site-footer-copy site-footer-hosting">
									Runs on Cloudflare’s edge network.
									{" "}
									<a href="/system-status">Live system status</a>
								</p>
							</div>
							<div>
								<p class="site-footer-heading">Product</p>
								<ul class="site-footer-links">
									<li><a href="/pricing">Pricing</a></li>
									<li><a href="/compare">Compare</a></li>
									<li><a href="/demo">Live demo</a></li>
									<li><a href="/claims-pack">Claims pack</a></li>
									<li><a href="/property-management">Property management</a></li>
									<li><a href="/apps">Apps</a></li>
									<li><a href="/accessories">Accessories</a></li>
									<li><a href="/integrations">Integrations</a></li>
								</ul>
							</div>
							<div>
								<p class="site-footer-heading">Learn</p>
								<ul class="site-footer-links">
									<li><a href="/guides">Guides</a></li>
									<li><a href="/about">All articles</a></li>
									<li><a href="/freeze-season">Freeze season</a></li>
									<li><a href="/freeze-map">Freeze map</a></li>
									<li><a href="/docs/api">HTTP API</a></li>
									<li><a href="/stories">Customer stories</a></li>
									<li><a href="/about/probe-demo">Probe demo</a></li>
									<li><a href="/share-kit">Share kit</a></li>
									<li>
										<a
											href="https://github.com/doodersrage/thermaltrace"
											target="_blank"
											rel="noreferrer"
										>GitHub</a>
									</li>
									<li>
										<a
											href="https://doodersrage.github.io/thermaltrace/"
											target="_blank"
											rel="noreferrer"
										>Extended docs</a>
									</li>
								</ul>
							</div>
							<div>
								<p class="site-footer-heading">Account</p>
								<ul class="site-footer-links">
									{user ? (
										<>
											<li><a href="/dashboard">Dashboard</a></li>
											<li><a href="/dashboard/settings">Settings</a></li>
											<li><a href="/api/auth/signout">Sign out</a></li>
										</>
									) : (
										<>
											<li><a href="/signin">Sign in</a></li>
											<li><a href="/register?next=/dashboard/devices">Create free account</a></li>
										</>
									)}
									<li><a href="/contact">Contact</a></li>
									<li><a href="/privacy">Privacy</a></li>
									<li><a href="/terms">Terms</a></li>
								</ul>
							</div>
						</div>
						<p class="site-footer-legal">
							Copyright © {currentYear} ThermalTrace. All rights reserved.
							{" · "}
							<a href="/privacy">Privacy</a>
							{" · "}
							<a href="/terms">Terms</a>
						</p>
					</div>
				</footer>
			)}
		</div>
		{loadTurnstile && (
			<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
		)}
		<AnalyticsDisclosure show={loadAnalytics} />
		<script src="/nudge-dismiss.js" defer is:inline />
		<script is:inline define:vars={{ registerServiceWorker }}>
			(() => {
				const toggle = document.getElementById("site-nav-toggle");
				const nav = document.getElementById("site-nav");
				if (!toggle || !nav) return;

				const setOpen = (open) => {
					nav.classList.toggle("site-nav-open", open);
					toggle.setAttribute("aria-expanded", open ? "true" : "false");
					toggle.textContent = open ? "Close" : "Menu";
				};

				toggle.addEventListener("click", (event) => {
					event.stopPropagation();
					setOpen(!nav.classList.contains("site-nav-open"));
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape") setOpen(false);
				});

				document.addEventListener("click", (event) => {
					const target = event.target;
					if (!(target instanceof Node)) return;
					if (!nav.contains(target) && !toggle.contains(target)) {
						setOpen(false);
					}
				});

				nav.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => setOpen(false));
				});
			})();

			document.addEventListener("click", async (event) => {
				const target = event.target;
				if (!(target instanceof HTMLElement)) return;
				const btn = target.closest("[data-copy]");
				if (!(btn instanceof HTMLElement)) return;
				const text = btn.getAttribute("data-copy");
				if (!text) return;
				const label = btn.getAttribute("data-copy-label") || "Copy";
				try {
					await navigator.clipboard.writeText(text);
					btn.textContent = "Copied";
					setTimeout(() => {
						btn.textContent = label;
					}, 1500);
				} catch {
					btn.textContent = "Copy failed";
					setTimeout(() => {
						btn.textContent = label;
					}, 1500);
				}
			});

			if (registerServiceWorker && "serviceWorker" in navigator) {
				window.addEventListener("load", () => {
					navigator.serviceWorker.register("/sw.js?v=5").catch(() => {});
				});
			}
		</script>
	</body>
</html>
