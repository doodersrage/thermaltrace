---
import { Image } from "astro:assets";
import Layout from '../layouts/Layout.astro';
import DemoTempsPanel from '../components/DemoTempsPanel';
import WeatherPanel from '../components/WeatherPanel';
import FaqSection from '../components/FaqSection.astro';
import HomeStatusChip from '../components/HomeStatusChip.astro';
import HomePwaCard from '../components/HomePwaCard.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import { BRAND_DESCRIPTION, BRAND_POSITIONING } from '../lib/brand';
import BrandMark from '../components/BrandMark.astro';
import { getAuthFromCookies } from '../lib/auth';
import {
  getBrandDefinition,
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from '../lib/schemaMarkup';
import { getMarketingFaqs, getMarketingFaqSchema } from '../lib/marketingFaqs';
import { getMemberPriceDisplay, getProPriceDisplay } from '../lib/stripePricing';
import { fetchAppStatusSummary } from '../lib/appStatus';
import { getStory } from '../lib/stories';
import dashboardInsights from '../assets/marketing/thermaltrace-dashboard-insights.jpg';

const { user } = await getAuthFromCookies(Astro.cookies);
const isAuthenticated = !!user;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/");
const homeFaqs = getMarketingFaqs("home");
const schema = [
  getBreadcrumbSchema(siteUrl, [{ name: "Home", path: "/" }]),
  getMarketingFaqSchema(pageUrl, "home"),
].filter(Boolean) as Record<string, unknown>[];

const homeDescription = BRAND_DESCRIPTION;
const brandDefinition = getBrandDefinition();

const memberPrice = getMemberPriceDisplay().monthly;
const proPrice = getProPriceDisplay().monthly;
const appStatus = await fetchAppStatusSummary();
const featuredStory = getStory("pipe-near-miss")!;
---

<Layout
  title="Garage freeze & flood monitoring"
  description={homeDescription}
  schema={schema}
  softwareApplication
  speakableSelectors={[".home-hero-brand", ".home-hero-promise", ".home-hero-lead", ".faq-answer"]}
  ogImage="/og-dashboard.jpg"
  ogImageAlt="ThermalTrace live telemetry graph: probe curves with humidity, dew point, freeze alerts, and flood/wet contacts"
>
		<div class="home-marketing">
			<section class="home-hero home-hero--bleed">
				<div class="home-hero-inner home-hero-grid">
					<div class="home-hero-copy">
						<p class="home-hero-audience">{BRAND_POSITIONING}</p>
						<BrandMark as="h1" class="home-hero-brand" mark />
						<p class="home-hero-promise">Know before your pipes freeze or your space floods.</p>
						<p class="home-hero-lead">{brandDefinition}</p>
						<div class="home-hero-actions">
							{isAuthenticated ? (
								<>
									<a class="btn-primary home-hero-cta-primary" href="/dashboard">Open dashboard</a>
									<a class="btn-secondary" href="/dashboard/live">Live readings</a>
								</>
							) : (
								<>
									<a class="btn-primary home-hero-cta-primary" href="/about/probe-demo?preset=coldSnap">Try a cold snap</a>
									<a class="btn-secondary" href="/about/esp32-freeze-kit">Build a ~$25 probe</a>
								</>
							)}
						</div>
						{isAuthenticated ? (
							<p class="home-hero-nohw">
								Signed in — Overview for ops, Live for glanceable probes, or
								<a class="text-link" href="/dashboard/devices">Devices</a>
								to manage ingest.
							</p>
						) : (
							<p class="home-hero-nohw">
								No hardware yet? Cause a cold snap in the
								<a class="text-link" href="/about/probe-demo?preset=coldSnap">simulator</a>,
								then build the
								<a class="text-link" href="/about/esp32-freeze-kit">ESP32 freeze kit</a>
								for your garage —
								<a class="text-link" href="/register?next=/dashboard/devices">start free</a>
								(no credit card).
							</p>
						)}
						<p class="home-hero-plans">
							<a class="text-link" href="/pricing">
								Free forever · no credit card
								<span aria-hidden="true"> · </span>
								{memberPrice ? `Member ${memberPrice}/mo` : "Member"}
								<span aria-hidden="true"> · </span>
								{proPrice ? `Pro ${proPrice}/mo` : "Pro"}
							</a>
						</p>
					</div>
					<figure class="home-hero-visual">
						<Image
							src={dashboardInsights}
								alt="ThermalTrace Insights: seven-day probe curves with the freeze line, flood/wet contacts, nights-at-risk forecast, and forecast-backed time-to-freeze clock"
							widths={[480, 720, 960, 1200]}
							sizes="(max-width: 959px) 100vw, 42vw"
							class="home-hero-visual-img home-hero-visual-img--dashboard"
							fetchpriority="high"
						/>
						<figcaption class="home-hero-visual-caption">
							Real ThermalTrace dashboard: probe curves, freeze threshold, and flood/wet contacts, not a mockup.
							{" "}
							<a class="text-link" href="/about/probe-demo">Try the interactive simulator</a>
							{" · "}
							<a class="text-link" href="/demo">Live readings</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="page-shell page-stack">
				<HomeStatusChip status={appStatus} />

				<section class="home-live-block" id="home-live" aria-labelledby="home-live-title">
					<div class="home-live-intro">
						<h2 class="home-live-title" id="home-live-title">Two ways to try it (no account)</h2>
						<p class="home-live-lede">
							<strong>Hands-on:</strong>
							{" "}
							<a class="text-link" href="/about/probe-demo">Interactive probe simulator</a>
							to open the bay door, trigger a cold snap, and watch multi-zone risk and push/pull JSON respond.
							{" "}
							<strong>Observational:</strong>
							live demo probes below on the production ingest path. Full live page (weather + kit steps):
							<a class="text-link" href="/demo">/demo</a>.
						</p>
					</div>
					<p class="home-live-cta mb-4">
						<a class="btn-primary" href="/about/probe-demo?preset=coldSnap">Try a cold snap</a>
						<a class="btn-secondary" href="/about/esp32-freeze-kit">Want this for your garage?</a>
						<a class="btn-ghost" href="/demo">Live demo feed</a>
					</p>
					<div class="home-live" aria-label="Live demo readings">
						<DemoTempsPanel client:visible />
						<WeatherPanel client:visible cityId={null} guest />
					</div>
				</section>

				<section class="home-steps" aria-labelledby="home-steps-title">
					<div class="home-steps-intro">
						<h2 class="home-steps-title" id="home-steps-title">How it works</h2>
						<p class="home-steps-lede">
							One recommended path: ESP32 + waterproof probe → ThermalTrace → phone alert. Other boards and feeds stay supported after you are live.
						</p>
					</div>
					<ol class="home-steps-list">
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">1</span>
							<div>
								<h3 class="home-step-title">Build one probe</h3>
								<p class="home-step-copy">
									ESP32 + waterproof DS18B20 is the default kit (~$20–30 parts). Wire it, flash Wi‑Fi, and you are ready to POST.
								</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">2</span>
							<div>
								<h3 class="home-step-title">Connect</h3>
								<p class="home-step-copy">
									Create a free push device, paste the ingest key into the sketch, and POST once. Sensors auto-import on first contact.
								</p>
							</div>
						</li>
						<li class="home-step">
							<span class="home-step-num" aria-hidden="true">3</span>
							<div>
								<h3 class="home-step-title">Get freeze alerts</h3>
								<p class="home-step-copy">
									Set freeze °F + email, send a test, then watch Live and Overview. Add a flood/leak contact when you are ready.
								</p>
							</div>
						</li>
					</ol>
					<div class="home-steps-actions">
						<a class="btn-primary" href="/about/esp32-freeze-kit">ESP32 freeze kit BOM</a>
						<a class="btn-secondary" href="/register?next=/dashboard/devices">Start free</a>
						<a class="btn-ghost" href="/about/adding-devices">All device options</a>
					</div>
				</section>

				<section class="home-need" id="what-you-need" aria-labelledby="home-need-title">
					<div class="home-need-intro">
						<h2 class="home-need-title" id="home-need-title">What you need</h2>
						<p class="home-need-lede">
							Monitor an unheated garage for under about $25 in parts. No subscription required to try freeze alerts.
						</p>
					</div>
					<div class="home-need-grid">
						<div class="home-need-col">
							<h3 class="home-need-col-title">Parts</h3>
							<ul class="home-need-list">
								<li><strong>ThermalTrace account</strong> — free, no credit card</li>
								<li><strong>ESP32 board</strong> — about $8–15</li>
								<li><strong>Waterproof DS18B20</strong> — about $2–5</li>
								<li><strong>Wi‑Fi</strong> — your existing home network</li>
							</ul>
						</div>
						<div class="home-need-col">
							<h3 class="home-need-col-title">What you get</h3>
							<ul class="home-need-list">
								<li>Live garage temperature on phone and web</li>
								<li>History curves with a freeze line</li>
								<li>Freeze alerts (email on Free; SMS/push on Pro)</li>
								<li>No home server to babysit</li>
							</ul>
						</div>
					</div>
					<div class="home-need-actions">
						<a class="btn-primary" href="/about/esp32-freeze-kit">Open the parts list</a>
						<a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">Try the simulator first</a>
					</div>
				</section>

				<div class="product-shot-pair" aria-label="Product screenshots">
					<ProductScreenshot shot="devices" compact />
					<ProductScreenshot shot="overview-status" compact />
				</div>

				<section class="home-maker" aria-labelledby="home-maker-title">
					<h2 class="home-maker-title" id="home-maker-title">Love DIY? You don’t have to DIY everything.</h2>
					<p class="home-maker-lede">
						Keep your ESP32, Arduino, MQTT, or Home Assistant setup. ThermalTrace adds hosted history plus household freeze and flood alerts without another server to babysit.
					</p>
					<p class="home-maker-tagline">Your sensor. Your data. Your alerts.</p>
					<ul class="home-compat-list">
						<li>ESP32</li>
						<li>Arduino</li>
						<li>HTTPS JSON</li>
						<li>MQTT bridge</li>
						<li><a class="text-link" href="/integrations/home-assistant">Home Assistant</a></li>
						<li><a class="text-link" href="/about/thermostat-oauth">Nest / Ecobee</a></li>
						<li><a class="text-link" href="/compare/diy-mqtt">vs DIY MQTT</a></li>
					</ul>
				</section>

				<section class="home-story" aria-labelledby="home-story-title">
					<p class="home-story-kicker">Real-world</p>
					<h2 class="home-story-title" id="home-story-title">34°F. That’s when the alert mattered.</h2>
					<p class="home-story-copy">
						{featuredStory.location}: a cold garage corner dipped night after night before supply lines iced.
						History showed the pattern; the alert made someone fix the door seal.
						That is exactly the kind of timeline a
						<a class="text-link" href="/claims-pack">claims evidence pack</a>
						would document if freeze damage ever became an insurance conversation.
					</p>
					<ProductScreenshot
						shot="history-chart"
						caption="The same freeze line households set in Alerts, visible on History curves."
					/>
					<p class="home-story-cta mb-0">
						<a class="text-link" href={featuredStory.path}>Read the near-miss story</a>
						<span aria-hidden="true"> · </span>
						<a class="text-link" href="/claims-pack">Claims evidence pack</a>
						<span aria-hidden="true"> · </span>
						<a class="text-link" href="/stories">More stories</a>
					</p>
				</section>

				<section class="home-audiences" id="use-cases" aria-labelledby="home-audiences-title">
					<div class="home-audiences-intro">
						<h2 class="home-audiences-title" id="home-audiences-title">Built for the messy middle</h2>
						<p class="home-audiences-lede">
							Homemakers wiring one garage, and landlords watching a portfolio: same cold-and-water problem, different scale.
						</p>
					</div>
					<div class="home-audiences-grid">
						<article class="home-audience">
							<h3 class="home-audience-title">Claims evidence pack</h3>
							<p class="home-audience-copy">
								Pro exports a printable freeze/leak summary with matching readings and alert CSVs for a date range you choose: monitoring evidence when you need more than a screenshot.
							</p>
							<p class="home-audience-cta mb-0">
								<a class="text-link" href="/claims-pack">See the claims pack</a>
							</p>
						</article>
						<article class="home-audience">
							<h3 class="home-audience-title">Property managers</h3>
							<p class="home-audience-copy">
								Portfolio raises owned-property limits and adds property-manager logins for on-site staff so rentals and multi-unit sites share one freeze-and-flood alert stack.
							</p>
							<p class="home-audience-cta mb-0">
								<a class="text-link" href="/property-management">Property management</a>
							</p>
						</article>
					</div>
				</section>

				<section class="home-features" aria-label="Product highlights">
					<article class="home-feature">
						<h2 class="home-feature-title">Protect vulnerable spaces</h2>
						<p class="home-feature-copy">
							Freeze and leak alerts on every plan, plus a time-to-freeze clock for this space so you know when pipes will hit freeze, not only after they do. Member adds outdoor forecast warnings; Pro adds official NWS alerts, SMS, and push.
							<a class="text-link" href="/about/cold-snap-playbook">Cold-snap playbook</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Catch leaks before they spread</h2>
						<p class="home-feature-copy">
							Flood / leak contacts auto-alert when wet, even during snooze or vacation. Add a sump or tank
							<code>level</code>
							sensor if you want early-warning rules before water reaches the floor.
							<a class="text-link" href="/about/ingest-and-webhooks">Flood + level ingest guide</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Your sensors, your stack</h2>
						<p class="home-feature-copy">
							Temperature, humidity, air quality, doors, leaks, power, and motion on hardware you control.
							<a class="text-link" href="/about/ingest-and-webhooks">Ingest guide</a>
							·
							<a class="text-link" href="/docs/api">HTTP API</a>
						</p>
					</article>
					<article class="home-feature">
						<h2 class="home-feature-title">Household ready</h2>
						<p class="home-feature-copy">
							Invite family and share one free live link without handing out a password. Pro expands share scopes and adds a
							<a class="text-link" href="/claims-pack">claims evidence pack</a>.
						</p>
					</article>
				</section>

				<section class="home-pricing-ladder" aria-labelledby="home-pricing-title">
					<h2 class="home-pricing-title" id="home-pricing-title">Free to start</h2>
					<p class="home-pricing-lede">
						Pick a rung by job, whether that is freeze nights, wet leak alerts, or portfolio monitoring. Full limits live on pricing.
					</p>
					<ul class="home-pricing-list">
						<li>
							<strong>Free</strong>
							<span>See if ThermalTrace works for you</span>
						</li>
						<li>
							<strong>Member</strong>
							<span>Track a whole cold season{memberPrice ? ` · ${memberPrice}/mo` : ""}</span>
						</li>
						<li>
							<strong>Pro</strong>
							<span>Serious alerts and automation{proPrice ? ` · ${proPrice}/mo` : ""}</span>
						</li>
					</ul>
					<div class="home-pricing-actions">
						<a class="btn-primary" href="/pricing">Compare plans</a>
						<a class="btn-secondary" href="/register?next=/dashboard/devices">Start free</a>
					</div>
				</section>

				<HomePwaCard />

				<section class="card home-guides">
					<div class="home-guides-copy">
						<h2 class="card-title">Guides by job</h2>
						<p class="card-subtitle mb-0">
							Hardware setup, freeze alerts, flood/leak alerts, sharing, and the API. Then all articles if you want every guide.
						</p>
					</div>
					<div class="home-guides-actions">
						<a class="btn-primary" href="/guides">Open the guides hub</a>
						<a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 freeze kit</a>
						<a class="btn-secondary" href="/accessories">Accessories</a>
						<a class="btn-secondary" href="/claim-puck">Claim puck</a>
						<a class="btn-secondary" href="/about/ingest-and-webhooks">Flood / leak guide</a>
						<a class="btn-ghost" href="/about">All articles</a>
					</div>
				</section>

				<p class="home-oss mb-0">
					Open-source dashboard and sample sensor sketches.
					<a class="text-link" href="https://github.com/doodersrage/thermaltrace" target="_blank" rel="noreferrer">View source on GitHub</a>.
				</p>

				<FaqSection
					faqs={homeFaqs}
					lede="Straight answers for homeowners wiring probes, wet contacts, and setting freeze or flood alerts."
				/>
			</div>
		</div>
</Layout>
