---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";
import { compareGuides } from "../lib/compareGuides";
import EditorialPhotoStrip from "../components/EditorialPhotoStrip.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { compareHubPhotos } from "../lib/aboutPhotos";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/compare");
const compareFaqs = getMarketingFaqs("compare");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Compare", path: "/compare" },
  ]),
  getMarketingFaqSchema(pageUrl, "compare"),
].filter(Boolean) as Record<string, unknown>[];

const stripPhotoIds = compareHubPhotos.map((p) => p.id);
const stripLabels = compareHubPhotos.map((p) => p.label);
const stripHrefs = compareHubPhotos.map((p) => p.href);
---
<Layout
  title="Compare monitoring options"
  description="ThermalTrace vs DIY MQTT, Govee, TempStick, Tempest, Nest, and Ecobee for freeze and flood/leak alerts in unconditioned spaces, without running your own servers."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Compare"
      title="Built for homeowners, not home servers"
      lede="ThermalTrace is for live probe sensors, freeze and flood/leak alerts, and optional SMS, without running your own infrastructure. Plan limits and the Free/Member/Pro/Portfolio matrix live on Pricing; this page compares ThermalTrace to other approaches."
    >
      <a slot="actions" class="btn-primary" href="/pricing">See plans &amp; pricing</a>
      <a slot="actions" class="btn-secondary" href="/register?next=/dashboard/temperature">Start free</a>
    </PageHeader>

    <EditorialPhotoStrip
      photoIds={stripPhotoIds}
      labels={stripLabels}
      hrefs={stripHrefs}
    />

    <section class="card">
      <h2 class="card-title">Detailed comparisons</h2>
      <p class="card-subtitle mb-4">
        Side-by-side guides for common alternatives: ops burden, alerts, and when each option fits.
      </p>
      <ul class="space-y-4 mb-4">
        {compareGuides.map((guide) => (
          <li>
            <a class="text-link font-semibold" href={guide.path}>{guide.title}</a>
            <p class="text-sm text-[var(--color-text-muted)] mt-1 mb-0">{guide.summary}</p>
          </li>
        ))}
      </ul>
      <p class="text-sm text-[var(--color-text-muted)] mb-4">
        <strong class="text-[var(--color-text)]">SmartThings</strong> can add ThermalTrace sensors via the
        <a class="text-link" href="/integrations/smartthings">Matter bridge path</a>
        (no Cloud-to-Cloud app). Consumer pods still sit with Govee below:
        <a class="text-link" href="/compare/govee">Govee guide</a>.
      </p>
      <div class="border border-[var(--color-border)] rounded-lg p-4">
        <p class="font-semibold mb-1">
          <a class="text-link" href="/integrations/home-assistant">Home Assistant (HACS)</a>
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          Complementary, not a rival: keep HA on the LAN and use ThermalTrace for household freeze and leak SMS, history, and off-site alerts. Official HACS integration + MQTT dual-run notes on the
          <a class="text-link" href="/integrations/home-assistant">Home Assistant page</a>
, and see
          <a class="text-link" href="/compare/diy-mqtt">vs DIY MQTT</a>
          if you’re weighing a full self-hosted stack.
        </p>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">ThermalTrace vs alternatives</h2>
      <div class="overflow-x-auto">
        <table class="plan-comparison-table">
          <caption class="sr-only">ThermalTrace compared to DIY scripts and Govee or SmartThings</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">ThermalTrace</th>
              <th scope="col">DIY script + cron</th>
              <th scope="col">Govee / SmartThings</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Time to freeze (this space)</th>
              <td>Forecast-backed clock + remaining-hours alert</td>
              <td>You write the model</td>
              <td>Threshold only</td>
            </tr>
            <tr>
              <th scope="row">Freeze alerts (email/SMS/push)</th>
              <td>Built-in, per-household</td>
              <td>You wire Twilio + cron</td>
              <td>App push; SMS extra or absent</td>
            </tr>
            <tr>
              <th scope="row">ESP/Arduino push ingest</th>
              <td>One-time device key</td>
              <td>Custom endpoint</td>
              <td>Govee pods / SmartThings devices</td>
            </tr>
            <tr>
              <th scope="row">History & CSV export</th>
              <td>On paid plans</td>
              <td>Self-hosted DB</td>
              <td>Subscription tiers</td>
            </tr>
            <tr>
              <th scope="row">Share links & Grafana</th>
              <td>1 family live link; Pro adds history/metrics</td>
              <td>Manual setup</td>
              <td>Rare on consumer apps</td>
            </tr>
            <tr>
              <th scope="row">Home Assistant (HACS)</th>
              <td><a class="text-link" href="/integrations/home-assistant">Official integration</a> (share link)</td>
              <td>REST sensors + webhooks</td>
              <td>Varies by vendor</td>
            </tr>
            <tr>
              <th scope="row">Household multi-user</th>
              <td>Free</td>
              <td>N/A</td>
              <td>Family sharing is awkward</td>
            </tr>
            <tr>
              <th scope="row">Hosting &amp; uptime ops</th>
              <td>Cloudflare edge; <a class="text-link" href="/system-status">public status</a></td>
              <td>You own the VPS / cron</td>
              <td>Vendor cloud (opaque)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="product-shot-row">
      <ProductScreenshot
        shot="history-chart"
        caption="What you get without running your own stack: probe curves against your freeze threshold."
      />
      <section class="card">
        <h2 class="card-title">Who it's for</h2>
        <ul class="text-sm space-y-2 mb-4">
          <li><strong>Free</strong>, one property, live charts, email/chat alerts, and one family live share link while you evaluate.</li>
          <li><strong>Member</strong>. CSV history and more devices through a cold season.</li>
          <li><strong>Pro</strong>. SMS, push, Nest/Ecobee house context, unlimited share scopes, <a class="text-link" href="/integrations/home-assistant">Home Assistant (HACS)</a>, <a class="text-link" href="/claims-pack">claims pack</a>, and webhooks when someone needs to wake up at 2 a.m. Free already includes one family live link. See the <a class="text-link" href="/docs/api">HTTP API</a> for ingest and metrics.</li>
          <li><strong>Portfolio</strong>, for larger multi-property ops past Pro’s property ceiling, with property-manager logins. Details on <a class="text-link" href="/pricing#portfolio">Pricing</a> and <a class="text-link" href="/property-management">property management</a>.</li>
        </ul>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/register?next=/dashboard/temperature">Start free, no card required</a>
          <a class="btn-secondary" href="/pricing">See plan prices</a>
          <a class="btn-ghost" href="/stories/garage-freeze-alert">Read a freeze case study</a>
        </div>
      </section>
    </div>

    <section class="card">
      <h2 class="card-title">Plan limits live on pricing</h2>
      <p class="card-subtitle mb-4">
        Device counts, retention, Nest/Ecobee, property-manager logins, and Free vs Member vs Pro vs Portfolio are compared on the pricing page so this page can stay focused on alternatives, not a second plan matrix.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/pricing#plan-matrix">Open the plan comparison</a>
        <a class="btn-secondary" href="/register?next=/dashboard/temperature">Create free account</a>
      </div>
    </section>

    <FaqSection faqs={compareFaqs} />
  </div>
</Layout>
