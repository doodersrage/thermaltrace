---
export const prerender = false;

import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import DemoTempsPanel from "../components/DemoTempsPanel";
import WeatherPanel from "../components/WeatherPanel";
import HomeStatusChip from "../components/HomeStatusChip.astro";
import FaqSection from "../components/FaqSection.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { fetchAppStatusSummary } from "../lib/appStatus";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import historyChart from "../assets/marketing/thermaltrace-dashboard-history-chart.jpg";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/demo");
const demoFaqs = getMarketingFaqs("demo");
const appStatus = await fetchAppStatusSummary();
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Live demo", path: "/demo" },
  ]),
  getMarketingFaqSchema(pageUrl, "demo"),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "ThermalTrace live probe demo",
    description:
      "No-account ThermalTrace demos: interactive multi-zone probe simulator plus live demo probes on the production ingest path.",
    url: pageUrl,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Live probe demo"
  description="Try ThermalTrace without an account: interactive probe simulator, real live demo probes, and the same freeze/flood alert path your hardware will use."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
  ogImage="/og-dashboard.jpg"
  ogImageAlt="ThermalTrace live probe temperature curves, no account required"
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Try it (no account)"
      title="Demos: simulator + live feed"
      lede="Cause a freeze event in the interactive probe simulator, or watch real demo probes next to outdoor weather: same ingest path your ESP or Arduino will use for freeze and flood alerts."
    >
      <a slot="actions" class="btn-primary" href="/about/probe-demo?preset=coldSnap">Interactive simulator</a>
      <a slot="actions" class="btn-secondary" href="#live-feed">Live readings</a>
      <a slot="actions" class="btn-ghost" href="/register?next=/dashboard/devices">Connect my probes</a>
    </PageHeader>

    <section class="card" aria-labelledby="demo-paths-title">
      <h2 class="card-title" id="demo-paths-title">Three ways to try ThermalTrace</h2>
      <p class="card-subtitle mb-4">
        Start with the simulator if you want to feel freeze risk respond to you, then confirm with the live feed and auto-wet flood path.
      </p>
      <ul class="demo-paths text-sm space-y-3 mb-0">
        <li>
          <strong><a class="text-link" href="/about/probe-demo">Interactive probe simulator</a></strong>
          {": "}
          Hands-on (best first stop). Tweak door open/closed, sun load, outdoor air, and freeze threshold. Cause a cold snap; watch multi-zone bars and push/pull JSON update.
        </li>
        <li>
          <strong><a class="text-link" href="#live-feed">Live demo feed</a></strong>
          {": "}
          Observational. Real demo probes refresh here on the production ingest path. Best when you want “is this fake?” answered with live numbers.
        </li>
        <li>
          <strong><a class="text-link" href="/about/kit-qr-onboarding">Kit QR onboarding</a></strong>
          {": "}
          Hardware path. After you create a push device, scan the ingest QR (or print it on a kit label) so firmware can POST temperature, flood, and other sensor kinds without typing the key.
        </li>
      </ul>
    </section>

    <section class="card demo-sim-promo" aria-labelledby="demo-sim-title">
      <h2 class="card-title" id="demo-sim-title">Cause the change: interactive simulator</h2>
      <p class="card-subtitle mb-4">
        Presets for cold snap, door draft, and sun load reuse the same Overview space-status helper as production.
        Open the bay door and watch the door zone diverge from the workbench: that’s why multi-probe placement matters.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/about/probe-demo?preset=doorDraft">Try door draft</a>
        <a class="btn-secondary" href="/about/probe-demo?preset=coldSnap">Try cold snap</a>
        <a class="btn-ghost" href="/about/probe-demo">Open full simulator</a>
      </div>
    </section>

    <HomeStatusChip status={appStatus} />

    <section class="card" id="live-feed" aria-labelledby="live-feed-title">
      <h2 class="card-title" id="live-feed-title">Live demo feed</h2>
      <p class="card-subtitle mb-4">
        Real demo probe readings and outdoor weather, not a mockup. Prefer to manipulate variables yourself?
        {" "}
        <a class="text-link" href="/about/probe-demo">Open the interactive simulator</a>.
      </p>
      <div class="home-live" aria-label="Live demo readings">
        <DemoTempsPanel client:visible intervalMs={15000} />
        <WeatherPanel client:visible cityId={null} guest />
      </div>
    </section>

    <ProductScreenshot
      shot="insights"
      caption="Same product UI after you connect hardware. Insights with freeze threshold, flood/level card, and nights-at-risk."
    />

    <section class="demo-freeze" aria-labelledby="demo-freeze-title">
      <div class="demo-freeze-copy">
        <h2 class="demo-freeze-title" id="demo-freeze-title">Same data that fires freeze and flood alerts</h2>
        <p class="demo-freeze-lede">
          When a probe crosses your threshold, ThermalTrace can reach you on email, Discord, Telegram, Slack, and on Pro, SMS and browser push. Wet flood/leak contacts auto-alert on the same stack. Set the line once; test it before the next cold night.
        </p>
        <ul class="demo-freeze-channels" aria-label="Alert channels">
          <li>Email · Discord · Telegram · Slack</li>
          <li>SMS · push · webhooks on Pro</li>
          <li>Leak / flood sensors alert automatically when wet</li>
        </ul>
        <div class="demo-freeze-actions">
          <a class="btn-primary" href="/register?next=/dashboard/devices">Start free: open Devices</a>
          <a class="btn-secondary" href="/stories/water-heater-pad-leak">Flood/leak story</a>
          <a class="btn-ghost" href="/about/alert-channel-cookbook">Channel cookbook</a>
        </div>
      </div>
      <figure class="demo-freeze-visual">
        <Image
          src={historyChart}
          alt="ThermalTrace temperature trend with humidity, dew point, and freeze threshold at 34°F"
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) 100vw, 42vw"
          class="demo-freeze-img"
        />
      </figure>
    </section>

    <section class="home-steps" aria-labelledby="demo-steps-title">
      <div class="home-steps-intro">
        <h2 class="home-steps-title" id="demo-steps-title">Your kit next</h2>
        <p class="home-steps-lede">
          Free account, no credit card, from blank dashboard to a live curve in one sitting.
          Physical kits can use
          {" "}
          <a class="text-link" href="/about/kit-qr-onboarding">kit QR onboarding</a>
          {" "}
          so the ingest URL is a scan away.
        </p>
      </div>
      <ol class="home-steps-list">
        <li class="home-step">
          <span class="home-step-num" aria-hidden="true">1</span>
          <div>
            <h3 class="home-step-title">Create a push device</h3>
            <p class="home-step-copy">
              Sign up and open Devices, or use <strong>Try without hardware</strong> on Overview for the demo pull feed. Copy the ingest URL or QR from the 30-minute callout.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-num" aria-hidden="true">2</span>
          <div>
            <h3 class="home-step-title">POST JSON</h3>
            <p class="home-step-copy">
              POST to <code>/api/ingest/&lt;key&gt;</code>. Sensors auto-import on first POST: rename on Devices afterward.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-num" aria-hidden="true">3</span>
          <div>
            <h3 class="home-step-title">Watch Home &amp; set alerts</h3>
            <p class="home-step-copy">
              Confirm live values, set a freeze threshold, and know that wet flood/leak contacts auto-alert on the same account.
            </p>
          </div>
        </li>
      </ol>
      <div class="home-steps-actions">
        <a class="btn-primary" href="/register?next=/dashboard/devices">Start free: open Devices</a>
        <a class="btn-secondary" href="/about/adding-devices">Adding devices guide</a>
        <a class="btn-ghost" href="/about/kit-qr-onboarding">Kit QR walkthrough</a>
      </div>
    </section>

    <section class="home-compat" aria-label="Works with">
      <p class="home-compat-label">Works with</p>
      <ul class="home-compat-list">
        <li>ESP32</li>
        <li>Arduino</li>
        <li>HTTPS JSON push</li>
        <li>HTTPS JSON pull</li>
        <li>MQTT bridge</li>
        <li><a class="text-link" href="/integrations/home-assistant">Home Assistant (HACS)</a></li>
        <li>Discord · Telegram · Slack</li>
      </ul>
      <p class="home-compat-note">
        Keep MQTT on your LAN; mirror to ThermalTrace over HTTPS for household freeze/flood alerts and history.
        <a class="text-link" href="/about/mqtt-bridge">MQTT bridge recipe</a>
      </p>
    </section>

    <section class="demo-explore" aria-labelledby="demo-explore-title">
      <h2 class="demo-explore-title" id="demo-explore-title">Keep exploring</h2>
      <p class="demo-explore-lede">
        Already triggered a simulated cold snap? Confirm with the live feed, then try a flood/leak story, map a city, or set up kit QR.
      </p>
      <ul class="demo-explore-list">
        <li>
          <a class="text-link" href="/about/probe-demo">Interactive probe simulator</a>
          <span class="demo-explore-hint">Primary hands-on demo: door, sun, outdoor, freeze threshold</span>
        </li>
        <li>
          <a class="text-link" href="/freeze-map">Community freeze map</a>
          <span class="demo-explore-hint">Opt-in city aggregates, no account required</span>
        </li>
        <li>
          <a class="text-link" href="/about/kit-qr-onboarding">Kit QR onboarding</a>
          <span class="demo-explore-hint">Create device → scan ingest QR → first POST</span>
        </li>
        <li>
          <a class="text-link" href="/stories/garage-freeze-alert">Freeze case study</a>
          <span class="demo-explore-hint">Why a second probe near pipes matters</span>
        </li>
      </ul>
    </section>

    <FaqSection
      faqs={demoFaqs}
      lede="Demo-specific answers, for plans and product basics see Pricing or the homepage FAQ."
    />
  </div>
</Layout>

<style>
  .demo-paths {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .demo-paths li {
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-border);
  }

  .demo-paths li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .demo-freeze {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .demo-freeze {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
  }

  .demo-freeze-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-text);
  }

  .demo-freeze-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .demo-freeze-channels {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .demo-freeze-channels li + li {
    margin-top: 0.35rem;
  }

  .demo-freeze-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .demo-freeze-visual {
    margin: 0;
  }

  .demo-freeze-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 12px);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .demo-explore-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: var(--color-text);
  }

  .demo-explore-lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .demo-explore-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .demo-explore-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
    }
  }

  .demo-explore-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .demo-explore-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
