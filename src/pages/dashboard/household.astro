---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getAuthFromCookies } from "../../lib/auth";
import {
  countOwnedHouseholds,
  getOrCreateHouseholdForUser,
  getOwnedHouseholdId,
  listHouseholdMembers,
  listUserHouseholds,
  getUserHouseholdRole,
  canManageHousehold,
} from "../../lib/households";
import { listPendingInvites } from "../../lib/householdInvites";
import { getHouseholdErrorMessage } from "../../lib/householdErrors";
import { getUserEntitlements } from "../../lib/entitlements";
import { createAdminClient, createServerClient } from "../../lib/supabase";
import { buildSiteUrl } from "../../lib/stripe";
import { listHouseholdActivity } from "../../lib/householdActivity";
import { formatHouseholdActivityAction } from "../../lib/householdActivityLabels";
import { householdRoleLabel } from "../../lib/householdRoleLabel";
import { uniqueWeatherCityPresets } from "../../lib/weatherCities";
import DashboardCard from "../../components/dashboard/DashboardCard.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const active = await getOrCreateHouseholdForUser(user.id, user.email);
const ownedId = await getOwnedHouseholdId(user.id);
const manageId = ownedId ?? active.householdId;

const [membersResult, householdsResult, invitesResult, householdRow, entitlements, ownedCount] =
  await Promise.all([
    manageId ? listHouseholdMembers(manageId) : Promise.resolve({ members: [], error: null }),
    shell
      ? Promise.resolve({ households: shell.households, error: null as string | null })
      : listUserHouseholds(user.id),
    manageId ? listPendingInvites(manageId) : Promise.resolve({ invites: [], error: null }),
    manageId
      ? createServerClient()
          .from("households")
          .select(
            "name, freeze_map_opt_in, freeze_map_city_id, freeze_map_lat, freeze_map_lon, freeze_map_label",
          )
          .eq("id", manageId)
          .maybeSingle()
      : Promise.resolve({ data: null }),
    shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
    countOwnedHouseholds(user.id),
  ]);

const atPropertyLimit = ownedCount >= entitlements.maxOwnedHouseholds;
const canCreateProperty = !atPropertyLimit;
const canInvitePropertyManager =
  entitlements.tier === "portfolio" || entitlements.tier === "admin";

const admin = createAdminClient();
const membersWithEmail = await Promise.all(
  membersResult.members.map(async (member) => {
    const { data } = await admin.auth.admin.getUserById(member.user_id);
    return { ...member, email: data.user?.email ?? member.user_id };
  }),
);

const errorCode = Astro.url.searchParams.get("error");
const errorMessage = getHouseholdErrorMessage(errorCode);
const notice = Astro.url.searchParams.get("invited")
  ? "Invite email sent."
  : Astro.url.searchParams.get("removed")
    ? "Member removed."
    : Astro.url.searchParams.get("saved")
      ? "Household updated."
      : Astro.url.searchParams.get("switched")
        ? "Active household switched."
      : Astro.url.searchParams.get("joined")
        ? "You joined the household."
      : Astro.url.searchParams.get("invite_revoked")
        ? "Invite cancelled."
      : Astro.url.searchParams.get("left")
        ? "You left the household."
      : Astro.url.searchParams.get("property_created")
        ? "New property created and set active."
      : null;

const isOwner = Boolean(ownedId && ownedId === manageId);
const manageRole = manageId
  ? await getUserHouseholdRole(user.id, manageId)
  : null;
const canManage = canManageHousehold(manageRole);
const activeMembership = householdsResult.households.find(
  (h) => h.household_id === active.householdId,
);
const canLeaveActive =
  Boolean(active.householdId) && activeMembership?.role === "member";
const siteOrigin = buildSiteUrl(Astro.request, "/").replace(/\/$/, "");
const householdActivity =
  manageId && canManage
    ? await listHouseholdActivity(manageId, { limit: 15 })
    : [];
const myMembership = membersWithEmail.find((m) => m.user_id === user.id);
const digestOptInRow =
  active.householdId && active.householdId !== manageId
    ? await createServerClient()
        .from("household_members")
        .select("digest_opt_in")
        .eq("household_id", active.householdId)
        .eq("user_id", user.id)
        .maybeSingle()
    : Promise.resolve({ data: myMembership ? { digest_opt_in: myMembership.digest_opt_in } : null });
const digestOptInResult = await digestOptInRow;
const digestOptIn = Boolean(digestOptInResult.data?.digest_opt_in);
const digestSaved = Astro.url.searchParams.get("digest_saved");
const digestError = Astro.url.searchParams.get("digest_error");
---
<DashboardLayout title="Household">
  <div class="space-y-6">
    <DashboardCard>
      <h2 class="card-title">Household sharing</h2>
      <p class="card-subtitle">
        Share devices and history. Invite by email: recipients get a link and don’t need an account yet.
      </p>
      {notice && <p class="alert-success mt-4">{notice}</p>}
      {errorMessage && <p class="alert-warning mt-4" role="alert">{errorMessage}</p>}
      {digestSaved && (
        <p class="alert-success mt-4" role="status">Digest preference saved.</p>
      )}
      {digestError && (
        <p class="alert-warning mt-4" role="alert">Could not save digest preference.</p>
      )}
    </DashboardCard>

    {active.householdId && (
      <DashboardCard>
        <h2 class="card-title">Weekly digest</h2>
        <p class="card-subtitle mb-4">
          When the property owner has digests enabled, opt in to receive the same weekly probe summary.
        </p>
        <form action="/api/user/digest-opt-in" method="post" class="flex flex-wrap items-center gap-3">
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <input type="hidden" name="digest_opt_in" value="0" />
          <label class="checkbox-row mb-0">
            <input type="checkbox" name="digest_opt_in" value="1" checked={digestOptIn} />
            <span>Email me the weekly household digest</span>
          </label>
          <button type="submit" class="btn-secondary btn-sm">Save</button>
        </form>
      </DashboardCard>
    )}

    <DashboardCard>
    {canCreateProperty ? (
    <form action="/api/household" method="post">
      <input type="hidden" name="action" value="create_property" />
      <input type="hidden" name="redirect" value="/dashboard/household" />
      <h2 class="card-title">Add another property</h2>
      <p class="card-subtitle mb-4">
        Create a second household (vacation home, rental, etc.) and switch between them from the dashboard.
      </p>
      <div class="form-field">
        <label class="form-label" for="property-name">Property name</label>
        <input class="form-input" id="property-name" name="name" placeholder="Lake house" required />
      </div>
      <button class="btn-secondary mt-2" type="submit">Create property</button>
    </form>
    ) : (
      <>
        <h2 class="card-title">Add another property</h2>
        <p class="card-subtitle mb-4">
          Your plan allows {entitlements.maxOwnedHouseholds} owned
          {entitlements.maxOwnedHouseholds === 1 ? " household" : " households"}
          ({ownedCount} in use). Upgrade to Pro for multiple properties.
        </p>
        <UpgradeNudge feature="multi_property" tier={entitlements.tier} />
      </>
    )}
    </DashboardCard>

    {isOwner && (
      <DashboardCard>
        <form method="POST" data-rename-household-form>
          <input type="hidden" name="action" value="rename" />
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <h2 class="card-title">Household name</h2>
          <p class="alert-success mt-0 mb-3 hidden" data-form-status role="status"></p>
          <p class="alert-warning mt-0 mb-3 hidden" data-form-error role="alert"></p>
          <div class="form-field">
            <label class="form-label" for="household-name">Name</label>
            <input
              class="form-input"
              id="household-name"
              name="name"
              value={householdRow.data?.name ?? ""}
              required
            />
          </div>
          <button class="btn-secondary" type="submit" data-form-submit>Save name</button>
        </form>
      </DashboardCard>
    )}

    {isOwner && (
      <DashboardCard id="freeze-map">
      <form method="POST" id="freeze-map-form" data-freeze-map-form>
        <input type="hidden" name="action" value="freeze_map" />
        <input type="hidden" name="redirect" value="/dashboard/household" />
        <p class="alert-success mt-0 mb-3 hidden" data-form-status role="status"></p>
        <p class="alert-warning mt-0 mb-3 hidden" data-form-error role="alert"></p>
        <input
          type="hidden"
          name="freeze_map_lat"
          id="freeze_map_lat"
          value={householdRow.data?.freeze_map_lat ?? ""}
        />
        <input
          type="hidden"
          name="freeze_map_lon"
          id="freeze_map_lon"
          value={householdRow.data?.freeze_map_lon ?? ""}
        />
        <input
          type="hidden"
          name="freeze_map_label"
          id="freeze_map_label"
          value={householdRow.data?.freeze_map_label ?? ""}
        />
        <h2 class="card-title">Public freeze-risk map</h2>
        <p class="card-subtitle mb-4">
          Opt in to contribute anonymized indoor temperature averages for your city.
          No household, device, or address is shown on the public map.
        </p>
        <label class="checkbox-row mb-3">
          <input
            type="checkbox"
            name="freeze_map_opt_in"
            value="true"
            checked={householdRow.data?.freeze_map_opt_in === true}
          />
          <span>Include this household in city aggregates</span>
        </label>
        <div class="form-field">
          <label class="form-label" for="freeze_map_city_id">Preset city</label>
          <select class="form-input" id="freeze_map_city_id" name="freeze_map_city_id">
            <option value="">Select a preset (optional)</option>
            {uniqueWeatherCityPresets().map((city) => (
              <option
                value={city.id}
                selected={householdRow.data?.freeze_map_city_id === city.id}
              >
                {city.label}
              </option>
            ))}
          </select>
        </div>
        <div class="form-field">
          <label class="form-label" for="city-search">Or search any city</label>
          <input
            class="form-input"
            type="search"
            id="city-search"
            placeholder="e.g. Asheville, NC"
            autocomplete="off"
          />
          <p class="form-hint mb-2" id="city-search-selected">
            {householdRow.data?.freeze_map_label
              ? `Selected: ${householdRow.data.freeze_map_label}`
              : "Search and pick a result if your city is not in the preset list."}
          </p>
          <ul id="city-search-results" class="space-y-2 text-sm"></ul>
        </div>
        <button class="btn-secondary" type="submit" data-form-submit>Save freeze map settings</button>
        <p class="form-hint mt-2 mb-0">
          View the public list at <a class="text-link" href="/freeze-map">/freeze-map</a>.
        </p>
      </form>
      <script is:inline>
        (() => {
          const input = document.getElementById("city-search");
          const results = document.getElementById("city-search-results");
          const latEl = document.getElementById("freeze_map_lat");
          const lonEl = document.getElementById("freeze_map_lon");
          const labelEl = document.getElementById("freeze_map_label");
          const preset = document.getElementById("freeze_map_city_id");
          const selected = document.getElementById("city-search-selected");
          if (!(input instanceof HTMLInputElement) || !results) return;
          let timer = null;

          preset?.addEventListener("change", () => {
            if (preset.value) {
              if (latEl) latEl.value = "";
              if (lonEl) lonEl.value = "";
              if (labelEl) labelEl.value = preset.options[preset.selectedIndex]?.text || "";
              if (selected) selected.textContent = "Using preset city.";
              results.innerHTML = "";
            }
          });

          input.addEventListener("input", () => {
            clearTimeout(timer);
            const q = input.value.trim();
            if (q.length < 2) {
              results.innerHTML = "";
              return;
            }
            timer = setTimeout(async () => {
              try {
                const res = await fetch("/api/weather/city-search?q=" + encodeURIComponent(q));
                const data = await res.json();
                results.innerHTML = "";
                (data.results || []).forEach((row) => {
                  const li = document.createElement("li");
                  const btn = document.createElement("button");
                  btn.type = "button";
                  btn.className = "btn-ghost text-left";
                  btn.textContent = row.label;
                  btn.addEventListener("click", () => {
                    if (latEl) latEl.value = String(row.lat);
                    if (lonEl) lonEl.value = String(row.lon);
                    if (labelEl) labelEl.value = row.label;
                    if (preset) preset.value = "";
                    if (selected) selected.textContent = "Selected: " + row.label;
                    results.innerHTML = "";
                    input.value = row.label;
                  });
                  li.appendChild(btn);
                  results.appendChild(li);
                });
              } catch {
                results.innerHTML = "<li>Search failed</li>";
              }
            }, 300);
          });
        })();
      </script>
      </DashboardCard>
    )}

    {householdsResult.households.length > 1 && (
      <DashboardCard>
        <h2 class="card-title">Active household</h2>
        <p class="card-subtitle">Choose which household’s devices and history you see.</p>
        <ul class="space-y-3">
          {householdsResult.households.map((h) => (
            <li class="flex items-center justify-between gap-4">
              <div>
                <strong>{h.name}</strong>
                <span class="text-sm text-[var(--color-text-muted)]">
                  {" · "}
                  {householdRoleLabel(h.role)}
                </span>
                {h.household_id === active.householdId && (
                  <span class="feed-health-ok ml-2">Active</span>
                )}
              </div>
              {h.household_id !== active.householdId && (
                <form action="/api/household" method="post">
                  <input type="hidden" name="action" value="switch" />
                  <input type="hidden" name="household_id" value={h.household_id} />
                  <input type="hidden" name="redirect" value="/dashboard/household" />
                  <button class="btn-secondary" type="submit">Switch</button>
                </form>
              )}
            </li>
          ))}
        </ul>
      </DashboardCard>
    )}

    {canManage ? (
      <DashboardCard>
        <form method="POST" id="household-invite-form" data-invite-form>
          <input type="hidden" name="action" value="invite" />
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <h2 class="card-title">Invite by email</h2>
          <p class="card-subtitle mb-4">
            Invites go to your owned household{householdRow.data?.name ? ` (${householdRow.data.name})` : ""}.
          </p>
          <p class="alert-success mt-0 mb-4 hidden" id="invite-status" role="status"></p>
          <p class="alert-warning mt-0 mb-4 hidden" id="invite-error" role="alert"></p>
          <div class="form-field">
            <label class="form-label" for="email">Invitee email</label>
            <input class="form-input" type="email" id="email" name="email" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="invite_role">Role</label>
            <select class="form-input" id="invite_role" name="role">
              <option value="member">Editor (can edit devices & alerts)</option>
              {canInvitePropertyManager ? (
                <option value="property_manager">Property manager (devices & alerts only)</option>
              ) : null}
              <option value="viewer">Viewer (read-only dashboard)</option>
              <option value="alert_only">Alert only (notifications, read-only)</option>
            </select>
            {!canInvitePropertyManager && (
              <p class="form-hint mb-0 mt-2">
                <a class="text-link" href="/pricing#portfolio">Portfolio</a>
                {" "}adds property-manager logins for on-site staff (no billing access).
              </p>
            )}
          </div>
          <button class="btn-primary" type="submit" id="invite-submit">Send invite link</button>
        </form>
      </DashboardCard>
    ) : (
      <DashboardCard>
        <h2 class="card-title">Invites</h2>
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          Only the household owner can send invites.
        </p>
      </DashboardCard>
    )}

    {canManage && (invitesResult.invites ?? []).length > 0 && (
      <DashboardCard>
        <h2 class="card-title">Pending invites</h2>
        <ul class="space-y-3">
          {invitesResult.invites.map((invite) => {
            const href = `${siteOrigin}/invite/${invite.token}`;
            return (
              <li class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <strong>{invite.email}</strong>
                  <p class="m-0 text-sm break-all text-[var(--color-text-muted)]">{href}</p>
                  <p class="m-0 text-sm">Expires {new Date(invite.expires_at).toLocaleString()}</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    class="btn-secondary shrink-0"
                    data-copy={href}
                    data-copy-label="Copy link"
                  >
                    Copy link
                  </button>
                  <form
                    action="/api/household"
                    method="post"
                    onsubmit="return confirm('Cancel this invite?');"
                  >
                    <input type="hidden" name="action" value="revoke_invite" />
                    <input type="hidden" name="invite_id" value={invite.id} />
                    <input type="hidden" name="redirect" value="/dashboard/household" />
                    <button class="btn-ghost" type="submit">Cancel</button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      </DashboardCard>
    )}

    <DashboardCard>
      <h2 class="card-title">Members</h2>
      <ul class="space-y-3">
        {membersWithEmail.map((member) => (
          <li class="flex items-center justify-between gap-4">
            <div>
              <strong>{member.email}</strong>
              <span class="text-sm text-[var(--color-text-muted)]">
                {" · "}
                {householdRoleLabel(member.role)}
              </span>
            </div>
            {member.role !== "owner" && ownedId === manageId && (
              <form
                action="/api/household"
                method="post"
                onsubmit="return confirm('Remove this member from the household?');"
              >
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="user_id" value={member.user_id} />
                <input type="hidden" name="redirect" value="/dashboard/household" />
                <button class="btn-ghost" type="submit">Remove</button>
              </form>
            )}
          </li>
        ))}
      </ul>
      {canLeaveActive && active.householdId && (
        <form
          action="/api/household"
          method="post"
          class="mt-6 border-t border-[var(--color-border)] pt-4"
          onsubmit="return confirm('Leave this household? You will lose access to its shared devices and history.');"
        >
          <input type="hidden" name="action" value="leave" />
          <input type="hidden" name="household_id" value={active.householdId} />
          <input type="hidden" name="redirect" value="/dashboard/household" />
          <p class="card-subtitle mb-3">
            You are a member of this household. Leaving removes your access to its devices and history.
          </p>
          <button class="btn-ghost" type="submit">Leave household</button>
        </form>
      )}
    </DashboardCard>

    {canManage && (
      <DashboardCard>
        <h2 class="card-title">Recent activity</h2>
        <p class="card-subtitle mb-4">
          Invites, alert changes, device transfers, and ingest key reveals for this household.
        </p>
        {householdActivity.length === 0 ? (
          <p class="text-sm text-[var(--color-text-muted)]">No activity yet.</p>
        ) : (
          <ul class="space-y-2 text-sm">
            {householdActivity.map((row) => (
              <li>
                <strong>{formatHouseholdActivityAction(row.action)}</strong>
                {row.detail ? `: ${row.detail}` : ""}
                <span class="text-[var(--color-text-muted)]">
                  {" "}
                  · {new Date(row.created_at).toLocaleString()}
                </span>
              </li>
            ))}
          </ul>
        )}
      </DashboardCard>
    )}
  </div>
</DashboardLayout>

<script>
  import { actions } from "astro:actions";

  const inviteForm = document.querySelector<HTMLFormElement>("[data-invite-form]");
  const inviteStatus = document.getElementById("invite-status");
  const inviteError = document.getElementById("invite-error");
  const inviteSubmit = document.getElementById("invite-submit");

  inviteForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(inviteForm instanceof HTMLFormElement)) return;

    inviteStatus?.classList.add("hidden");
    inviteError?.classList.add("hidden");
    if (inviteSubmit instanceof HTMLButtonElement) {
      inviteSubmit.disabled = true;
      inviteSubmit.textContent = "Sending…";
    }

    const { data, error } = await actions.inviteHouseholdMember(new FormData(inviteForm));

    if (inviteSubmit instanceof HTMLButtonElement) {
      inviteSubmit.disabled = false;
      inviteSubmit.textContent = "Send invite link";
    }

    if (error) {
      if (inviteError) {
        inviteError.textContent = error.message || "Could not send invite.";
        inviteError.classList.remove("hidden");
      }
      return;
    }

    if (inviteStatus) {
      inviteStatus.textContent = data?.message ?? "Invite sent.";
      inviteStatus.classList.remove("hidden");
    }
    inviteForm.reset();
    window.setTimeout(() => window.location.reload(), 800);
  });

  function wireStatusForm(
    selector: string,
    run: (formData: FormData) => Promise<{ data?: { message?: string } | null; error?: { message?: string } | null }>,
    idleLabel: string,
  ) {
    const form = document.querySelector<HTMLFormElement>(selector);
    if (!form) return;
    const statusEl = form.querySelector<HTMLElement>("[data-form-status]");
    const errorEl = form.querySelector<HTMLElement>("[data-form-error]");
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-form-submit]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      statusEl?.classList.add("hidden");
      errorEl?.classList.add("hidden");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Saving…";
      }
      const formData = new FormData(form);
      if (!formData.has("freeze_map_opt_in")) formData.set("freeze_map_opt_in", "");
      const { data, error } = await run(formData);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = idleLabel;
      }
      if (error) {
        if (errorEl) {
          errorEl.textContent = error.message || "Could not save.";
          errorEl.classList.remove("hidden");
        }
        return;
      }
      if (statusEl) {
        statusEl.textContent = data?.message ?? "Saved.";
        statusEl.classList.remove("hidden");
      }
    });
  }

  wireStatusForm(
    "[data-rename-household-form]",
    (formData) => actions.renameHousehold(formData),
    "Save name",
  );
  wireStatusForm(
    "[data-freeze-map-form]",
    (formData) => actions.updateFreezeMapSettings(formData),
    "Save freeze map settings",
  );
</script>
