---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";
import { listEmailSuppressions } from "../../lib/emailSuppressions";

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const removed = Astro.url.searchParams.get("removed") === "1";
const added = Astro.url.searchParams.get("added") === "1";
const formError = Astro.url.searchParams.get("error")?.trim() ?? "";
const { rows, error } = await listEmailSuppressions(200);
---
<DashboardLayout title="Email suppressions" requireAdmin>
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Email suppressions</h2>
      <p class="card-subtitle mb-0">
        Addresses we will not send to (bounces, noreply aliases, invalid). Protects Cloudflare Email bounce rate.
        Removing a row allows mail again — only do that when the mailbox is known-good.
      </p>
      {added && (
        <p class="alert-success mt-4 mb-0" role="status">Address suppressed.</p>
      )}
      {removed && (
        <p class="alert-success mt-4 mb-0" role="status">Suppression removed.</p>
      )}
      {formError && (
        <p class="alert-warning mt-4 mb-0" role="alert">Could not update: {formError}</p>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Add suppression</h2>
      <p class="card-subtitle mb-4">
        Manually block an address before the next send (known bounce, noreply, test junk).
      </p>
      <form method="POST" action="/api/admin/email-suppressions/add" class="space-y-4">
        <div class="form-field">
          <label class="form-label" for="suppress-email">Email</label>
          <input
            class="form-input"
            type="email"
            id="suppress-email"
            name="email"
            required
            autocomplete="off"
            placeholder="user@example.com"
          />
        </div>
        <div class="form-field">
          <label class="form-label" for="suppress-reason">Reason</label>
          <select class="form-input" id="suppress-reason" name="reason">
            <option value="manual">manual</option>
            <option value="bounce">bounce</option>
            <option value="invalid">invalid</option>
            <option value="noreply">noreply</option>
            <option value="complaint">complaint</option>
          </select>
        </div>
        <div class="form-field">
          <label class="form-label" for="suppress-note">Note (optional)</label>
          <input
            class="form-input"
            type="text"
            id="suppress-note"
            name="note"
            maxlength="500"
            placeholder="Why this address is blocked"
          />
        </div>
        <button class="btn-primary" type="submit">Suppress address</button>
      </form>
    </section>

    <section class="card">
      {error ? (
        <p class="alert-warning mb-0">Unable to load suppressions: {error}</p>
      ) : rows.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">No suppressed addresses yet.</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Email</th>
                <th>Reason</th>
                <th>Updated</th>
                <th>Last error</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td>
                    <code>{row.email}</code>
                  </td>
                  <td>{row.reason}</td>
                  <td>{new Date(row.updated_at).toLocaleString()}</td>
                  <td class="contact-message-cell">
                    {row.last_error ? <code>{row.last_error}</code> : "—"}
                  </td>
                  <td>
                    <form method="POST" action="/api/admin/email-suppressions/remove">
                      <input type="hidden" name="email" value={row.email} />
                      <button type="submit" class="btn-ghost text-sm">
                        Remove
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
        Showing {rows.length} row{rows.length === 1 ? "" : "s"} (max 200). Also review Cloudflare Email Service suppressions in the dashboard.
      </p>
    </section>
  </div>
</DashboardLayout>
