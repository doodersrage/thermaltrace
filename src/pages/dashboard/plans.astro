---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PlansCard from "../../components/PlansCard.astro";
import PlanComparisonTable from "../../components/PlanComparisonTable.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import ReferralCard from "../../components/ReferralCard.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getUserEntitlements } from "../../lib/entitlements";
import { canDownloadHistoryCsv } from "../../lib/adminAccess";
import { getUserSubscription } from "../../lib/stripeSubscriptions";
import { normalizeComparisonTier, nextUpgradeTier } from "../../lib/planComparison";
import { getSiteUrl } from "../../lib/stripe";
import { resolveStripePriceId } from "../../lib/planTier";

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const [entitlements, subscription, canDownloadCsv] = await Promise.all([
  shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
  getUserSubscription(user.id),
  shell
    ? Promise.resolve(shell.entitlements.canDownloadCsv)
    : canDownloadHistoryCsv(user.id),
]);

const currentTier = normalizeComparisonTier(entitlements.tier);
const upgradeTarget = nextUpgradeTier(entitlements.tier);
const subscriptionNotice = Astro.url.searchParams.get("subscription");
const siteUrl = getSiteUrl(Astro.request);
const portfolioCheckoutAvailable = Boolean(
  resolveStripePriceId("portfolio", "monthly") ||
    resolveStripePriceId("portfolio", "annual"),
);
const referralRewardDays = Number(
  (user.app_metadata as Record<string, unknown> | undefined)?.referral_reward_days ?? 0,
);
---
<DashboardLayout
  title="Plans"
  subtitle="Compare tiers and upgrade when you need longer retention, SMS, or more properties."
>
  <div class="space-y-6">

    {upgradeTarget && (
      <UpgradeNudge
        feature={
          upgradeTarget === "member"
            ? "data_retention"
            : upgradeTarget === "pro"
              ? "sms_alerts"
              : "portfolio_scale"
        }
        tier={entitlements.tier}
      />
    )}

    <PlansCard
      canDownloadCsv={canDownloadCsv}
      subscription={subscription}
      entitlements={entitlements}
      subscriptionNotice={subscriptionNotice}
      portfolioCheckoutAvailable={portfolioCheckoutAvailable}
    />

    <ReferralCard siteUrl={siteUrl} rewardDays={referralRewardDays} />

    <section class="card">
      <h2 class="card-title">Feature comparison</h2>
      <p class="card-subtitle mb-4">Your column is highlighted.</p>
      <PlanComparisonTable highlightTier={currentTier} />
    </section>
  </div>
</DashboardLayout>
