---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import UserManager from "../../components/UserManager.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";
import {
  fetchManagedUsers,
  managedUserListQueryString,
  parseManagedUserListQuery,
} from "../../lib/userManager";
import { fetchReferralAdminStats } from "../../lib/referrals";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

// Gate before admin-only fetches -- DashboardLayout's own requireAdmin
// check runs too late to stop this page's frontmatter from already
// having queried admin-only data (Astro.redirect() from a nested layout
// isn't a reliable way to abort a page's response; see ops.astro).
if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const listQuery = parseManagedUserListQuery(Astro.url.searchParams);
const queryString = (page?: number) =>
  managedUserListQueryString({ ...listQuery, page });

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect(`/dashboard/users${queryString(1)}`);
}

const users = await fetchManagedUsers(user.id, pageParam, undefined, listQuery);
const referralStats = await fetchReferralAdminStats();
const status = Astro.url.searchParams.get("status");

if (users.totalPages > 0 && pageParam > users.totalPages) {
  return Astro.redirect(`/dashboard/users${queryString(users.totalPages)}`);
}
---
<DashboardLayout title="Users" subtitle="Manage registered accounts and admin group membership." requireAdmin>
  <div class="space-y-6">
    <AdminNav />

    <section class="card">
      <h2 class="card-title">Referral program</h2>
      <p class="card-subtitle mb-4">Signups and referrer rewards granted on Pro subscription.</p>
      <div class="stat-grid mb-4">
        <article class="stat-item">
          <span class="stat-label">Total signups</span>
          <p class="stat-value">{referralStats.totalSignups}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">Referrer rewards granted</span>
          <p class="stat-value">{referralStats.rewardedSignups}</p>
        </article>
      </div>
      {referralStats.topReferrers.length > 0 && (
        <ul class="space-y-2 text-sm mb-0">
          {referralStats.topReferrers.map((row) => (
            <li>
              <code>{row.userId.slice(0, 8)}…</code>: {row.count} signup{row.count === 1 ? "" : "s"}
            </li>
          ))}
        </ul>
      )}
    </section>

    <UserManager
      users={users}
      currentUserId={user.id}
      query={listQuery}
      status={status}
    />
  </div>
</DashboardLayout>
