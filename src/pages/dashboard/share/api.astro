---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import ShareNav from "../../../components/dashboard/ShareNav.astro";
import UpgradeNudge from "../../../components/UpgradeNudge.astro";
import { loadShareDashboardContext } from "../../../lib/shareDashboardContext";

const ctx = await loadShareDashboardContext(Astro.cookies, Astro.request, Astro.url);
if (ctx.redirect) return Astro.redirect(ctx.redirect);

const {
  entitlements,
  apiKeys,
  inboundWebhooks,
  ingestStats,
  canManage,
  siteUrl,
  newApiKey,
  inboundToken,
  inboundSigningSecret,
  notice,
  noticeIsError,
} = ctx;

const redirectTo = "/dashboard/share/api";
const showWebhookNudge =
  !entitlements.canUseOutboundWebhook && !entitlements.canCreateShareLinks;
---
<DashboardLayout title="Share" subtitle="API keys, inbound webhooks, and ingest stats.">
  <ShareNav active="api">
    <div class="space-y-6">
      {notice && (
        <div class="dashboard-flash">
          <p class:list={[noticeIsError ? "alert-warning" : "alert-success", "mt-0 mb-0"]}>{notice}</p>
        </div>
      )}

      <section class="card">
        <h2 class="card-title">First success path</h2>
        <p class="card-subtitle mb-4">
          Most integrators start with device ingest (not Prometheus). Create a push device, then POST JSON
          with the per-device key: curl example lives on the HTTP API docs.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/dashboard/devices">Create push device</a>
          <a class="btn-secondary" href="/docs/api#ingest">API docs: ingest curl</a>
          <a class="btn-ghost" href="/about/probe-demo">Copy sample JSON from simulator</a>
        </div>
      </section>

      {showWebhookNudge && (
        <UpgradeNudge feature="webhooks" tier={entitlements.tier} />
      )}

      {entitlements.canCreateShareLinks && canManage && (
        <section class="card">
          <h2 class="card-title">Dashboard API keys</h2>
          <p class="card-subtitle mb-4">
            Scrape Prometheus metrics with <code>Authorization: Bearer &lt;key&gt;</code> at
            <code>/api/v1/metrics</code>.
          </p>
          {newApiKey && (
            <div class="ingest-key-callout mb-4">
              <p class="ingest-key-value break-all text-sm mb-2">{newApiKey}</p>
              <button type="button" class="btn-primary" data-copy={newApiKey} data-copy-label="Copy key">
                Copy key
              </button>
            </div>
          )}
          <form action="/api/api-keys" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <div class="form-field mb-0">
              <label class="form-label" for="api-key-name">Name</label>
              <input class="form-input" id="api-key-name" name="name" value="Metrics key" />
            </div>
            <button class="btn-secondary" type="submit">Create API key</button>
          </form>
          {apiKeys.length === 0 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">No active API keys.</p>
          ) : (
            <ul class="space-y-3">
              {apiKeys.map((key) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <strong>{key.name}</strong>
                    <span class="text-sm text-[var(--color-text-muted)]"> · {key.key_prefix}…</span>
                  </div>
                  <form action="/api/api-keys" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="id" value={key.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">Revoke</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
          <p class="mt-4 mb-0 text-sm">
            <a class="text-link" href="/grafana/thermaltrace-dashboard.json" download>
              Download Grafana dashboard JSON
            </a>
          </p>
        </section>
      )}

      {!entitlements.canCreateShareLinks && (
        <UpgradeNudge feature="share_links" tier={entitlements.tier} />
      )}

      {entitlements.canUseOutboundWebhook && (
        <section class="card" id="inbound-webhooks">
          <h2 class="card-title">Inbound webhooks</h2>
          <p class="card-subtitle mb-4">
            Let Home Assistant or Zapier POST to ThermalTrace. Actions:
            <code>snooze</code>, <code>vacation</code>, <code>clear_snooze</code>, <code>clear_vacation</code>, <code>status</code>.
            Example: <code>{`{"action":"snooze","hours":24}`}</code> to <code>POST /api/inbound/&lt;token&gt;</code>.
          </p>
          {!canManage && (
            <p class="alert-warning mb-4" role="status">View-only: cannot create or revoke inbound webhooks.</p>
          )}
          {inboundToken && (
            <div class="ingest-key-callout mb-4">
              <p class="text-sm mb-2">New webhook URL (copy now):</p>
              <p class="ingest-key-value break-all text-sm mb-2">{siteUrl}/api/inbound/{inboundToken}</p>
              {inboundSigningSecret && (
                <>
                  <p class="text-sm mb-2">Signing secret (for X-ThermalTrace-Signature, copy now):</p>
                  <p class="ingest-key-value break-all text-sm mb-2">{inboundSigningSecret}</p>
                </>
              )}
              <button type="button" class="btn-primary" data-copy={`${siteUrl}/api/inbound/${inboundToken}`} data-copy-label="Copy URL">
                Copy URL
              </button>
            </div>
          )}
          {canManage && (
            <form action="/api/inbound-webhooks" method="post" class="mb-4 flex flex-wrap gap-2 items-end">
              <input type="hidden" name="action" value="create" />
              <input type="hidden" name="redirect" value={redirectTo} />
              <div class="form-field mb-0">
                <label class="form-label" for="inbound-name">Name</label>
                <input class="form-input" id="inbound-name" name="name" value="HA automation" />
              </div>
              <button class="btn-secondary" type="submit">Create inbound webhook</button>
            </form>
          )}
          {inboundWebhooks.length === 0 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">No inbound webhooks yet.</p>
          ) : (
            <ul class="space-y-3">
              {inboundWebhooks.map((wh) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <strong>{wh.name}</strong>
                    <span class="text-sm text-[var(--color-text-muted)]"> · {wh.token_prefix}…</span>
                  </div>
                  <form action="/api/inbound-webhooks" method="post">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="webhook_id" value={wh.id} />
                    <input type="hidden" name="redirect" value={redirectTo} />
                    <button class="btn-ghost" type="submit">Revoke</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}

      <section class="card">
        <h2 class="card-title">Ingest stats (7 days)</h2>
        <p class="card-subtitle mb-4">
          Daily POST success and error counts per push device.
          {ingestStats.length === 0 && " No ingest activity recorded yet. POST from a push device to populate."}
        </p>
        {ingestStats.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-[var(--color-text-muted)]">
                  <th class="py-2 pr-3">Device</th>
                  <th class="py-2 pr-3">Day</th>
                  <th class="py-2 pr-3">OK</th>
                  <th class="py-2">Errors</th>
                </tr>
              </thead>
              <tbody>
                {ingestStats.slice(0, 20).map((row) => (
                  <tr class="border-t border-[var(--color-border)]">
                    <td class="py-2 pr-3">{row.device_name}</td>
                    <td class="py-2 pr-3">{row.day}</td>
                    <td class="py-2 pr-3">{row.success_count}</td>
                    <td class="py-2">{row.error_count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  </ShareNav>
</DashboardLayout>
