---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DisplayPreferences from "../../components/DisplayPreferences.astro";
import PwaInstallCard from "../../components/dashboard/PwaInstallCard.astro";
import DashboardCard from "../../components/dashboard/DashboardCard.astro";
import DashboardComfortCard from "../../components/dashboard/DashboardComfortCard.astro";
import TenantRelayCard from "../../components/dashboard/TenantRelayCard.astro";
import AccountSecurity from "../../components/AccountSecurity.astro";
import AccountLifecycle from "../../components/AccountLifecycle.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { getUserPreferences } from "../../lib/userPreferences";
import { getUserEntitlements } from "../../lib/entitlements";
import { getAlertSettingsForUser } from "../../lib/notify";
import {
  canEditHousehold,
  getOrCreateHouseholdForUser,
  getUserHouseholdRole,
} from "../../lib/households";
import { getTenantNotifySettings } from "../../lib/tenantRelay";
import {
  getDashboardQuietUntil,
  getPinnedOverviewMetrics,
  isDashboardQuietActive,
  shouldForceSimpleOverview,
} from "../../lib/dashboardComfort";

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const household = await getOrCreateHouseholdForUser(user.id, user.email);
const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);

const [preferences, entitlements, alertSettings, tenantNotify] = await Promise.all([
  getUserPreferences(user),
  shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
  getAlertSettingsForUser(user.id, user.user_metadata),
  household.householdId
    ? getTenantNotifySettings(household.householdId)
    : Promise.resolve({ email: null, name: null }),
]);
const prefsSaved = Astro.url.searchParams.get("prefs_saved");
const prefsError = Astro.url.searchParams.get("prefs_error");
const passwordUpdated = Astro.url.searchParams.get("password") === "updated";
const deleteError = Astro.url.searchParams.get("delete_error");
const retentionSaved = Astro.url.searchParams.get("retention_saved");
const tenantSaved = Astro.url.searchParams.get("tenant_saved");
const tenantError = Astro.url.searchParams.get("tenant_error");
const pinnedSaved = Astro.url.searchParams.get("pinned_saved");
const pinnedError = Astro.url.searchParams.get("pinned_error");
const quietSaved = Astro.url.searchParams.get("quiet_saved");
const quietCleared = Astro.url.searchParams.get("quiet_cleared");
const onboardingDismissed =
  (user.user_metadata as Record<string, unknown> | undefined)?.onboarding_dismissed ===
  true;
const quietUntil = getDashboardQuietUntil(user);
const quietActive = isDashboardQuietActive(user);
const pinnedMetrics = getPinnedOverviewMetrics(user);
const forceSimpleNote = shouldForceSimpleOverview(householdRole);
const planLabel =
  entitlements.tier === "admin"
    ? "Admin"
    : entitlements.tier.charAt(0).toUpperCase() + entitlements.tier.slice(1);
---
<DashboardLayout
  title="Settings"
  subtitle="Live display and theme. Security, retention, and landlord relay live under Advanced."
>
  <div class="space-y-6">
    {(passwordUpdated || prefsSaved || prefsError || pinnedSaved || pinnedError || quietSaved || quietCleared) && (
      <div>
      {passwordUpdated && (
        <p class="alert-success mt-0 mb-0" role="status">Password updated.</p>
      )}
      {prefsSaved && (
        <p class="alert-success mt-0 mb-0" role="status">Display preferences saved.</p>
      )}
      {prefsError && (
        <p class="alert-warning mt-0 mb-0" role="alert">Could not save display preferences.</p>
      )}
      {pinnedSaved && (
        <p class="alert-success mt-0 mb-0" role="status">Pinned metrics saved.</p>
      )}
      {pinnedError && (
        <p class="alert-warning mt-0 mb-0" role="alert">Could not save pinned metrics.</p>
      )}
      {(quietSaved || quietCleared) && (
        <p class="alert-success mt-0 mb-0" role="status">
          {quietCleared ? "Recommendations shown again." : "Overview recommendations hidden for 7 days."}
        </p>
      )}
      </div>
    )}

    <DisplayPreferences preferences={preferences} redirectTo="/dashboard/settings" />

    <div id="dashboard-comfort">
      <DashboardComfortCard
        pinnedMetrics={pinnedMetrics}
        quietUntil={quietUntil}
        quietActive={quietActive}
        forceSimpleNote={forceSimpleNote}
      />
    </div>

    <PwaInstallCard />

    <DashboardCard>
      <h2 class="card-title">Getting started checklist</h2>
      <p class="card-subtitle mb-3">
        {onboardingDismissed
          ? "The overview checklist is currently hidden."
          : "The overview checklist shows until setup is complete."}
      </p>
      <form action="/api/user/onboarding" method="post">
        <input type="hidden" name="action" value={onboardingDismissed ? "reset" : "dismiss"} />
        <input type="hidden" name="redirect" value="/dashboard/settings" />
        <button type="submit" class="btn-secondary">
          {onboardingDismissed ? "Show checklist on overview" : "Hide checklist on overview"}
        </button>
      </form>
    </DashboardCard>

    <details class="card">
      <summary class="card-title cursor-pointer">Advanced account</summary>
      <p class="card-subtitle mb-4">
        MFA, data retention, tenant relay, and account deletion: leave these alone unless you need them.
      </p>

      <div class="space-y-6">
        <AccountSecurity />

        <AccountLifecycle
          userEmail={user.email ?? "your account"}
          dataRetentionDays={alertSettings.dataRetentionDays}
          historyDays={entitlements.historyDays}
          tierLabel={planLabel}
          canCustomizeRetention={entitlements.historyDays >= 90}
          hasPasswordAuth={
            (user.identities?.some((identity) => identity.provider === "email") ??
              Boolean(user.email))
          }
          deleteError={deleteError}
        />

        {retentionSaved && (
          <p class="alert-success" role="status">Retention preference saved.</p>
        )}

        {tenantSaved && (
          <p class="alert-success" role="status">Tenant contact saved.</p>
        )}
        {tenantError && (
          <p class="alert-warning" role="alert">
            {tenantError === "1" ? "Could not save tenant contact." : decodeURIComponent(tenantError)}
          </p>
        )}

        {household.householdId && (
          <TenantRelayCard
            canEdit={canEdit}
            settings={tenantNotify}
            householdId={household.householdId}
          />
        )}
      </div>
    </details>
  </div>
</DashboardLayout>
