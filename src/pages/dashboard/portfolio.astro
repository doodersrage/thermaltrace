---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardCard from "../../components/dashboard/DashboardCard.astro";
import ReadingAgeBadge from "../../components/dashboard/ReadingAgeBadge.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { fetchCrossPropertySnapshots } from "../../lib/crossProperty";
import { getUserEntitlements } from "../../lib/entitlements";
import { attachPropertyHealth } from "../../lib/portfolioHealth";
import {
  PORTFOLIO_SORT_OPTIONS,
  applyPortfolioListQuery,
  parsePortfolioListQuery,
  portfolioListQueryString,
} from "../../lib/portfolioList";

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

const entitlements = shell
  ? shell.entitlements
  : await getUserEntitlements(user.id);
const { properties, error } = entitlements.canUsePortfolio
  ? await fetchCrossPropertySnapshots(user.id)
  : { properties: [], error: null as string | null };
const withHealth = attachPropertyHealth(properties);
const atRisk = withHealth.filter((p) => p.atRisk);
const floodWet = withHealth.filter((p) => p.floodWet);
const coldest = [...withHealth]
  .filter((p) => p.minTempF != null)
  .sort((a, b) => (a.minTempF ?? 999) - (b.minTempF ?? 999))
  .slice(0, 5);
const avgHealth =
  withHealth.length > 0
    ? Math.round(withHealth.reduce((sum, p) => sum + p.health.score, 0) / withHealth.length)
    : null;

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const listQuery = parsePortfolioListQuery(Astro.url.searchParams);
const queryString = (page?: number) =>
  portfolioListQueryString({ ...listQuery, page });
const listPath = `/dashboard/portfolio${queryString()}`;

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect(`/dashboard/portfolio${queryString(1)}`);
}

const listed = applyPortfolioListQuery(withHealth, listQuery, pageParam);
if (listed.totalPages > 0 && pageParam > listed.totalPages) {
  return Astro.redirect(`/dashboard/portfolio${queryString(listed.totalPages)}`);
}

const hasFilters = Boolean(
  listQuery.search || listQuery.status || listQuery.sort !== "name_asc",
);
const showingFrom =
  listed.totalCount === 0 ? 0 : (listed.page - 1) * listed.pageSize + 1;
const showingTo =
  listed.totalCount === 0
    ? 0
    : Math.min(listed.page * listed.pageSize, listed.totalCount);
const prevPage = listed.page > 1 ? listed.page - 1 : null;
const nextPage = listed.page < listed.totalPages ? listed.page + 1 : null;

const flash = Astro.url.searchParams;
const vacationFlash = flash.get("portfolio_vacation") === "1";
const vacationCleared = flash.get("portfolio_vacation_cleared") === "1";
const vacationDays = flash.get("days");
const vacationProperties = flash.get("properties");
const viewMode = Astro.url.searchParams.get("view") === "heatmap" ? "heatmap" : "list";
---
<DashboardLayout title="Portfolio">
  <div class="space-y-6">
    {!entitlements.canUsePortfolio ? (
      <UpgradeNudge feature="multi_property" tier={entitlements.tier} />
    ) : entitlements.tier === "pro" ? (
      <UpgradeNudge feature="portfolio_scale" tier={entitlements.tier} />
    ) : null}
    <section class="card">
      <h2 class="card-title">All properties</h2>
      <p class="card-subtitle mb-0">
        Cross-property freeze and flood risk at a glance
        {!entitlements.canUsePortfolio
          ? ": upgrade to Pro to unlock portfolio view and alerts"
          : entitlements.tier === "pro"
            ? ". Portfolio raises the property ceiling and adds property-manager logins"
            : ""}.
      </p>
      {error && <p class="alert-warning mt-3" role="alert">{error}</p>}
      {vacationFlash && (
        <p class="alert-success mt-3" role="status">
          Vacation mode set for {vacationDays ?? "7"} days across {vacationProperties ?? "your"} editable propert{(vacationProperties === "1") ? "y" : "ies"}.
        </p>
      )}
      {vacationCleared && (
        <p class="alert-success mt-3" role="status">
          Vacation cleared across {vacationProperties ?? "your"} editable propert{(vacationProperties === "1") ? "y" : "ies"}.
        </p>
      )}
      {entitlements.canUsePortfolio && withHealth.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          <a
            class:list={["btn-ghost btn-sm", viewMode === "list" && "font-semibold"]}
            href={`/dashboard/portfolio${portfolioListQueryString({ ...listQuery, page: 1 })}`}
          >
            List
          </a>
          <a
            class:list={["btn-ghost btn-sm", viewMode === "heatmap" && "font-semibold"]}
            href={`/dashboard/portfolio${(() => {
              const base = portfolioListQueryString({ ...listQuery, page: 1 });
              return base ? `${base}&view=heatmap` : "?view=heatmap";
            })()}`}
          >
            Heatmap
          </a>
        </div>
      )}
    </section>

    {entitlements.canUsePortfolio && withHealth.length > 0 && (
      <DashboardCard>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="card-title">Portfolio health</h2>
            <p class="card-subtitle mb-0">
              Average score {avgHealth}% · {atRisk.length} at freeze/flood risk
              {floodWet.length > 0 ? ` · ${floodWet.length} wet` : ""} · coldest listed below
            </p>
          </div>
        </div>
        {coldest.length > 0 && (
          <ul class="m-0 mt-3 p-0 list-none space-y-1 text-sm">
            {coldest.map((p) => (
              <li>
                <strong>{p.name}</strong>
                {": "}
                {p.minTempF != null ? `${p.minTempF.toFixed(1)}°F` : "—"}
                {" · "}
                <span class="text-[var(--color-text-muted)]">{p.health.detail}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-4 flex flex-wrap gap-2 items-end">
          <form action="/api/user/portfolio-vacation" method="post" class="flex flex-wrap gap-2 items-end">
            <input type="hidden" name="action" value="vacation" />
            <input type="hidden" name="redirect" value={listPath} />
            <div class="form-field mb-0">
              <label class="form-label" for="portfolio-vacation-days">Bulk vacation (days)</label>
              <input
                class="form-input w-24"
                id="portfolio-vacation-days"
                name="days"
                type="number"
                min="1"
                max="90"
                value="7"
              />
            </div>
            <div class="form-field mb-0">
              <label class="form-label" for="portfolio-vacation-until">Or until date</label>
              <input
                class="form-input"
                id="portfolio-vacation-until"
                name="until"
                type="date"
                min={new Date().toISOString().slice(0, 10)}
              />
            </div>
            <button class="btn-secondary" type="submit">Mute all properties</button>
          </form>
          <form action="/api/user/portfolio-vacation" method="post">
            <input type="hidden" name="action" value="clear_vacation" />
            <input type="hidden" name="redirect" value={listPath} />
            <button class="btn-ghost" type="submit">Clear vacation everywhere</button>
          </form>
        </div>
        <p class="mt-2 mb-0 text-xs text-[var(--color-text-muted)]">
          Bulk vacation applies to every property you can edit. Forecast / NWS / flood alerts still deliver during vacation.
          Toggle the coldest-properties digest under
          <a class="text-link" href="/dashboard/alerts#alert-section-essentials">Alerts → Essentials</a>.
        </p>
      </DashboardCard>
    )}

    {atRisk.length > 0 && (
      <DashboardCard>
        <h2 class="card-title text-[var(--color-warning)]">
          {atRisk.length} propert{atRisk.length === 1 ? "y" : "ies"} at freeze or flood risk today
        </h2>
        <p class="card-subtitle mb-3">
          Portfolio digest emails fire when properties cross freeze: toggle under
          <a class="text-link" href="/dashboard/alerts#alert-section-essentials">Alerts → Essentials</a>.
          Flood/leak wet contacts auto-alert per property (bypass vacation).
        </p>
        <ul class="m-0 p-0 list-none space-y-2">
          {atRisk.map((p) => (
            <li class="text-sm">
              <strong>{p.name}</strong>
              {p.floodWet
                ? ": flood/leak wet"
                : `: ${p.minTempF?.toFixed(1)}°F (threshold ${p.freezeThresholdF}°F)`}
            </li>
          ))}
        </ul>
      </DashboardCard>
    )}

    <DashboardCard>
      {entitlements.canUsePortfolio ? (
      <>
      {properties.length <= 1 && (
        <div class="mb-4">
          <h3 class="card-title text-base">Add another property</h3>
          <p class="card-subtitle mb-3">
            Portfolio is most useful with two or more households. Create a second property (rental,
            vacation home, workshop) under Household, then switch between them here.
          </p>
          <a class="btn-secondary" href="/dashboard/household">Add property on Household</a>
        </div>
      )}
      {properties.length === 0 ? (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          No properties in this portfolio yet, open Household to create or join one.
        </p>
      ) : (
      <>
      <form class="history-filters" method="get" action="/dashboard/portfolio">
        {viewMode === "heatmap" && <input type="hidden" name="view" value="heatmap" />}
        <div class="form-field mb-0">
          <label class="form-label" for="portfolio-search">Search</label>
          <input
            class="form-input"
            type="search"
            id="portfolio-search"
            name="q"
            value={listQuery.search}
            placeholder="Property name or id"
          />
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="portfolio-status">Status</label>
          <select class="form-input" id="portfolio-status" name="status">
            <option value="" selected={listQuery.status === ""}>All statuses</option>
            <option value="at_risk" selected={listQuery.status === "at_risk"}>At risk</option>
            <option value="wet" selected={listQuery.status === "wet"}>Wet flood/leak</option>
            <option value="watch" selected={listQuery.status === "watch"}>Watch</option>
            <option value="healthy" selected={listQuery.status === "healthy"}>Healthy</option>
            <option value="offline" selected={listQuery.status === "offline"}>Offline</option>
          </select>
        </div>
        <div class="form-field mb-0">
          <label class="form-label" for="portfolio-sort">Sort</label>
          <select class="form-input" id="portfolio-sort" name="sort">
            {PORTFOLIO_SORT_OPTIONS.map((opt) => (
              <option value={opt.value} selected={listQuery.sort === opt.value}>
                {opt.label}
              </option>
            ))}
          </select>
        </div>
        <button type="submit" class="btn-secondary self-end">Apply</button>
        {hasFilters && (
          <a class="btn-ghost self-end" href="/dashboard/portfolio">Clear</a>
        )}
      </form>
      <p class="preference-hint mb-4">
        Health summary above stays portfolio-wide. This table filters and sorts the property list.
      </p>
      {listed.rows.length === 0 ? (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          {hasFilters
            ? "No properties match these filters."
            : "No properties in this portfolio yet."}
        </p>
      ) : (
      <>
      {viewMode === "heatmap" && (
        <div class="portfolio-heatmap mb-4" role="list">
          {listed.rows.map((p) => {
            const tone =
              p.health.label === "healthy"
                ? "healthy"
                : p.health.label === "watch"
                  ? "watch"
                  : p.health.label === "offline"
                    ? "offline"
                    : "risk";
            return (
              <a
                class:list={["portfolio-heatmap-cell", `portfolio-heatmap-cell--${tone}`]}
                href={`/dashboard?household=${p.householdId}`}
                role="listitem"
                title={`${p.name}: ${p.health.score}% · ${p.health.detail}`}
              >
                <span class="portfolio-heatmap-name">{p.name}</span>
                <span class="portfolio-heatmap-score">{p.health.score}%</span>
                <span class="portfolio-heatmap-meta">
                  {p.minTempF != null ? `${p.minTempF.toFixed(0)}°F` : "—"}
                  {p.floodWet ? " · wet" : ""}
                </span>
              </a>
            );
          })}
        </div>
      )}
      <div class:list={["overflow-x-auto portfolio-list-desktop", viewMode === "heatmap" && "hidden"]}>
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th class="text-left py-2">Property</th>
              <th class="text-left py-2">Role</th>
              <th class="text-left py-2">Health</th>
              <th class="text-left py-2">Min temp</th>
              <th class="text-left py-2">Devices</th>
              <th class="text-left py-2">Last reading</th>
            </tr>
          </thead>
          <tbody>
            {listed.rows.map((p) => (
              <tr class="border-t border-[var(--color-border)]">
                <td class="py-2">
                  <form action="/api/household/switch" method="post" class="inline">
                    <input type="hidden" name="household_id" value={p.householdId} />
                    <input type="hidden" name="redirect" value="/dashboard" />
                    <button type="submit" class="text-link">{p.name}</button>
                  </form>
                  {p.atRisk && (
                    <span class="ml-2 text-xs text-[var(--color-warning)]">
                      {p.floodWet ? "Wet" : "At risk"}
                    </span>
                  )}
                </td>
                <td class="py-2 capitalize">{p.role.replace("_", " ")}</td>
                <td class="py-2">
                  <span
                    class:list={[
                      "font-medium",
                      p.health.label === "healthy" && "text-[var(--color-success)]",
                      p.health.label === "watch" && "text-[var(--color-warning)]",
                      (p.health.label === "at_risk" || p.health.label === "offline") &&
                        "text-[var(--color-danger)]",
                    ]}
                  >
                    {p.health.score}%
                  </span>
                  <span class="block text-xs text-[var(--color-text-muted)]">{p.health.detail}</span>
                </td>
                <td class="py-2">
                  {p.minTempF != null ? `${p.minTempF.toFixed(1)}°F` : "—"}
                </td>
                <td class="py-2">{p.deviceCount}</td>
                <td class="py-2">
                  <ReadingAgeBadge iso={p.lastReadingAt} emptyLabel="—" />
                  {p.lastReadingAt && (
                    <span class="block text-xs text-[var(--color-text-muted)] mt-1">
                      {new Date(p.lastReadingAt).toLocaleString()}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class:list={["portfolio-list-mobile space-y-3", viewMode === "heatmap" && "hidden"]}>
        {listed.rows.map((p) => (
          <article class="rounded-lg border border-[var(--color-border)] p-3 text-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <form action="/api/household/switch" method="post" class="inline">
                <input type="hidden" name="household_id" value={p.householdId} />
                <input type="hidden" name="redirect" value="/dashboard" />
                <button type="submit" class="text-link font-semibold">{p.name}</button>
              </form>
              <span
                class:list={[
                  "font-medium",
                  p.health.label === "healthy" && "text-[var(--color-success)]",
                  p.health.label === "watch" && "text-[var(--color-warning)]",
                  (p.health.label === "at_risk" || p.health.label === "offline") &&
                    "text-[var(--color-danger)]",
                ]}
              >
                {p.health.score}%
              </span>
            </div>
            <p class="m-0 mt-1 text-xs text-[var(--color-text-muted)]">
              {p.role.replace("_", " ")}
              {" · "}
              {p.minTempF != null ? `${p.minTempF.toFixed(1)}°F` : "no temp"}
              {" · "}
              {p.deviceCount} device{p.deviceCount === 1 ? "" : "s"}
              {p.atRisk ? (p.floodWet ? " · wet" : " · at risk") : ""}
            </p>
            <p class="m-0 mt-2 text-xs text-[var(--color-text-muted)]">{p.health.detail}</p>
            <p class="m-0 mt-2">
              <ReadingAgeBadge iso={p.lastReadingAt} emptyLabel="No readings" />
            </p>
          </article>
        ))}
      </div>
      <div class="pagination">
        <p class="pagination-summary">
          Showing {showingFrom}–{showingTo} of {listed.totalCount} properties
        </p>
        <div class="pagination-controls">
          {prevPage ? (
            <a class="btn-secondary" href={`/dashboard/portfolio${queryString(prevPage)}`}>Previous</a>
          ) : (
            <span class="btn-secondary pagination-disabled">Previous</span>
          )}
          <span class="pagination-current">
            Page {listed.page} of {Math.max(listed.totalPages, 1)}
          </span>
          {nextPage ? (
            <a class="btn-secondary" href={`/dashboard/portfolio${queryString(nextPage)}`}>Next</a>
          ) : (
            <span class="btn-secondary pagination-disabled">Next</span>
          )}
        </div>
      </div>
      </>
      )}
      </>
      )}
      </>
      ) : (
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          Portfolio view shows freeze risk across all your properties. Available on Pro.
        </p>
      )}
    </DashboardCard>
  </div>
</DashboardLayout>

<style>
  .portfolio-heatmap {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }

  .portfolio-heatmap-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    min-height: 5.5rem;
  }

  .portfolio-heatmap-cell--healthy {
    background: color-mix(in srgb, var(--color-success, #16a34a) 18%, transparent);
  }

  .portfolio-heatmap-cell--watch {
    background: color-mix(in srgb, var(--color-warning, #d97706) 22%, transparent);
  }

  .portfolio-heatmap-cell--risk {
    background: color-mix(in srgb, var(--color-danger, #dc2626) 22%, transparent);
  }

  .portfolio-heatmap-cell--offline {
    background: color-mix(in srgb, var(--color-text-muted) 14%, transparent);
  }

  .portfolio-heatmap-name {
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .portfolio-heatmap-score {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .portfolio-heatmap-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .portfolio-list-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .portfolio-list-mobile {
      display: none;
    }

    .portfolio-list-desktop {
      display: block;
    }
  }
</style>

<script>
  const flashKeys = [
    "portfolio_vacation",
    "portfolio_vacation_cleared",
    "days",
    "properties",
  ];
  const url = new URL(window.location.href);
  let changed = false;
  for (const key of flashKeys) {
    if (url.searchParams.has(key)) {
      url.searchParams.delete(key);
      changed = true;
    }
  }
  if (changed) {
    window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
  }
</script>
