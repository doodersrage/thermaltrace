---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import { listRecentJobRuns } from "../../lib/jobRuns";
import { listRecentIngestStatsAdmin } from "../../lib/ingestStats";
import { flagIngestAbuse } from "../../lib/ingestAbuse";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

// Gate before admin-only fetches -- this page had no auth check of its
// own at all, relying entirely on DashboardLayout's requireAdmin, which
// runs too late to stop the frontmatter below from already having
// queried job-run and ingest-abuse data (Astro.redirect() from a nested
// layout isn't a reliable way to abort a page's response; see ops.astro).
if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const { runs, error } = await listRecentJobRuns(40);
const ingestStats = await listRecentIngestStatsAdmin(7);
const ingestAbuse = flagIngestAbuse(ingestStats);
---
<DashboardLayout title="Jobs" subtitle="Cron history, digests, and ingest abuse watch." requireAdmin={true}>
  <div class="space-y-6">
    <AdminNav />
    <section class="card">
      <h2 class="card-title">Ingest abuse watch</h2>
      <p class="card-subtitle mb-4">Devices with ≥50% ingest errors over the last 7 days (minimum 5 posts).</p>
      {ingestAbuse.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">No suspicious ingest patterns right now.</p>
      ) : (
        <ul class="space-y-2 text-sm mb-0">
          {ingestAbuse.slice(0, 10).map((row) => (
            <li>
              <strong>{row.device_name}</strong> on {row.day}: {row.error_count} errors / {row.total} total (
              {Math.round(row.errorRate * 100)}%)
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Job runs</h2>
      {error ? (
        <p class="alert-warning">Unable to load job runs: {error}</p>
      ) : runs.length === 0 ? (
        <p class="mb-0">No job runs recorded yet. They appear after the first scheduled poll (every 15 minutes).</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Started</th>
                <th>Job</th>
                <th>Status</th>
                <th>Finished</th>
                <th>Detail</th>
              </tr>
            </thead>
            <tbody>
              {runs.map((run) => (
                <tr>
                  <td>{new Date(run.started_at).toLocaleString()}</td>
                  <td>{run.job_name}</td>
                  <td>
                    <span class={run.status === "success" ? "feed-health-ok" : run.status === "error" ? "feed-health-error" : ""}>
                      {run.status}
                    </span>
                  </td>
                  <td>{run.finished_at ? new Date(run.finished_at).toLocaleString() : "—"}</td>
                  <td class="contact-message-cell">
                    <code>{JSON.stringify(run.detail)}</code>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
