---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import { fetchCheckoutAnalyticsAdmin } from "../../lib/checkoutAnalytics";
import { fetchAppStatus } from "../../lib/appStatus";
import { fetchReferralAdminStats } from "../../lib/referrals";
import { listRecentServerErrors } from "../../lib/serverErrors";
import { auditStripeDisplayPrices } from "../../lib/stripePriceAudit";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";
import { isTwilioConfigured } from "../../lib/notify";
import { isVapidConfigured, countPushSubscriptions } from "../../lib/webPush";
import { getFcmConfigStatus } from "../../lib/fcm";
import { channelTestErrorMessage } from "../../lib/alertChannelLabels";

const { session, user } = await getAuthFromCookies(Astro.cookies);
if (!session || !user) {
  return Astro.redirect("/signin");
}

// Gate before admin-only fetches — otherwise non-admins can hit a blank 200.
if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const emailTestOk = Astro.url.searchParams.get("email_test") === "1";
const channelTestOk = Astro.url.searchParams.get("channel_test") === "1";
const channelKind = Astro.url.searchParams.get("channel_kind");
const channelError = channelTestErrorMessage(
  Astro.url.searchParams.get("channel_error"),
);
const twilioConfigured = isTwilioConfigured();
const vapidConfigured = isVapidConfigured();
const fcmStatus = getFcmConfigStatus();
const pushSubscriptionCount = await countPushSubscriptions(user.id);

const [checkout, status, referrals, serverErrors, priceAudit] = await Promise.all([
  fetchCheckoutAnalyticsAdmin(30, 30),
  fetchAppStatus(),
  fetchReferralAdminStats(),
  listRecentServerErrors(15),
  auditStripeDisplayPrices(),
]);

function sourceLabel(source: string): string {
  if (source === "direct") return "Direct / pricing";
  if (source.startsWith("nudge_")) return source.replace("nudge_", "").replace(/_/g, " ");
  return source;
}

function formatUsd(amount: number | null): string {
  if (amount == null) return "—";
  return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(amount);
}

const priceMismatches = priceAudit.rows.filter((row) => row.match === false);
const opsDiscordConfigured = Boolean(
  import.meta.env.OPS_DISCORD_WEBHOOK_URL?.trim() ||
    import.meta.env.DISCORD_OPS_WEBHOOK_URL?.trim(),
);
---
<DashboardLayout title="Ops" subtitle="Health, checkout funnel, pricing audit, and email tests." requireAdmin>
  <div class="space-y-6">
    <AdminNav />
    <section class="card animate-slide-in-left">
      <h2 class="card-title">Ops & conversion</h2>
      <p class="card-subtitle mb-0">{user.email}: health, checkout funnel, pricing audit, and email tests.</p>
      {emailTestOk && (
        <p class="alert-success mt-4 mb-0" role="status">Test email sent to {user.email}.</p>
      )}
      {channelTestOk && (
        <p class="alert-success mt-4 mb-0" role="status">
          {channelKind === "push"
            ? "Browser push smoke test delivered."
            : channelKind === "sms"
              ? "SMS smoke test delivered."
              : "Channel smoke test succeeded."}
        </p>
      )}
      {channelError && (
        <p class="alert-warning mt-4 mb-0" role="alert">
          Channel smoke test failed: {channelError}.
          {Astro.url.searchParams.get("channel_error") === "push_no_subscription" && (
            <>
              {" "}
              Open{" "}
              <a class="text-link" href="/dashboard/alerts?tab=settings#alert-section-channels">
                Alerts → Channels → Push
              </a>
              , click <strong>Enable browser push on this device</strong>, allow notifications, save
              if needed, then retry.
            </>
          )}
        </p>
      )}
      {priceMismatches.length > 0 && (
        <p class="alert-warning mt-4 mb-0" role="alert">
          {priceMismatches.length} Stripe display price(s) do not match live Stripe amounts: update Worker `STRIPE_DISPLAY_*` secrets.
        </p>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Weekly checklist</h2>
      <ol class="text-sm space-y-2 mb-0 list-decimal pl-5">
        <li>Scan <strong>Platform health</strong> and recent page errors below.</li>
        <li>Confirm Stripe display audit shows Match for all four prices.</li>
        <li>Review checkout funnel sources: double down on winning nudges.</li>
        <li>Send one drip/trial email smoke test after template changes.</li>
        <li>
          Verify Twilio + VAPID secrets
          {twilioConfigured ? (
            <> · Twilio configured</>
          ) : (
            <>
              {" · "}
              <a class="text-link" href="https://console.twilio.com/" target="_blank" rel="noreferrer">
                Add `TWILIO_*` in `.env`
              </a>
              {" then "}
              <code>pnpm secrets:push</code>
            </>
          )}
          {vapidConfigured ? " · VAPID configured" : " · set `VAPID_*` (run `pnpm generate:vapid`)"}.
        </li>
        <li>
          After deploy: <code>pnpm ops:smoke</code> and submit{" "}
          <a class="text-link" href="https://search.google.com/search-console" target="_blank" rel="noreferrer">
            sitemap in Search Console
          </a>
          .
        </li>
        <li>
          Ops notify: email uses `SMTP_MAIL_TO`
          {opsDiscordConfigured ? " · Discord webhook configured" : " · set optional `OPS_DISCORD_WEBHOOK_URL` for Discord"}.
        </li>
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">Platform health</h2>
      <div class="stat-grid mb-4">
        <article class="stat-item">
          <span class="stat-label">Status</span>
          <p class:list={["stat-value text-base", status.healthy ? "text-[var(--color-success)]" : "text-[var(--color-danger)]"]}>
            {status.healthy ? "Healthy" : "Degraded"}
          </p>
        </article>
        <article class="stat-item">
          <span class="stat-label">Job errors (24h)</span>
          <p class="stat-value">{status.recentJobErrors}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">Ingest abuse flags</span>
          <p class="stat-value">{status.ingestAbuseCount}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">Page errors (recent)</span>
          <p class="stat-value">{serverErrors.length}</p>
        </article>
      </div>
      <p class="mb-0 text-sm">
        <a class="text-link" href="/system-status">Public status page</a>
        {" · "}
        <a class="text-link" href="/dashboard/jobs">Job history</a>
      </p>
    </section>

    {serverErrors.length > 0 && (
      <section class="card">
        <h2 class="card-title">Recent page errors</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">When</th>
                <th class="py-2 pr-3">Path</th>
                <th class="py-2">Message</th>
              </tr>
            </thead>
            <tbody>
              {serverErrors.map((row) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3 whitespace-nowrap">{new Date(row.created_at).toLocaleString()}</td>
                  <td class="py-2 pr-3 font-mono text-xs">{row.method} {row.path}</td>
                  <td class="py-2" title={row.stack ?? undefined}>{row.message}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">Stripe display price audit</h2>
      <p class="card-subtitle mb-4">Compare Worker display env vars with live Stripe price amounts.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[var(--color-text-muted)]">
              <th class="py-2 pr-3">Plan</th>
              <th class="py-2 pr-3">Interval</th>
              <th class="py-2 pr-3">Display env</th>
              <th class="py-2 pr-3">Stripe API</th>
              <th class="py-2">Match</th>
            </tr>
          </thead>
          <tbody>
            {priceAudit.rows.map((row) => (
              <tr class="border-t border-[var(--color-border)]">
                <td class="py-2 pr-3 capitalize">{row.plan}</td>
                <td class="py-2 pr-3">{row.interval}</td>
                <td class="py-2 pr-3">{formatUsd(row.displayAmountUsd)}</td>
                <td class="py-2 pr-3">{formatUsd(row.stripeAmountUsd)}</td>
                <td class="py-2">
                  {row.match == null ? "—" : row.match ? "✓" : "Mismatch"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Referrals</h2>
      <div class="stat-grid mb-0">
        <article class="stat-item">
          <span class="stat-label">Total signups</span>
          <p class="stat-value">{referrals.totalSignups}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">Rewards granted</span>
          <p class="stat-value">{referrals.rewardedSignups}</p>
        </article>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Email smoke tests</h2>
      <p class="card-subtitle mb-4">Send sample drip/trial templates to your admin email ({user.email}).</p>
      <div class="flex flex-wrap gap-2">
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="drip_day1" />
          <button class="btn-secondary" type="submit">Test drip day 1</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="drip_day3" />
          <button class="btn-secondary" type="submit">Test drip day 3</button>
        </form>
        <form action="/api/admin/email-test" method="post">
          <input type="hidden" name="kind" value="trial_3d" />
          <button class="btn-secondary" type="submit">Test trial reminder</button>
        </form>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Channel smoke tests</h2>
      <p class="card-subtitle mb-4">
        Confirm Pro alert channels are wired. Twilio:
        <strong>{twilioConfigured ? "configured" : "not configured"}</strong>
        {" · "}
        VAPID:
        <strong>{vapidConfigured ? "configured" : "not configured"}</strong>
        {" · "}
        FCM:
        <strong>
          {fcmStatus === "configured"
            ? "configured"
            : fcmStatus === "invalid"
              ? "invalid JSON"
              : "not configured"}
        </strong>
        {fcmStatus === "invalid" && (
          <>
            {" "}
            (secret is set but not parseable — re-run <code>pnpm secrets:push</code> after the
            dotenv unquote fix)
          </>
        )}
        .
      </p>
      <div class="flex flex-wrap gap-4 items-end">
        <form action="/api/admin/channel-test" method="post" class="flex flex-wrap gap-2 items-end">
          <input type="hidden" name="kind" value="sms" />
          <div class="form-field mb-0">
            <label class="form-label" for="channel-test-phone">SMS phone (optional override)</label>
            <input
              class="form-input"
              id="channel-test-phone"
              name="phone"
              type="tel"
              placeholder="+15551234567"
              disabled={!twilioConfigured}
            />
          </div>
          <button class="btn-secondary" type="submit" disabled={!twilioConfigured}>
            Test SMS
          </button>
        </form>
        <form action="/api/admin/channel-test" method="post">
          <input type="hidden" name="kind" value="push" />
          <button class="btn-secondary" type="submit" disabled={!vapidConfigured}>
            Test browser push
          </button>
        </form>
      </div>
      <p class="form-hint mt-3 mb-0">
        SMS uses your alert phone if the override is blank. Browser push:
        {pushSubscriptionCount > 0
          ? ` ${pushSubscriptionCount} subscription(s) saved for your account.`
          : " this browser is not subscribed yet."}
        {" "}
        Enable under{" "}
        <a class="text-link" href="/dashboard/alerts?tab=settings#alert-section-channels">Alerts → Push</a>
        {" "}
        first. Android FCM tokens register from the native app when FCM secrets are set.
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Checkout funnel (30 days)</h2>
      <p class="card-subtitle mb-4">Stripe checkout sessions started: includes upgrade nudge sources.</p>
      <div class="stat-grid mb-4">
        <article class="stat-item">
          <span class="stat-label">Checkouts started</span>
          <p class="stat-value">{checkout.last30Days}</p>
        </article>
        <article class="stat-item">
          <span class="stat-label">All time (last 500 logged)</span>
          <p class="stat-value">{checkout.totalCheckouts}</p>
        </article>
      </div>

      <div class="grid gap-6 lg:grid-cols-2 mb-4">
        <div>
          <h3 class="text-sm font-semibold mb-2">By source</h3>
          {checkout.bySource.length === 0 ? (
            <p class="text-sm text-[var(--color-text-muted)] mb-0">No checkout events yet.</p>
          ) : (
            <ul class="text-sm space-y-1 mb-0">
              {checkout.bySource.map((row) => (
                <li class="flex justify-between gap-2">
                  <span>{sourceLabel(row.source)}</span>
                  <strong>{row.count}</strong>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div>
          <h3 class="text-sm font-semibold mb-2">By plan</h3>
          {checkout.byPlan.length === 0 ? (
            <p class="text-sm text-[var(--color-text-muted)] mb-0">No checkout events yet.</p>
          ) : (
            <ul class="text-sm space-y-1 mb-0">
              {checkout.byPlan.map((row) => (
                <li class="flex justify-between gap-2">
                  <span class="capitalize">{row.plan}</span>
                  <strong>{row.count}</strong>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      {checkout.recent.length > 0 && (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">When</th>
                <th class="py-2 pr-3">Plan</th>
                <th class="py-2 pr-3">Interval</th>
                <th class="py-2">Source</th>
              </tr>
            </thead>
            <tbody>
              {checkout.recent.map((row) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3 whitespace-nowrap">{new Date(row.createdAt).toLocaleString()}</td>
                  <td class="py-2 pr-3 capitalize">{row.plan}</td>
                  <td class="py-2 pr-3">{row.interval}</td>
                  <td class="py-2">{row.source ? sourceLabel(row.source) : "Direct"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
