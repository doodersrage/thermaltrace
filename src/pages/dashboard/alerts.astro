---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AlertSettings from "../../components/AlertSettings.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import PwaInstallCard from "../../components/dashboard/PwaInstallCard.astro";
import ProductAnalyticsTracker from "../../components/ProductAnalyticsTracker.astro";
import ReferralCard from "../../components/ReferralCard.astro";
import FalseAlarmTipsCard from "../../components/dashboard/FalseAlarmTipsCard.astro";
import AlertActivityList from "../../components/dashboard/AlertActivityList.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { resolveSiteUrl } from "../../lib/schemaMarkup";
import {
  ensureAlertDeliveryEvidence,
  getAlertSettingsForUser,
  isTwilioConfigured,
} from "../../lib/notify";
import { getRuntimeEnv } from "../../lib/runtimeEnv";
import { getUserEntitlements } from "../../lib/entitlements";
import { listRecentAlertEventsFiltered } from "../../lib/alertEvents";
import { formatAlertChannelsCsv } from "../../lib/alertChannelLabels";
import { formatRelativeAge } from "../../lib/relativeTime";
import {
  getOrCreateHouseholdForUser,
  getUserHouseholdRole,
  canEditHousehold,
} from "../../lib/households";
import { listHouseholdDevices } from "../../lib/devices";
import { getTenantNotifySettings } from "../../lib/tenantRelay";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const household = await getOrCreateHouseholdForUser(user.id, user.email);
const householdRole = household.householdId
  ? await getUserHouseholdRole(user.id, household.householdId)
  : null;
const canEdit = canEditHousehold(householdRole);

const activityPage = Math.max(1, Number(Astro.url.searchParams.get("activity_page") ?? "1") || 1);
const activityKind = Astro.url.searchParams.get("activity_kind")?.trim() ?? "";
const activityUnacked = Astro.url.searchParams.get("activity_unacked") === "1";
const activityPageSize = 20;
const activityOffset = (activityPage - 1) * activityPageSize;

const [alertSettingsLoaded, entitlements, activityPageResult, devicesResult, tenantNotify] =
  await Promise.all([
    getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
    getUserEntitlements(user.id),
    listRecentAlertEventsFiltered(user.id, {
      limit: activityPageSize,
      offset: activityOffset,
      kind: activityKind || null,
      unackedOnly: activityUnacked,
    }),
    household.householdId
      ? listHouseholdDevices(household.householdId)
      : Promise.resolve({ devices: [] as Awaited<ReturnType<typeof listHouseholdDevices>>["devices"], error: null }),
    household.householdId
      ? getTenantNotifySettings(household.householdId)
      : Promise.resolve({ email: null, name: null }),
  ]);

const recentEvents = activityPageResult.events;
const activityHasMore = activityPageResult.hasMore;

const { settings: alertSettings } = await ensureAlertDeliveryEvidence(
  user.id,
  alertSettingsLoaded,
);

const hasTenantRelay = Boolean(tenantNotify.email);
const hasOutboundWebhook = Boolean(alertSettings.outboundWebhookUrl?.trim());

const deviceSpaces = [
  ...new Set(
    (devicesResult.devices ?? [])
      .map((device) => device.space?.trim())
      .filter((space): space is string => Boolean(space)),
  ),
].sort((a, b) => a.localeCompare(b));

const thresholdSensors = (devicesResult.devices ?? []).flatMap((device) =>
  device.sensors
    .filter((sensor) => sensor.kind === "temperature")
    .map((sensor) => ({
      id: sensor.id,
      label: sensor.label,
      deviceName: device.name,
      space: device.space ?? null,
    })),
);

const sentChannels = formatAlertChannelsCsv(Astro.url.searchParams.get("sent"));
const skippedChannels = formatAlertChannelsCsv(Astro.url.searchParams.get("skipped"));
const testReason = Astro.url.searchParams.get("test_reason");

const alertNotice = Astro.url.searchParams.get("alert_saved")
  ? Astro.url.searchParams.get("channels_incomplete")
    ? "Alert settings saved. Some enabled channels are missing a destination and will be skipped until filled in."
    : "Alert settings saved."
  : Astro.url.searchParams.get("alert_error")
    ? Astro.url.searchParams.get("alert_error") === "invalid_webhook_url"
      ? "One of your webhook URLs isn't a valid https:// address, or points to a private network. Fix it and save again."
      : Astro.url.searchParams.get("alert_error") === "weak_telegram_secret"
        ? "Telegram webhook secret must be at least 16 characters -- it's the only thing protecting that endpoint. Use a longer random value and save again."
        : "Unable to save alert settings."
    : Astro.url.searchParams.get("test_sent")
      ? skippedChannels
        ? `Test sent via ${sentChannels}. Skipped incomplete: ${skippedChannels}.`
        : `Test alert sent via ${sentChannels || "your enabled channels"}.`
      : Astro.url.searchParams.get("test_error")
        ? testReason === "incomplete"
          ? "No channels could send: enable a channel and fill in its destination, then try again."
          : testReason === "none"
            ? "No alert channels are enabled. Turn on at least one channel, save, then retry."
            : "Could not send test alert. Check channel settings and try again."
        : Astro.url.searchParams.get("ack_ok")
          ? Astro.url.searchParams.get("ack_msg") ?? "Alert marked as handled."
          : Astro.url.searchParams.get("ack_error")
            ? Astro.url.searchParams.get("ack_msg") ?? "Could not acknowledge alert."
            : null;

const alertNoticeIsError =
  Boolean(Astro.url.searchParams.get("alert_error")) ||
  Boolean(Astro.url.searchParams.get("test_error")) ||
  Boolean(Astro.url.searchParams.get("channels_incomplete"));

const needsPro =
  !entitlements.canUseSms ||
  !entitlements.canUsePush ||
  !entitlements.canUseOutboundWebhook;

const lastAlertCandidates = [
  alertSettings.lastAlertSentAt,
  alertSettings.lastOutageAlertAt,
  alertSettings.lastRateAlertAt,
  alertSettings.lastForecastAlertAt,
].filter(Boolean) as string[];
const lastAlertAt =
  lastAlertCandidates.sort((a, b) => Date.parse(b) - Date.parse(a))[0] ?? null;
const lastAlertAge = formatRelativeAge(lastAlertAt);

const analyticsEvents = (() => {
  const events: Array<{
    name: import("../../lib/productAnalytics").ProductEvent;
    props?: Record<string, string | number | boolean>;
  }> = [];
  if (Astro.url.searchParams.get("test_sent")) {
    events.push({ name: "first_alert_test" });
  }
  if (Astro.url.searchParams.get("alert_saved")) {
    events.push({ name: "alert_essentials_saved" });
  }
  return events;
})();

const testSent = Boolean(Astro.url.searchParams.get("test_sent"));

const showReferralNudge =
  canEdit &&
  !testSent &&
  (recentEvents.length > 0 || Boolean(lastAlertAt));

const showReferralCard = (testSent && canEdit) || showReferralNudge;

const primaryUpgradeFeature = testSent
  ? needsPro
    ? ("sms_alerts" as const)
    : !entitlements.canUseClaimsPack
      ? ("claims_pack" as const)
      : null
  : !entitlements.canUseForecastAlerts
    ? ("cold_risk" as const)
    : needsPro
      ? ("sms_alerts" as const)
      : null;

const siteUrl = resolveSiteUrl(Astro.site);
const referralRewardDays = Number(
  (user.app_metadata as Record<string, unknown> | undefined)?.referral_reward_days ?? 0,
);
---
<DashboardLayout title="Alerts">
  <ProductAnalyticsTracker events={analyticsEvents} />
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Alerts</h2>
      <p class="card-subtitle">
        Start with freeze °F + email under Essentials. Add more channels and rules when you need them.
      </p>
      <p class="mt-0 mb-0 text-sm text-[var(--color-text-muted)]">
        Confirm critical zones with a local reading: alerts can be delayed by sensor lag, network gaps, or channel delivery.
      </p>
      <p class="mt-0 mb-0 text-sm text-[var(--color-text-muted)]">
        Status: <strong>{alertSettings.enabled ? "On" : "Off"}</strong>
        {lastAlertAt ? (
          <>
            {" · "}Last alert {lastAlertAge.label}
            {lastAlertAge.absolute ? ` (${lastAlertAge.absolute})` : ""}
          </>
        ) : (
          <> · No alerts sent yet</>
        )}
      </p>
      {alertNotice && (
        <p class:list={[alertNoticeIsError ? "alert-warning" : "alert-success", "mt-4"]} role="status">
          {alertNotice}
        </p>
      )}
    </section>

    {testSent && (
      <section class="card alert-success">
        <h2 class="card-title">Alerts are working</h2>
        <p class="card-subtitle mb-4">
          Delivery path confirmed. A few useful next steps while you’re here:
        </p>
        <div class="flex flex-wrap gap-3 mb-0">
          {entitlements.canCreateShareLinks || entitlements.canCreateFamilyShareLink ? (
            <a class="btn-primary" href="/dashboard/share/links">Share a live link with family</a>
          ) : (
            <a class="btn-primary" href="/dashboard/share/links">Share links</a>
          )}
          <a class="btn-secondary" href="/dashboard/history?tab=exports#claims-pack">
            {entitlements.canUseClaimsPack ? "Download claims pack" : "Claims evidence pack"}
          </a>
          {needsPro && (
            <a class="btn-ghost" href="/dashboard/plans">Compare plans</a>
          )}
        </div>
      </section>
    )}

    {primaryUpgradeFeature && (
      <UpgradeNudge feature={primaryUpgradeFeature} tier={entitlements.tier} compact />
    )}

    {showReferralCard && (
      <ReferralCard siteUrl={siteUrl} rewardDays={referralRewardDays} />
    )}
    {canEdit && recentEvents.length > 0 && (
      <FalseAlarmTipsCard />
    )}

    {canEdit && (
      <section class="card" id="send-test-alert">
        <h2 class="card-title">Send a test alert</h2>
        <p class="card-subtitle mb-4">
          {lastAlertAt || testSent
            ? "Fires a sample message to every channel you currently have enabled. Save settings first if you just changed them."
            : "Confirm delivery once before you rely on freeze warnings. Enable at least one channel below, save, then send."}
        </p>
        <form action="/api/user/alert-test" method="post">
          <input type="hidden" name="redirect" value="/dashboard/alerts" />
          <button
            class:list={lastAlertAt || testSent ? "btn-secondary" : "btn-primary"}
            type="submit"
          >
            Send test now
          </button>
        </form>
      </section>
    )}

    <AlertSettings
      userEmail={user.email ?? ""}
      settings={alertSettings}
      entitlements={entitlements}
      vapidPublicKey={getRuntimeEnv("VAPID_PUBLIC_KEY") ?? ""}
      twilioConfigured={isTwilioConfigured()}
      redirectTo="/dashboard/alerts"
      canEdit={canEdit}
      essentialsFirst={!Boolean(
        alertSettings.lastAlertSentAt ||
          alertSettings.lastOutageAlertAt ||
          alertSettings.lastRateAlertAt,
      )}
      deviceSpaces={deviceSpaces}
      thresholdSensors={thresholdSensors}
    />

    <section class="card">
      <h2 class="card-title">Door + cold</h2>
      <p class="card-subtitle mb-0">
        Door contact on Shelly or ESPHome?
        <a class="text-link" href="/about/garage-door-cold-playbook">Set up a combined alert rule</a>
        (door open while temperature drops) ·
        <a class="text-link" href="/about/esphome-shelly-recipes">ESPHome &amp; Shelly ingest recipes</a>
      </p>
    </section>

    <PwaInstallCard />

    {recentEvents.some((event) =>
      ["threshold", "freeze", "forecast", "nws", "flood", "humidity"].some((kind) =>
        event.kind?.toLowerCase().includes(kind),
      ),
    ) && (
      <section class="card">
        <h2 class="card-title">Need evidence for a claim?</h2>
        <p class="card-subtitle mb-4">
          After a real freeze or leak event, export a dated summary with matching readings from History.
        </p>
        <a class="btn-secondary" href="/dashboard/history#claims-pack">
          {entitlements.canUseClaimsPack ? "Open claims pack" : "See claims pack (Pro)"}
        </a>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">Recent alert activity</h2>
      <p class="card-subtitle mb-4">Audit trail of delivered and skipped channels.</p>
      <form class="mb-4 flex flex-wrap items-end gap-3" method="get" action="/dashboard/alerts">
        <div class="form-field mb-0">
          <label class="form-label" for="activity_kind">Kind</label>
          <select class="form-input" id="activity_kind" name="activity_kind">
            <option value="" selected={!activityKind}>All</option>
            <option value="freeze" selected={activityKind === "freeze"}>Freeze</option>
            <option value="flood" selected={activityKind === "flood"}>Flood</option>
            <option value="forecast" selected={activityKind === "forecast"}>Forecast</option>
            <option value="threshold" selected={activityKind === "threshold"}>Threshold</option>
            <option value="test" selected={activityKind === "test"}>Test</option>
          </select>
        </div>
        <label class="checkbox-row mb-0">
          <input type="checkbox" name="activity_unacked" value="1" checked={activityUnacked} />
          <span>Unhandled only</span>
        </label>
        <button type="submit" class="btn-secondary btn-sm">Filter</button>
        {(activityKind || activityUnacked || activityPage > 1) && (
          <a class="btn-ghost btn-sm" href="/dashboard/alerts#recent-alert-activity">Clear</a>
        )}
      </form>
      <div id="recent-alert-activity">
        <AlertActivityList
          events={recentEvents}
          canEdit={canEdit}
          hasTenantRelay={hasTenantRelay}
          hasOutboundWebhook={hasOutboundWebhook}
          canUseOutboundWebhook={entitlements.canUseOutboundWebhook}
        />
      </div>
      {(activityPage > 1 || activityHasMore) && (
        <div class="mt-4 flex flex-wrap gap-2">
          {activityPage > 1 && (
            <a
              class="btn-ghost btn-sm"
              href={`/dashboard/alerts?activity_page=${activityPage - 1}${activityKind ? `&activity_kind=${encodeURIComponent(activityKind)}` : ""}${activityUnacked ? "&activity_unacked=1" : ""}#recent-alert-activity`}
            >
              Newer
            </a>
          )}
          {activityHasMore && (
            <a
              class="btn-secondary btn-sm"
              href={`/dashboard/alerts?activity_page=${activityPage + 1}${activityKind ? `&activity_kind=${encodeURIComponent(activityKind)}` : ""}${activityUnacked ? "&activity_unacked=1" : ""}#recent-alert-activity`}
            >
              Older
            </a>
          )}
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
