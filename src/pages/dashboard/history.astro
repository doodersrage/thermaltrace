---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import GarageTempHistory from "../../components/GarageTempHistory.astro";
import UpgradeNudge from "../../components/UpgradeNudge.astro";
import HistorySubscription from "../../components/HistorySubscription.astro";
import ProductAnalyticsTracker from "../../components/ProductAnalyticsTracker.astro";
import DashboardTabNav from "../../components/dashboard/DashboardTabNav.astro";
import { getAuthFromCookies } from "../../lib/auth";
import { canDownloadHistoryCsv } from "../../lib/adminAccess";
import {
  fetchGarageTempChartData,
  fetchGarageTempHistory,
  fetchHistoryFilterOptions,
} from "../../lib/garageTempsHistory";
import { fetchPriorYearCompareBundle } from "../../lib/priorYearCompare";
import { detectTemperatureAnomalies } from "../../lib/anomalyDetection";
import { getUserSubscription } from "../../lib/stripeSubscriptions";
import {
  compareProbeAverages,
  compareSpaceAverages,
  computeSeasonalInsights,
} from "../../lib/seasonalInsights";
import { getUserDevicesAsTempConfig } from "../../lib/devices";
import { getUserPreferences } from "../../lib/userPreferences";
import { fetchIndoorOutdoorDelta, buildIndoorOutdoorSeries } from "../../lib/indoorOutdoorDelta";
import { getOrCreateHouseholdForUser } from "../../lib/households";
import { getIndoorReferenceSensorId, findReferenceSensorLabel } from "../../lib/indoorReference";
import { fetchHouseChartOverlay } from "../../lib/houseContext";
import { listConnectionsForHousehold } from "../../lib/thermostatConnections";
import { computeDailyFreezeHours, computeFreezeHours } from "../../lib/freezeHours";
import FreezeHoursChart from "../../components/FreezeHoursChart";
import ProbeSpreadChart from "../../components/ProbeSpreadChart";
import { buildProbeSpreadSeries } from "../../lib/probeSpread";

import { buildColdestDayOverlay, shiftSeriesOntoCurrentWindow } from "../../lib/historyOverlay";
import IndoorOutdoorChart from "../../components/IndoorOutdoorChart.tsx";
import { clampIsoToHistoryWindow, historyCutoffIso } from "../../lib/retentionSchedule";
import { formatHistoryRetention, getUserEntitlements } from "../../lib/entitlements";
import { getAlertSettingsForUser } from "../../lib/notify";
import { listAlertEventsInRange } from "../../lib/alertEvents";
import { toChartAlertMarkers } from "../../lib/chartAlertMarkers";
import { listHistorySavedViews } from "../../lib/historySavedViews";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const feedFilter = Astro.url.searchParams.get("feed")?.trim() ?? "";
const probeFilter = Astro.url.searchParams.get("probe")?.trim() ?? "";
const fromDateParam = Astro.url.searchParams.get("from")?.trim() ?? "";
const toDate = Astro.url.searchParams.get("to")?.trim() ?? "";
const daysParam = Number(Astro.url.searchParams.get("days") ?? "7");

if (pageParam < 1 || Number.isNaN(pageParam)) {
  return Astro.redirect("/dashboard/history?page=1");
}

const entitlements = await getUserEntitlements(user.id);
const historyDays = entitlements.historyDays;
const cutoffDate = historyCutoffIso(historyDays).slice(0, 10);
const fromDate =
  fromDateParam && fromDateParam < cutoffDate ? cutoffDate : fromDateParam;
const requestedDays = daysParam === 90 ? 90 : daysParam === 30 ? 30 : 7;
const chartDays = Math.min(requestedDays, historyDays);
const overlayColdest =
  Astro.url.searchParams.get("overlay") === "coldest" && historyDays >= 365;
const comparePreset = Astro.url.searchParams.get("compare_preset")?.trim() ?? "";
let compareFromParam = Astro.url.searchParams.get("compare_from")?.trim() ?? "";
let compareToParam = Astro.url.searchParams.get("compare_to")?.trim() ?? "";

function isoDay(d: Date): string {
  return d.toISOString().slice(0, 10);
}

if (comparePreset === "prior_week" || comparePreset === "prior_month") {
  const end = toDate
    ? new Date(`${toDate}T12:00:00.000Z`)
    : new Date();
  const spanDays =
    fromDate && toDate
      ? Math.max(
          1,
          Math.ceil(
            (Date.parse(`${toDate}T23:59:59`) - Date.parse(`${fromDate}T00:00:00`)) /
              (24 * 60 * 60 * 1000),
          ),
        )
      : chartDays;
  const shift = comparePreset === "prior_month" ? 30 : spanDays;
  const compareEnd = new Date(end.getTime() - shift * 24 * 60 * 60 * 1000);
  const compareStart = new Date(
    compareEnd.getTime() - (spanDays - 1) * 24 * 60 * 60 * 1000,
  );
  compareFromParam = isoDay(compareStart);
  compareToParam = isoDay(compareEnd);
}

const hasCustomCompare = Boolean(compareFromParam && compareToParam);
const compareYoy =
  !overlayColdest &&
  !hasCustomCompare &&
  Astro.url.searchParams.get("yoy") === "1" &&
  historyDays >= 365;
const needPriorYear = compareYoy || overlayColdest;

const filters = {
  feedName: feedFilter || undefined,
  probeKey: probeFilter || undefined,
  from: fromDate
    ? clampIsoToHistoryWindow(
        new Date(`${fromDate}T00:00:00`).toISOString(),
        historyDays,
      )
    : historyCutoffIso(historyDays),
  to: toDate ? new Date(`${toDate}T23:59:59`).toISOString() : undefined,
};

const chartFilters = {
  feedName: feedFilter || undefined,
  probeKey: probeFilter || undefined,
  from: fromDate
    ? clampIsoToHistoryWindow(
        new Date(`${fromDate}T00:00:00`).toISOString(),
        historyDays,
      )
    : undefined,
  to: toDate ? new Date(`${toDate}T23:59:59`).toISOString() : undefined,
};

const preferences = await getUserPreferences(user);

const chartWindowDays =
  fromDate && toDate
    ? Math.min(
        historyDays,
        Math.max(
          1,
          Math.ceil(
            (Date.parse(`${toDate}T23:59:59`) - Date.parse(`${fromDate}T00:00:00`)) /
              (24 * 60 * 60 * 1000),
          ),
        ),
      )
    : chartDays;

const [
  history,
  chartData,
  priorYearBundle,
  comparePeriodData,
  filterOptions,
  canDownloadCsv,
  subscription,
  insights,
  alertSettings,
  savedViews,
] = await Promise.all([
  fetchGarageTempHistory(user.id, pageParam, undefined, filters),
  fetchGarageTempChartData(user.id, chartWindowDays, chartFilters),
  needPriorYear
    ? fetchPriorYearCompareBundle(
        user.id,
        overlayColdest ? Math.max(chartWindowDays, 30) : chartWindowDays,
        chartFilters,
        user,
      )
    : Promise.resolve({
        points: [],
        source: "none" as const,
        outdoorLocationLabel: null,
        earliestLocalReadingAt: null,
      }),
  hasCustomCompare
    ? fetchGarageTempChartData(user.id, historyDays, {
        feedName: feedFilter || undefined,
        probeKey: probeFilter || undefined,
        from: clampIsoToHistoryWindow(
          new Date(`${compareFromParam}T00:00:00`).toISOString(),
          historyDays,
        ),
        to: new Date(`${compareToParam}T23:59:59`).toISOString(),
      })
    : Promise.resolve({ points: [], error: null }),
  fetchHistoryFilterOptions(user.id),
  canDownloadHistoryCsv(user.id),
  getUserSubscription(user.id),
  computeSeasonalInsights(user.id, Math.min(30, historyDays), user),
  getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
  listHistorySavedViews(user.id),
]);

const priorYearData = { points: priorYearBundle.points, error: null };

const chartMarkerTimes = chartData.points
  .map((p) => Date.parse(p.timestamp))
  .filter((ts) => Number.isFinite(ts));
const chartAlertMarkers =
  chartMarkerTimes.length > 0
    ? toChartAlertMarkers(
        await listAlertEventsInRange(
          user.id,
          new Date(Math.min(...chartMarkerTimes)).toISOString(),
          new Date(Math.max(...chartMarkerTimes)).toISOString(),
          200,
        ),
      )
    : [];

const outdoorDelta = await fetchIndoorOutdoorDelta(
  chartData.points,
  preferences.weatherCityId,
  user,
);
const indoorOutdoorSeries = outdoorDelta
  ? buildIndoorOutdoorSeries(chartData.points, outdoorDelta.outdoorF)
  : [];
const freezeHours = computeFreezeHours(chartData.points, alertSettings.freezeThresholdF);
const dailyFreezeHours = computeDailyFreezeHours(
  chartData.points,
  alertSettings.freezeThresholdF,
);
const probeSpreadSeries = buildProbeSpreadSeries(chartData.points);

const coldestOverlay = overlayColdest
  ? buildColdestDayOverlay(priorYearData.points, chartData.points)
  : { overlay: [], coldestDay: null as string | null, minTempF: null as number | null };

const overlayPoints = overlayColdest
  ? coldestOverlay.overlay
  : hasCustomCompare
    ? shiftSeriesOntoCurrentWindow(comparePeriodData.points, chartData.points)
    : compareYoy
      ? shiftSeriesOntoCurrentWindow(priorYearData.points, chartData.points)
      : [];

const overlayLegend = overlayColdest
  ? coldestOverlay.coldestDay
    ? priorYearBundle.source === "outdoor_estimate"
      ? `Gray = coldest outdoor day last year (${coldestOverlay.coldestDay}, estimated)`
      : `Gray = coldest day last year (${coldestOverlay.coldestDay}${
        coldestOverlay.minTempF != null
          ? `, low ${coldestOverlay.minTempF.toFixed(1)}°F`
          : ""
      })`
    : priorYearBundle.earliestLocalReadingAt
      ? `Gray = no prior-year probe data (history starts ${new Date(priorYearBundle.earliestLocalReadingAt).toLocaleDateString()})`
      : "Gray = coldest day last year (no prior-year data)"
  : hasCustomCompare
    ? `Gray = compare window ${compareFromParam} → ${compareToParam}`
    : compareYoy
      ? priorYearBundle.source === "outdoor_estimate"
        ? `Gray = outdoor estimate last year${priorYearBundle.outdoorLocationLabel ? ` (${priorYearBundle.outdoorLocationLabel})` : ""}`
        : "Gray = same window last year (time-aligned)"
      : null;

if (history.totalPages > 0 && pageParam > history.totalPages) {
  return Astro.redirect(`/dashboard/history?page=${history.totalPages}`);
}

const subscriptionNotice = Astro.url.searchParams.get("subscription");
const anomalies = detectTemperatureAnomalies(chartData.points);
const probeCompare = compareProbeAverages(chartData.points);

const deviceConfig = await getUserDevicesAsTempConfig(user.id, user.email);
const household = await getOrCreateHouseholdForUser(user.id, user.email);
const indoorReferenceSensorId = household.householdId
  ? await getIndoorReferenceSensorId(household.householdId)
  : null;
const thermostatConnections =
  household.householdId && entitlements.canUseThermostatIntegration
    ? await listConnectionsForHousehold(household.householdId)
    : [];
const houseChartOverlay = household.householdId
  ? await fetchHouseChartOverlay({
      householdId: household.householdId,
      days: chartWindowDays,
      hasThermostatConnection: thermostatConnections.length > 0,
      referenceSensorId: indoorReferenceSensorId,
      filters: { from: chartFilters.from, to: chartFilters.to },
    })
  : { points: [], source: null };
const houseChartLegend =
  houseChartOverlay.source === "thermostat"
    ? "House (thermostat)"
    : houseChartOverlay.source === "reference"
      ? `House (${findReferenceSensorLabel(deviceConfig.devices, indoorReferenceSensorId) ?? "reference"})`
      : null;
const probeToSpace = new Map<string, string>();
for (const device of deviceConfig.devices) {
  if (!device.space) continue;
  for (const sensor of device.sensors) {
    if (sensor.kind === "temperature") {
      probeToSpace.set(sensor.label, device.space);
    }
  }
}
const spaceCompare = compareSpaceAverages(chartData.points, probeToSpace);

const claimsFrom = fromDate || cutoffDate;
const claimsTo = toDate || new Date().toISOString().slice(0, 10);
const claimsPackQs = new URLSearchParams({
  from: claimsFrom,
  to: claimsTo,
}).toString();
const claimsPackHref = `/api/claims/pack?${claimsPackQs}`;

const claimsEmailed = Astro.url.searchParams.get("claims_emailed") === "1";
const alertParam = Number(Astro.url.searchParams.get("alert") ?? "");
const highlightAlertId =
  Number.isFinite(alertParam) && alertParam > 0 ? alertParam : null;
const claimsErrorCode = Astro.url.searchParams.get("claims_error");
const claimsErrorMessage =
  claimsErrorCode === "pro_required"
    ? "Pro plan required for the claims pack."
    : claimsErrorCode === "invalid_email"
      ? "Enter a valid adjuster email address."
      : claimsErrorCode === "no_household"
        ? "No household found to generate a claims pack for."
        : claimsErrorCode === "recipient_not_allowed"
          ? "That email address could not be delivered to."
          : claimsErrorCode === "send_failed"
            ? "Couldn't send the claims pack email. Try again."
            : null;

const historyTabRaw = Astro.url.searchParams.get("tab")?.trim() ?? "chart";
const historyTab =
  historyTabRaw === "table" || historyTabRaw === "exports" ? historyTabRaw : "chart";

function historyTabHref(tab: string): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("tab", tab);
  if (tab !== "table") params.delete("page");
  return `/dashboard/history?${params.toString()}`;
}

const historyTabs = [
  { id: "chart", label: "Chart", href: historyTabHref("chart") },
  { id: "table", label: "Table", href: historyTabHref("table") },
  { id: "exports", label: "Exports", href: historyTabHref("exports") },
];

const historyUpgradeFeature =
  entitlements.historyDays < 90
    ? ("data_retention" as const)
    : !canDownloadCsv
      ? ("csv_export" as const)
      : !entitlements.canUseClaimsPack && historyTab === "exports"
        ? ("claims_pack" as const)
        : null;
---
<DashboardLayout title="Reading History">
  {subscriptionNotice === "success" && (
    <ProductAnalyticsTracker
      events={[
        {
          name: "purchase",
          props: {
            currency: "USD",
            value: 0,
            transaction_id: "stripe_checkout",
          },
        },
      ]}
    />
  )}
  <div class="space-y-6">
    <section class="card">
      <h2 class="card-title">Reading history</h2>
      <p class="card-subtitle mb-4">
        Browse saved temperature and humidity snapshots by feed and probe.
        {canDownloadCsv
          ? " Download CSV from the Table tab or Exports below."
          : " Subscribe to unlock CSV export of your saved history."}
      </p>
      <DashboardTabNav tabs={historyTabs} activeId={historyTab} ariaLabel="History views" />
    </section>

    {historyUpgradeFeature && (
      <UpgradeNudge feature={historyUpgradeFeature} tier={entitlements.tier} />
    )}

    <details class="card">
      <summary class="dashboard-recommendations-summary">Plan & retention details</summary>
      <div class="dashboard-recommendations-body">
        <p class="mb-0 text-sm">
          Your {entitlements.tier === "admin" ? "Admin" : entitlements.tier} plan includes{" "}
          <strong>{formatHistoryRetention(historyDays)}</strong> of history
          {entitlements.tier === "pro" || entitlements.tier === "admin" ? "+" : ""}.
          Raw readings older than 90 days roll into hourly averages for longer windows.
          {canDownloadCsv
            ? " CSV export covers the retained window."
            : " Member unlocks CSV export of the retained window."}
        </p>
      </div>
    </details>

    {(historyTab === "chart" || historyTab === "table") && (
      <>
        {historyTab === "chart" && outdoorDelta && (
          <details class="card">
            <summary class="dashboard-recommendations-summary">Indoor vs outdoor</summary>
            <div class="dashboard-recommendations-body">
              <p class="card-subtitle">
                Chart-window probe average compared with current outdoor weather
                {outdoorDelta.cityName ? ` in ${outdoorDelta.cityName}` : ""}.
              </p>
              <div class="stat-grid">
                <article class="stat-item">
                  <span class="stat-label">Indoor avg</span>
                  <p class="stat-value">{outdoorDelta.indoorAvgF.toFixed(1)}°F</p>
                </article>
                <article class="stat-item">
                  <span class="stat-label">Outdoor now</span>
                  <p class="stat-value">{outdoorDelta.outdoorF.toFixed(1)}°F</p>
                  <p class="stat-detail">{outdoorDelta.outdoorDescription}</p>
                </article>
                <article class="stat-item">
                  <span class="stat-label">Delta</span>
                  <p class="stat-value">
                    {outdoorDelta.deltaF > 0 ? "+" : ""}
                    {outdoorDelta.deltaF.toFixed(1)}°F
                  </p>
                </article>
              </div>
              {indoorOutdoorSeries.length >= 2 && (
                <div class="mt-4">
                  <IndoorOutdoorChart client:visible points={indoorOutdoorSeries} />
                </div>
              )}
            </div>
          </details>
        )}

        {historyTab === "chart" && probeSpreadSeries.length >= 2 && (
          <details class="card" open>
            <summary class="dashboard-recommendations-summary">Probe spread</summary>
            <div class="dashboard-recommendations-body">
              <p class="card-subtitle mb-4">
                Hourly gap between the warmest and coldest probe in this window.
              </p>
              <ProbeSpreadChart client:visible points={probeSpreadSeries} />
            </div>
          </details>
        )}

        {historyTab === "chart" && chartData.points.length >= 2 && (
          <details class="card" open={dailyFreezeHours.some((d) => d.hoursBelow > 0)}>
            <summary class="dashboard-recommendations-summary">Season freeze exposure</summary>
            <div class="dashboard-recommendations-body">
              <p class="card-subtitle mb-4">
                Estimated time at or below {alertSettings.freezeThresholdF}°F in the selected chart window.
              </p>
              <div class="stat-grid">
                <article class="stat-item">
                  <span class="stat-label">Hours ≤ {alertSettings.freezeThresholdF}°F</span>
                  <p class="stat-value">{freezeHours.hoursBelow34.toFixed(1)}</p>
                </article>
                <article class="stat-item">
                  <span class="stat-label">Readings ≤ {alertSettings.freezeThresholdF}°F</span>
                  <p class="stat-value">{freezeHours.readingsBelow34}</p>
                </article>
                <article class="stat-item">
                  <span class="stat-label">Coldest</span>
                  <p class="stat-value">
                    {freezeHours.coldestF != null ? `${freezeHours.coldestF.toFixed(1)}°F` : "—"}
                  </p>
                </article>
              </div>
              {dailyFreezeHours.length >= 2 && (
                <div class="mt-4">
                  <FreezeHoursChart
                    client:visible
                    days={dailyFreezeHours}
                    thresholdF={alertSettings.freezeThresholdF}
                  />
                </div>
              )}
            </div>
          </details>
        )}

        <GarageTempHistory
          history={history}
          chartPoints={chartData.points}
          priorYearPoints={overlayPoints}
          compareYoy={compareYoy}
          overlayColdest={overlayColdest}
          overlayLegend={overlayLegend}
          basePath="/dashboard/history"
          tab={historyTab}
          canDownloadCsv={canDownloadCsv}
          feedFilter={feedFilter}
          probeFilter={probeFilter}
          fromDate={fromDate}
          toDate={toDate}
          compareFrom={compareFromParam}
          compareTo={compareToParam}
          days={chartDays}
          maxHistoryDays={historyDays}
          canCompareYoy={historyDays >= 365}
          anomalies={anomalies}
          filterOptions={filterOptions}
          freezeThresholdF={alertSettings.freezeThresholdF}
          housePoints={houseChartOverlay.points}
          houseLegend={houseChartLegend}
          viewMode={historyTab === "chart" ? "chart" : "table"}
          hideTitle
          savedViews={savedViews}
          canShareChart={canDownloadCsv}
          alertMarkers={chartAlertMarkers}
          highlightAlertId={highlightAlertId}
          canUseClaimsPack={entitlements.canUseClaimsPack}
        />
      </>
    )}

    {historyTab === "exports" && (
      <>
        <section class="card" id="season-summary">
          <h2 class="card-title">Window summary</h2>
          <p class="card-subtitle">
            Snapshot for {claimsFrom} → {claimsTo} (same window as claims pack below). Open the Chart tab to explore, or download evidence from Exports.
          </p>
          {chartData.points.length < 2 ? (
            <p class="mb-0 text-sm text-[var(--color-text-muted)]">
              Not enough readings in this window for a summary yet.
            </p>
          ) : (
            <>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-4">
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">Coldest</p>
                  <p class="m-0 text-lg font-semibold">
                    {freezeHours.coldestF != null ? `${freezeHours.coldestF.toFixed(1)}°F` : "—"}
                  </p>
                </div>
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">
                    Hours ≤ {alertSettings.freezeThresholdF}°F
                  </p>
                  <p class="m-0 text-lg font-semibold">
                    {freezeHours.hoursBelow34.toFixed(1)} h
                  </p>
                </div>
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">Readings</p>
                  <p class="m-0 text-lg font-semibold">{freezeHours.totalReadings}</p>
                </div>
                <div>
                  <p class="m-0 text-xs text-[var(--color-text-muted)]">Critical alert ticks</p>
                  <p class="m-0 text-lg font-semibold">{chartAlertMarkers.length}</p>
                </div>
              </div>
              <p class="mb-3 text-sm">
                <a
                  class="text-link"
                  href={`/dashboard/history?from=${claimsFrom}&to=${claimsTo}&tab=chart`}
                >
                  Open this window on the Chart tab
                </a>
                {entitlements.canUseClaimsPack && (
                  <>
                    {" · "}
                    <a class="text-link" href={claimsPackHref}>Download claims pack (PDF)</a>
                  </>
                )}
              </p>
              {insights.length > 0 && (
                <ul class="space-y-2 mb-0 text-sm">
                  {insights.slice(0, 4).map((insight) => (
                    <li>
                      <strong>{insight.title}:</strong> {insight.detail}
                    </li>
                  ))}
                </ul>
              )}
            </>
          )}
        </section>

        <section class="card" id="claims-pack">
      <h2 class="card-title">Claims / insurance pack</h2>
      <p class="card-subtitle">
        Printable evidence summary for a date range: freeze exposure, devices, and alert timeline, with links to matching readings and alert-event CSVs.
        {" "}
        <a class="text-link" href="/claims-pack">Learn more about the claims pack</a>.
      </p>
      {claimsEmailed && <p class="alert-success mt-0 mb-4">Claims pack emailed.</p>}
      {claimsErrorMessage && (
        <p class="alert-warning mt-0 mb-4" role="alert">{claimsErrorMessage}</p>
      )}
      {entitlements.canUseClaimsPack ? (
        <>
          <p class="mb-3 text-sm text-[var(--color-text-muted)]">
            Uses the History filters above when set ({claimsFrom} → {claimsTo}). Downloads a PDF summary; companion CSVs cover the same window.
          </p>
          <a class="btn-primary" href={claimsPackHref}>Download claims pack (PDF)</a>
          <a class="btn-ghost text-sm ml-2" href={`${claimsPackHref}?format=html`}>HTML version</a>

          <form action="/api/claims/email" method="post" class="mt-4 flex flex-wrap items-end gap-3">
            <input type="hidden" name="from" value={claimsFrom} />
            <input type="hidden" name="to" value={claimsTo} />
            <input type="hidden" name="redirect" value="/dashboard/history" />
            <div class="form-field mb-0">
              <label class="form-label" for="adjuster_email">Email to adjuster</label>
              <input
                class="form-input"
                type="email"
                id="adjuster_email"
                name="adjuster_email"
                placeholder="adjuster@insurer.com"
                required
              />
            </div>
            <button type="submit" class="btn-secondary">Send claims pack</button>
          </form>
        </>
      ) : (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">
          Upgrade to Pro to download the claims pack from this tab.
        </p>
      )}
    </section>

    <section class="card" id="monitoring-certificate">
      <h2 class="card-title">Monitoring certificate</h2>
      <p class="card-subtitle mb-3">
        One-page PDF summary of your alert configuration and monitored devices: useful for insurers, landlords, or property managers.
      </p>
      <a class="btn-secondary" href="/api/monitoring/certificate">Download monitoring certificate (PDF)</a>
      <a class="btn-ghost text-sm ml-2" href="/api/monitoring/certificate?format=html">HTML version</a>
    </section>

    {insights.length > 0 && (
      <section class="card">
        <h2 class="card-title">Seasonal insights ({Math.min(30, historyDays)} days)</h2>
        <ul class="space-y-2 mb-0">
          {insights.map((insight) => (
            <li>
              <strong>{insight.title}:</strong> {insight.detail}
            </li>
          ))}
        </ul>
        {probeCompare.length > 0 && (
          <p class="mt-4 mb-0 text-sm">{probeCompare[0]}</p>
        )}
        {spaceCompare.length > 0 && (
          <p class="mt-2 mb-0 text-sm">{spaceCompare[0]}</p>
        )}
      </section>
    )}

    <HistorySubscription
      canDownloadCsv={canDownloadCsv}
      subscription={subscription}
      subscriptionNotice={subscriptionNotice}
    />

    <p class="mb-0 text-sm">
      <a class="text-link" href="/api/ical/outlook">Subscribe to freeze outlook (iCal)</a>
    </p>
      </>
    )}
  </div>
</DashboardLayout>
