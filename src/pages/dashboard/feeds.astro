---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import AdminNav from "../../components/dashboard/AdminNav.astro";
import { collectAllUsersFeedHealth } from "../../lib/collectHistory";
import { getAuthFromCookies } from "../../lib/auth";
import { isUserAdmin } from "../../lib/adminAccess";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

// Gate before admin-only fetches -- DashboardLayout's own requireAdmin
// check runs too late to stop this page's frontmatter from already
// having queried every account's feed health (Astro.redirect() from a
// nested layout isn't a reliable way to abort a page's response; see
// ops.astro).
if (!(await isUserAdmin(user.id))) {
  return Astro.redirect("/dashboard");
}

const { statuses, errors } = await collectAllUsersFeedHealth();
const failing = statuses.filter((status) => !status.ok);
const healthy = statuses.filter((status) => status.ok);
---

<DashboardLayout title="Feed health" subtitle="Live status for every configured feed across accounts." requireAdmin>
  <div class="space-y-6">
    <AdminNav />
    {errors.length > 0 && (
      <div class="alert-warning">
        {errors.map((message) => <p class="m-0">{message}</p>)}
      </div>
    )}
    <section class="card animate-slide-in-left">
      <h2 class="card-title">Needs attention ({failing.length})</h2>
      {failing.length === 0 ? (
        <p class="m-0 stat-detail">All checked feeds are responding.</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">User</th>
                <th scope="col">Feed</th>
                <th scope="col">URL</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {failing.map((status) => (
                <tr>
                  <td>{status.userEmail ?? status.userId}</td>
                  <td>{status.feedName}</td>
                  <td><code>{status.url}</code></td>
                  <td>{status.message}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Healthy feeds ({healthy.length})</h2>
      {healthy.length === 0 ? (
        <p class="m-0 stat-detail">No healthy feeds found.</p>
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">User</th>
                <th scope="col">Feed</th>
                <th scope="col">Probes</th>
                <th scope="col">Checked</th>
              </tr>
            </thead>
            <tbody>
              {healthy.map((status) => (
                <tr>
                  <td>{status.userEmail ?? status.userId}</td>
                  <td>{status.feedName}</td>
                  <td>{status.probeCount}</td>
                  <td>{new Date(status.checkedAt).toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
