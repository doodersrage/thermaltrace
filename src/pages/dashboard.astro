---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import DashboardOnboarding from "../components/DashboardOnboarding.astro";
import DashboardAndroidNudge from "../components/DashboardAndroidNudge.astro";
import DashboardBayBuddyNudge from "../components/DashboardBayBuddyNudge.astro";
import DemoPullNudge from "../components/DemoPullNudge.astro";
import ProbeSimulatorNudge from "../components/dashboard/ProbeSimulatorNudge.astro";
import NestConnectNudge from "../components/dashboard/NestConnectNudge.astro";
import OverviewPwaNudge from "../components/dashboard/OverviewPwaNudge.astro";
import DashboardYoureLive from "../components/DashboardYoureLive.astro";
import AlertSetupNudge from "../components/dashboard/AlertSetupNudge.astro";
import DashboardStoryCard from "../components/dashboard/DashboardStoryCard.astro";
import GarageRiskStatusCard from "../components/dashboard/GarageRiskStatusCard.astro";
import { computeGarageRiskStatus } from "../lib/garageRiskStatus";
import { getAuthFromCookies } from "../lib/auth";
import { getUserPreferences } from "../lib/userPreferences";
import { getUserEntitlements } from "../lib/entitlements";
import { latestFromShell } from "../lib/dashboardShell";
import { listHouseholdDevices } from "../lib/devices";
import { ensureAlertDeliveryEvidence, getAlertSettingsForUser } from "../lib/notify";
import {
  getOrCreateHouseholdForUser,
  listHouseholdMembers,
  listUserHouseholds,
  getUserHouseholdRole,
  canEditHousehold,
} from "../lib/households";
import TimeToFreezeCard from "../components/TimeToFreezeCard.astro";
import WeekCompareCard from "../components/WeekCompareCard.astro";
import UpgradeNudge from "../components/UpgradeNudge.astro";
import { nextUpgradeTier } from "../lib/planComparison";
import {
  fetchWeekCompare,
} from "../lib/dashboardInsights";
import { fetchGarageTempChartData } from "../lib/garageTempsHistory";
import { fetchLatestSensorValues } from "../lib/sensorReadings";
import { formatRelativeAge } from "../lib/relativeTime";
import {
  summarizeStaleSensors,
} from "../lib/sensorFreshness";
import {
  listLowBatteryDevices,
  lowBatteryBannerMessage,
} from "../lib/deviceBatteryUi";
import {
  fetchNightsAtRiskForConfig,
  fetchWeatherSnapshotForConfig,
} from "../lib/weatherContext";
import { isWeatherLocationConfigured } from "../lib/personalWeatherStations";
import { personalWeatherConfigFromPreferences } from "../lib/userPreferences";
import { fetchNwsAlerts } from "../lib/nwsAlerts";
import {
  buildTimeToFreezeProjection,
  outdoorPointsFromHourly,
} from "../lib/spaceThermalModel";
import {
  fetchOpenMeteoHourlyWindow,
  splitOpenMeteoPastAndForecast,
} from "../lib/openMeteoHistory";
import {
  buildHeatingInsights,
  estimateHeatingLossRate,
} from "../lib/heatingInsights";
import HeatingInsightsCard from "../components/HeatingInsightsCard.astro";
import { listConnectionsForHousehold } from "../lib/thermostatConnections";
import {
  fetchThermostatContextWithStatus,
} from "../lib/thermostatCorrelation";
import { getIndoorReferenceSensorId } from "../lib/indoorReference";
import { buildHouseContext, fetchHouseChartOverlay } from "../lib/houseContext";
import ProductAnalyticsTracker from "../components/ProductAnalyticsTracker.astro";
import UnackedAlertsBanner from "../components/UnackedAlertsBanner.astro";
import ColdSnapChecklistCard from "../components/ColdSnapChecklistCard.astro";
import FreezeReadinessCard from "../components/dashboard/FreezeReadinessCard.astro";
import { shouldShowColdSnapChecklist } from "../lib/coldSnapChecklist";
import { computeFreezeReadiness, hasConfiguredAlertChannel } from "../lib/freezeReadiness";
import { resolveAlertEmail } from "../lib/alerts";
import { getHouseholdFreezeMapSettings } from "../lib/freezeMap";
import { fetchRegionalBenchmark } from "../lib/regionalBenchmark";
import TestAlertNudge from "../components/dashboard/TestAlertNudge.astro";
import FreezeMapOptInNudge from "../components/dashboard/FreezeMapOptInNudge.astro";
import RegionalBenchmarkCard from "../components/dashboard/RegionalBenchmarkCard.astro";
import { countUnacknowledgedAlerts, listAlertEventsInRange } from "../lib/alertEvents";
import { toChartAlertMarkers } from "../lib/chartAlertMarkers";
import LowBatteryBanner from "../components/dashboard/LowBatteryBanner.astro";
import DashboardMultiPropertyNudge from "../components/dashboard/DashboardMultiPropertyNudge.astro";
import DashboardOverviewToggle from "../components/dashboard/DashboardOverviewToggle.astro";
import AttentionNeededStrip from "../components/dashboard/AttentionNeededStrip.astro";
import OverviewQuickActions from "../components/dashboard/OverviewQuickActions.astro";
import { getDashboardOverviewMode } from "../lib/dashboardOverviewMode";
import {
  getDashboardQuietUntil,
  getPinnedOverviewMetrics,
  isDashboardQuietActive,
  shouldForceSimpleOverview,
  shouldShowOverviewGrowthTips,
  PINNABLE_OVERVIEW_METRICS,
  PINNABLE_OVERVIEW_METRIC_LABELS,
  type PinnableOverviewMetric,
} from "../lib/dashboardComfort";
import { buildOverviewBannerQueue, partitionOverviewBanners } from "../lib/overviewBanners";
import {
  devicesOpsPath,
  devicesSetupPath,
} from "../lib/dashboardDeepLinks";
import { computeFreezeHours } from "../lib/freezeHours";
import {
  buildAirQualityOverview,
  buildBatteryOverview,
  buildDoorTempSummary,
  buildMotionSummary,
  buildPowerTempSummary,
  buildRssiOverview,
  computeCondensationHours,
  computeFeedUptimePct,
  feedHealthFromDevices,
  computeIndoorOutdoorDelta,
  computeProbeSpreadF,
  doorOpenMinutesFromSessions,
  loadDoorSessions24h,
  loadEnergyOverview,
  loadFloodLevelOverview,
  loadMotionSessions24h,
  loadPowerOffSessions24h,
} from "../lib/overviewExtras";
import FloodLevelCard from "../components/dashboard/FloodLevelCard.astro";
import OverviewFlash from "../components/dashboard/OverviewFlash.astro";
import OverviewInsightsExtras from "../components/dashboard/OverviewInsightsExtras.astro";

import DashboardMetricGrid from "../components/dashboard/DashboardMetricGrid.astro";
import MetricCard from "../components/dashboard/MetricCard.astro";
import DashboardWeekChart from "../components/dashboard/DashboardWeekChart.astro";
import NightsAtRiskCard from "../components/dashboard/NightsAtRiskCard.astro";

const shell = Astro.locals.dashboardShell ?? null;
const { session, user } = shell
  ? { session: shell.session, user: shell.user }
  : await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

let overviewMode = getDashboardOverviewMode(user);
const quietUntil = getDashboardQuietUntil(user);
const quietActive = isDashboardQuietActive(user);
const pinnedMetrics = getPinnedOverviewMetrics(user);
const pinnedMetricSet = new Set<PinnableOverviewMetric>(pinnedMetrics);

const onboardingDismissed =
  (user.user_metadata as Record<string, unknown> | undefined)?.onboarding_dismissed ===
  true;

const [
  preferences,
  entitlements,
  alertSettingsLoaded,
  household,
  userHouseholds,
  unackedAlertCount,
] = await Promise.all([
  getUserPreferences(user),
  shell ? Promise.resolve(shell.entitlements) : getUserEntitlements(user.id),
  getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
  shell?.activeHouseholdId
    ? Promise.resolve({ householdId: shell.activeHouseholdId, error: null as string | null })
    : getOrCreateHouseholdForUser(user.id, user.email),
  shell
    ? Promise.resolve({ households: shell.households, error: null as string | null })
    : listUserHouseholds(user.id),
  shell ? Promise.resolve(shell.unackedAlerts) : countUnacknowledgedAlerts(user.id),
]);

const activeHouseholdId = household.householdId;
const weatherConfig = personalWeatherConfigFromPreferences(preferences);
const chartWindowDays = Math.min(30, Math.max(7, entitlements.historyDays));

const [{ settings: alertSettings }, members, householdDevicesResult, householdRole] =
  await Promise.all([
    ensureAlertDeliveryEvidence(user.id, alertSettingsLoaded),
    household.householdId && !onboardingDismissed
      ? listHouseholdMembers(household.householdId)
      : Promise.resolve({ members: [] as Awaited<ReturnType<typeof listHouseholdMembers>>["members"] }),
    household.householdId
      ? listHouseholdDevices(household.householdId)
      : Promise.resolve({ devices: [] as Awaited<ReturnType<typeof listHouseholdDevices>>["devices"] }),
    activeHouseholdId
      ? getUserHouseholdRole(user.id, activeHouseholdId)
      : Promise.resolve(null),
  ]);

const shellLatest = latestFromShell(shell, household.householdId);
const latest = shellLatest
  ? shellLatest
  : household.householdId
    ? await fetchLatestSensorValues(household.householdId)
    : [];

const devicesEarly = householdDevicesResult.devices;
const canEditEarly = canEditHousehold(householdRole);
const forceSimpleEarly = shouldForceSimpleOverview(householdRole);
const onboardingDismissedEarly = onboardingDismissed;
const hasDevicesEarly =
  devicesEarly.some((d) => d.source === "push" || d.source === "pull_url");
const hasAlertsEnabledEarly = alertSettings.enabled;
const hasEmailAlertsEarly =
  alertSettings.enabled && hasConfiguredAlertChannel(alertSettings, user.email);
const lastAlertCandidatesEarlyGate = [
  alertSettings.lastAlertSentAt,
  alertSettings.lastOutageAlertAt,
  alertSettings.lastRateAlertAt,
  alertSettings.lastForecastAlertAt,
  alertSettings.lastRunwayAlertAt,
  alertSettings.lastFloodAlertAt,
  alertSettings.lastNwsAlertAt,
].filter(Boolean) as string[];
const hasTestAlertEarly = lastAlertCandidatesEarlyGate.length > 0;
const essentialDoneEarly =
  (hasDevicesEarly || latest.length > 0) &&
  hasAlertsEnabledEarly &&
  hasTestAlertEarly &&
  (hasEmailAlertsEarly || hasConfiguredAlertChannel(alertSettings, user.email));
const firstRunFocusEarly =
  canEditEarly && !onboardingDismissedEarly && !essentialDoneEarly;
const showInsightsEarly =
  !forceSimpleEarly &&
  getDashboardOverviewMode(user) === "insights" &&
  !firstRunFocusEarly;

const loadHeavyWeather = showInsightsEarly;
const loadChart = showInsightsEarly;

const [weatherSnapshot, nightsAtRisk, chartWeek] = await Promise.all([
  loadHeavyWeather
    ? fetchWeatherSnapshotForConfig(weatherConfig)
    : Promise.resolve(null),
  showInsightsEarly
    ? fetchNightsAtRiskForConfig(
        weatherConfig,
        alertSettings.freezeThresholdF,
      )
    : Promise.resolve([] as Awaited<ReturnType<typeof fetchNightsAtRiskForConfig>>),
  loadChart
    ? fetchGarageTempChartData(user.id, chartWindowDays)
    : Promise.resolve({
        points: [] as Awaited<ReturnType<typeof fetchGarageTempChartData>>["points"],
        error: null as string | null,
      }),
]);

const devices = householdDevicesResult.devices;
const canEdit = canEditHousehold(householdRole);
const forceSimple = shouldForceSimpleOverview(householdRole);
if (forceSimple) {
  overviewMode = "simple";
}
const canExportCsv = entitlements.canDownloadCsv;
const hasHistory = loadChart ? chartWeek.points.length > 0 : latest.length > 0;

const chartMarkerTimes = chartWeek.points
  .map((p) => Date.parse(p.timestamp))
  .filter((ts) => Number.isFinite(ts));
const loadChartAlertMarkers = chartMarkerTimes.length > 0;

/** Device + freeze email + at least one alert (test counts). Insights wait until this. */
const hasDevices =
  devices.some((d) => d.source === "push" || d.source === "pull_url") ||
  latest.length > 0;
const hasAlertsEnabled = alertSettings.enabled;
const hasEmailAlerts =
  alertSettings.enabled &&
  alertSettings.channelEmail &&
  Boolean(resolveAlertEmail(alertSettings, user.email));
const lastAlertCandidatesEarly = [
  alertSettings.lastAlertSentAt,
  alertSettings.lastOutageAlertAt,
  alertSettings.lastRateAlertAt,
  alertSettings.lastForecastAlertAt,
  alertSettings.lastRunwayAlertAt,
  alertSettings.lastFloodAlertAt,
  alertSettings.lastNwsAlertAt,
].filter(Boolean) as string[];
const lastAlertAt =
  lastAlertCandidatesEarly.sort((a, b) => Date.parse(b) - Date.parse(a))[0] ?? null;
/** Live probes or a configured device, alerts on, and a delivered test/real alert. */
const essentialDone =
  (hasDevices || latest.length > 0) &&
  hasAlertsEnabled &&
  Boolean(lastAlertAt) &&
  (hasEmailAlerts || hasConfiguredAlertChannel(alertSettings, user.email));
const firstRunFocus = canEdit && !onboardingDismissed && !essentialDone;
const showInsights = !firstRunFocus && overviewMode === "insights";

const weatherHasCoords =
  weatherSnapshot?.lat != null &&
  weatherSnapshot?.lon != null &&
  Number.isFinite(weatherSnapshot.lat) &&
  Number.isFinite(weatherSnapshot.lon);

const [
  thermostatConnections,
  indoorReferenceSensorId,
  freezeMapSettings,
  nwsAlerts,
  weekCompareResult,
  doorSessions,
  floodLevelOverview,
  energyOverview,
  powerOffSessions,
  motionSessions,
  outdoorHourly,
  chartAlertEvents,
] = await Promise.all([
  entitlements.canUseThermostatIntegration &&
  household.householdId &&
  !firstRunFocus
    ? listConnectionsForHousehold(household.householdId)
    : Promise.resolve([] as Awaited<ReturnType<typeof listConnectionsForHousehold>>),
  showInsights && household.householdId
    ? getIndoorReferenceSensorId(household.householdId)
    : Promise.resolve(null),
  household.householdId
    ? getHouseholdFreezeMapSettings(household.householdId)
    : Promise.resolve({
        optIn: false,
        cityId: null,
        lat: null,
        lon: null,
        label: null,
      }),
  weatherHasCoords && weatherSnapshot && showInsights
    ? fetchNwsAlerts(weatherSnapshot.lat!, weatherSnapshot.lon!).catch(() => null)
    : Promise.resolve(null),
  showInsights
    ? fetchWeekCompare(user.id, user, chartWeek.points)
    : Promise.resolve({
        compare: {
          thisWeekAvgF: null,
          priorYearAvgF: null,
          deltaF: null,
          sampleCount: 0,
          priorYearSource: "none" as const,
          priorYearOutdoorLabel: null,
          earliestLocalReadingAt: null,
        },
        error: null,
      }),
  showInsights ? loadDoorSessions24h(devices) : Promise.resolve([]),
  (() => {
    if (showInsights)
      return loadFloodLevelOverview(devices).catch(() => ({
        floodOpen: [],
        recentFlood: [],
        levels: [],
      }));

    // Simple overview already has `latest` readings; avoid the heavier
    // 48h flood/level history queries to keep the dashboard fast.
    const wetFlood = latest
      .filter((row) => row.sensor.kind === "flood" && row.value_bool === true)
      .sort((a, b) => Date.parse(b.recorded_at) - Date.parse(a.recorded_at))
      .slice(0, 4)
      .map((row) => ({
        label: row.sensor.label,
        since: row.recorded_at,
      }));

    const levels = latest
      .filter((row) => row.sensor.kind === "level" && row.value_num != null)
      .map((row) => ({
        label: row.sensor.label,
        value: row.value_num as number,
        at: row.recorded_at,
        risingPerHour: null as number | null,
      }));

    return Promise.resolve({
      floodOpen: wetFlood,
      recentFlood: [],
      levels,
    });
  })(),
  showInsights ? loadEnergyOverview(devices) : Promise.resolve(null),
  showInsights ? loadPowerOffSessions24h(devices) : Promise.resolve([]),
  showInsights ? loadMotionSessions24h(devices) : Promise.resolve([]),
  // Time-to-freeze / OpenMeteo only on Insights (not Simple or first-run).
  showInsights && weatherHasCoords && weatherSnapshot
    ? fetchOpenMeteoHourlyWindow(weatherSnapshot.lat!, weatherSnapshot.lon!).catch(() => [])
    : Promise.resolve([]),
  loadChartAlertMarkers
    ? listAlertEventsInRange(
        user.id,
        new Date(Math.min(...chartMarkerTimes)).toISOString(),
        new Date(Math.max(...chartMarkerTimes)).toISOString(),
        200,
      )
    : Promise.resolve([] as Awaited<ReturnType<typeof listAlertEventsInRange>>),
]);

const chartAlertMarkers = toChartAlertMarkers(chartAlertEvents);

const [thermostatOverview, houseChartOverlay] = await Promise.all([
  showInsights && thermostatConnections[0] && household.householdId
    ? fetchThermostatContextWithStatus(
        household.householdId,
        thermostatConnections[0].provider,
      )
    : Promise.resolve(null),
  showInsights && household.householdId
    ? fetchHouseChartOverlay({
        householdId: household.householdId,
        days: chartWindowDays,
        hasThermostatConnection: thermostatConnections.length > 0,
        referenceSensorId: indoorReferenceSensorId,
      })
    : Promise.resolve({ points: [], source: null as "thermostat" | "reference" | null }),
]);

const houseContext = buildHouseContext({
  thermostatSnapshot: thermostatOverview?.snapshot ?? null,
  referenceSensorId: indoorReferenceSensorId,
  latest,
  devices,
});

const hasSensors =
  preferences.tempProbes.length > 0 ||
  devices.some((d) => d.sensors.length > 0);
const hasHouseholdMembers = members.members.length > 1;

const passwordUpdated = Astro.url.searchParams.get("password") === "updated";
const prefsSaved = Astro.url.searchParams.get("prefs_saved");
const checkedSaved = Astro.url.searchParams.get("checked_saved") === "1";
const checkedError = Astro.url.searchParams.get("checked_error") === "1";
const ackOk = Astro.url.searchParams.get("ack_ok") === "1";
const ackMsg = Astro.url.searchParams.get("ack_msg");
const snoozeFlash = Astro.url.searchParams.get("snooze") === "1";
const snoozeCleared = Astro.url.searchParams.get("snooze_cleared") === "1";
const vacationFlash = Astro.url.searchParams.get("vacation") === "1";
const vacationCleared = Astro.url.searchParams.get("vacation_cleared") === "1";
const vacationError = Astro.url.searchParams.get("vacation_error") === "1";
const snoozeHours = Astro.url.searchParams.get("hours");
const spaceCheckedMap =
  user.user_metadata?.space_checked_by_household &&
  typeof user.user_metadata.space_checked_by_household === "object" &&
  !Array.isArray(user.user_metadata.space_checked_by_household)
    ? (user.user_metadata.space_checked_by_household as Record<string, unknown>)
    : {};
const spaceCheckedAtForHousehold =
  household.householdId &&
  typeof spaceCheckedMap[household.householdId] === "string"
    ? (spaceCheckedMap[household.householdId] as string)
    : typeof user.user_metadata?.space_checked_at === "string"
      ? user.user_metadata.space_checked_at
      : null;
const prefsError = Astro.url.searchParams.get("prefs_error");

const newestReading = latest
  .map((row) => row.recorded_at)
  .filter(Boolean)
  .sort((a, b) => Date.parse(b!) - Date.parse(a!))[0] ?? null;
const lastAge = formatRelativeAge(newestReading);
const staleSummary = summarizeStaleSensors(latest, devices);
const staleSensorCount = staleSummary.total;
const lowBatteryDevices = listLowBatteryDevices(
  devices,
  alertSettings.batteryThresholdPct,
);
const lowBatteryMessage = lowBatteryBannerMessage(lowBatteryDevices);
const showMultiPropertyNudge =
  userHouseholds.households.length === 1 &&
  devices.length > 0 &&
  (entitlements.tier === "pro" || entitlements.tier === "member") &&
  canEdit &&
  !firstRunFocus;
const feedHealth = { statuses: feedHealthFromDevices(devices), error: null as string | null };
const feedIssueCount = feedHealth.statuses.filter((s) => !s.ok).length;
const sensorCount =
  latest.length > 0
    ? latest.length
    : devices.reduce((sum, d) => sum + d.sensors.length, 0);

const lastAlertAge = formatRelativeAge(lastAlertAt);

const nightsRiskCount = nightsAtRisk.filter((n) => n.atRisk).length;

const showColdSnapChecklist = shouldShowColdSnapChecklist({
  nightsRiskCount,
  outdoorTempF: weatherSnapshot?.temp ?? null,
  hasNwsFreezeAlerts: Boolean(nwsAlerts && nwsAlerts.alerts.length > 0),
});

const freezeReadiness = computeFreezeReadiness({
  alertSettings,
  devices,
  latest,
  weatherLocationConfigured: isWeatherLocationConfigured(weatherConfig),
  canUseForecast: entitlements.canUseForecastAlerts,
  canUseNws: entitlements.canUseNwsAlerts,
  hasSentAnyAlert: Boolean(lastAlertAt),
});

const coldestProbeTempF = (() => {
  const temps = latest
    .filter((row) => row.sensor.kind === "temperature" && row.value_num != null)
    .map((row) => row.value_num as number);
  return temps.length > 0 ? Math.min(...temps) : null;
})();

const wetFloodCount = latest.filter(
  (row) => row.sensor.kind === "flood" && row.value_bool === true,
).length;

const coldestProbeMarginF =
  coldestProbeTempF != null
    ? coldestProbeTempF - alertSettings.freezeThresholdF
    : null;

const freezeHours = computeFreezeHours(
  chartWeek.points,
  alertSettings.freezeThresholdF,
);
const probeSpread = computeProbeSpreadF(latest);
const indoorOutdoorDeltaF = computeIndoorOutdoorDelta(
  coldestProbeTempF ?? houseContext?.ambientTempF ?? null,
  weatherSnapshot?.temp ?? null,
);
const condensation = computeCondensationHours(chartWeek.points);
const feedUptime = computeFeedUptimePct(feedHealth.statuses);
const airQualityOverview = buildAirQualityOverview(latest);
const rssiOverview = buildRssiOverview(
  devices,
  alertSettings.rssiThreshold ?? -80,
);

const regionalBenchmark =
  showInsights &&
  household.householdId &&
  freezeMapSettings.optIn &&
  coldestProbeTempF != null
    ? await fetchRegionalBenchmark({
        householdId: household.householdId,
        yourTempF: coldestProbeTempF,
      })
    : null;

const exportToDate = new Date();
const exportFromDate = new Date(exportToDate.getTime() - 7 * 24 * 60 * 60 * 1000);
const exportFrom = exportFromDate.toISOString().slice(0, 10);
const exportTo = exportToDate.toISOString().slice(0, 10);

const useCelsius = preferences.useCelsius;
const outdoorSplit = splitOpenMeteoPastAndForecast(outdoorHourly);
const doorOpenNearby = latest.some(
  (row) =>
    row.sensor.kind === "door" &&
    (row.value_bool === true || row.value_text === "open"),
);
const timeToFreeze = buildTimeToFreezeProjection({
  currentTempF:
    coldestProbeTempF ??
    chartWeek.points.filter((p) => Number.isFinite(p.tempf)).at(-1)?.tempf ??
    alertSettings.freezeThresholdF + 10,
  freezeThresholdF: alertSettings.freezeThresholdF,
  indoorSamples: chartWeek.points
    .filter((p) => Number.isFinite(p.tempf))
    .map((p) => ({ at: p.timestamp, tempF: p.tempf })),
  outdoorPast: outdoorPointsFromHourly(outdoorSplit.past),
  outdoorForecast: outdoorPointsFromHourly(outdoorSplit.forecast),
  doorOpenNearby,
  timeZone: alertSettings.quietHoursTimezone,
  lookAheadHours: alertSettings.forecastHoursAhead,
  useCelsius,
});
const doorOpenMinutes = doorOpenMinutesFromSessions(doorSessions);
const doorTempSummary = showInsights
  ? buildDoorTempSummary(
      doorSessions,
      chartWeek.points,
      weatherSnapshot?.temp ?? null,
    )
  : null;
const powerTempSummary = showInsights
  ? buildPowerTempSummary(
      powerOffSessions,
      chartWeek.points,
      weatherSnapshot?.temp ?? null,
    )
  : null;
const motionSummary = showInsights ? buildMotionSummary(motionSessions) : null;
const batteryOverview = showInsights ? buildBatteryOverview(devices) : [];
const coolingRateFPerHour = estimateHeatingLossRate(
  chartWeek.points,
  weatherSnapshot?.temp ?? null,
);
const heatingInsights = buildHeatingInsights({
  indoorPoints: chartWeek.points,
  outdoorTempF: weatherSnapshot?.temp ?? null,
  freezeThresholdF: alertSettings.freezeThresholdF,
  doorOpenMinutes,
  houseTempF: houseContext?.ambientTempF ?? null,
  thermostatSnapshot: houseContext?.thermostatSnapshot ?? null,
});

const sensorsValue =
  sensorCount === 0
    ? "None"
    : staleSensorCount > 0
      ? `${staleSensorCount} stale`
      : `${sensorCount} fresh`;
const feedsValue =
  feedHealth.statuses.length === 0
    ? "None"
    : feedIssueCount > 0
      ? `${feedIssueCount} issue${feedIssueCount === 1 ? "" : "s"}`
      : `${feedHealth.statuses.length} online`;

const showDemoPullNudge =
  canEdit &&
  latest.length === 0 &&
  devices.length === 0 &&
  !onboardingDismissed;

const upgradeTarget = nextUpgradeTier(entitlements.tier);

const hasTestAlert = Boolean(lastAlertAt);

const showProbeSimulatorNudge =
  canEdit &&
  latest.length === 0 &&
  !onboardingDismissed &&
  !showDemoPullNudge;

const showNestConnectNudge =
  canEdit &&
  !firstRunFocus &&
  thermostatConnections.length === 0 &&
  (latest.length === 0 || !onboardingDismissed) &&
  !showDemoPullNudge &&
  !showProbeSimulatorNudge;

const showOverviewPwaNudge =
  canEdit &&
  !firstRunFocus &&
  latest.length > 0 &&
  (onboardingDismissed || essentialDone);

const showAndroidNudge =
  canEdit && !firstRunFocus && (latest.length > 0 || hasDevices);
const showBayBuddyNudge = showAndroidNudge;

const showYoureLive =
  canEdit &&
  latest.length > 0 &&
  !onboardingDismissed &&
  (!essentialDone || !hasHistory);
const showSecondaryNudges = onboardingDismissed || essentialDone;
const showAlertSetupNudge =
  showSecondaryNudges && canEdit && (!hasAlertsEnabled || !hasEmailAlerts);
const showTestAlertNudge =
  showSecondaryNudges &&
  canEdit &&
  hasAlertsEnabled &&
  hasConfiguredAlertChannel(alertSettings) &&
  !hasTestAlert;
const showFreezeMapOptInNudge =
  showSecondaryNudges &&
  canEdit &&
  latest.length > 0 &&
  Boolean(household.householdId) &&
  !freezeMapSettings.optIn;

const showClaimsPackPrompt = showInsights && canEdit && hasHistory;
const showStoryCard = showSecondaryNudges && canEdit && !showAlertSetupNudge;

/** Empty or unfinished first-run: keep Overview on device → freeze email → test alert. */
const prioritizeEmptyOverview = latest.length === 0;
const prioritizeFirstRun = firstRunFocus || prioritizeEmptyOverview;

const analyticsEvents: Array<{
  name: import("../lib/productAnalytics").ProductEvent;
  props?: Record<string, string | number | boolean>;
}> = [];
if (hasDevices) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "devices" } });
if (hasSensors) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "sensors" } });
if (hasHistory) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "history" } });
if (hasEmailAlerts) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "alerts" } });
if (hasTestAlert) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "alert_test" } });
if (latest.length > 0) analyticsEvents.push({ name: "first_ingest" });
if (Astro.url.searchParams.get("demo_pull") === "1") {
  analyticsEvents.push({ name: "demo_pull_started" });
}

const overviewBannerQueue = buildOverviewBannerQueue({
  lowBattery: Boolean(lowBatteryMessage),
  stale: staleSensorCount > 0,
  quietActive,
  prioritizeFirstRun,
  showTestAlertNudge,
  showAlertSetupNudge,
  showYoureLive,
  showFreezeMapOptInNudge,
  showStoryCard,
  showMultiPropertyNudge,
  upgradeTarget,
});
const {
  criticalBanners,
  primaryBannerIds,
  secondaryBannerIds,
  secondaryOpsBannerIds,
  secondaryTipBannerIds,
} = partitionOverviewBanners(overviewBannerQueue);

const showGrowthTips = shouldShowOverviewGrowthTips(user, {
  hasLive: latest.length > 0,
  settled: essentialDone || onboardingDismissed,
});
const showNestInDigest = showGrowthTips && showNestConnectNudge;
const showPwaInDigest = showGrowthTips && showOverviewPwaNudge;
const showAndroidInDigest = showGrowthTips && showAndroidNudge;
const showBayBuddyInDigest = showGrowthTips && showBayBuddyNudge;
const attentionOpsCount = secondaryOpsBannerIds.length;
const tipsCount =
  secondaryTipBannerIds.length +
  (showNestInDigest ? 1 : 0) +
  (showPwaInDigest ? 1 : 0) +
  (showAndroidInDigest ? 1 : 0) +
  (showBayBuddyInDigest ? 1 : 0);

const overviewUrgent =
  unackedAlertCount > 0 || criticalBanners.length > 0 || firstRunFocus;
const overviewCalm = !overviewUrgent;

function showPinnedMetric(id: PinnableOverviewMetric): boolean {
  return pinnedMetricSet.has(id);
}

const garageRisk = computeGarageRiskStatus({
  hasDevices,
  hasLiveReading: latest.length > 0,
  coldestProbeTempF,
  freezeThresholdF: alertSettings.freezeThresholdF,
  staleSensorCount,
  nightsRiskCount,
  alertsEnabled: hasAlertsEnabled,
  hasEmailAlerts,
  outdoorTempF: weatherSnapshot?.temp ?? null,
  showColdSnapChecklist,
  hoursUntilFreeze: timeToFreeze.hours,
  hitsAtLabel: timeToFreeze.hitsAtLabel,
  wetFloodCount,
});
---
<DashboardLayout
  title="Overview"
  subtitle="Space status for this property."
  liveLagging={staleSensorCount > 0 || lastAge.lagging}
>
  <ProductAnalyticsTracker events={analyticsEvents} />
  <div class="dashboard-stack">
    <OverviewFlash
      passwordUpdated={passwordUpdated}
      prefsSaved={prefsSaved}
      prefsError={prefsError}
      checkedSaved={checkedSaved}
      checkedError={checkedError}
      ackOk={ackOk}
      ackMsg={ackMsg}
      snoozeFlash={snoozeFlash}
      snoozeHours={snoozeHours}
      snoozeCleared={snoozeCleared}
      vacationFlash={vacationFlash}
      vacationCleared={vacationCleared}
      vacationError={vacationError}
    />
    <div id="overview-live-flash" class="dashboard-flash hidden" aria-live="polite"></div>

    <DashboardOnboarding
      hasDevices={hasDevices}
      hasSensors={hasSensors}
      hasHistory={hasHistory}
      hasAlertsEnabled={hasAlertsEnabled}
      hasEmailAlerts={hasEmailAlerts}
      hasTestAlert={hasTestAlert}
      hasHouseholdMembers={hasHouseholdMembers}
      hasLiveSensors={latest.length > 0}
      hasHousehold={Boolean(household.householdId)}
      hasFloodSensor={devices.some((d) => d.sensors.some((s) => s.kind === "flood"))}
      dismissed={onboardingDismissed}
      showDemoFeed={showDemoPullNudge}
    />

    <GarageRiskStatusCard status={garageRisk} />
    <div id="overview-offline-banner" class="alert-warning mb-0" role="status" hidden>
      Showing last-known dashboard status (offline or stale cache).
    </div>

    <UnackedAlertsBanner
      count={unackedAlertCount}
      canEdit={canEdit}
    />

    <OverviewQuickActions
      canEdit={canEdit}
      unackedCount={unackedAlertCount}
      snoozeUntil={alertSettings.snoozeUntil ?? null}
      spaceCheckedAt={spaceCheckedAtForHousehold}
      householdId={household.householdId}
      deviceSpaces={[
        ...new Set(
          devices
            .map((device) => device.space?.trim())
            .filter((space): space is string => Boolean(space)),
        ),
      ].sort((a, b) => a.localeCompare(b))}
    />

    <LowBatteryBanner message={primaryBannerIds.has("lowBattery") ? lowBatteryMessage : null} />

    {primaryBannerIds.has("stale") && staleSensorCount > 0 && (
      <div class="alert-warning mb-0" role="status" data-stale-banner>
        {staleSummary.bannerMessage}.
        {" "}
        <a href="/dashboard/live" class="text-link">Open Live</a>
        {" · "}
        <a href={devicesOpsPath()} class="text-link">Devices</a>
        {" · "}
        <a href="/about/debugging-stale-readings" class="text-link">Debug guide</a>
      </div>
    )}

    {!canEdit && (
      <p class="alert-warning mt-0 mb-0" role="status">
        View-only access: you can see live data but cannot change devices, alerts, or sharing.
      </p>
    )}

    <section class="dashboard-section" id="status" aria-labelledby="status-heading">
      <div class="dashboard-section-head">
        <div>
          <h2 id="status-heading" class="dashboard-section-title">Status</h2>
          {firstRunFocus && (
            <p class="dashboard-section-desc mb-0">
              Essentials only until freeze + email + a test alert are done.
            </p>
          )}
          {!firstRunFocus && (
            <p class="dashboard-section-desc mb-0">
              Ops snapshot — probe values live on
              <a class="text-link" href="/dashboard/live">Live</a>.
            </p>
          )}
        </div>
        {!firstRunFocus && canEdit && (
          <details class="status-pin-picker">
            <summary class="text-sm text-link cursor-pointer">Pin metrics</summary>
            <form
              action="/api/user/dashboard-pinned-metrics"
              method="post"
              class="mt-3 flex flex-wrap gap-3 items-end"
            >
              <input type="hidden" name="redirect" value="/dashboard" />
              {PINNABLE_OVERVIEW_METRICS.map((id) => (
                <label class="text-sm flex items-center gap-1">
                  <input
                    type="checkbox"
                    name="metrics"
                    value={id}
                    checked={pinnedMetricSet.has(id)}
                  />
                  <span>{PINNABLE_OVERVIEW_METRIC_LABELS[id]}</span>
                </label>
              ))}
              <button type="submit" class="btn-secondary btn-sm">Save pins</button>
            </form>
          </details>
        )}
      </div>
      <DashboardMetricGrid>
        {(canEdit || showPinnedMetric("last_reading")) && (
          <MetricCard
            label="Last reading"
            value={newestReading ? lastAge.label : "None yet"}
            href="/dashboard/live"
            tone={!newestReading || lastAge.lagging ? "warning" : "success"}
            metricId="last_reading"
            pinned={showPinnedMetric("last_reading")}
            statusVisible={showPinnedMetric("last_reading")}
            canPin={canEdit}
            snapshotField="last_reading"
            liveAgeIso={newestReading}
          />
        )}
        {(canEdit || showPinnedMetric("sensors")) && (
          <MetricCard
            label="Sensors"
            value={sensorsValue}
            detail={sensorCount > 0 ? `${sensorCount} total` : null}
            href="/dashboard/devices"
            tone={staleSensorCount > 0 ? "warning" : "neutral"}
            metricId="sensors"
            pinned={showPinnedMetric("sensors")}
            statusVisible={showPinnedMetric("sensors")}
            canPin={canEdit}
            snapshotField="sensors"
          />
        )}
        {!firstRunFocus && (canEdit || showPinnedMetric("feeds")) && (
          <MetricCard
            label="Feeds"
            value={feedsValue}
            href={devicesSetupPath({ tab: "pull", hash: "pull-feeds" })}
            tone={feedIssueCount > 0 ? "warning" : "neutral"}
            metricId="feeds"
            pinned={showPinnedMetric("feeds")}
            statusVisible={showPinnedMetric("feeds")}
            canPin={canEdit}
          />
        )}
        {(canEdit || showPinnedMetric("alerts")) && (
          <MetricCard
            label="Alerts"
            value={alertSettings.enabled ? "On" : "Off"}
            detail={lastAlertAt ? `Last ${lastAlertAge.label}` : "Send a test"}
            href="/dashboard/alerts"
            tone={alertSettings.enabled ? "success" : "neutral"}
            metricId="alerts"
            pinned={showPinnedMetric("alerts")}
            statusVisible={showPinnedMetric("alerts")}
            canPin={canEdit}
            snapshotField="alerts"
          />
        )}
        {!firstRunFocus && houseContext && (canEdit || showPinnedMetric("house")) && (
          <MetricCard
            label="House"
            value={houseContext.metricValue}
            detail={houseContext.metricDetail}
            href={devicesSetupPath({ tab: "pull", hash: "indoor-reference" })}
            tone="neutral"
            metricId="house"
            pinned={showPinnedMetric("house")}
            statusVisible={showPinnedMetric("house")}
            canPin={canEdit}
          />
        )}
        {!firstRunFocus && (
          <>
            {(canEdit || showPinnedMetric("freeze_hours")) && (
              <MetricCard
                label="Freeze hours (7d)"
                value={
                  chartWeek.points.length < 2
                    ? "—"
                    : `${freezeHours.hoursBelow34.toFixed(1)} h`
                }
                detail={
                  freezeHours.degreeHoursBelow > 0
                    ? `${freezeHours.degreeHoursBelow.toFixed(0)} °F·h below ${alertSettings.freezeThresholdF}°F`
                    : freezeHours.coldestF != null
                      ? `Coldest ${freezeHours.coldestF.toFixed(1)}°F`
                      : `≤ ${alertSettings.freezeThresholdF}°F`
                }
                href="/dashboard/history"
                tone={freezeHours.hoursBelow34 > 0 ? "warning" : "neutral"}
                metricId="freeze_hours"
                pinned={showPinnedMetric("freeze_hours")}
                statusVisible={showPinnedMetric("freeze_hours")}
                canPin={canEdit}
              />
            )}
            {(canEdit || showPinnedMetric("coldest_margin")) && (
              <MetricCard
                label="Coldest margin"
                value={
                  coldestProbeMarginF == null
                    ? "—"
                    : `${coldestProbeMarginF >= 0 ? "+" : ""}${coldestProbeMarginF.toFixed(1)}°F`
                }
                detail={
                  coldestProbeTempF != null
                    ? `${coldestProbeTempF.toFixed(1)}°F vs ${alertSettings.freezeThresholdF}°F alert`
                    : "No live probe"
                }
                href="/dashboard/live"
                tone={
                  coldestProbeMarginF == null
                    ? "neutral"
                    : coldestProbeMarginF <= 0
                      ? "danger"
                      : coldestProbeMarginF <= 5
                        ? "warning"
                        : "success"
                }
                metricId="coldest_margin"
                pinned={showPinnedMetric("coldest_margin")}
                statusVisible={showPinnedMetric("coldest_margin")}
                canPin={canEdit}
                snapshotField="coldest_margin"
              />
            )}
            {(canEdit || showPinnedMetric("indoor_outdoor")) && (
              <MetricCard
                label="Indoor − outdoor"
                value={
                  indoorOutdoorDeltaF == null
                    ? "—"
                    : `${indoorOutdoorDeltaF >= 0 ? "+" : ""}${indoorOutdoorDeltaF.toFixed(1)}°F`
                }
                detail={
                  indoorOutdoorDeltaF == null
                    ? "Need live probe + weather"
                    : weatherSnapshot?.temp != null && coldestProbeTempF != null
                      ? `${coldestProbeTempF.toFixed(0)}°F indoor vs ${weatherSnapshot.temp.toFixed(0)}°F out`
                      : "ΔT using coldest probe"
                }
                href="/dashboard/live"
                tone={
                  indoorOutdoorDeltaF == null
                    ? "neutral"
                    : indoorOutdoorDeltaF < 5
                      ? "warning"
                      : "neutral"
                }
                metricId="indoor_outdoor"
                pinned={showPinnedMetric("indoor_outdoor")}
                statusVisible={showPinnedMetric("indoor_outdoor")}
                canPin={canEdit}
              />
            )}
            {(canEdit || showPinnedMetric("probe_spread")) && (
              <MetricCard
                label="Probe spread"
                value={probeSpread ? `${probeSpread.spreadF.toFixed(1)}°F` : "—"}
                detail={
                  probeSpread
                    ? `${probeSpread.coldestF.toFixed(1)}–${probeSpread.warmestF.toFixed(1)}°F · ${probeSpread.probeCount} probes`
                    : "Need 2+ live temps"
                }
                href="/dashboard/live"
                tone={
                  probeSpread == null
                    ? "neutral"
                    : probeSpread.spreadF >= 8
                      ? "warning"
                      : "neutral"
                }
                metricId="probe_spread"
                pinned={showPinnedMetric("probe_spread")}
                statusVisible={showPinnedMetric("probe_spread")}
                canPin={canEdit}
              />
            )}
            {(canEdit || showPinnedMetric("condensation")) && (
              <MetricCard
                label="Condensation (7d)"
                value={
                  chartWeek.points.length < 2
                    ? "—"
                    : `${condensation.hours.toFixed(1)} h`
                }
                detail={
                  condensation.latestMarginF != null
                    ? `Now ${condensation.latestMarginF.toFixed(1)}°F above dew point`
                    : "Hours near dew point"
                }
                href="/dashboard/history"
                tone={
                  condensation.hours >= 6 ||
                  (condensation.latestMarginF != null && condensation.latestMarginF <= 2)
                    ? "warning"
                    : "neutral"
                }
                metricId="condensation"
                pinned={showPinnedMetric("condensation")}
                statusVisible={showPinnedMetric("condensation")}
                canPin={canEdit}
              />
            )}
            {feedUptime && (canEdit || showPinnedMetric("feed_health")) && (
              <MetricCard
                label="Feed health"
                value={`${feedUptime.pct.toFixed(0)}%`}
                detail={`${feedUptime.ok}/${feedUptime.total} feeds reachable now`}
                href={devicesSetupPath({ tab: "pull", hash: "pull-feeds" })}
                tone={feedUptime.pct < 100 ? "warning" : "success"}
                metricId="feed_health"
                pinned={showPinnedMetric("feed_health")}
                statusVisible={showPinnedMetric("feed_health")}
                canPin={canEdit}
              />
            )}
          </>
        )}
      </DashboardMetricGrid>
      {!firstRunFocus && canEdit && (
        <p class="mt-3 mb-0 text-sm text-[var(--color-text-muted)]">
          Or use ★ on each card. More comfort settings in
          <a class="text-link" href="/dashboard/settings#dashboard-comfort"> Settings</a>.
        </p>
      )}
    </section>

    <DemoPullNudge show={showDemoPullNudge} />
    <ProbeSimulatorNudge show={showProbeSimulatorNudge} />

    {(hasDevices || chartWeek.points.length > 0) && (
      <TimeToFreezeCard
        projection={timeToFreeze}
        freezeThresholdF={alertSettings.freezeThresholdF}
        useCelsius={useCelsius}
      />
    )}

    <FloodLevelCard overview={floodLevelOverview} />

    <ColdSnapChecklistCard
      show={showColdSnapChecklist}
      coldSnapEnabled={alertSettings.forecastFreezeEnabled}
      canUseForecast={entitlements.canUseForecastAlerts}
    />

    <AttentionNeededStrip
      count={attentionOpsCount}
      title="Attention needed"
      storageKey="tt-attention-ops-collapsed"
      defaultOpen={attentionOpsCount > 0 && !overviewCalm}
      showQuietControls={false}
    >
      <div class="space-y-4">
          <AlertSetupNudge
            hasAlertsEnabled={hasAlertsEnabled}
            hasEmailAlerts={hasEmailAlerts}
            canEdit={canEdit}
            show={secondaryBannerIds.has("alertSetup")}
          />
          <TestAlertNudge
            canEdit={canEdit}
            show={secondaryBannerIds.has("testAlert")}
          />
          {secondaryBannerIds.has("freezeReadiness") && (
            <FreezeReadinessCard readiness={freezeReadiness} />
          )}
          {secondaryBannerIds.has("stale") && staleSensorCount > 0 && (
            <div class="alert-warning mb-0" role="status" data-stale-banner>
              {staleSummary.bannerMessage}.
              {" "}
              <a href="/dashboard/live" class="text-link">Open Live</a>
              {" · "}
              <a href={devicesOpsPath()} class="text-link">Devices</a>
            </div>
          )}
          <LowBatteryBanner message={secondaryBannerIds.has("lowBattery") ? lowBatteryMessage : null} />
      </div>
    </AttentionNeededStrip>

    <AttentionNeededStrip
      count={tipsCount}
      quietActive={quietActive}
      quietUntil={quietUntil}
      title="Tips"
      storageKey="tt-attention-tips-collapsed"
      defaultOpen={false}
      showQuietControls={true}
      showGrowthDismiss={showNestInDigest || showPwaInDigest || showAndroidInDigest || showBayBuddyInDigest}
    >
      <div class="space-y-4">
          <NestConnectNudge
            show={showNestInDigest}
            nestEntitled={entitlements.canUseThermostatIntegration}
          />
          <OverviewPwaNudge show={showPwaInDigest} />
          <DashboardAndroidNudge show={showAndroidInDigest} />
          <DashboardBayBuddyNudge show={showBayBuddyInDigest} />
          <DashboardYoureLive
            show={secondaryBannerIds.has("youreLive")}
            hasAlertsEnabled={hasAlertsEnabled}
            hasEmailAlerts={hasEmailAlerts}
            hasTestAlert={hasTestAlert}
          />
          <FreezeMapOptInNudge
            canEdit={canEdit}
            show={secondaryBannerIds.has("freezeMap") || primaryBannerIds.has("freezeMap")}
            cityLabel={freezeMapSettings.label}
          />
          <DashboardStoryCard show={secondaryBannerIds.has("story") || primaryBannerIds.has("story")} />
          <DashboardMultiPropertyNudge show={secondaryBannerIds.has("multiProperty") || primaryBannerIds.has("multiProperty")} />
          {secondaryBannerIds.has("upgrade") && upgradeTarget === "member" && (
            <UpgradeNudge feature="data_retention" tier={entitlements.tier} compact />
          )}
          {secondaryBannerIds.has("upgrade") && upgradeTarget === "pro" && (
            <UpgradeNudge feature="sms_alerts" tier={entitlements.tier} compact />
          )}
      </div>
    </AttentionNeededStrip>

    <section class="dashboard-section" aria-labelledby="curves-heading">
      <div class="dashboard-section-head">
        <div>
          <h2 id="curves-heading" class="dashboard-section-title">Probe curves</h2>
          <p class="dashboard-section-desc">
            {firstRunFocus
              ? `${chartWindowDays}-day temperature trend. Insights unlock after freeze + email + a test alert.`
              : forceSimple
                ? `${chartWindowDays}-day temperature trend (Simple view for viewers).`
                : showInsights
                  ? `${chartWindowDays}-day traces, freeze outlook, and week-over-week change.`
                  : `${chartWindowDays}-day temperature trend. Switch to Insights for freeze outlook and comparisons.`}
          </p>
        </div>
        {!firstRunFocus && !forceSimple && <DashboardOverviewToggle mode={overviewMode} />}
      </div>
      <div class="dashboard-insights">
        <div class="dashboard-insights-primary">
          <DashboardWeekChart
            points={chartWeek.points}
            housePoints={houseChartOverlay.points}
            houseLegend={
              houseChartOverlay.source === "thermostat"
                ? "House (thermostat)"
                : houseContext?.referenceLabel
                  ? `House (${houseContext.referenceLabel})`
                  : "House"
            }
            freezeThresholdF={alertSettings.freezeThresholdF}
            canExport={canExportCsv}
            exportFrom={exportFrom}
            exportTo={exportTo}
            days={chartWindowDays}
            alertMarkers={chartAlertMarkers}
          />
          {showInsights && (
            <NightsAtRiskCard
              nightsAtRisk={nightsAtRisk}
              nightsRiskCount={nightsRiskCount}
              freezeThresholdF={alertSettings.freezeThresholdF}
              weatherSnapshot={weatherSnapshot}
              weatherHasCoords={weatherHasCoords}
              nwsAlerts={nwsAlerts}
            />
          )}
        </div>
        {showInsights && (
          <aside class="dashboard-insights-side">
            <WeekCompareCard compare={weekCompareResult.compare} useCelsius={useCelsius} />
            {regionalBenchmark && (
              <RegionalBenchmarkCard benchmark={regionalBenchmark} />
            )}
            <HeatingInsightsCard insights={heatingInsights} />
            <OverviewInsightsExtras
              doorTempSummary={doorTempSummary}
              powerTempSummary={powerTempSummary}
              motionSummary={motionSummary}
              devices={devices}
              doorSessions={doorSessions}
              householdId={household.householdId}
              batteryOverview={batteryOverview}
              rssiOverview={rssiOverview}
              airQualityOverview={airQualityOverview}
              energyOverview={energyOverview}
              coolingRateFPerHour={coolingRateFPerHour}
              canUseClaimsPack={entitlements.canUseClaimsPack}
              tier={entitlements.tier}
              showClaimsPackPrompt={showClaimsPackPrompt}
            />
          </aside>
        )}
      </div>
      {!showInsights && (
        <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
          <a class="text-link" href="/dashboard/history">Open History</a> for full charts, CSV export, and claims pack.
        </p>
      )}
    </section>
  </div>
  <script>
    (function () {
      var loadedAt = Date.now();
      var label = document.getElementById("overview-refresh-label");
      var refreshButtons = function () {
        return document.querySelectorAll("[data-dashboard-refresh]");
      };
      var flashKeys = [
        "checked_saved",
        "checked_error",
        "ack_ok",
        "ack_msg",
        "ack_error",
        "password",
        "prefs_saved",
        "prefs_error",
        "snooze",
        "snooze_cleared",
        "hours",
        "vacation",
        "vacation_cleared",
        "vacation_error",
      ];

      function stripFlashParams() {
        var url = new URL(window.location.href);
        var changed = false;
        flashKeys.forEach(function (key) {
          if (url.searchParams.has(key)) {
            url.searchParams.delete(key);
            changed = true;
          }
        });
        if (changed) {
          window.history.replaceState({}, "", url.pathname + (url.search || "") + url.hash);
        }
      }

      function renderAge() {
        if (!label) return;
        var mins = Math.max(0, Math.round((Date.now() - loadedAt) / 60000));
        label.textContent =
          mins < 1 ? "Updated just now" : mins === 1 ? "Updated 1m ago" : "Updated " + mins + "m ago";
      }

      function setMetric(field, value, detail, tone) {
        var card = document.querySelector('[data-snapshot-field="' + field + '"]');
        if (!card) return;
        var valueEl = card.querySelector("[data-metric-value]");
        var detailEl = card.querySelector("[data-metric-detail]");
        if (valueEl && value != null) valueEl.textContent = value;
        if (detailEl && detail != null) detailEl.textContent = detail;
        if (tone) {
          card.className = card.className.replace(/metric-card--\w+/g, "metric-card--" + tone);
        }
      }

      function showLiveFlash(message, isError) {
        var flash = document.getElementById("overview-live-flash");
        if (!flash) return;
        flash.textContent = message;
        flash.classList.remove("hidden");
        flash.classList.toggle("dashboard-flash--error", Boolean(isError));
        flash.classList.toggle("alert-warning", Boolean(isError));
        flash.classList.toggle("alert-success", !isError);
        window.clearTimeout(showLiveFlash._t);
        showLiveFlash._t = window.setTimeout(function () {
          flash.classList.add("hidden");
        }, 4500);
      }

      function applyUnackedChrome(count) {
        var n = typeof count === "number" ? count : 0;
        var banner = document.querySelector("[data-unacked-banner]");
        if (banner) {
          banner.setAttribute("data-unacked-count", String(n));
          var show = n > 0;
          banner.hidden = !show;
          banner.classList.toggle("hidden", !show);
          var label = banner.querySelector("[data-unacked-label]");
          if (label) {
            label.textContent = " unhandled alert" + (n === 1 ? "" : "s") + ".";
          }
          var ackAllWrap = banner.querySelector("[data-unacked-ack-all]");
          var canEdit = banner.getAttribute("data-can-edit") === "1";
          if (ackAllWrap) {
            ackAllWrap.classList.toggle("hidden", !(canEdit && n > 0));
            var ackBtn = ackAllWrap.querySelector("[data-qa-action='ack_all']");
            if (ackBtn) {
              ackBtn.setAttribute(
                "data-qa-confirm",
                "Mark all " + n + " unhandled alerts as handled?",
              );
            }
          }
          var claims = banner.querySelector("[data-unacked-claims]");
          if (claims) claims.classList.toggle("hidden", n <= 0);
        }

        var qa = document.querySelector("[data-overview-quick-actions]");
        if (qa) qa.setAttribute("data-unacked", String(n));

        var ackSlot = document.querySelector("[data-qa-ack-slot]");
        if (ackSlot) {
          if (n > 0) {
            var ackHtml =
              '<button type="button" class="btn-secondary btn-sm" data-qa-action="ack_latest">Acknowledge latest</button>';
            if (n > 1) {
              ackHtml +=
                '<button type="button" class="btn-ghost btn-sm" data-qa-action="ack_all" data-qa-confirm="Mark all ' +
                n +
                ' unhandled alerts as handled?">Handle remaining (<span data-overview-field="unackedCount">' +
                n +
                "</span>)</button>";
            }
            ackSlot.innerHTML = ackHtml;
          } else {
            ackSlot.innerHTML =
              '<a class="btn-ghost btn-sm" href="/dashboard/alerts" data-qa-alerts-clear>Alerts clear</a>';
          }
        }
      }

      function applySnoozeChrome(active) {
        var qa = document.querySelector("[data-overview-quick-actions]");
        if (qa) qa.setAttribute("data-snooze-active", active ? "1" : "0");
        var slot = document.querySelector("[data-qa-snooze-slot]");
        if (!slot) return;
        if (active) {
          slot.innerHTML =
            '<button type="button" class="btn-ghost btn-sm" id="overview-snooze-action" data-qa-snooze="clear_snooze">Clear snooze</button>';
        } else {
          slot.innerHTML =
            '<span class="text-sm text-[var(--color-text-muted)]">Snooze</span>' +
            [1, 4, 24]
              .map(function (hours) {
                return (
                  '<button type="button" class="btn-secondary btn-sm"' +
                  (hours === 24 ? ' id="overview-snooze-action"' : "") +
                  ' data-qa-snooze="snooze" data-qa-hours="' +
                  hours +
                  '">' +
                  hours +
                  "h</button>"
                );
              })
              .join("");
        }
      }

      function applySnapshot(data) {
        if (!data || typeof data !== "object") return;
        loadedAt = Date.now();
        renderAge();
        var title = document.querySelector('[data-overview-field="riskTitle"]');
        var detail = document.querySelector('[data-overview-field="riskDetail"]');
        var riskCard = document.querySelector("[data-overview-risk]");
        var riskAction = document.querySelector('[data-overview-field="riskAction"]');
        if (title && data.riskTitle) title.textContent = data.riskTitle;
        if (detail && data.riskDetail) detail.textContent = data.riskDetail;
        if (riskCard && data.risk) {
          riskCard.setAttribute("data-risk-level", data.risk);
          riskCard.className = riskCard.className.replace(
            /garage-risk-status--\w+/g,
            "garage-risk-status--" + data.risk,
          );
        }
        if (riskAction) {
          if (data.riskActionLabel) riskAction.textContent = data.riskActionLabel;
          if (data.riskActionHref) riskAction.setAttribute("href", data.riskActionHref);
        }

        if (typeof data.unackedAlerts === "number") {
          applyUnackedChrome(data.unackedAlerts);
          var qaDetails = document.querySelector("[data-qa-details]");
          if (qaDetails && data.unackedAlerts > 0) qaDetails.open = true;
          document.querySelectorAll('[data-overview-field="unackedCount"]').forEach(function (el) {
            el.textContent = String(data.unackedAlerts);
          });
        }

        if (typeof data.snoozeActive === "boolean") {
          applySnoozeChrome(data.snoozeActive);
        }

        if (data.lastReadingAt) {
          setMetric(
            "last_reading",
            data.lastReadingAge || "just now",
            null,
            data.lastReadingLagging ? "warning" : "success",
          );
          var lastValue = document.querySelector(
            '[data-snapshot-field="last_reading"] [data-metric-value]',
          );
          if (lastValue) lastValue.setAttribute("data-live-age-iso", data.lastReadingAt);
          window.dispatchEvent(
            new CustomEvent("tt:live-readings", {
              detail: {
                lastReadingAt: data.lastReadingAt,
                sensorCount: typeof data.sensorCount === "number" ? data.sensorCount : undefined,
              },
            }),
          );
        } else {
          setMetric("last_reading", "None yet", null, "warning");
        }

        if (typeof data.sensorCount === "number") {
          var sensorsLabel =
            data.sensorCount === 0
              ? "None"
              : data.staleSensors > 0
                ? data.staleSensors + " stale"
                : data.sensorCount + " fresh";
          setMetric(
            "sensors",
            sensorsLabel,
            data.sensorCount > 0 ? data.sensorCount + " total" : null,
            data.staleSensors > 0 ? "warning" : "neutral",
          );
        }

        if (typeof data.alertsEnabled === "boolean") {
          setMetric("alerts", data.alertsEnabled ? "On" : "Off", null, data.alertsEnabled ? "success" : "neutral");
        }

        if (typeof data.coldestMarginF === "number") {
          var margin = data.coldestMarginF;
          var marginLabel = (margin >= 0 ? "+" : "") + margin.toFixed(1) + "°F";
          var marginDetail =
            data.coldestProbeTempF != null
              ? data.coldestProbeTempF.toFixed(1) +
                "°F vs " +
                data.freezeThresholdF +
                "°F alert"
              : null;
          var marginTone =
            margin <= 0 ? "danger" : margin <= 5 ? "warning" : "success";
          setMetric("coldest_margin", marginLabel, marginDetail, marginTone);
        }

        document.querySelectorAll("[data-stale-banner]").forEach(function (el) {
          var show = typeof data.staleSensors === "number" && data.staleSensors > 0;
          el.hidden = !show;
          el.classList.toggle("hidden", !show);
          if (show && data.staleBannerMessage) {
            var textNode = el.firstChild;
            if (textNode && textNode.nodeType === 3) {
              textNode.textContent = data.staleBannerMessage + ". ";
            }
          }
        });

        var banner = document.getElementById("overview-offline-banner");
        if (banner) banner.hidden = true;
      }

      function setRefreshDisabled(disabled: boolean) {
        refreshButtons().forEach(function (el) {
          if (el instanceof HTMLButtonElement) el.disabled = disabled;
        });
      }

      function softRefresh() {
        setRefreshDisabled(true);
        fetch("/api/user/dashboard-snapshot", { headers: { Accept: "application/json" } })
          .then(function (res) {
            var banner = document.getElementById("overview-offline-banner");
            if (res.headers.get("X-ThermalTrace-Stale") === "1" && banner) {
              banner.hidden = false;
            }
            if (!res.ok) throw new Error("refresh failed");
            return res.json();
          })
          .then(applySnapshot)
          .catch(function () {
            var banner = document.getElementById("overview-offline-banner");
            if (banner) banner.hidden = false;
          })
          .finally(function () {
            setRefreshDisabled(false);
          });
      }

      window.addEventListener("overview:soft-refresh", softRefresh);
      stripFlashParams();
      setInterval(renderAge, 30000);
      setInterval(function () {
        if (document.visibilityState !== "visible") return;
        if (Date.now() - loadedAt < 2.5 * 60 * 1000) return;
        softRefresh();
      }, 60000);

      function setPinUi(metric, pinned) {
        document.querySelectorAll('[data-pin-metric="' + metric + '"]').forEach(function (btnEl) {
          btnEl.setAttribute("data-pinned", pinned ? "1" : "0");
          btnEl.textContent = pinned ? "★" : "☆";
          var label = btnEl.getAttribute("aria-label") || "";
          if (label) {
            if (/^Unpin /.test(label)) {
              btnEl.setAttribute("aria-label", pinned ? label : label.replace(/^Unpin /, "Pin "));
            } else if (/^Pin /.test(label)) {
              btnEl.setAttribute("aria-label", pinned ? label.replace(/^Pin /, "Unpin ") : label);
            }
          }
          btnEl.title = pinned ? "Unpin from Status" : "Pin to Status";
        });
        var card = document.querySelector('#status [data-metric-id="' + metric + '"]');
        if (card) {
          card.hidden = !pinned;
          card.classList.toggle("hidden", !pinned);
        }
        var checkbox = document.querySelector(
          'input[name="metrics"][value="' + metric + '"]',
        );
        if (checkbox) checkbox.checked = pinned;
      }

      document.addEventListener("click", function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;
        var pinBtn = target.closest("[data-pin-metric]");
        if (!(pinBtn instanceof HTMLButtonElement)) return;
        event.preventDefault();
        event.stopPropagation();
        var metric = pinBtn.getAttribute("data-pin-metric");
        if (!metric) return;
        var wasPinned = pinBtn.getAttribute("data-pinned") === "1";
        pinBtn.disabled = true;
        fetch("/api/user/dashboard-pinned-metrics", {
          method: "POST",
          credentials: "same-origin",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ action: "toggle", metric: metric }),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { ok: res.ok, status: res.status, data: data };
            });
          })
          .then(function (result) {
            if (!result.ok) {
              showLiveFlash(
                (result.data && result.data.error) || "Could not update pin.",
                true,
              );
              return;
            }
            var metrics = result.data && result.data.metrics;
            var nowPinned = Array.isArray(metrics) ? metrics.indexOf(metric) !== -1 : !wasPinned;
            setPinUi(metric, nowPinned);
            if (nowPinned) {
              showLiveFlash("Pinned to Status.", false);
            } else {
              showLiveFlash("Unpinned from Status.", false);
            }
          })
          .catch(function () {
            showLiveFlash("Could not update pin.", true);
          })
          .finally(function () {
            pinBtn.disabled = false;
          });
      });

      fetch("/api/user/dashboard-snapshot", { headers: { Accept: "application/json" } })
        .then(function (res) {
          var banner = document.getElementById("overview-offline-banner");
          if (!banner) return;
          if (res.headers.get("X-ThermalTrace-Stale") === "1") {
            banner.hidden = false;
          }
        })
        .catch(function () {
          var banner = document.getElementById("overview-offline-banner");
          if (banner) banner.hidden = false;
        });
    })();
  </script>
</DashboardLayout>
