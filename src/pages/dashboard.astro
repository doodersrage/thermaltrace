---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import DashboardOnboarding from "../components/DashboardOnboarding.astro";
import DashboardAndroidNudge from "../components/DashboardAndroidNudge.astro";
import DashboardBayBuddyNudge from "../components/DashboardBayBuddyNudge.astro";
import DemoPullNudge from "../components/DemoPullNudge.astro";
import ProbeSimulatorNudge from "../components/dashboard/ProbeSimulatorNudge.astro";
import NestConnectNudge from "../components/dashboard/NestConnectNudge.astro";
import OverviewPwaNudge from "../components/dashboard/OverviewPwaNudge.astro";
import DashboardYoureLive from "../components/DashboardYoureLive.astro";
import AlertSetupNudge from "../components/dashboard/AlertSetupNudge.astro";
import DashboardStoryCard from "../components/dashboard/DashboardStoryCard.astro";
import GarageRiskStatusCard from "../components/dashboard/GarageRiskStatusCard.astro";
import { computeGarageRiskStatus } from "../lib/garageRiskStatus";
import { getAuthFromCookies } from "../lib/auth";
import { getUserPreferences } from "../lib/userPreferences";
import { fetchUserTempConfig } from "../lib/userTempConfig";
import { getUserEntitlements } from "../lib/entitlements";
import { getUserDevicesAsTempConfig, listHouseholdDevices } from "../lib/devices";
import { ensureAlertDeliveryEvidence, getAlertSettingsForUser } from "../lib/notify";
import {
  getOrCreateHouseholdForUser,
  listHouseholdMembers,
  listUserHouseholds,
  getUserHouseholdId,
  getUserHouseholdRole,
  canEditHousehold,
} from "../lib/households";
import HouseholdSwitcher from "../components/HouseholdSwitcher.astro";
import DoorDurationCard from "../components/DoorDurationCard.astro";
import DoorEventHistory from "../components/DoorEventHistory.astro";
import TimeToFreezeCard from "../components/TimeToFreezeCard.astro";
import WeekCompareCard from "../components/WeekCompareCard.astro";
import UpgradeNudge from "../components/UpgradeNudge.astro";
import { nextUpgradeTier } from "../lib/planComparison";
import {
  fetchWeekCompare,
} from "../lib/dashboardInsights";
import { fetchGarageTempChartData } from "../lib/garageTempsHistory";
import { checkFeedHealth } from "../lib/collectHistory";
import { fetchLatestSensorValues } from "../lib/sensorReadings";
import { formatRelativeAge } from "../lib/relativeTime";
import {
  summarizeStaleSensors,
} from "../lib/sensorFreshness";
import {
  listLowBatteryDevices,
  lowBatteryBannerMessage,
} from "../lib/deviceBatteryUi";
import {
  fetchNightsAtRiskForConfig,
  fetchWeatherSnapshotForConfig,
} from "../lib/weatherContext";
import { isWeatherLocationConfigured } from "../lib/personalWeatherStations";
import { personalWeatherConfigFromPreferences } from "../lib/userPreferences";
import { fetchNwsAlerts } from "../lib/nwsAlerts";
import {
  buildTimeToFreezeProjection,
  outdoorPointsFromHourly,
} from "../lib/spaceThermalModel";
import {
  fetchOpenMeteoHourlyWindow,
  splitOpenMeteoPastAndForecast,
} from "../lib/openMeteoHistory";
import {
  buildHeatingInsights,
  estimateHeatingLossRate,
} from "../lib/heatingInsights";
import HeatingInsightsCard from "../components/HeatingInsightsCard.astro";
import { listConnectionsForHousehold } from "../lib/thermostatConnections";
import {
  fetchThermostatContextWithStatus,
} from "../lib/thermostatCorrelation";
import { getIndoorReferenceSensorId } from "../lib/indoorReference";
import { buildHouseContext, fetchHouseChartOverlay } from "../lib/houseContext";
import ProductAnalyticsTracker from "../components/ProductAnalyticsTracker.astro";
import UnackedAlertsBanner from "../components/UnackedAlertsBanner.astro";
import ColdSnapChecklistCard from "../components/ColdSnapChecklistCard.astro";
import FreezeReadinessCard from "../components/dashboard/FreezeReadinessCard.astro";
import { shouldShowColdSnapChecklist } from "../lib/coldSnapChecklist";
import { computeFreezeReadiness, hasConfiguredAlertChannel } from "../lib/freezeReadiness";
import { resolveAlertEmail } from "../lib/alerts";
import { getHouseholdFreezeMapSettings } from "../lib/freezeMap";
import { fetchRegionalBenchmark } from "../lib/regionalBenchmark";
import TestAlertNudge from "../components/dashboard/TestAlertNudge.astro";
import FreezeMapOptInNudge from "../components/dashboard/FreezeMapOptInNudge.astro";
import RegionalBenchmarkCard from "../components/dashboard/RegionalBenchmarkCard.astro";
import ClaimsPackPromptCard from "../components/dashboard/ClaimsPackPromptCard.astro";
import { countUnacknowledgedAlerts } from "../lib/alertEvents";
import LowBatteryBanner from "../components/dashboard/LowBatteryBanner.astro";
import DashboardMultiPropertyNudge from "../components/dashboard/DashboardMultiPropertyNudge.astro";
import DashboardOverviewToggle from "../components/dashboard/DashboardOverviewToggle.astro";
import { getDashboardOverviewMode } from "../lib/dashboardOverviewMode";
import { computeFreezeHours } from "../lib/freezeHours";
import {
  buildAirQualityOverview,
  buildBatteryOverview,
  buildDoorTempSummary,
  buildMotionSummary,
  buildPowerTempSummary,
  buildRssiOverview,
  computeCondensationHours,
  computeFeedUptimePct,
  computeIndoorOutdoorDelta,
  computeProbeSpreadF,
  doorOpenMinutesFromSessions,
  loadDoorSessions24h,
  loadEnergyOverview,
  loadFloodLevelOverview,
  loadMotionSessions24h,
  loadPowerOffSessions24h,
} from "../lib/overviewExtras";
import BatteryDeclineCard from "../components/dashboard/BatteryDeclineCard.astro";
import DoorTempInsightCard from "../components/dashboard/DoorTempInsightCard.astro";
import EnergyOverviewCard from "../components/dashboard/EnergyOverviewCard.astro";
import FloodLevelCard from "../components/dashboard/FloodLevelCard.astro";
import AirQualityCard from "../components/dashboard/AirQualityCard.astro";
import InsightCalloutCard from "../components/dashboard/InsightCalloutCard.astro";
import RssiOverviewCard from "../components/dashboard/RssiOverviewCard.astro";

import DashboardMetricGrid from "../components/dashboard/DashboardMetricGrid.astro";
import MetricCard from "../components/dashboard/MetricCard.astro";
import DashboardWeekChart from "../components/dashboard/DashboardWeekChart.astro";
import NightsAtRiskCard from "../components/dashboard/NightsAtRiskCard.astro";

const { session, user } = await getAuthFromCookies(Astro.cookies);

if (!session || !user) {
  return Astro.redirect("/signin");
}

const overviewMode = getDashboardOverviewMode(user);

const [
  preferences,
  tempConfig,
  entitlements,
  deviceConfig,
  alertSettingsLoaded,
  household,
  feedHealth,
  userHouseholds,
  activeHouseholdId,
  unackedAlertCount,
] = await Promise.all([
  getUserPreferences(user),
  fetchUserTempConfig(user.id),
  getUserEntitlements(user.id),
  getUserDevicesAsTempConfig(user.id, user.email),
  getAlertSettingsForUser(user.id, user.user_metadata as Record<string, unknown>),
  getOrCreateHouseholdForUser(user.id, user.email),
  checkFeedHealth(user.id),
  listUserHouseholds(user.id),
  getUserHouseholdId(user.id),
  countUnacknowledgedAlerts(user.id),
]);

const weatherConfig = personalWeatherConfigFromPreferences(preferences);

// Heal alert evidence and resolve weather in parallel (weather only needs preferences).
const [{ settings: alertSettings }, weatherSnapshot] = await Promise.all([
  ensureAlertDeliveryEvidence(user.id, alertSettingsLoaded),
  fetchWeatherSnapshotForConfig(weatherConfig),
]);

const chartWindowDays = Math.min(30, Math.max(7, entitlements.historyDays));

const [
  members,
  householdDevicesResult,
  latest,
  nightsAtRisk,
  householdRole,
  chartWeek,
] = await Promise.all([
  household.householdId
    ? listHouseholdMembers(household.householdId)
    : Promise.resolve({ members: [] as Awaited<ReturnType<typeof listHouseholdMembers>>["members"] }),
  household.householdId
    ? listHouseholdDevices(household.householdId)
    : Promise.resolve({ devices: deviceConfig.devices }),
  household.householdId
    ? fetchLatestSensorValues(household.householdId)
    : Promise.resolve([]),
  fetchNightsAtRiskForConfig(
    weatherConfig,
    alertSettings.freezeThresholdF,
    weatherSnapshot,
  ),
  activeHouseholdId
    ? getUserHouseholdRole(user.id, activeHouseholdId)
    : Promise.resolve(null),
  fetchGarageTempChartData(user.id, chartWindowDays),
]);

const devices = householdDevicesResult.devices;
const canEdit = canEditHousehold(householdRole);
const canExportCsv = entitlements.canDownloadCsv;
const hasHistory = chartWeek.points.length > 0;

/** Device + freeze email + at least one alert (test counts). Insights wait until this. */
const hasDevices =
  tempConfig.hasCustomConfig ||
  deviceConfig.devices.some((d) => d.source === "push");
const hasAlertsEnabled = alertSettings.enabled;
const hasEmailAlerts =
  alertSettings.enabled &&
  alertSettings.channelEmail &&
  Boolean(resolveAlertEmail(alertSettings, user.email));
const onboardingDismissed =
  (user.user_metadata as Record<string, unknown> | undefined)?.onboarding_dismissed ===
  true;
const lastAlertCandidatesEarly = [
  alertSettings.lastAlertSentAt,
  alertSettings.lastOutageAlertAt,
  alertSettings.lastRateAlertAt,
  alertSettings.lastForecastAlertAt,
  alertSettings.lastRunwayAlertAt,
  alertSettings.lastFloodAlertAt,
  alertSettings.lastNwsAlertAt,
].filter(Boolean) as string[];
const lastAlertAt =
  lastAlertCandidatesEarly.sort((a, b) => Date.parse(b) - Date.parse(a))[0] ?? null;
/** Live probes or a configured device, alerts on, and a delivered test/real alert. */
const essentialDone =
  (hasDevices || latest.length > 0) &&
  hasAlertsEnabled &&
  Boolean(lastAlertAt) &&
  (hasEmailAlerts || hasConfiguredAlertChannel(alertSettings, user.email));
const firstRunFocus = canEdit && !onboardingDismissed && !essentialDone;
const showInsights = !firstRunFocus && overviewMode === "insights";

const weatherHasCoords =
  weatherSnapshot?.lat != null &&
  weatherSnapshot?.lon != null &&
  Number.isFinite(weatherSnapshot.lat) &&
  Number.isFinite(weatherSnapshot.lon);

const [
  thermostatConnections,
  indoorReferenceSensorId,
  freezeMapSettings,
  nwsAlerts,
  weekCompareResult,
  doorSessions,
  floodLevelOverview,
  energyOverview,
  powerOffSessions,
  motionSessions,
  outdoorHourly,
] = await Promise.all([
  entitlements.canUseThermostatIntegration && household.householdId
    ? listConnectionsForHousehold(household.householdId)
    : Promise.resolve([] as Awaited<ReturnType<typeof listConnectionsForHousehold>>),
  household.householdId
    ? getIndoorReferenceSensorId(household.householdId)
    : Promise.resolve(null),
  household.householdId
    ? getHouseholdFreezeMapSettings(household.householdId)
    : Promise.resolve({
        optIn: false,
        cityId: null,
        lat: null,
        lon: null,
        label: null,
      }),
  weatherHasCoords && weatherSnapshot
    ? fetchNwsAlerts(weatherSnapshot.lat!, weatherSnapshot.lon!).catch(() => null)
    : Promise.resolve(null),
  showInsights
    ? fetchWeekCompare(user.id, user, chartWeek.points)
    : Promise.resolve({
        compare: {
          thisWeekAvgF: null,
          priorYearAvgF: null,
          deltaF: null,
          sampleCount: 0,
          priorYearSource: "none" as const,
          priorYearOutdoorLabel: null,
          earliestLocalReadingAt: null,
        },
        error: null,
      }),
  showInsights ? loadDoorSessions24h(devices) : Promise.resolve([]),
  (() => {
    if (showInsights)
      return loadFloodLevelOverview(devices).catch(() => ({
        floodOpen: [],
        recentFlood: [],
        levels: [],
      }));

    // Simple overview already has `latest` readings; avoid the heavier
    // 48h flood/level history queries to keep the dashboard fast.
    const wetFlood = latest
      .filter((row) => row.sensor.kind === "flood" && row.value_bool === true)
      .sort((a, b) => Date.parse(b.recorded_at) - Date.parse(a.recorded_at))
      .slice(0, 4)
      .map((row) => ({
        label: row.sensor.label,
        at: row.recorded_at,
      }));

    const levels = latest
      .filter((row) => row.sensor.kind === "level" && row.value_num != null)
      .map((row) => ({
        label: row.sensor.label,
        value: row.value_num as number,
        at: row.recorded_at,
        risingPerHour: null as number | null,
      }));

    return Promise.resolve({
      floodOpen: [],
      recentFlood: wetFlood,
      levels,
    });
  })(),
  showInsights ? loadEnergyOverview(devices) : Promise.resolve(null),
  showInsights ? loadPowerOffSessions24h(devices) : Promise.resolve([]),
  showInsights ? loadMotionSessions24h(devices) : Promise.resolve([]),
  // Time-to-freeze UI is hidden during first-run — skip OpenMeteo until then.
  !firstRunFocus && weatherHasCoords && weatherSnapshot
    ? fetchOpenMeteoHourlyWindow(weatherSnapshot.lat!, weatherSnapshot.lon!).catch(() => [])
    : Promise.resolve([]),
]);

const [thermostatOverview, houseChartOverlay] = await Promise.all([
  !firstRunFocus && thermostatConnections[0] && household.householdId
    ? fetchThermostatContextWithStatus(
        household.householdId,
        thermostatConnections[0].provider,
      )
    : Promise.resolve(null),
  !firstRunFocus && household.householdId
    ? fetchHouseChartOverlay({
        householdId: household.householdId,
        days: chartWindowDays,
        hasThermostatConnection: thermostatConnections.length > 0,
        referenceSensorId: indoorReferenceSensorId,
      })
    : Promise.resolve({ points: [], source: null as "thermostat" | "reference" | null }),
]);

const houseContext = buildHouseContext({
  thermostatSnapshot: thermostatOverview?.snapshot ?? null,
  referenceSensorId: indoorReferenceSensorId,
  latest,
  devices,
});

const hasSensors =
  preferences.tempProbes.length > 0 ||
  deviceConfig.devices.some(
    (d) => d.source === "push" && d.sensors.length > 0,
  );
const hasHouseholdMembers = members.members.length > 1;

const passwordUpdated = Astro.url.searchParams.get("password") === "updated";
const prefsSaved = Astro.url.searchParams.get("prefs_saved");
const prefsError = Astro.url.searchParams.get("prefs_error");

const newestReading = latest
  .map((row) => row.recorded_at)
  .filter(Boolean)
  .sort((a, b) => Date.parse(b!) - Date.parse(a!))[0] ?? null;
const lastAge = formatRelativeAge(newestReading);
const staleSummary = summarizeStaleSensors(latest, devices);
const staleSensorCount = staleSummary.total;
const lowBatteryDevices = listLowBatteryDevices(
  devices,
  alertSettings.batteryThresholdPct,
);
const lowBatteryMessage = lowBatteryBannerMessage(lowBatteryDevices);
const showMultiPropertyNudge =
  userHouseholds.households.length === 1 &&
  devices.length > 0 &&
  (entitlements.tier === "pro" || entitlements.tier === "member") &&
  canEdit &&
  !firstRunFocus;
const feedIssueCount = feedHealth.statuses.filter((s) => !s.ok).length;
const sensorCount =
  latest.length > 0
    ? latest.length
    : devices.reduce((sum, d) => sum + d.sensors.length, 0);

const lastAlertAge = formatRelativeAge(lastAlertAt);

const nightsRiskCount = nightsAtRisk.filter((n) => n.atRisk).length;

const showColdSnapChecklist = shouldShowColdSnapChecklist({
  nightsRiskCount,
  outdoorTempF: weatherSnapshot?.temp ?? null,
  hasNwsFreezeAlerts: Boolean(nwsAlerts && nwsAlerts.alerts.length > 0),
});

const freezeReadiness = computeFreezeReadiness({
  alertSettings,
  devices,
  latest,
  weatherLocationConfigured: isWeatherLocationConfigured(weatherConfig),
  canUseForecast: entitlements.canUseForecastAlerts,
  canUseNws: entitlements.canUseNwsAlerts,
  hasSentAnyAlert: Boolean(lastAlertAt),
});

const coldestProbeTempF = (() => {
  const temps = latest
    .filter((row) => row.sensor.kind === "temperature" && row.value_num != null)
    .map((row) => row.value_num as number);
  return temps.length > 0 ? Math.min(...temps) : null;
})();

const wetFloodCount = latest.filter(
  (row) => row.sensor.kind === "flood" && row.value_bool === true,
).length;

const coldestProbeMarginF =
  coldestProbeTempF != null
    ? coldestProbeTempF - alertSettings.freezeThresholdF
    : null;

const freezeHours = computeFreezeHours(
  chartWeek.points,
  alertSettings.freezeThresholdF,
);
const probeSpread = computeProbeSpreadF(latest);
const indoorOutdoorDeltaF = computeIndoorOutdoorDelta(
  coldestProbeTempF ?? houseContext?.ambientTempF ?? null,
  weatherSnapshot?.temp ?? null,
);
const condensation = computeCondensationHours(chartWeek.points);
const feedUptime = computeFeedUptimePct(feedHealth.statuses);
const airQualityOverview = buildAirQualityOverview(latest);
const rssiOverview = buildRssiOverview(
  devices,
  alertSettings.rssiThreshold ?? -80,
);

const regionalBenchmark =
  showInsights &&
  household.householdId &&
  freezeMapSettings.optIn &&
  coldestProbeTempF != null
    ? await fetchRegionalBenchmark({
        householdId: household.householdId,
        yourTempF: coldestProbeTempF,
      })
    : null;

const exportToDate = new Date();
const exportFromDate = new Date(exportToDate.getTime() - 7 * 24 * 60 * 60 * 1000);
const exportFrom = exportFromDate.toISOString().slice(0, 10);
const exportTo = exportToDate.toISOString().slice(0, 10);

const useCelsius = preferences.useCelsius;
const outdoorSplit = splitOpenMeteoPastAndForecast(outdoorHourly);
const doorOpenNearby = latest.some(
  (row) =>
    row.sensor.kind === "door" &&
    (row.value_bool === true || row.value_text === "open"),
);
const timeToFreeze = buildTimeToFreezeProjection({
  currentTempF:
    coldestProbeTempF ??
    chartWeek.points.filter((p) => Number.isFinite(p.tempf)).at(-1)?.tempf ??
    alertSettings.freezeThresholdF + 10,
  freezeThresholdF: alertSettings.freezeThresholdF,
  indoorSamples: chartWeek.points
    .filter((p) => Number.isFinite(p.tempf))
    .map((p) => ({ at: p.timestamp, tempF: p.tempf })),
  outdoorPast: outdoorPointsFromHourly(outdoorSplit.past),
  outdoorForecast: outdoorPointsFromHourly(outdoorSplit.forecast),
  doorOpenNearby,
  timeZone: alertSettings.quietHoursTimezone,
  lookAheadHours: alertSettings.forecastHoursAhead,
  useCelsius,
});
const doorOpenMinutes = doorOpenMinutesFromSessions(doorSessions);
const doorTempSummary = showInsights
  ? buildDoorTempSummary(
      doorSessions,
      chartWeek.points,
      weatherSnapshot?.temp ?? null,
    )
  : null;
const powerTempSummary = showInsights
  ? buildPowerTempSummary(
      powerOffSessions,
      chartWeek.points,
      weatherSnapshot?.temp ?? null,
    )
  : null;
const motionSummary = showInsights ? buildMotionSummary(motionSessions) : null;
const batteryOverview = showInsights ? buildBatteryOverview(devices) : [];
const coolingRateFPerHour = estimateHeatingLossRate(
  chartWeek.points,
  weatherSnapshot?.temp ?? null,
);
const heatingInsights = buildHeatingInsights({
  indoorPoints: chartWeek.points,
  outdoorTempF: weatherSnapshot?.temp ?? null,
  freezeThresholdF: alertSettings.freezeThresholdF,
  doorOpenMinutes,
  houseTempF: houseContext?.ambientTempF ?? null,
  thermostatSnapshot: houseContext?.thermostatSnapshot ?? null,
});

const sensorsValue =
  sensorCount === 0
    ? "None"
    : staleSensorCount > 0
      ? `${staleSensorCount} stale`
      : `${sensorCount} fresh`;
const feedsValue =
  feedHealth.statuses.length === 0
    ? "None"
    : feedIssueCount > 0
      ? `${feedIssueCount} issue${feedIssueCount === 1 ? "" : "s"}`
      : `${feedHealth.statuses.length} online`;

const showDemoPullNudge =
  canEdit &&
  latest.length === 0 &&
  deviceConfig.devices.length === 0 &&
  !onboardingDismissed;

const upgradeTarget = nextUpgradeTier(entitlements.tier);

const hasTestAlert = Boolean(lastAlertAt);

const showProbeSimulatorNudge =
  canEdit &&
  latest.length === 0 &&
  !onboardingDismissed &&
  !showDemoPullNudge;

const showNestConnectNudge =
  canEdit &&
  !firstRunFocus &&
  thermostatConnections.length === 0 &&
  (latest.length === 0 || !onboardingDismissed) &&
  !showDemoPullNudge &&
  !showProbeSimulatorNudge;

const showOverviewPwaNudge =
  canEdit &&
  !firstRunFocus &&
  latest.length > 0 &&
  (onboardingDismissed || essentialDone);

const showAndroidNudge =
  canEdit && !firstRunFocus && (latest.length > 0 || hasDevices);
const showBayBuddyNudge = showAndroidNudge;

const showYoureLive =
  canEdit &&
  latest.length > 0 &&
  !onboardingDismissed &&
  (!essentialDone || !hasHistory);
const showSecondaryNudges = onboardingDismissed || essentialDone;
const showAlertSetupNudge =
  showSecondaryNudges && canEdit && (!hasAlertsEnabled || !hasEmailAlerts);
const showTestAlertNudge =
  showSecondaryNudges &&
  canEdit &&
  hasAlertsEnabled &&
  hasConfiguredAlertChannel(alertSettings) &&
  !hasTestAlert;
const showFreezeMapOptInNudge =
  showSecondaryNudges &&
  canEdit &&
  latest.length > 0 &&
  Boolean(household.householdId) &&
  !freezeMapSettings.optIn;

const showClaimsPackPrompt = showInsights && canEdit && hasHistory;
const showStoryCard = showSecondaryNudges && canEdit && !showAlertSetupNudge;

/** Empty or unfinished first-run: keep Overview on device → freeze email → test alert. */
const prioritizeEmptyOverview = latest.length === 0;
const prioritizeFirstRun = firstRunFocus || prioritizeEmptyOverview;

const analyticsEvents: Array<{
  name: import("../lib/productAnalytics").ProductEvent;
  props?: Record<string, string | number | boolean>;
}> = [];
if (hasDevices) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "devices" } });
if (hasSensors) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "sensors" } });
if (hasHistory) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "history" } });
if (hasEmailAlerts) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "alerts" } });
if (hasTestAlert) analyticsEvents.push({ name: "onboarding_step_complete", props: { step: "alert_test" } });
if (latest.length > 0) analyticsEvents.push({ name: "first_ingest" });
if (Astro.url.searchParams.get("demo_pull") === "1") {
  analyticsEvents.push({ name: "demo_pull_started" });
}

type OverviewBanner = { id: string; priority: number; show: boolean };
const overviewBannerQueue: OverviewBanner[] = [
  { id: "lowBattery", priority: 2, show: Boolean(lowBatteryMessage) },
  { id: "stale", priority: 3, show: staleSensorCount > 0 },
  { id: "coldSnap", priority: 4, show: showColdSnapChecklist && !prioritizeFirstRun },
  { id: "testAlert", priority: 5, show: showTestAlertNudge },
  { id: "alertSetup", priority: 6, show: showAlertSetupNudge },
  { id: "youreLive", priority: 7, show: showYoureLive },
  { id: "freezeMap", priority: 8, show: showFreezeMapOptInNudge },
  { id: "story", priority: 9, show: showStoryCard && !prioritizeFirstRun },
  { id: "multiProperty", priority: 10, show: showMultiPropertyNudge },
  {
    id: "freezeReadiness",
    priority: prioritizeFirstRun ? 18 : 11,
    show: !prioritizeFirstRun,
  },
  // Upgrade CTAs stay in "More recommendations" only — never primary.
  { id: "upgrade", priority: 20, show: upgradeTarget === "member" || upgradeTarget === "pro" },
];
const activeOverviewBanners = overviewBannerQueue
  .filter((banner) => banner.show)
  .sort((a, b) => a.priority - b.priority);
const primaryBannerIds = new Set(
  activeOverviewBanners.slice(0, 1).map((banner) => banner.id),
);
const secondaryBannerIds = new Set(
  activeOverviewBanners.slice(1).map((banner) => banner.id),
);
const hasSecondaryBanners =
  secondaryBannerIds.size > 0 ||
  showNestConnectNudge ||
  showOverviewPwaNudge ||
  showAndroidNudge ||
  showBayBuddyNudge;
const secondaryRecommendationCount =
  secondaryBannerIds.size +
  (showNestConnectNudge ? 1 : 0) +
  (showOverviewPwaNudge ? 1 : 0) +
  (showAndroidNudge ? 1 : 0) +
  (showBayBuddyNudge ? 1 : 0);

const garageRisk = computeGarageRiskStatus({
  hasDevices,
  hasLiveReading: latest.length > 0,
  coldestProbeTempF,
  freezeThresholdF: alertSettings.freezeThresholdF,
  staleSensorCount,
  nightsRiskCount,
  alertsEnabled: hasAlertsEnabled,
  hasEmailAlerts,
  outdoorTempF: weatherSnapshot?.temp ?? null,
  showColdSnapChecklist,
  hoursUntilFreeze: timeToFreeze.hours,
  hitsAtLabel: timeToFreeze.hitsAtLabel,
  wetFloodCount,
});
---
<DashboardLayout title="Overview">
  <ProductAnalyticsTracker events={analyticsEvents} />
  <div class="dashboard-stack">
    {(passwordUpdated || prefsSaved || prefsError) && (
      <div class="dashboard-flash">
        {passwordUpdated && (
          <p class="alert-success mt-0 mb-0" role="status">Password updated.</p>
        )}
        {prefsSaved && (
          <p class="alert-success mt-0 mb-0" role="status">
            Display preferences saved.
            {" "}
            <a class="text-link" href="/dashboard/settings">Open settings</a>
          </p>
        )}
        {prefsError && (
          <p class="alert-warning mt-0 mb-0" role="alert">
            Could not save display preferences.
            {" "}
            <a class="text-link" href="/dashboard/settings">Try again in settings</a>
          </p>
        )}
      </div>
    )}

    <DashboardOnboarding
      hasDevices={hasDevices}
      hasSensors={hasSensors}
      hasHistory={hasHistory}
      hasAlertsEnabled={hasAlertsEnabled}
      hasEmailAlerts={hasEmailAlerts}
      hasTestAlert={hasTestAlert}
      hasHouseholdMembers={hasHouseholdMembers}
      hasLiveSensors={latest.length > 0}
      hasHousehold={Boolean(household.householdId)}
      hasFloodSensor={devices.some((d) => d.sensors.some((s) => s.kind === "flood"))}
      dismissed={onboardingDismissed}
    />

    <GarageRiskStatusCard status={garageRisk} />
    {!firstRunFocus && (hasDevices || chartWeek.points.length > 0) && (
      <TimeToFreezeCard
        projection={timeToFreeze}
        freezeThresholdF={alertSettings.freezeThresholdF}
        useCelsius={useCelsius}
      />
    )}

    <DemoPullNudge show={showDemoPullNudge} />
    <ProbeSimulatorNudge show={showProbeSimulatorNudge} />

    <HouseholdSwitcher
      households={userHouseholds.households}
      activeHouseholdId={activeHouseholdId}
    />

    <UnackedAlertsBanner
      count={unackedAlertCount}
      showClaimsPackCta={unackedAlertCount > 0}
    />

    <LowBatteryBanner message={primaryBannerIds.has("lowBattery") ? lowBatteryMessage : null} />

    {primaryBannerIds.has("stale") && staleSensorCount > 0 && (
      <div class="alert-warning mb-0" role="status">
        {staleSummary.bannerMessage}.        <a href="/" class="text-link ml-1">Check Home</a>
        {" · "}
        <a href="/dashboard/temperature" class="text-link">Devices</a>
        {" · "}
        <a href="/about/debugging-stale-readings" class="text-link">Debug guide</a>
      </div>
    )}

    <DashboardYoureLive
      show={primaryBannerIds.has("youreLive")}
      hasAlertsEnabled={hasAlertsEnabled}
      hasEmailAlerts={hasEmailAlerts}
      hasTestAlert={hasTestAlert}
    />

    <AlertSetupNudge
      hasAlertsEnabled={hasAlertsEnabled}
      hasEmailAlerts={hasEmailAlerts}
      canEdit={canEdit}
      show={primaryBannerIds.has("alertSetup")}
    />

    <TestAlertNudge
      canEdit={canEdit}
      show={primaryBannerIds.has("testAlert")}
    />

    <FreezeMapOptInNudge
      canEdit={canEdit}
      show={primaryBannerIds.has("freezeMap")}
      cityLabel={freezeMapSettings.label}
    />

    <DashboardStoryCard show={primaryBannerIds.has("story")} />

    <ColdSnapChecklistCard
      show={primaryBannerIds.has("coldSnap")}
      coldSnapEnabled={alertSettings.forecastFreezeEnabled}
      canUseForecast={entitlements.canUseForecastAlerts}
    />

    {primaryBannerIds.has("freezeReadiness") && (
      <FreezeReadinessCard readiness={freezeReadiness} />
    )}

    <DashboardMultiPropertyNudge show={primaryBannerIds.has("multiProperty")} />

    {hasSecondaryBanners && (
      <details class="card dashboard-recommendations">
        <summary class="dashboard-recommendations-summary">
          More recommendations ({secondaryRecommendationCount})
        </summary>
        <div class="dashboard-recommendations-body space-y-4">
          <NestConnectNudge
            show={showNestConnectNudge}
            nestEntitled={entitlements.canUseThermostatIntegration}
          />
          <OverviewPwaNudge show={showOverviewPwaNudge} />
          <DashboardAndroidNudge show={showAndroidNudge} />
          <DashboardBayBuddyNudge show={showBayBuddyNudge} />
          <DashboardYoureLive
            show={secondaryBannerIds.has("youreLive")}
            hasAlertsEnabled={hasAlertsEnabled}
            hasEmailAlerts={hasEmailAlerts}
            hasTestAlert={hasTestAlert}
          />
          <AlertSetupNudge
            hasAlertsEnabled={hasAlertsEnabled}
            hasEmailAlerts={hasEmailAlerts}
            canEdit={canEdit}
            show={secondaryBannerIds.has("alertSetup")}
          />
          <TestAlertNudge
            canEdit={canEdit}
            show={secondaryBannerIds.has("testAlert")}
          />
          <FreezeMapOptInNudge
            canEdit={canEdit}
            show={secondaryBannerIds.has("freezeMap")}
            cityLabel={freezeMapSettings.label}
          />
          <DashboardStoryCard show={secondaryBannerIds.has("story")} />
          <DashboardMultiPropertyNudge show={secondaryBannerIds.has("multiProperty")} />
          <ColdSnapChecklistCard
            show={secondaryBannerIds.has("coldSnap")}
            coldSnapEnabled={alertSettings.forecastFreezeEnabled}
            canUseForecast={entitlements.canUseForecastAlerts}
          />
          {secondaryBannerIds.has("freezeReadiness") && (
            <FreezeReadinessCard readiness={freezeReadiness} />
          )}
          {secondaryBannerIds.has("upgrade") && upgradeTarget === "member" && (
            <UpgradeNudge feature="data_retention" tier={entitlements.tier} compact />
          )}
          {secondaryBannerIds.has("upgrade") && upgradeTarget === "pro" && (
            <UpgradeNudge feature="sms_alerts" tier={entitlements.tier} compact />
          )}
          {secondaryBannerIds.has("stale") && staleSensorCount > 0 && (
            <div class="alert-warning mb-0" role="status">
              {staleSummary.bannerMessage}.              <a href="/" class="text-link ml-1">Check Home</a>
              {" · "}
              <a href="/dashboard/temperature" class="text-link">Devices</a>
            </div>
          )}
          <LowBatteryBanner message={secondaryBannerIds.has("lowBattery") ? lowBatteryMessage : null} />
        </div>
      </details>
    )}

    {firstRunFocus && canEdit && (
      <section class="card" aria-labelledby="first-run-focus-title">
        <h2 class="card-title" id="first-run-focus-title">
          {latest.length === 0
            ? "Get a reading on this Overview"
            : "Finish the alert path"}
        </h2>
        <p class="card-subtitle mb-4">
          {latest.length === 0
            ? hasDevices
              ? "You have a device. POST JSON once (or fetch a pull feed) so sensors appear here, then set freeze + email and send a test."
              : "Create a push device for ESP/Arduino, or try the demo feed, then set freeze + email and send a test."
            : !hasEmailAlerts
              ? "Live probes are in. Set freeze threshold + email under Alerts, then send a test so you trust delivery before a real freeze night."
              : "Send a test alert once. Insights, Nest, Android nudges, and the full status strip unlock after that."}
        </p>
        <div class="flex flex-wrap gap-3">
          {latest.length === 0 ? (
            <>
              <a class="btn-primary" href="/dashboard/temperature">Open Devices</a>
              {showDemoPullNudge && (
                <a class="btn-secondary" href="#demo-pull-nudge">Try demo feed</a>
              )}
              {!hasDevices && (
                <a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 parts list</a>
              )}
              <a class="btn-ghost" href="/about/probe-demo">Probe simulator</a>
            </>
          ) : !hasEmailAlerts ? (
            <a class="btn-primary" href="/dashboard/alerts#alert-section-essentials">
              Alert essentials
            </a>
          ) : (
            <a class="btn-primary" href="/dashboard/alerts#send-test-alert">Send test alert</a>
          )}
          {latest.length > 0 && hasEmailAlerts && (
            <a class="btn-ghost" href="/dashboard/alerts#alert-section-essentials">
              Review freeze + email
            </a>
          )}
          {latest.length === 0 && (
            <a class="btn-ghost" href="/dashboard/alerts#alert-section-essentials">Alert essentials</a>
          )}
        </div>
      </section>
    )}

    {prioritizeEmptyOverview && canEdit && !firstRunFocus && (
      <section class="card" aria-labelledby="empty-overview-cta-title">
        <h2 class="card-title" id="empty-overview-cta-title">Get a reading on this Overview</h2>
        <p class="card-subtitle mb-4">
          {hasDevices
            ? "You have a device. POST JSON once (or fetch a pull feed) so sensors appear here, then set freeze + email."
            : "Create a push device for ESP/Arduino, or try the demo feed, then set freeze + email under Alerts."}
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/dashboard/temperature">Open Devices</a>
          {showDemoPullNudge && (
            <a class="btn-secondary" href="#demo-pull-nudge">Try demo feed</a>
          )}
          {!hasDevices && (
            <a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 parts list</a>
          )}
          <a class="btn-ghost" href="/about/probe-demo">Probe simulator</a>
          <a class="btn-ghost" href="/dashboard/alerts#alert-section-essentials">Alert essentials</a>
        </div>
      </section>
    )}

    {!canEdit && (
      <p class="alert-warning mt-0 mb-0" role="status">
        View-only access: you can see live data but cannot change devices, alerts, or sharing.
      </p>
    )}

    <section class="dashboard-section" id="status" aria-labelledby="status-heading">
      <div class="dashboard-section-head">
        <h2 id="status-heading" class="dashboard-section-title">Status</h2>
        {firstRunFocus && (
          <p class="dashboard-section-desc mb-0">
            Essentials only until freeze + email + a test alert are done.
          </p>
        )}
      </div>
      <DashboardMetricGrid>
        <MetricCard
          label="Last reading"
          value={newestReading ? lastAge.label : "None yet"}
          href="/"
          tone={!newestReading || lastAge.lagging ? "warning" : "success"}
        />
        <MetricCard
          label="Sensors"
          value={sensorsValue}
          detail={sensorCount > 0 ? `${sensorCount} total` : null}
          href="/dashboard/temperature"
          tone={staleSensorCount > 0 ? "warning" : "neutral"}
        />
        {!firstRunFocus && (
          <MetricCard
            label="Feeds"
            value={feedsValue}
            href="/dashboard/temperature#pull-feeds"
            tone={feedIssueCount > 0 ? "warning" : "neutral"}
          />
        )}
        <MetricCard
          label="Alerts"
          value={alertSettings.enabled ? "On" : "Off"}
          detail={lastAlertAt ? `Last ${lastAlertAge.label}` : "Send a test"}
          href="/dashboard/alerts"
          tone={alertSettings.enabled ? "success" : "neutral"}
        />
        {!firstRunFocus && houseContext && (
          <MetricCard
            label="House"
            value={houseContext.metricValue}
            detail={houseContext.metricDetail}
            href="/dashboard/temperature#indoor-reference"
            tone="neutral"
          />
        )}
        {!firstRunFocus && (
          <>
            <MetricCard
              label="Freeze hours (7d)"
              value={
                chartWeek.points.length < 2
                  ? "—"
                  : `${freezeHours.hoursBelow34.toFixed(1)} h`
              }
              detail={
                freezeHours.degreeHoursBelow > 0
                  ? `${freezeHours.degreeHoursBelow.toFixed(0)} °F·h below ${alertSettings.freezeThresholdF}°F`
                  : freezeHours.coldestF != null
                    ? `Coldest ${freezeHours.coldestF.toFixed(1)}°F`
                    : `≤ ${alertSettings.freezeThresholdF}°F`
              }
              href="/dashboard/history"
              tone={freezeHours.hoursBelow34 > 0 ? "warning" : "neutral"}
            />
            <MetricCard
              label="Coldest margin"
              value={
                coldestProbeMarginF == null
                  ? "—"
                  : `${coldestProbeMarginF >= 0 ? "+" : ""}${coldestProbeMarginF.toFixed(1)}°F`
              }
              detail={
                coldestProbeTempF != null
                  ? `${coldestProbeTempF.toFixed(1)}°F vs ${alertSettings.freezeThresholdF}°F alert`
                  : "No live probe"
              }
              href="/"
              tone={
                coldestProbeMarginF == null
                  ? "neutral"
                  : coldestProbeMarginF <= 0
                    ? "danger"
                    : coldestProbeMarginF <= 5
                      ? "warning"
                      : "success"
              }
            />
            <MetricCard
              label="Indoor − outdoor"
              value={
                indoorOutdoorDeltaF == null
                  ? "—"
                  : `${indoorOutdoorDeltaF >= 0 ? "+" : ""}${indoorOutdoorDeltaF.toFixed(1)}°F`
              }
              detail={
                indoorOutdoorDeltaF == null
                  ? "Need live probe + weather"
                  : weatherSnapshot?.temp != null && coldestProbeTempF != null
                    ? `${coldestProbeTempF.toFixed(0)}°F indoor vs ${weatherSnapshot.temp.toFixed(0)}°F out`
                    : "ΔT using coldest probe"
              }
              href="/"
              tone={
                indoorOutdoorDeltaF == null
                  ? "neutral"
                  : indoorOutdoorDeltaF < 5
                    ? "warning"
                    : "neutral"
              }
            />
            <MetricCard
              label="Probe spread"
              value={probeSpread ? `${probeSpread.spreadF.toFixed(1)}°F` : "—"}
              detail={
                probeSpread
                  ? `${probeSpread.coldestF.toFixed(1)}–${probeSpread.warmestF.toFixed(1)}°F · ${probeSpread.probeCount} probes`
                  : "Need 2+ live temps"
              }
              href="/"
              tone={
                probeSpread == null
                  ? "neutral"
                  : probeSpread.spreadF >= 8
                    ? "warning"
                    : "neutral"
              }
            />
            <MetricCard
              label="Condensation (7d)"
              value={
                chartWeek.points.length < 2
                  ? "—"
                  : `${condensation.hours.toFixed(1)} h`
              }
              detail={
                condensation.latestMarginF != null
                  ? `Now ${condensation.latestMarginF.toFixed(1)}°F above dew point`
                  : "Hours near dew point"
              }
              href="/dashboard/history"
              tone={
                condensation.hours >= 6 ||
                (condensation.latestMarginF != null && condensation.latestMarginF <= 2)
                  ? "warning"
                  : "neutral"
              }
            />
            {feedUptime && (
              <MetricCard
                label="Feed health"
                value={`${feedUptime.pct.toFixed(0)}%`}
                detail={`${feedUptime.ok}/${feedUptime.total} feeds reachable now`}
                href="/dashboard/temperature#pull-feeds"
                tone={feedUptime.pct < 100 ? "warning" : "success"}
              />
            )}
          </>
        )}
      </DashboardMetricGrid>
    </section>

    <section class="dashboard-section" aria-labelledby="curves-heading">
      <div class="dashboard-section-head">
        <div>
          <h2 id="curves-heading" class="dashboard-section-title">Probe curves</h2>
          <p class="dashboard-section-desc">
            {firstRunFocus
              ? `${chartWindowDays}-day temperature trend. Insights unlock after freeze + email + a test alert.`
              : showInsights
                ? `${chartWindowDays}-day traces, freeze outlook, and week-over-week change.`
                : `${chartWindowDays}-day temperature trend. Switch to Insights for freeze outlook and comparisons.`}
          </p>
        </div>
        {!firstRunFocus && <DashboardOverviewToggle mode={overviewMode} />}
      </div>
      <div class="dashboard-insights">
        <div class="dashboard-insights-primary">
          <DashboardWeekChart
            points={chartWeek.points}
            housePoints={houseChartOverlay.points}
            houseLegend={
              houseChartOverlay.source === "thermostat"
                ? "House (thermostat)"
                : houseContext?.referenceLabel
                  ? `House (${houseContext.referenceLabel})`
                  : "House"
            }
            freezeThresholdF={alertSettings.freezeThresholdF}
            canExport={canExportCsv}
            exportFrom={exportFrom}
            exportTo={exportTo}
            days={chartWindowDays}
          />
          {showInsights && (
            <NightsAtRiskCard
              nightsAtRisk={nightsAtRisk}
              nightsRiskCount={nightsRiskCount}
              freezeThresholdF={alertSettings.freezeThresholdF}
              weatherSnapshot={weatherSnapshot}
              weatherHasCoords={weatherHasCoords}
              nwsAlerts={nwsAlerts}
            />
          )}
        </div>
        {showInsights && (
          <aside class="dashboard-insights-side">
            <WeekCompareCard compare={weekCompareResult.compare} useCelsius={useCelsius} />
            {regionalBenchmark && (
              <RegionalBenchmarkCard benchmark={regionalBenchmark} />
            )}
            <HeatingInsightsCard insights={heatingInsights} />
            {doorTempSummary && (
              <DoorTempInsightCard
                title={doorTempSummary.title}
                detail={doorTempSummary.detail}
                tone={doorTempSummary.tone}
              />
            )}
            {powerTempSummary && (
              <InsightCalloutCard
                title="Power vs temperature"
                subtitle="Circuit Off time correlated with cooling rate."
                headline={powerTempSummary.title}
                detail={powerTempSummary.detail}
                tone={powerTempSummary.tone}
                href="/dashboard/temperature"
                hrefLabel="Open Devices"
              />
            )}
            {motionSummary && (
              <InsightCalloutCard
                title="Motion"
                subtitle="Activity in the last 24 hours."
                headline={motionSummary.title}
                detail={motionSummary.detail}
                tone={motionSummary.tone}
              />
            )}
            <DoorDurationCard devices={devices} sessions={doorSessions} />
            <DoorEventHistory householdId={household.householdId} />
            <BatteryDeclineCard rows={batteryOverview} />
            <RssiOverviewCard rows={rssiOverview} />
            <AirQualityCard overview={airQualityOverview} />
            {energyOverview && (
              <EnergyOverviewCard
                energy={energyOverview}
                coolingRateFPerHour={coolingRateFPerHour}
              />
            )}
            <FloodLevelCard overview={floodLevelOverview} />
            <ClaimsPackPromptCard
              canUseClaimsPack={entitlements.canUseClaimsPack}
              tier={entitlements.tier}
              show={showClaimsPackPrompt}
            />
          </aside>
        )}
      </div>
      {!showInsights && (
        <>
          <FloodLevelCard overview={floodLevelOverview} />
          <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
            <a class="text-link" href="/dashboard/history">Open History</a> for full charts, CSV export, and claims pack.
          </p>
        </>
      )}
    </section>
  </div>
</DashboardLayout>
