---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlanComparisonTable from "../components/PlanComparisonTable.astro";
import FaqSection from "../components/FaqSection.astro";
import { getAuthFromCookies } from "../lib/auth";
import {
  getUserEntitlements,
  FREE_HISTORY_DAYS,
  FREE_MAX_DEVICES,
  MEMBER_HISTORY_DAYS,
  MEMBER_MAX_DEVICES,
  PRO_HISTORY_DAYS,
  PRO_MAX_DEVICES,
  PRO_MAX_OWNED_HOUSEHOLDS,
  PORTFOLIO_MAX_OWNED_HOUSEHOLDS,
  formatHistoryRetention,
} from "../lib/entitlements";
import { normalizeComparisonTier } from "../lib/planComparison";
import {
  getMemberPriceDisplay,
  getPortfolioPriceDisplay,
  getProPriceDisplay,
} from "../lib/stripePricing";
import { getUserSubscription } from "../lib/stripeSubscriptions";
import { isActiveSubscriptionStatus } from "../lib/stripe";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";
import ProductScreenshot from "../components/ProductScreenshot.astro";

const { user } = await getAuthFromCookies(Astro.cookies);
const entitlements = user ? await getUserEntitlements(user.id) : null;
const subscription = user ? await getUserSubscription(user.id) : null;
const currentTier = entitlements ? normalizeComparisonTier(entitlements.tier) : null;
// Raw tier for pricing card CTAs -- normalizeComparisonTier maps Portfolio to
// its own comparison column, but each card button still needs the raw tier so
// Portfolio subscribers don't see "Upgrade to Pro".
const rawTier = entitlements?.tier ?? null;
const hasBilling =
  subscription !== null && isActiveSubscriptionStatus(subscription.status);
const memberPrices = getMemberPriceDisplay();
const proPrices = getProPriceDisplay();
const portfolioPrices = getPortfolioPriceDisplay();
const portfolioPricingConfigured =
  portfolioPrices.monthly != null || portfolioPrices.annual != null;
const defaultInterval =
  import.meta.env.PRICING_DEFAULT_INTERVAL === "monthly" ? "monthly" : "annual";

function priceForInterval(
  prices: ReturnType<typeof getMemberPriceDisplay>,
  interval: "monthly" | "annual",
): { amount: string; period: string; sub: string } {
  if (interval === "monthly") {
    const amount = prices.monthly ?? "Contact us";
    return {
      amount,
      period: prices.monthly ? "/mo" : "",
      sub: "Billed monthly",
    };
  }
  if (prices.annual) {
    return {
      amount: prices.annual,
      period: "/yr",
      sub: prices.annualMonthlyEquivalent
        ? `${prices.annualMonthlyEquivalent}/mo billed annually`
        : "Billed annually",
    };
  }
  // Don't reuse monthly under the annual toggle -- that looks like a bug.
  return {
    amount: "Contact us",
    period: "",
    sub: "Annual pricing not configured",
  };
}

function savingsForInterval(
  pct: number | null,
  interval: "monthly" | "annual",
): string {
  const label = pct != null && pct > 0 ? `${pct}%` : "~20%";
  return interval === "annual"
    ? `Save ${label} vs monthly`
    : `Switch to annual to save ${label}`;
}

const memberMonthly = priceForInterval(memberPrices, "monthly");
const memberAnnual = priceForInterval(memberPrices, "annual");
const proMonthly = priceForInterval(proPrices, "monthly");
const proAnnual = priceForInterval(proPrices, "annual");
const portfolioMonthly = priceForInterval(portfolioPrices, "monthly");
const portfolioAnnual = priceForInterval(portfolioPrices, "annual");
if (!portfolioPricingConfigured) {
  // Avoid "Billed monthly" / "Save ~20%" placeholder copy sitting under a
  // "Contact us" price before you've set the Stripe price + display env vars.
  portfolioMonthly.sub = "Custom pricing";
  portfolioAnnual.sub = "Custom pricing";
}
const maxAnnualSavings = Math.max(
  memberPrices.annualSavingsPct ?? 0,
  proPrices.annualSavingsPct ?? 0,
  portfolioPrices.annualSavingsPct ?? 0,
);
const annualSavingsLabel =
  maxAnnualSavings > 0 ? `Save up to ${maxAnnualSavings}%` : "Save ~20%";
const memberSavingsMonthly = savingsForInterval(memberPrices.annualSavingsPct, "monthly");
const memberSavingsAnnual = savingsForInterval(memberPrices.annualSavingsPct, "annual");
const proSavingsMonthly = savingsForInterval(proPrices.annualSavingsPct, "monthly");
const proSavingsAnnual = savingsForInterval(proPrices.annualSavingsPct, "annual");
const portfolioSavingsMonthly = portfolioPricingConfigured
  ? savingsForInterval(portfolioPrices.annualSavingsPct, "monthly")
  : "";
const portfolioSavingsAnnual = portfolioPricingConfigured
  ? savingsForInterval(portfolioPrices.annualSavingsPct, "annual")
  : "";
const monthlyHint = `You’re viewing monthly prices. Annual locks in ${maxAnnualSavings > 0 ? `${maxAnnualSavings}%` : "about 20%"} off (${memberAnnual.amount} / ${proAnnual.amount} per year).`;
const annualHint = `You’re viewing yearly totals. Toggle Monthly to see ${memberMonthly.amount} / ${proMonthly.amount} per month.`;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/pricing");
const pricingFaqs = getMarketingFaqs("pricing");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing" },
  ]),
  getMarketingFaqSchema(pageUrl, "pricing"),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Plans & pricing"
  description="Compare ThermalTrace Free, Member, Pro, and Portfolio: device counts, history retention, freeze warnings, flood/leak alerts, official NWS alerts, and annual billing savings. Start free for cold and water monitoring, or scale up to Portfolio for multiple properties."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Pricing"
      title="Plans that grow with your probes"
      lede="Start free to see if ThermalTrace fits. Upgrade to Member for a full cold season of history, or Pro when you want serious freeze and flood alerts, thermostat context, and automation. Need more than a handful of properties or on-site manager logins? Portfolio is below."
    >
      {user ? (
        <p class="page-header-meta">
          Signed in as <strong>{user.email}</strong>
          {currentTier && (
            <>
              {" · "}
              Current plan: <strong>{currentTier}</strong>
            </>
          )}
          {" · "}
          <a class="text-link" href="/dashboard">Dashboard</a>
        </p>
      ) : (
        <>
          <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">Create free account</a>
          <a slot="actions" class="btn-secondary" href="/signin">Sign in</a>
        </>
      )}
    </PageHeader>

    <section class="pricing-ladder" aria-label="Plan ladder">
      <ul class="pricing-ladder-list">
        <li>
          <strong>Free</strong>
          <span>See if ThermalTrace works for you: live curves, freeze and leak alerts, one family live share.</span>
        </li>
        <li>
          <strong>Member</strong>
          <span>Track a whole cold season, or a wet basement season: 90-day history, CSV, more devices, and forecast freeze warnings.</span>
        </li>
        <li>
          <strong>Pro</strong>
          <span>Serious alerts and automation. NWS, SMS, push, Nest/Ecobee house context, claims pack, 14-day trial. Up to {PRO_MAX_OWNED_HOUSEHOLDS} properties.</span>
        </li>
        <li>
          <strong>Portfolio</strong>
          <span>Larger multi-property ops: up to {PORTFOLIO_MAX_OWNED_HOUSEHOLDS} owned properties, cross-property freeze/flood risk view, property-manager logins without billing access.</span>
        </li>
      </ul>
    </section>

    <section class="plan-tier-section">
      <div class="billing-interval-toggle" role="group" aria-label="Billing interval">
        <button
          type="button"
          class="billing-interval-btn"
          data-interval="monthly"
          aria-pressed={defaultInterval === "monthly" ? "true" : "false"}
        >
          Monthly
        </button>
        <button
          type="button"
          class="billing-interval-btn"
          data-interval="annual"
          aria-pressed={defaultInterval === "annual" ? "true" : "false"}
        >
          Annual
          <span class="billing-interval-badge">{annualSavingsLabel}</span>
        </button>
      </div>
      <p
        class="billing-interval-hint"
        data-hint-monthly={monthlyHint}
        data-hint-annual={annualHint}
      >
        {defaultInterval === "annual" ? annualHint : monthlyHint}
      </p>

      <div class="plan-tier-grid">
        <article class="plan-tier-card">
          <div class="plan-tier-badge-slot" aria-hidden="true"></div>
          <h2 class="plan-tier-name">Free</h2>
          <p class="plan-tier-price">$0</p>
          <div class="plan-tier-meta">
            <p class="plan-tier-savings">&nbsp;</p>
            <p class="plan-tier-sub">&nbsp;</p>
          </div>
          <p class="plan-tier-tagline">Live monitoring for one property, no credit card</p>
          <ul class="plan-tier-list">
            <li>{FREE_MAX_DEVICES} push devices per property</li>
            <li>{formatHistoryRetention(FREE_HISTORY_DAYS)} of history</li>
            <li>Threshold freeze and leak alerts</li>
          </ul>
          <div class="plan-tier-footer">
            {!user ? (
              <a class="btn-secondary" href="/register?next=/dashboard/devices">Get started</a>
            ) : currentTier === "free" ? (
              <p>Current plan</p>
            ) : (
              <p>Included in your plan</p>
            )}
          </div>
        </article>

        <article class="plan-tier-card plan-tier-card-featured" id="member" aria-labelledby="plan-member-name">
          <div class="plan-tier-badge-slot">
            <span class="plan-tier-badge">Most popular</span>
          </div>
          <h2 class="plan-tier-name" id="plan-member-name">Member</h2>
          <p class="plan-tier-price" aria-live="polite">
            <span
              class="plan-tier-amount"
              data-price-monthly={memberMonthly.amount}
              data-price-annual={memberAnnual.amount}
            >
              {defaultInterval === "annual" ? memberAnnual.amount : memberMonthly.amount}
            </span><span
              class="plan-tier-period"
              data-period-monthly={memberMonthly.period}
              data-period-annual={memberAnnual.period}
            >{defaultInterval === "annual" ? memberAnnual.period : memberMonthly.period}</span>
          </p>
          <div class="plan-tier-meta">
            <p
              class="plan-tier-savings"
              data-savings-monthly={memberSavingsMonthly}
              data-savings-annual={memberSavingsAnnual}
            >
              {defaultInterval === "annual" ? memberSavingsAnnual : memberSavingsMonthly}
            </p>
            <p
              class="plan-tier-sub"
              data-sub-monthly={memberMonthly.sub}
              data-sub-annual={memberAnnual.sub}
            >
              {defaultInterval === "annual" ? memberAnnual.sub : memberMonthly.sub}
            </p>
          </div>
          <p class="plan-tier-tagline">History export, more headroom, and forecast freeze</p>
          <ul class="plan-tier-list">
            <li>{MEMBER_MAX_DEVICES} push devices per property</li>
            <li>{formatHistoryRetention(MEMBER_HISTORY_DAYS)} of history</li>
            <li>Forecast freeze warnings</li>
            <li>CSV history export</li>
          </ul>
          <div class="plan-tier-footer">
            {user ? (
              currentTier === "free" ? (
                <form action="/api/stripe/checkout" method="post" class="checkout-form">
                  <input type="hidden" name="plan" value="member" />
                  <input type="hidden" name="interval" value={defaultInterval} data-interval-input />
                  <button class="btn-primary" type="submit">Upgrade to Member</button>
                </form>
              ) : (
                <p>Included in your plan</p>
              )
            ) : (
              <a class="btn-primary" href="/signin?next=/pricing">Sign in to subscribe</a>
            )}
          </div>
        </article>

        <article class="plan-tier-card">
          <div class="plan-tier-badge-slot" aria-hidden="true"></div>
          <h2 class="plan-tier-name">Pro</h2>
          <p class="plan-tier-price" aria-live="polite">
            <span
              class="plan-tier-amount"
              data-price-monthly={proMonthly.amount}
              data-price-annual={proAnnual.amount}
            >
              {defaultInterval === "annual" ? proAnnual.amount : proMonthly.amount}
            </span><span
              class="plan-tier-period"
              data-period-monthly={proMonthly.period}
              data-period-annual={proAnnual.period}
            >{defaultInterval === "annual" ? proAnnual.period : proMonthly.period}</span>
          </p>
          <div class="plan-tier-meta">
            <p
              class="plan-tier-savings"
              data-savings-monthly={proSavingsMonthly}
              data-savings-annual={proSavingsAnnual}
            >
              {defaultInterval === "annual" ? proSavingsAnnual : proSavingsMonthly}
            </p>
            <p
              class="plan-tier-sub"
              data-sub-monthly={`${proMonthly.sub} · 14-day free trial`}
              data-sub-annual={`${proAnnual.sub} · 14-day free trial`}
            >
              {defaultInterval === "annual"
                ? `${proAnnual.sub} · 14-day free trial`
                : `${proMonthly.sub} · 14-day free trial`}
            </p>
          </div>
          <p class="plan-tier-tagline">Official NWS alerts, Nest/Ecobee house context, <a class="text-link" href="/claims-pack">claims pack</a></p>
          <ul class="plan-tier-list">
            <li>{PRO_MAX_DEVICES} push devices per property</li>
            <li>{formatHistoryRetention(PRO_HISTORY_DAYS)}+ of history</li>
            <li>Forecast freeze warnings + official NWS alerts</li>
            <li><a class="text-link" href="/about/thermostat-oauth">Nest / Ecobee</a> thermostat connection (house vs probe)</li>
            <li><a class="text-link" href="/claims-pack">Claims / insurance evidence pack</a></li>
            <li>
              SMS, push, webhooks, Pro share scopes &amp;
              <a class="text-link" href="/docs/api">API keys</a>
            </li>
            <li>Up to {PRO_MAX_OWNED_HOUSEHOLDS} owned properties (vacation home, rental, workshop)</li>
          </ul>
          <div class="plan-tier-footer">
            {user ? (
              rawTier === "portfolio" || rawTier === "admin" ? (
                <p>Included in your plan</p>
              ) : rawTier !== "pro" ? (
                <form action="/api/stripe/checkout" method="post" class="checkout-form">
                  <input type="hidden" name="plan" value="pro" />
                  <input type="hidden" name="interval" value={defaultInterval} data-interval-input />
                  <button class="btn-primary" type="submit">Start Pro trial</button>
                </form>
              ) : (
                <p>You're on Pro</p>
              )
            ) : (
              <a class="btn-primary" href="/signin?next=/pricing">Sign in for Pro trial</a>
            )}
          </div>
        </article>

        <article class="plan-tier-card" id="portfolio">
          <div class="plan-tier-badge-slot">
            <span class="plan-tier-badge">For portfolios</span>
          </div>
          <h2 class="plan-tier-name">Portfolio</h2>
          <p class="plan-tier-price" aria-live="polite">
            <span
              class="plan-tier-amount"
              data-price-monthly={portfolioMonthly.amount}
              data-price-annual={portfolioAnnual.amount}
            >
              {defaultInterval === "annual" ? portfolioAnnual.amount : portfolioMonthly.amount}
            </span><span
              class="plan-tier-period"
              data-period-monthly={portfolioMonthly.period}
              data-period-annual={portfolioAnnual.period}
            >{defaultInterval === "annual" ? portfolioAnnual.period : portfolioMonthly.period}</span>
          </p>
          <div class="plan-tier-meta">
            <p
              class="plan-tier-savings"
              data-savings-monthly={portfolioSavingsMonthly}
              data-savings-annual={portfolioSavingsAnnual}
            >
              {defaultInterval === "annual" ? portfolioSavingsAnnual : portfolioSavingsMonthly}
            </p>
            <p
              class="plan-tier-sub"
              data-sub-monthly={portfolioMonthly.sub}
              data-sub-annual={portfolioAnnual.sub}
            >
              {defaultInterval === "annual" ? portfolioAnnual.sub : portfolioMonthly.sub}
            </p>
          </div>
          <p class="plan-tier-tagline">
            For ops past Pro’s {PRO_MAX_OWNED_HOUSEHOLDS}-property ceiling: managers without billing access
          </p>
          <ul class="plan-tier-list">
            <li>Everything in Pro, plus: </li>
            <li>Up to {PORTFOLIO_MAX_OWNED_HOUSEHOLDS} owned properties (Pro already covers up to {PRO_MAX_OWNED_HOUSEHOLDS})</li>
            <li>Cross-property freeze-risk dashboard</li>
            <li>Property-manager logins (devices &amp; alerts only, no billing or other properties)</li>
          </ul>
          <p class="text-sm text-[var(--color-text-muted)] mt-3 mb-0">
            A few rentals or a vacation place usually stay on Pro. Portfolio is priced for larger landlords and property-management teams: see
            <a class="text-link" href="/property-management">property management</a>.
          </p>
          <div class="plan-tier-footer">
            {user ? (
              rawTier === "portfolio" || rawTier === "admin" ? (
                <p>You're on Portfolio</p>
              ) : portfolioPricingConfigured ? (
                <form action="/api/stripe/checkout" method="post" class="checkout-form">
                  <input type="hidden" name="plan" value="portfolio" />
                  <input type="hidden" name="interval" value={defaultInterval} data-interval-input />
                  <button class="btn-primary" type="submit">Upgrade to Portfolio</button>
                </form>
              ) : (
                <a class="btn-primary" href="/contact">Contact us about Portfolio</a>
              )
            ) : portfolioPricingConfigured ? (
              <a class="btn-primary" href="/signin?next=/pricing">Sign in to subscribe</a>
            ) : (
              <a class="btn-primary" href="/contact">Contact us about Portfolio</a>
            )}
          </div>
        </article>
      </div>
      {user && hasBilling && (
        <form action="/api/stripe/portal" method="post" class="mt-4">
          <button class="btn-secondary" type="submit">Manage billing</button>
        </form>
      )}
    </section>

    <div class="product-shot-row">
      <ProductScreenshot
        shot="history-chart"
        caption="Member and Pro keep longer curves. Free still shows live readings plus threshold freeze and leak alerts."
      />
      <section class="card" id="integrations">
        <h2 class="card-title">Integrations on Pro</h2>
        <p class="card-subtitle mb-4">
          Free already includes one family live share link. Pro unlocks history/metrics scopes, never-expire links,
          inbound snooze webhooks, outbound alert hooks, and the
          <a class="text-link" href="/integrations/home-assistant">official Home Assistant HACS integration</a>
          at full power. Connect <a class="text-link" href="/about/thermostat-oauth">Nest or Ecobee</a> for house
          ambient and setpoint beside your garage probes, or push any indoor climate sensor as an
          <a class="text-link" href="/dashboard/devices?view=setup&tab=pull#indoor-reference">indoor reference</a>.
          Keep MQTT on your LAN; use ThermalTrace for household freeze and leak SMS, history, and off-site alerts.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="/integrations">All integrations</a>
          <a class="btn-secondary" href="/integrations/home-assistant">HACS install guide</a>
          <a class="btn-secondary" href="/about/thermostat-oauth">Nest / Ecobee</a>
          <a class="btn-ghost" href="/docs/api">HTTP API</a>
        </div>
      </section>
    </div>

    <section class="card" id="plan-matrix">
      <h2 class="card-title">Full feature comparison</h2>
      <p class="card-subtitle mb-4">
        Canonical plan matrix for Free / Member / Pro / Portfolio: device counts, retention, freeze and leak alerts, thermostat, and manager logins.
        Comparing ThermalTrace against MQTT, Govee, or a weather station?
        {" "}<a class="text-link" href="/compare">See alternatives</a>
        {" "}(competitor guides, not a second copy of this table).
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mb-4">
        Portfolio includes everything under Pro, then raises the owned-property ceiling (Pro already allows up to {PRO_MAX_OWNED_HOUSEHOLDS}; Portfolio up to {PORTFOLIO_MAX_OWNED_HOUSEHOLDS}) and adds property-manager logins: see the Portfolio card above and
        <a class="text-link" href="/property-management">property management</a>.
      </p>
      <PlanComparisonTable highlightTier={currentTier} />
    </section>

    <section class="card">
      <h2 class="card-title">Hosted on Cloudflare’s edge</h2>
      <p class="mb-0 text-sm">
        Dashboards and ingest APIs run on Cloudflare Workers, no home server for you to keep online.
        For live job and ingest health (not a borrowed uptime badge), see
        <a class="text-link" href="/system-status">system status</a>.
      </p>
    </section>

    <FaqSection
      faqs={pricingFaqs}
      lede="Plan limits, upgrades, and billing: answered for freeze-season shoppers."
    />

    <section class="card">
      <h2 class="card-title">Still deciding?</h2>
      <p class="mb-0">
        Read the <a class="text-link" href="/stories/garage-freeze-alert">freeze case study</a>,
        build from the <a class="text-link" href="/about/esp32-freeze-kit">ESP32 freeze kit</a>
        or <a class="text-link" href="/accessories">hardware accessories</a>
        (including the <a class="text-link" href="/claim-puck">claim puck</a>),
        compare against <a class="text-link" href="/compare">DIY MQTT, Govee, or Tempest</a>,
        see the <a class="text-link" href="/about/accounts-and-dashboard">accounts guide</a>,
        or <a class="text-link" href="/contact">contact us</a> if you're unsure which tier fits.
      </p>
    </section>
  </div>

  <script define:vars={{ defaultInterval }}>
    const STORAGE_KEY = "thermaltrace-pricing-interval";

    function readInterval() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === "monthly" || stored === "annual") return stored;
      } catch {
        /* ignore */
      }
      return defaultInterval === "monthly" ? "monthly" : "annual";
    }

    function applyInterval(interval) {
      document.querySelectorAll(".billing-interval-btn").forEach((btn) => {
        const active = btn.getAttribute("data-interval") === interval;
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.classList.toggle("billing-interval-btn-active", active);
      });

      document.querySelectorAll("[data-price-monthly]").forEach((el) => {
        const price = el.getAttribute(`data-price-${interval}`) ?? "";
        el.textContent = price;
      });

      document.querySelectorAll("[data-period-monthly]").forEach((el) => {
        el.textContent = el.getAttribute(`data-period-${interval}`) ?? "";
      });

      document.querySelectorAll(".plan-tier-sub").forEach((el) => {
        const sub = el.getAttribute(`data-sub-${interval}`) ?? "\u00a0";
        el.textContent = sub || "\u00a0";
      });

      document.querySelectorAll(".plan-tier-savings").forEach((el) => {
        const savings = el.getAttribute(`data-savings-${interval}`) ?? "";
        el.textContent = savings || "\u00a0";
      });

      document.querySelectorAll("[data-hint-monthly]").forEach((el) => {
        const hint = el.getAttribute(`data-hint-${interval}`) ?? "";
        if (hint) el.textContent = hint;
      });

      document.querySelectorAll("[data-interval-input]").forEach((input) => {
        input.value = interval;
      });

      try {
        localStorage.setItem(STORAGE_KEY, interval);
      } catch {
        /* ignore */
      }
    }

    const initial = readInterval();
    applyInterval(initial);

    document.querySelectorAll(".billing-interval-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const interval = btn.getAttribute("data-interval");
        if (interval === "monthly" || interval === "annual") {
          applyInterval(interval);
        }
      });
    });

    document.querySelectorAll("form.checkout-form").forEach((form) => {
      form.addEventListener("submit", () => {
        const plan =
          form.querySelector('input[name="plan"]')?.getAttribute("value") ?? "unknown";
        const interval =
          form.querySelector('input[name="interval"]')?.getAttribute("value") ?? "unknown";
        const gtag = window.gtag;
        if (typeof gtag === "function") {
          gtag("event", "begin_checkout", {
            item_list_id: "pricing",
            items: [{ item_id: plan, item_name: plan, item_category: interval }],
          });
        }
      });
    });
  </script>
</Layout>
