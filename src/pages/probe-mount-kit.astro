---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { BRAND_NAME } from "../lib/brand";

const DS18B20 = BOM.adafruitDs18b20;
const CLIPS = BOM.mcmasterCableTieMounts;
const ZIP = BOM.mcmasterUvZipTies;
const RESISTOR = BOM.amazonResistor4k7;
const PADS = BOM.adafruitFoamTape;
---
<AccessoryProduct
  accessoryId="probe-mount-kit"
  faqKey="probeMountKit"
  title="Probe mount kit"
  description={`Zip-ties, pipe clips, adhesive pads, 4.7k pull-up, and waterproof DS18B20 mounting notes for a reliable ${BRAND_NAME} freeze probe.`}
  kicker="Kit / merch"
>
  <a slot="actions" class="btn-primary" href="/about/esp32-freeze-kit">ESP32 freeze kit</a>
  <a slot="actions" class="btn-secondary" href="/about/probe-mounting-enclosures">Mounting guide</a>
  <a slot="actions" class="btn-ghost" href="/about/pico-w-ingest">Pico W ingest</a>

  <section class="card">
    <h2 class="card-title">What it is</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>Does:</strong> Names the physical bits that make a garage probe stay put and read pipe/air
        temperature honestly.
      </li>
      <li>
        <strong>Does not:</strong> A ThermalTrace-branded drop-ship box. Buy parts from Adafruit / Amazon using the
        lists below and the
        <a class="text-link" href="/about/esp32-freeze-kit">ESP32 freeze kit BOM</a>.
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">BOM</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">Probe mount kit BOM</caption>
        <thead>
          <tr>
            <th scope="col">Part</th>
            <th scope="col">Why</th>
            <th scope="col">Buy</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Waterproof DS18B20</th>
            <td>1m+ lead, stainless tip for pipe / crawlspace.</td>
            <td>
              <a class="text-link" href={DS18B20} target="_blank" rel={commerceLinkRel(DS18B20)}>Adafruit DS18B20</a>
              ·
              <a class="text-link" href={BOM.amazonDs18b20} target="_blank" rel={commerceLinkRel(BOM.amazonDs18b20)}>Amazon</a>
            </td>
          </tr>
          <tr>
            <th scope="row">4.7kΩ resistor</th>
            <td>1-Wire pull-up to 3.3V.</td>
            <td>
              <a class="text-link" href={RESISTOR} target="_blank" rel={commerceLinkRel(RESISTOR)}>Amazon 4.7k</a>
            </td>
          </tr>
          <tr>
            <th scope="row">UV zip-ties</th>
            <td>Secure probe to pipe or strut without crushing the tip.</td>
            <td>
              <a class="text-link" href={ZIP} target="_blank" rel={commerceLinkRel(ZIP)}>McMaster UV zip-ties</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Pipe clip / cable mount</th>
            <td>Optional rigid hold on copper / PEX.</td>
            <td>
              <a class="text-link" href={CLIPS} target="_blank" rel={commerceLinkRel(CLIPS)}>McMaster cable-tie mounts</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Adhesive pads</th>
            <td>Mount the ESP32 enclosure on painted drywall or joists.</td>
            <td>
              <a class="text-link" href={PADS} target="_blank" rel={commerceLinkRel(PADS)}>Adafruit foam tape</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">Placement tips</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>Prefer pipe metal or insulated tip contact over dangling in a sunny doorway.</li>
      <li>Keep the ESP32 dry; only the probe tip belongs in damp crawlspaces.</li>
      <li>
        Validate swings with the
        <a class="text-link" href="/about/probe-demo">probe demo</a>
        and
        <a class="text-link" href="/about/probe-mounting-enclosures">mounting enclosures</a>
        article.
      </li>
    </ul>
  </section>
</AccessoryProduct>
