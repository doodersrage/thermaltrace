---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import { BRAND_NAME } from "../lib/brand";
import {
  getBreadcrumbSchema,
  getSoftwareApplicationSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";
import garageInstallLifestyle from "../assets/thermaltrace-garage-install-lifestyle.jpg";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/android");
const androidFaqs = getMarketingFaqs("android");

const ANDROID_REPO = "https://github.com/doodersrage/thermaltrace-android";
const playStoreUrl = String(import.meta.env.PUBLIC_PLAY_STORE_URL ?? "").trim();
const playStoreLive = playStoreUrl.startsWith("https://play.google.com/");

const software = getSoftwareApplicationSchema(siteUrl);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Apps", path: "/apps" },
    { name: "Android app", path: "/android" },
  ]),
  {
    ...software,
    "@type": ["SoftwareApplication", "MobileApplication"],
    name: `${BRAND_NAME} for Android`,
    operatingSystem: "Android",
    applicationCategory: "UtilitiesApplication",
    url: pageUrl,
    downloadUrl: playStoreLive ? playStoreUrl : ANDROID_REPO,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: playStoreLive
        ? "https://schema.org/InStock"
        : "https://schema.org/PreOrder",
      url: playStoreLive ? playStoreUrl : pageUrl,
    },
  },
  getMarketingFaqSchema(pageUrl, "android"),
].filter(Boolean) as Record<string, unknown>[];

const description = playStoreLive
  ? `${BRAND_NAME} Android companion on Google Play, live probes, freeze and flood alerts, MFA, and household tools for your existing account. Phone is not a sensor.`
  : `${BRAND_NAME} works on Android today via the installable web app (PWA). Native Play store app is in review — live probes, freeze and flood alerts, MFA for your existing account. Phone is not a sensor.`;
---
<Layout
  title="Android app"
  description={description}
  schema={schema}
  ogImage="/og-android.jpg"
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker={playStoreLive ? "Google Play" : "Works today · native app next"}
      title="ThermalTrace for Android"
      lede={playStoreLive
        ? "Native companion on Google Play, live readings, history, freeze/flood alerts, devices, MFA, and household tools for your ThermalTrace account."
        : "Use ThermalTrace on Android today with the installable web app — same account, live readings, and alerts. The native Play listing is in review; GitHub build/sideload is optional for early testers."}
    >
      {playStoreLive ? (
        <a slot="actions" class="btn-primary" href={playStoreUrl} target="_blank" rel="noreferrer">
          Get it on Google Play
        </a>
      ) : (
        <a slot="actions" class="btn-primary" href="/about/install-pwa">
          Install the web app (PWA)
        </a>
      )}
      {!playStoreLive && (
        <a slot="actions" class="btn-secondary" href={ANDROID_REPO} target="_blank" rel="noreferrer">
          GitHub · build or sideload
        </a>
      )}
      <a slot="actions" class="btn-ghost" href={playStoreLive ? ANDROID_REPO : "/contact?topic=android"}>
        {playStoreLive ? "Source on GitHub" : "Request Play launch note"}
      </a>
    </PageHeader>

    <figure class="card overflow-hidden p-0 mb-0">
      <Image
        src={garageInstallLifestyle}
        alt={`${BRAND_NAME} lifestyle photo: checking probe readings on phone and laptop beside a DIY install near copper pipes`}
        widths={[640, 960, 1280]}
        sizes="(max-width: 960px) 100vw, 900px"
        class="w-full h-auto block"
      />
      <figcaption class="px-4 py-3 text-sm text-[var(--color-text-muted)]">
        DIY install vibe: phone and laptop as companions to your own probes. Screens in this
        illustration are stylized, not a product screenshot.
      </figcaption>
    </figure>

    <section class="card">
      <h2 class="card-title">What the phone does (and does not)</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li>
          <strong>Does:</strong> sign in to your ThermalTrace account, show live curves, history,
          and the same forecast-backed time-to-freeze clock as Overview,
          manage alerts/devices/household settings, and (on Pro) receive freeze/flood push via Firebase Cloud Messaging.
        </li>
        <li>
          <strong>Does not:</strong> read temperature from the handset. Your ESP/Arduino (or JSON feeds)
          keep posting to thermaltrace.dev; the app is a client over HTTPS.
        </li>
      </ul>
      <p class="mt-4 mb-0 text-sm text-[var(--color-text-muted)]">
        Want a desktop glance instead?
        <a class="text-link" href="/bay-buddy">Bay Buddy</a>
        shows freeze and flood moods for one space without opening the full dashboard.
      </p>
    </section>

    {playStoreLive ? (
      <section class="card">
        <h2 class="card-title">Google Play</h2>
        <p class="card-subtitle mb-4">
          Install from the Play Store with the same ThermalTrace account you use on the web.
          Pro push alerts use Firebase Cloud Messaging on Android.
        </p>
        <a class="btn-primary" href={playStoreUrl} target="_blank" rel="noreferrer">
          Open in Google Play
        </a>
      </section>
    ) : (
      <section class="card">
        <h2 class="card-title">Use Android today (PWA)</h2>
        <p class="card-subtitle mb-4">
          Install thermaltrace.dev from Chrome — home screen icon, live readings, and alerts on your existing account.
          Native Play listing is next; GitHub build/sideload stays optional for early testers.
        </p>
        <div class="flex flex-wrap gap-3 mb-4">
          <a class="btn-primary" href="/about/install-pwa">PWA install steps</a>
          <a class="btn-secondary" href={ANDROID_REPO} target="_blank" rel="noreferrer">
            GitHub · thermaltrace-android
          </a>
        </div>
        <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
          <li>
            <a class="text-link" href="/register?next=/dashboard/devices">Create a free ThermalTrace account</a>
            and connect at least one probe.
          </li>
          <li>
            Install the PWA (or build/sideload the native app) and sign in with the same credentials.
          </li>
          <li>
            Enable Pro push alerts in
            <a class="text-link" href="/dashboard/alerts">Alert settings</a>
            for Firebase freeze notifications when the native app is installed.
          </li>
        </ol>
      </section>
    )}

    {!playStoreLive && (
    <section class="card">
      <h2 class="card-title">While Play review is pending</h2>
      <p class="card-subtitle mb-4">
        You already have a full phone experience via the PWA. The native app will attach to the same account when the listing goes live.
      </p>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li>
          <a class="text-link" href="/register?next=/dashboard/devices">Create a free account</a>
          and connect a push device or HTTPS feed.
        </li>
        <li>
          Set freeze thresholds under
          <a class="text-link" href="/dashboard/alerts">Alert settings</a>
          (email/chat today; SMS and push on Pro).
        </li>
        <li>
          On Android Chrome,
          <a class="text-link" href="/about/install-pwa">install the PWA</a>
          for a home-screen shortcut and optional browser Web Push.
        </li>
        <li>
          Prefer a launch email?
          <a class="text-link" href="/contact?topic=android">Tell us you’re waiting on Play</a>
          we read every message.
        </li>
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        Deep links stay aligned with the web app (<code>/dashboard</code>, alerts, household) so the native client and PWA feel familiar.
      </p>
    </section>
    )}

    <section class="card">
      <h2 class="card-title">Open source</h2>
      <p class="card-subtitle mb-0">
        App repository:
        <a
          class="text-link"
          href={ANDROID_REPO}
          target="_blank"
          rel="noreferrer"
        >thermaltrace-android</a>
        · Privacy:
        <a class="text-link" href="/privacy">how Android push tokens are handled</a>
        · API:
        <a class="text-link" href="/docs/api">HTTP reference</a>
      </p>
    </section>

    <FaqSection
      faqs={androidFaqs}
      lede="Straight answers for Play reviewers and homeowners waiting on the listing."
    />

    <p class="mb-0 text-sm">
      <a class="text-link" href="/apps">← All companion apps</a>
    </p>
  </div>
</Layout>
