---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqSection from "../components/FaqSection.astro";
import {
  listLatestFreezeMapSnapshots,
} from "../lib/freezeMap";
import {
  FREEZE_MAP_SAMPLE_FLOOR,
  resolveFreezeMapDisplay,
} from "../lib/freezeMapSeed";
import { COLD_SNAP_CHECKLIST } from "../lib/coldSnapChecklist";
import { getAuthFromCookies } from "../lib/auth";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  getHowToSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const { user } = await getAuthFromCookies(Astro.cookies);
const resolved = resolveFreezeMapDisplay(
  await listLatestFreezeMapSnapshots(),
  new Map(),
);
const snapshots = resolved.snapshots;
const isSeed = resolved.isSeed;
const visible = snapshots.filter(
  (row) => row.sample_count >= FREEZE_MAP_SAMPLE_FLOOR,
);
const coldest = [...visible]
  .filter((row) => row.min_temp_f != null)
  .sort((a, b) => (a.min_temp_f ?? 999) - (b.min_temp_f ?? 999))
  .slice(0, 3);

const month = new Date().getUTCMonth(); // 0-11
const inFreezeSeason = month >= 10 || month <= 2; // Nov–Mar
const seasonLabel = inFreezeSeason ? "Freeze season is here" : "Get ready before freeze season";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/freeze-season");
const description =
  "Set freeze alerts before the cold snap. Live community freeze map, ESP probe ingest, and email (SMS on Pro) when indoor temps drop toward 32°F.";

const freezeSeasonFaqs = [
  {
    question: "When is freeze season for ThermalTrace?",
    answer:
      "Treat November through March as primary freeze season in most of the contiguous US. Coastal and mountain climates vary; use your coldest nights and NWS freeze warnings as the real signal.",
  },
  {
    question: "Why not rely on outdoor weather alone?",
    answer:
      "Outdoor stations measure the yard. Pipes freeze in unheated bays, crawlspaces, and shops that lag outdoor air. Put a probe where the water is, then use outdoor weather for context.",
  },
  {
    question: "What should I do tonight before a cold snap?",
    answer:
      "Drip exterior-wall faucets if lines run cold, close propped doors, insulate spigots, confirm freeze alerts with a test, and verify a probe sits in the coldest corner near pipes. Checklist on this page.",
  },
  {
    question: "Where is the ESP32 parts list?",
    answer:
      "thermaltrace.dev/about/esp32-freeze-kit — ESP32 + waterproof DS18B20 BOM, wiring, and flash steps.",
  },
];

const freezeSeasonHowTo = getHowToSchema({
  name: "Prepare ThermalTrace for a freeze night",
  description,
  pageUrl,
  totalTime: "PT30M",
  steps: [
    ...COLD_SNAP_CHECKLIST.map((text, index) => ({
      name: `Checklist step ${index + 1}`,
      text,
    })),
    {
      name: "Opt into the freeze map (optional)",
      text: "Share anonymized city-level probe samples on the public freeze map so neighbors see regional risk.",
      url: `${siteUrl}/freeze-map`,
    },
  ],
});

const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Freeze season", path: "/freeze-season" },
  ]),
  getFaqPageSchema(pageUrl, freezeSeasonFaqs),
  freezeSeasonHowTo,
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Freeze season probe watch"
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Seasonal"
      title={seasonLabel}
      lede="Pipe freezes happen in spaces you do not walk through every hour. Put a probe where the water is, set a threshold a few degrees above 32°F, and get a clock for when this space hits freeze, plus an alert while you still have hours to act."
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/alerts?tab=settings#alert-section-essentials" : "/register?next=/dashboard/devices"}>
        {user ? "Open alert essentials" : "Start free: connect a probe"}
      </a>
      <a slot="actions" class="btn-secondary" href="/freeze-map">Community freeze map</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">Tonight’s checklist</h2>
      <ol class="text-sm space-y-2 mb-0">
        {COLD_SNAP_CHECKLIST.map((item) => (
          <li>{item}</li>
        ))}
        <li>
          Optional: opt your city into the <a class="text-link" href="/freeze-map">public freeze map</a>.
        </li>
      </ol>
    </section>

    {coldest.length > 0 && (
      <section class="card">
        <h2 class="card-title">{isSeed ? "Sample coldest cities" : "Coldest opt-in cities"}</h2>
        <p class="card-subtitle mb-4">
          {isSeed
            ? "Illustrative preview until enough households opt into the freeze map."
            : "From the latest ThermalTrace freeze-map snapshot."}
        </p>
        <ul class="text-sm space-y-2 mb-0">
          {coldest.map((row) => (
            <li>
              <strong>{row.city_label}</strong>: min {row.min_temp_f?.toFixed(1)}°F
            </li>
          ))}
        </ul>
        <p class="mt-4 mb-0">
          <a class="btn-secondary" href="/freeze-map">View full map</a>
        </p>
      </section>
    )}

    <section class="card">
      <h2 class="card-title">Why indoor probes beat outdoor weather alone</h2>
      <p class="mb-4 text-sm">
        A Tempest or airport reading says how cold the yard is. Your pipes care about the unheated bay,
        the leaky door, and the failed space heater. ThermalTrace watches that space, and can sit next to
        outdoor weather on your dashboard for context.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/compare/tempest">vs outdoor weather stations</a>
        <a class="btn-secondary" href="/about/esp32-freeze-kit">ESP32 + DS18B20 parts list</a>
        <a class="btn-ghost" href="/stories">Read freeze stories</a>
        <a class="btn-ghost" href="/demo">Try the live demo</a>
      </div>
    </section>

    <FaqSection
      faqs={freezeSeasonFaqs}
      lede="Seasonal freeze prep for homeowners with probes in cold spaces."
    />
  </div>
</Layout>
