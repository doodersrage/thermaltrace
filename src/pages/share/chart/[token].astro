---
import Layout from "../../layouts/Layout.astro";
import { getChartShareByToken } from "../../lib/chartShare";

export const prerender = false;

const token = Astro.params.token?.trim() ?? "";
if (!token) {
  return new Response("Not found", { status: 404 });
}

const share = await getChartShareByToken(token);
if (!share?.png) {
  return new Response("This chart share expired or was not found.", { status: 404 });
}

const format = Astro.url.searchParams.get("format");
if (format === "png") {
  return new Response(share.png, {
    status: 200,
    headers: {
      "Content-Type": "image/png",
      "Cache-Control": "public, max-age=3600",
    },
  });
}

const title = share.title?.trim() || "ThermalTrace chart";
---
<Layout title={title}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-2xl font-semibold mb-2">{title}</h1>
    <p class="text-sm text-[var(--color-text-muted)] mb-6">
      Shared chart snapshot · expires {new Date(share.expiresAt).toLocaleDateString()}
    </p>
    <img
      src={`/share/chart/${token}?format=png`}
      alt={title}
      class="w-full rounded border border-[var(--color-border)] bg-[var(--color-surface)]"
    />
    <p class="mt-6 text-sm">
      <a class="text-link" href="/">ThermalTrace</a>
      {" · "}
      <a class="text-link" href="/dashboard/history">Open History</a>
    </p>
  </main>
</Layout>
