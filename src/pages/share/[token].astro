---
import Layout from "../../layouts/Layout.astro";

const token = Astro.params.token;
if (!token) {
  return Astro.redirect("/");
}

const readingsUrl = `/api/share/${token}/readings`;
---
<Layout title="Shared live view" description="Read-only shared probe sensor readings." noindex>
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-semibold mb-2" id="share-title">Shared sensors</h1>
    <p class="text-[var(--color-text-muted)] mb-2" id="share-subtitle">Live read-only view</p>
    <p class="text-sm text-[var(--color-text-muted)] mb-8" id="share-meta"></p>
    <div id="share-root" class="space-y-4" data-url={readingsUrl}>
      <p>Loading…</p>
    </div>
    <p class="mt-10 text-sm text-[var(--color-text-muted)]">
      Want your own probe monitor?
      <a class="text-link" href="/register?next=/dashboard/devices">Create a free account</a>
    </p>
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.getElementById("share-root");
    const titleEl = document.getElementById("share-title");
    const subtitleEl = document.getElementById("share-subtitle");
    const metaEl = document.getElementById("share-meta");
    if (!root) return;
    const url = root.getAttribute("data-url");
    const STALE_MS = 2 * 60 * 60 * 1000;
    let pollTimer = null;

    function formatAge(iso) {
      if (!iso) return null;
      const ms = Date.now() - Date.parse(iso);
      if (Number.isNaN(ms) || ms < 0) return null;
      const minutes = Math.floor(ms / 60000);
      let label;
      if (minutes < 1) label = "Updated just now";
      else if (minutes < 60) label = "Updated " + minutes + "m ago";
      else {
        const hours = Math.floor(minutes / 60);
        label =
          hours < 48
            ? "Updated " + hours + "h ago"
            : "Updated " + Math.floor(hours / 24) + "d ago";
      }
      return { label, stale: ms >= STALE_MS };
    }

    function formatValue(r) {
      if (r.value_bool != null) {
        if (r.kind === "door") return r.value_bool ? "Open" : "Closed";
        if (r.kind === "power") return r.value_bool ? "On" : "Off";
        if (r.kind === "flood") return r.value_bool ? "Wet" : "Dry";
        if (r.kind === "motion") return r.value_bool ? "Detected" : "Clear";
        return r.value_bool ? "On / Open" : "Off / Closed";
      }
      if (r.value_num != null) {
        return Number(r.value_num).toFixed(1) + (r.unit ? " " + r.unit : "");
      }
      return r.value_text || "—";
    }

    function kindLabel(kind) {
      return (
        {
          temperature: "Temperature",
          humidity: "Humidity",
          co2: "CO₂",
          pressure: "Pressure",
          pm25: "PM2.5",
          voc: "VOC",
          level: "Level",
          energy: "Energy",
          door: "Door",
          power: "Power",
          flood: "Flood",
          motion: "Motion",
          generic: "Sensor",
        }[kind] || kind
      );
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function retryButtonHtml() {
      return '<p class="mt-4 mb-0"><button type="button" class="btn-secondary" id="share-retry">Retry</button></p>';
    }

    function bindRetry() {
      document.getElementById("share-retry")?.addEventListener("click", () => {
        root.innerHTML = "<p>Loading…</p>";
        load();
      });
    }

    function render(data) {
      if (titleEl && data.label) titleEl.textContent = data.label;
      if (subtitleEl) {
        subtitleEl.textContent =
          data.scope === "history"
            ? "History read-only view (7 days)"
            : data.scope === "metrics"
              ? "Metrics share"
              : "Live read-only view";
      }
      if (metaEl) {
        const parts = [];
        if (data.expires_at) {
          parts.push("Expires " + new Date(data.expires_at).toLocaleString());
        } else {
          parts.push("No expiry");
        }
        if (data.scope !== "history") {
          parts.push("Updates every 90 seconds");
        }
        metaEl.textContent = parts.join(" · ");
      }

      const history = data.history_points || [];
      let historyHtml = "";
      if (data.scope === "history" && history.length >= 2) {
        const temps = history.map((p) => p.tempf);
        const min = Math.min(...temps) - 2;
        const max = Math.max(...temps) + 2;
        const range = max - min || 1;
        const w = 320;
        const h = 120;
        const path = history
          .map((p, i) => {
            const x = (i / (history.length - 1)) * w;
            const y = h - ((p.tempf - min) / range) * h;
            return (i === 0 ? "M" : "L") + x.toFixed(1) + "," + y.toFixed(1);
          })
          .join(" ");
        historyHtml =
          '<div class="card mb-4"><p class="m-0 mb-2 text-sm text-[var(--color-text-muted)]">7-day temperature trend</p>' +
          '<svg viewBox="0 0 ' +
          w +
          " " +
          h +
          '" width="100%" height="120" role="img" aria-label="Temperature history chart">' +
          '<path d="' +
          path +
          '" fill="none" stroke="#ff7a00" stroke-width="2" /></svg></div>';
      }

      const readings = data.readings || [];
      if (readings.length === 0 && !historyHtml) {
        root.innerHTML =
          '<div class="empty-state">' +
          "<p>No readings yet. Sensors on this link may not have posted data.</p>" +
          '<p class="text-sm text-[var(--color-text-muted)] mb-0">This page keeps checking automatically.</p>' +
          retryButtonHtml() +
          "</div>";
        bindRetry();
        return;
      }

      root.innerHTML =
        historyHtml +
        readings
          .map((r) => {
            const age = formatAge(r.recorded_at);
            const staleClass = age && age.stale ? " stat-item-stale" : "";
            const ageHtml = age
              ? `<p class="m-0 mt-1 text-sm ${
                  age.stale ? "text-amber-300" : "text-[var(--color-text-muted)]"
                }">${age.stale ? "Stale · " + age.label : age.label}</p>`
              : "";
            return `<div class="card${staleClass}">
            <strong>${escapeHtml(r.label)}</strong>
            <p class="m-0 text-sm text-[var(--color-text-muted)]">${escapeHtml(r.device)} · ${escapeHtml(
              kindLabel(r.kind),
            )}</p>
            <p class="text-2xl m-0 mt-2">${escapeHtml(formatValue(r))}</p>
            ${ageHtml}
          </div>`;
          })
          .join("");
    }

    async function load() {
      try {
        const res = await fetch(url);
        const data = await res.json();
        if (!res.ok) {
          root.innerHTML =
            `<div class="empty-state"><p>${escapeHtml(
              data.error || "Unable to load this share link.",
            )}</p>${retryButtonHtml()}</div>`;
          if (metaEl) metaEl.textContent = "";
          bindRetry();
          return;
        }
        render(data);
      } catch {
        root.innerHTML =
          '<div class="empty-state"><p>Failed to load shared readings.</p>' +
          retryButtonHtml() +
          "</div>";
        bindRetry();
      }
    }

    load();
    pollTimer = setInterval(load, 90000);
  })();
</script>
