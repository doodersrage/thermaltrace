---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { fetchAppStatus } from "../lib/appStatus";
import { formatRelativeAge } from "../lib/relativeTime";
import {
  getBreadcrumbSchema,
  resolveSiteUrl,
} from "../lib/schemaMarkup";

const status = await fetchAppStatus();
const cronAge = formatRelativeAge(status.lastCronAt, "never");
const historyPollAge = formatRelativeAge(status.lastHistoryPollAt, "never");

const bannerTone = !status.healthy
  ? "danger"
  : status.ingestRateLimitElevated
    ? "warning"
    : "success";
const bannerTitle = !status.healthy
  ? "Degraded: investigating"
  : status.ingestRateLimitElevated
    ? "Operational: elevated ingest rate limits"
    : "All systems operational";
const bannerDetail = !status.healthy
  ? [
      status.historyPollStale ? "History poll is overdue." : null,
      status.recentJobErrors > 0
        ? `${status.recentJobErrors} cron job error${status.recentJobErrors === 1 ? "" : "s"} in the last 24 hours.`
        : null,
      status.lastCronStatus === "error" ? "Latest cron run failed." : null,
      !status.lastCronAt ? "No recent cron runs recorded." : null,
    ]
      .filter(Boolean)
      .join(" ")
  : "Healthy means the history poll is on schedule and no cron jobs failed in the last 24 hours. Ingest rate-limit events are shown separately and do not flip this banner to degraded by themselves.";

const siteUrl = resolveSiteUrl(Astro.site);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "System status", path: "/system-status" },
  ]),
];

const subscribed = Astro.url.searchParams.get("subscribed") === "1";
const confirmed = Astro.url.searchParams.get("confirmed") === "1";
const unsubscribed = Astro.url.searchParams.get("unsubscribed") === "1";
const statusError = Astro.url.searchParams.get("status_error");
const statusErrorMessage =
  statusError === "invalid_email"
    ? "Enter a valid email address."
    : statusError === "verification"
      ? "Verification failed. Please try again."
      : statusError === "rate_limited"
        ? "Too many attempts. Please try again in a few minutes."
        : statusError === "invalid_token"
          ? "That link is invalid or has already been used."
          : null;
---
<Layout
  title="System status"
  description="Live ThermalTrace system health: scheduled alert jobs, ingest activity, Cloudflare hosting, and whether crons are running on schedule."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Status"
      title="System status"
      lede="Public health for ThermalTrace jobs and ingest: what we measure ourselves. Updated on each page load."
    />

    <section class="card" aria-live="polite">
      <p
        class:list={[
          "text-lg font-semibold mb-2",
          bannerTone === "success" && "text-[var(--color-success-text)]",
          bannerTone === "warning" && "text-[var(--color-warning-text)]",
          bannerTone === "danger" && "text-[var(--color-danger)]",
        ]}
      >
        {bannerTitle}
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mb-4">{bannerDetail}</p>
      <dl class="text-sm space-y-2 mb-0">
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Last history poll</dt>
          <dd class:list={[status.historyPollStale && "text-[var(--color-danger)]"]}>
            {historyPollAge.label}
            {status.historyPollStale ? " (overdue)" : ""}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Poll schedule</dt>
          <dd>Every 15 minutes (:00, :15, :30, :45 UTC)</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Last cron job</dt>
          <dd>{status.lastCronJob ?? "—"} ({cronAge.label})</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Last job status</dt>
          <dd
            class:list={[
              status.lastCronStatus === "error" && "text-[var(--color-danger)]",
              status.lastCronStatus === "success" && "text-[var(--color-success-text)]",
            ]}
          >
            {status.lastCronStatus ?? "—"}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Job errors (24h)</dt>
          <dd class:list={[status.recentJobErrors > 0 && "text-[var(--color-danger)]"]}>
            {status.recentJobErrors}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Ingest rate-limit events (24h)</dt>
          <dd class:list={[status.ingestRateLimitElevated && "text-[var(--color-warning-text)]"]}>
            {status.ingestAbuseCount}
          </dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="text-[var(--color-text-muted)]">Checked at</dt>
          <dd>{new Date(status.checkedAt).toLocaleString()}</dd>
        </div>
      </dl>
    </section>

    <section class="card">
      <h2 class="card-title">Incidents</h2>
      <p class="card-subtitle mb-4">
        Written notes for customer-visible outages or degradations. Cron errors above also drive the live banner and status-email subscribers.
      </p>
      {status.healthy ? (
        <p class="mb-0 text-sm">
          No incidents recorded yet. When we publish a resolved incident (date, impact, recovery), it will appear here.          until then, treat the live banner and recent cron table as the source of truth.
        </p>
      ) : (
        <div class="alert-warning mt-0 mb-0" role="status">
          <p class="m-0 font-semibold">Open: service degraded</p>
          <p class="m-0 text-sm mt-1">{bannerDetail}</p>
          <p class="m-0 text-sm mt-2 text-[var(--color-text-muted)]">
            Started around this page load ({new Date(status.checkedAt).toLocaleString()}). Status subscribers are notified on degrade and recovery.
          </p>
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">Recent cron runs</h2>
      <p class="card-subtitle mb-4">Last 14 job executions (no sensitive detail shown).</p>
      {status.recentJobRuns.length === 0 ? (
        <p class="mb-0 text-sm text-[var(--color-text-muted)]">No job runs recorded yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[var(--color-text-muted)]">
                <th class="py-2 pr-3">Started</th>
                <th class="py-2 pr-3">Job</th>
                <th class="py-2">Status</th>
              </tr>
            </thead>
            <tbody>
              {status.recentJobRuns.map((run) => (
                <tr class="border-t border-[var(--color-border)]">
                  <td class="py-2 pr-3 whitespace-nowrap">{new Date(run.started_at).toLocaleString()}</td>
                  <td class="py-2 pr-3 font-mono text-xs">{run.job_name}</td>
                  <td class="py-2">
                    <span class:list={[run.status === "success" && "text-[var(--color-success)]", run.status === "error" && "text-[var(--color-danger)]"]}>
                      {run.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="card">
      <h2 class="card-title">What we monitor</h2>
      <ul class="text-sm space-y-2 mb-0">
        <li>Hourly history collection and alert evaluation</li>
        <li>Weekly digest and monthly/quarterly report emails</li>
        <li>Sensor reading retention and freeze-map aggregates</li>
        <li>Trial reminders and onboarding drip emails</li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Hosting</h2>
      <p class="mb-3 text-sm">
        ThermalTrace runs on <strong>Cloudflare’s edge network</strong> (Workers) so the dashboard and ingest APIs stay close to visitors, without you operating a home server.
        We publish <em>this</em> page’s job and ingest health, not a marketing uptime percentage or Cloudflare’s platform SLA as if it were our own.
      </p>
      <ul class="text-sm space-y-2 mb-0">
        <li>
          Stack notes:
          <a class="text-link" href="/about/astro-applications">Astro on Cloudflare</a>
          ·
          <a class="text-link" href="/about/cloudflare-workers-deployment">Workers deployment</a>
        </li>
        <li>
          Cloudflare platform incidents:
          <a class="text-link" href="https://www.cloudflarestatus.com/" target="_blank" rel="noreferrer">cloudflarestatus.com</a>
        </li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Get notified</h2>
      <p class="card-subtitle mb-4">
        Get a one-off email if this status changes (degraded or back to normal). No routine emails.
        The form is protected by Cloudflare Turnstile.
      </p>
      {subscribed && (
        <div class="alert-success mt-0" role="status">
          <p class="m-0">
            Check your inbox for a confirmation link -- you're not subscribed until you click it.
          </p>
        </div>
      )}
      {confirmed && (
        <div class="alert-success mt-0" role="status">
          <p class="m-0">You're subscribed to status updates.</p>
        </div>
      )}
      {unsubscribed && (
        <div class="alert-success mt-0" role="status">
          <p class="m-0">You've been unsubscribed from status updates.</p>
        </div>
      )}
      {statusErrorMessage && (
        <div class="alert-warning mt-0" role="alert">
          <p class="m-0">{statusErrorMessage}</p>
        </div>
      )}
      {!subscribed && !confirmed && (
        <form action="/api/status/subscribe" method="post" class="mt-4">
          {/* Honeypot: visually hidden; bots that fill "company" are rejected server-side. */}
          <div class="sr-only" aria-hidden="true">
            <label for="status-subscribe-company">Company</label>
            <input type="text" id="status-subscribe-company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-field">
            <label class="form-label" for="status-subscribe-email">Email</label>
            <input class="form-input" type="email" name="email" id="status-subscribe-email" required />
          </div>
          <div class="form-field">
            <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}></div>
          </div>
          <button class="btn-primary" type="submit">Notify me of status changes</button>
        </form>
      )}
    </section>
  </div>
</Layout>
