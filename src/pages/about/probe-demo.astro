---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProbeDemo from "../../components/ProbeDemo";
import FaqSection from "../../components/FaqSection.astro";
import AboutCcFigure from "../../components/AboutCcFigure.astro";
import { getAboutFaqs } from "../../lib/aboutFaqs";
import { BRAND_SPACES } from "../../lib/brand";
import {
  DEFAULT_ARTICLE_MODIFIED,
  DEFAULT_ARTICLE_PUBLISHED,
  getArticleSchema,
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import "../../styles/about.css";

const title = "Interactive probe demo";
const description =
  `Simulate multi-zone temperatures in ${BRAND_SPACES}. Adjust outdoor air, sun load, door state, and freeze threshold, see the same space-status logic and push/pull JSON shapes ThermalTrace uses in production.`;

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/about/probe-demo");
const faqs = getAboutFaqs("probe-demo");
const schema = [
  getArticleSchema({
    siteUrl,
    pageUrl,
    headline: title,
    description,
    datePublished: DEFAULT_ARTICLE_PUBLISHED,
    dateModified: DEFAULT_ARTICLE_MODIFIED,
  }),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
    { name: title, path: "/about/probe-demo" },
  ]),
  getFaqPageSchema(pageUrl, faqs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    description,
    url: pageUrl,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Any",
  },
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title={title}
  description={description}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="About · Simulator"
      title={title}
      lede={description}
    >
      <a slot="actions" class="btn-primary" href="#try-real">
        Want this for my garage?
      </a>
      <a slot="actions" class="btn-secondary" href="?preset=coldSnap">
        Jump to cold snap
      </a>
      <a slot="actions" class="btn-ghost" href="/about/esp32-freeze-kit">
        ESP32 freeze kit
      </a>
    </PageHeader>
    <p class="probe-demo-hero-note">
      Cause the change: hit <strong>Door draft</strong> and watch the door/entry zone drop vs the
      workbench, or <strong>Cold snap</strong> for Overview-style freeze risk. Readings refresh every
      two seconds with sensor-like noise. Copy <strong>Push ingest</strong> JSON for the same flat
      keys an ESP would POST. Placement theory:
      <a class="text-link" href="/about/temperature-probes">temperature probes</a>
      and
      <a class="text-link" href="/about/temperature-changes">what drives swings</a>.
    </p>

    <ProbeDemo client:visible />

    <AboutCcFigure
      photoId="garage-workbench"
      caption="Real workbench context, in the simulator above, the warmest zone is the workbench/tool-bench pocket. A probe only there can look fine while the door zone is already near freeze."
    />

    <FaqSection faqs={faqs} title="Probe demo FAQ" />

    <nav class="card about-pagination" aria-label="About section pages">
      <a class="btn-secondary" href="/about/temperature-probes">
        <span class="btn-icon btn-icon--start" aria-hidden="true">←</span>
        Temperature probes guide
      </a>
      <a class="btn-secondary" href="/about/adding-devices">
        Adding devices
        <span class="btn-icon btn-icon--end" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</Layout>
