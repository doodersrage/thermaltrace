---

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import AboutQuickStart from "../../components/AboutQuickStart.astro";
import AboutJourneys from "../../components/AboutJourneys.astro";
import AboutHubNav from "../../components/AboutHubNav.astro";
import AboutProbeActivity from "../../components/AboutProbeActivity";
import AboutSearch from "../../components/AboutSearch";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { aboutPages, getAboutStats } from "../../lib/aboutPages";
import { buildAboutSearchIndex } from "../../lib/aboutSearchIndex";
import { getFeaturedAboutPages } from "../../lib/aboutNavigation";
import FaqSection from "../../components/FaqSection.astro";
import EditorialPhotoStrip from "../../components/EditorialPhotoStrip.astro";
import "../../styles/about.css";
import { aboutHubPhotoIds } from "../../lib/aboutPhotos";

const title = "About ThermalTrace";
const description =
  "Guides on temperature probes, freeze and flood/leak alerts, Arduino firmware, ESP ingest, household sharing, and the monitoring stack behind ThermalTrace.";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/about");
const aboutHubFaqs = [
  {
    question: "What is covered in the About guides?",
    answer:
      "Probe placement, DHT22 and Arduino wiring, freeze thresholds, flood/leak contacts, ingest APIs, household sharing, PWA install, and how ThermalTrace stores and charts readings.",
  },
  {
    question: "Where should I start?",
    answer:
      "Pick a job-based journey on this page (freeze protection, flood/leak setup, wiring, ingest, debugging, or household setup), or search the full guide index.",
  },
  {
    question: "Is ThermalTrace open source?",
    answer:
      "Yes: application and firmware-related repos are linked from this hub so you can inspect, fork, or adapt the stack.",
  },
  {
    question: "Where does ThermalTrace run?",
    answer:
      "The website and ingest APIs run on Cloudflare’s edge (Workers). Live job and ingest health is on /system-status: we publish measured health, not a marketing uptime percentage. Stack detail: /about/astro-applications.",
  },
];
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
  getFaqPageSchema(pageUrl, aboutHubFaqs),
].filter(Boolean) as Record<string, unknown>[];

const stats = getAboutStats();
const featuredPages = getFeaturedAboutPages();
const searchIndex = buildAboutSearchIndex(aboutPages);
const featuredSearchIndex = buildAboutSearchIndex(featuredPages);
const initialSearchQuery = Astro.url.searchParams.get("q")?.trim() ?? "";
---
<Layout
  title="About"
  description={description}
  schema={schema}
  skipAuth
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="About"
      title={title}
      lede="Open-source guides on probes, freeze/flood alerts, firmware, and the stack behind ThermalTrace. Prefer a shorter list? Start on the guides hub."
    >
      <a slot="actions" class="btn-primary" href="/register?next=/dashboard/devices">Start free</a>
      <a slot="actions" class="btn-secondary" href="/guides">Guides hub</a>
    </PageHeader>

    <AboutJourneys />

    <EditorialPhotoStrip photoIds={aboutHubPhotoIds} />

    <AboutQuickStart />

    <section class="card about-browse">
      <h2 class="card-title">Find a guide</h2>
      <p class="card-subtitle">
        Search {stats.totalCount} articles or browse by learning path below.
      </p>
      <AboutSearch
        client:visible
        pages={searchIndex}
        featured={featuredSearchIndex}
        initialQuery={initialSearchQuery}
      />
    </section>

    <AboutHubNav />

    <section class="about-probe-hero">
      <div class="about-probe-hero-shell card overflow-hidden p-0">
        <div class="about-probe-hero-intro">
          <p class="about-probe-hero-eyebrow">Live simulation</p>
          <h2 class="about-probe-hero-title">Three probes, one space</h2>
          <p class="about-probe-hero-lede">
            Watch temperature and humidity shift as sun load, outdoor air, and airflow change
            conditions zone by zone, just like the live JSON feed.
          </p>
        </div>
        <AboutProbeActivity client:visible />
      </div>
    </section>

    <section class="card about-repos">
      <h2 class="card-title">Open-source repositories</h2>
      <p class="card-subtitle">
        Projects you can inspect, fork, or adapt for your own build.
        Programmatic integrations start with the
        <a class="text-link" href="/docs/api">HTTP API</a>
        and <a class="text-link" href="/openapi.yaml">openapi.yaml</a>.
      </p>
      <ul class="about-repos-list">
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/arduino-network-json-temperature-sever">
            <strong>arduino-network-json-temperature-sever</strong>
            <span>Arduino sketch and sensor firmware</span>
          </a>
        </li>
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/thermaltrace">
            <strong>thermaltrace</strong>
            <span>This website (Astro on Cloudflare): includes sample sensor sketches</span>
          </a>
        </li>
        <li>
          <a class="about-repos-link" target="_blank" rel="noreferrer" href="https://github.com/doodersrage/fast-api-relay">
            <strong>fast-api-relay</strong>
            <span>JSON feed relay (FastAPI with Redis caching)</span>
          </a>
        </li>
      </ul>
    </section>

    <FaqSection
      faqs={aboutHubFaqs}
      lede="Quick answers before you dive into a guide."
    />
  </div>
</Layout>
