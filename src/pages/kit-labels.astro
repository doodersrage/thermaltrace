---
import AccessoryProduct from "../layouts/AccessoryProduct.astro";
import { commerceLinkRel } from "../lib/affiliateLinks";
import { BOM } from "../lib/bomLinks";
import { BRAND_NAME } from "../lib/brand";

const NFC = BOM.adafruitNfc;
const LABELS = BOM.amazonQrLabelsSearch;
const NFC_AMAZON = BOM.amazonNtagSearch;
---
<AccessoryProduct
  accessoryId="kit-labels"
  faqKey="kitLabels"
  title="Kit QR & NFC labels"
  description={`Printable QR stickers and optional NFC tags encoding your ${BRAND_NAME} push ingest URL — onboard firmware without typing the key.`}
  kicker="Kit / merch"
>
  <a slot="actions" class="btn-primary" href="/about/kit-qr-onboarding">Kit QR guide</a>
  <a slot="actions" class="btn-secondary" href="/dashboard/devices">Devices</a>
  <a slot="actions" class="btn-ghost" href="/claims-pack">Claims pack</a>

  <section class="card">
    <h2 class="card-title">What it is</h2>
    <ul class="text-sm space-y-2 mb-0">
      <li>
        <strong>Does:</strong> Puts the full ingest URL on a sticker (QR) or NFC tag (NTAG213/215 URL record) so phone
        or laptop can scan during flash / HA setup.
      </li>
      <li>
        <strong>Does not:</strong> Sell branded drop-ship labels from ThermalTrace. Print from the Devices QR callout
        (SVG download) or write NFC with any NDEF URL writer. Rotate the key if a sticker is lost.
      </li>
    </ul>
  </section>

  <section class="card">
    <h2 class="card-title">Parts</h2>
    <div class="overflow-x-auto">
      <table class="plan-comparison-table">
        <caption class="sr-only">Kit label parts</caption>
        <thead>
          <tr>
            <th scope="col">Part</th>
            <th scope="col">Why</th>
            <th scope="col">Buy</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Waterproof label stock</th>
            <td>Garage / utility room stickers for device name + QR.</td>
            <td>
              <a class="text-link" href={LABELS} target="_blank" rel={commerceLinkRel(LABELS)}>Amazon label search</a>
            </td>
          </tr>
          <tr>
            <th scope="row">NFC NTAG stickers</th>
            <td>Optional tap-to-open ingest URL on Android / iPhone.</td>
            <td>
              <a class="text-link" href={NFC} target="_blank" rel={commerceLinkRel(NFC)}>Adafruit NFC</a>
              ·
              <a class="text-link" href={NFC_AMAZON} target="_blank" rel={commerceLinkRel(NFC_AMAZON)}>Amazon NTAG</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">Setup</h2>
    <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
      <li>
        Create or rotate a push key on
        <a class="text-link" href="/dashboard/devices">Devices</a>
        — QR is visible about 30 minutes.
      </li>
      <li>Download the SVG or print device name + QR + URL on waterproof stock.</li>
      <li>
        Optional: write the same HTTPS ingest URL as an NDEF URI record on an NFC tag. Keep tags with the kit, not on a
        public door.
      </li>
      <li>
        Full walkthrough:
        <a class="text-link" href="/about/kit-qr-onboarding">Kit QR onboarding</a>.
      </li>
    </ol>
  </section>
</AccessoryProduct>
