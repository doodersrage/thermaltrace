---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { getMarketingFaqs } from "../../lib/marketingFaqs";
import {
  AUTOMATION_INTEGRATION_PAGE,
  AUTOMATION_NAME,
  AUTOMATION_TAGLINE,
  N8N_ALERT_SHEETS_FLOW_URL,
} from "../../lib/automationIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, AUTOMATION_INTEGRATION_PAGE);
const faqs = getMarketingFaqs("automation");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Integrations", path: INTEGRATIONS_HUB_PAGE },
    { name: "Automation", path: AUTOMATION_INTEGRATION_PAGE },
  ]),
  getFaqPageSchema(pageUrl, faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="IFTTT, n8n & Sheets"
  description={`${AUTOMATION_NAME}: ${AUTOMATION_TAGLINE}`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="No-code & self-hosted"
      title="IFTTT, n8n, Sheets & Notion"
      lede={AUTOMATION_TAGLINE}
    >
      <a slot="actions" class="btn-primary" href={user ? "/dashboard/alerts" : "/register?next=/dashboard/alerts"}>
        {user ? "Alerts → webhooks" : "Start free / Pro trial"}
      </a>
      <a slot="actions" class="btn-secondary" href={N8N_ALERT_SHEETS_FLOW_URL} download>
        Download n8n → Sheets
      </a>
      <a slot="actions" class="btn-ghost" href="/about/zapier-make-recipes">Zapier & Make</a>
      <a slot="actions" class="btn-ghost" href={INTEGRATIONS_HUB_PAGE}>All integrations</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">IFTTT</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
        <li>Create an applet with trigger <strong>Webhooks → Receive a web request</strong> (event name e.g. <code>thermaltrace_alert</code>).</li>
        <li>
          Copy the IFTTT Maker URL into ThermalTrace <strong>Pro → Alerts → Outbound webhook</strong>.
          Optionally set a signing secret and verify <code>X-Signature</code> in a filter step if your plan allows code.
        </li>
        <li>Action: notify, toggle a smart plug, or append to a Google Sheet via IFTTT’s Sheets service.</li>
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">n8n</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-4">
        <li>
          Import
          <a class="text-link" href={N8N_ALERT_SHEETS_FLOW_URL} download>thermaltrace-alert-to-sheets.json</a>
          (Webhook → Set → Google Sheets append).
        </li>
        <li>Activate the workflow; copy the production webhook URL into ThermalTrace outbound webhook.</li>
        <li>Replace <code>YOUR_GOOGLE_SHEET_ID</code>; sheet headers: <code>sent_at</code>, <code>kind</code>, <code>title</code>, <code>body</code>.</li>
      </ol>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        Same payload as Zapier: <code>title</code>, <code>body</code>, <code>kind</code>, <code>sent_at</code>.
        <code>kind</code> may be <code>threshold</code>, <code>flood</code>, <code>runway</code>, <code>forecast</code>, and others.
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Google Sheets & Notion</h2>
      <p class="text-sm mb-2">
        Landlord / claims paper trail without building a PMS connector:
      </p>
      <ul class="text-sm space-y-2 mb-0 pl-5 list-disc">
        <li><strong>Sheets</strong> — use the n8n flow above, IFTTT Sheets, or Zapier “Create Spreadsheet Row”.</li>
        <li>
          <strong>Notion</strong> — n8n Notion node or Make “Create a database item” from the same Catch Hook;
          map <code>title</code> → Name, <code>kind</code> → Select, <code>body</code> → Text, <code>sent_at</code> → Date.
        </li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Inbound snooze (Pro)</h2>
      <p class="text-sm mb-2">
        From IFTTT/n8n when you arm the alarm or leave home:
      </p>
      <pre class="text-xs overflow-x-auto mb-2"><code>{`POST /api/inbound/gtw_…
Content-Type: application/json
X-ThermalTrace-Signature: <hmac-sha256-hex>

{"action":"snooze","hours":24}`}</code></pre>
      <p class="mb-0 text-sm text-[var(--color-text-muted)]">
        Create the token under Dashboard → Share. Details:
        <a class="text-link" href="/about/ingest-and-webhooks">ingest & webhooks</a>
        ·
        <a class="text-link" href="/about/zapier-make-recipes">Zapier & Make recipes</a>.
      </p>
    </section>

    <FaqSection title="Automation FAQ" faqs={faqs} lede="IFTTT vs n8n vs Zapier, and logging alerts to Sheets." />
  </div>
</Layout>
