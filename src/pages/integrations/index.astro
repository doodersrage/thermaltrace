---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import {
  DEV_DOCS_BASE,
  HACS_BADGE_URL,
  HACS_REPO_URL,
  INTEGRATION_CARDS,
  INTEGRATIONS_HUB_PATH,
} from "../../lib/integrationsHub";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, INTEGRATIONS_HUB_PATH);
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Integrations", path: INTEGRATIONS_HUB_PATH },
  ]),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="Integrations"
  description="Connect ThermalTrace to Home Assistant (HACS), Matter / Apple Home, MQTT, Grafana, Nest/Ecobee, webhooks, freeze-map embeds, and Zapier for freeze and flood/leak alerts, without giving up LAN-local MQTT."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Integrations"
      title="Wire ThermalTrace into your stack"
      lede="Hosted freeze and flood/leak alerts plus history for ESP/Arduino probes, with optional Home Assistant sensors, Matter / Apple Home accessories, Prometheus metrics, thermostat context, and webhook automations. Guides below stay on thermaltrace.dev; deep payload/Grafana write-ups live on the developer docs site and are labeled when they leave."
    >
      <a slot="actions" class="btn-primary" href="/integrations/home-assistant">Home Assistant (HACS)</a>
      <a slot="actions" class="btn-secondary" href="/integrations/matter">Matter / Apple Home</a>
      <a slot="actions" class="btn-ghost" href={user ? "/dashboard/share" : "/register?next=/dashboard/share"}>
        {user ? "Dashboard → Share" : "Start free"}
      </a>
      <a slot="actions" class="btn-ghost" href="/docs/api">HTTP API</a>
    </PageHeader>

    <section class="card">
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <a href={HACS_REPO_URL} target="_blank" rel="noreferrer">
          <img src={HACS_BADGE_URL} alt="HACS Custom" width="120" height="28" loading="lazy" />
        </a>
        <p class="text-sm text-[var(--color-text-muted)] mb-0">
          Official HACS custom integration: default store submission in progress.
        </p>
      </div>
      <p class="text-sm text-[var(--color-text-muted)] mb-0">
        Looking for OpenAPI schemas or Grafana dashboard JSON details?
        {" "}
        <a class="text-link" href={DEV_DOCS_BASE} target="_blank" rel="noreferrer">Developer docs (GitHub Pages)</a>
        {" "}
        open in a new tab.
      </p>
    </section>

    <section class="grid gap-4 sm:grid-cols-2">
      {INTEGRATION_CARDS.map((card) => (
        <article class="card h-full flex flex-col">
          <h2 class="card-title">{card.title}</h2>
          {card.tier && (
            <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)] mb-2">{card.tier}</p>
          )}
          <p class="text-sm mb-3">{card.summary}</p>
          {card.bullets && card.bullets.length > 0 && (
            <ul class="text-sm space-y-1.5 mb-4 pl-4 list-disc text-[var(--color-text-muted)]">
              {card.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
          <div class="mt-auto flex flex-wrap gap-2">
            <a
              class="btn-secondary"
              href={card.href}
              {...(card.external ? { target: "_blank", rel: "noreferrer" } : {})}
            >
              {card.cta ?? "Learn more"}
              {card.external ? (
                <span class="sr-only"> (opens developer docs)</span>
              ) : null}
              {card.external ? " ↗" : ""}
            </a>
            {card.secondaryHref && (
              <a
                class="btn-ghost"
                href={card.secondaryHref}
                {...(card.secondaryExternal ? { target: "_blank", rel: "noreferrer" } : {})}
              >
                {card.secondaryLabel ?? "More"}
                {card.secondaryExternal ? " ↗" : ""}
              </a>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="card">
      <h2 class="card-title">Still on DIY MQTT?</h2>
      <p class="mb-4">
        You can keep Mosquitto on the LAN and mirror readings to ThermalTrace for freeze/flood alerts, share links, and claims evidence.
        <a class="text-link" href="/compare/diy-mqtt">Compare vs DIY MQTT</a>
        ·
        <a class="text-link" href="/guides">Guides hub</a>
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/integrations/home-assistant">HACS install guide</a>
        <a class="btn-secondary" href="/about/ingest-and-webhooks">Ingest & webhooks</a>
        <a class="btn-ghost" href="/freeze-map#embed">Freeze map embed</a>
      </div>
    </section>
  </div>
</Layout>
