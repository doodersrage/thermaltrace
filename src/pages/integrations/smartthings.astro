---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import FaqSection from "../../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  getFaqPageSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../../lib/schemaMarkup";
import { getMarketingFaqs } from "../../lib/marketingFaqs";
import {
  SMARTTHINGS_INTEGRATION_PAGE,
  SMARTTHINGS_NAME,
  SMARTTHINGS_TAGLINE,
} from "../../lib/smartThingsIntegration";
import { MATTER_INTEGRATION_PAGE, MATTER_REPO_URL } from "../../lib/matterIntegration";
import { INTEGRATIONS_HUB_PAGE } from "../../lib/homeAssistantIntegration";
import { getAuthFromCookies } from "../../lib/auth";

const { user } = await getAuthFromCookies(Astro.cookies);
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, SMARTTHINGS_INTEGRATION_PAGE);
const faqs = getMarketingFaqs("smartThings");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Integrations", path: INTEGRATIONS_HUB_PAGE },
    { name: "SmartThings", path: SMARTTHINGS_INTEGRATION_PAGE },
  ]),
  getFaqPageSchema(pageUrl, faqs),
].filter(Boolean) as Record<string, unknown>[];
---
<Layout
  title="SmartThings via Matter"
  description={`${SMARTTHINGS_NAME}: ${SMARTTHINGS_TAGLINE}`}
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="SmartThings"
      title="Garage sensors in SmartThings"
      lede={SMARTTHINGS_TAGLINE}
    >
      <a slot="actions" class="btn-primary" href={MATTER_INTEGRATION_PAGE}>
        Matter bridge guide
      </a>
      <a slot="actions" class="btn-secondary" href={MATTER_REPO_URL} target="_blank" rel="noreferrer">
        Plugin on GitHub
      </a>
      <a slot="actions" class="btn-ghost" href={user ? "/dashboard/share/links" : "/register?next=/dashboard/share/links"}>
        {user ? "Share link" : "Start free"}
      </a>
      <a slot="actions" class="btn-ghost" href="/compare/govee">vs Govee / ST pods</a>
    </PageHeader>

    <section class="card">
      <h2 class="card-title">No Cloud-to-Cloud app (on purpose)</h2>
      <p class="text-sm mb-0">
        A Samsung SmartThings Cloud-to-Cloud connector means store review, OAuth, and a second cloud hop.
        ThermalTrace already has a <strong>Matterbridge</strong> plugin that exposes share-link temperature, humidity, leak, door, power, and motion on your LAN.
        SmartThings (like Apple Home and Google Home) can add that Matter bridge — one install path for all three.
      </p>
    </section>

    <section class="card">
      <h2 class="card-title">Setup</h2>
      <ol class="text-sm space-y-2 pl-5 list-decimal mb-0">
        <li>Create a family live share link under <a class="text-link" href="/dashboard/share/links">Dashboard → Share</a>.</li>
        <li>Install Matterbridge + <a class="text-link" href={MATTER_REPO_URL} target="_blank" rel="noreferrer">thermaltrace-matter</a> on a Pi/NAS.</li>
        <li>In the SmartThings app: add a Matter device / scan the Matterbridge QR (same flow as other Matter bridges).</li>
        <li>Keep freeze SMS on ThermalTrace push ingest — Matter polling is for glance and local automations.</li>
      </ol>
    </section>

    <section class="card">
      <h2 class="card-title">When to stay on ThermalTrace alone</h2>
      <p class="mb-0 text-sm">
        Consumer ST/Govee pods win on price for bedrooms. For detached garages and shops, ESP ingest + household freeze/leak channels still beat vendor Bluetooth range.
        See <a class="text-link" href="/compare/govee">ThermalTrace vs Govee / SmartThings</a>.
      </p>
    </section>

    <FaqSection title="SmartThings FAQ" faqs={faqs} lede="Matter path vs a dedicated SmartThings cloud app." />
  </div>
</Layout>
