---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm";
import FaqSection from "../components/FaqSection.astro";
import {
  getBreadcrumbSchema,
  resolvePageUrl,
  resolveSiteUrl,
} from "../lib/schemaMarkup";
import { getMarketingFaqs, getMarketingFaqSchema } from "../lib/marketingFaqs";

const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = resolvePageUrl(siteUrl, "/contact");
const contactFaqs = getMarketingFaqs("contact");
const schema = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ]),
  getMarketingFaqSchema(pageUrl, "contact"),
].filter(Boolean) as Record<string, unknown>[];

const githubIssues = "https://github.com/doodersrage/thermaltrace/issues";
---

<Layout
  title="Contact"
  description="Contact ThermalTrace about account or billing questions, or open a GitHub issue for bugs. Guides cover probes, ingest, and alerts."
  schema={schema}
  speakableSelectors={[".page-header-title", ".page-header-lede", ".faq-answer"]}
>
  <div class="page-shell page-stack">
    <PageHeader
      kicker="Contact"
      title="Get in touch"
      lede="Account and billing questions go here. Bugs and feature ideas belong on GitHub. We usually reply within 1–2 business days."
    >
      <a slot="actions" class="btn-secondary" href="/guides">Browse the guides</a>
      <a slot="actions" class="btn-secondary" href={githubIssues} target="_blank" rel="noreferrer">GitHub issues</a>
    </PageHeader>

    <div class="page-grid items-start">
      <div class="page-stack page-stack-tight">
        <section class="card">
          <h2 class="card-title">This form</h2>
          <p class="card-subtitle">Use it for account, billing, and household questions, plus anything the guides do not cover.</p>
          <ul class="grid gap-2 pl-5 leading-relaxed [list-style:disc] mb-0">
            <li>Account, billing, or household access</li>
            <li>Dashboard setup, history, freeze/flood alerts, or CSV export</li>
            <li>Android / Play listing questions or a launch-note request</li>
            <li>Ingest or probe questions after checking the guides</li>
          </ul>
        </section>

        <section class="card">
          <h2 class="card-title">GitHub issues</h2>
          <p class="card-subtitle mb-0">
            Bugs, firmware patches, and feature ideas belong in
            <a class="text-link" href={githubIssues} target="_blank" rel="noreferrer">GitHub issues</a>
            so other builders can follow along. Prefer not to use a web form? That is the best public path.
          </p>
        </section>

        <section class="card">
          <h2 class="card-title">Before you write</h2>
          <p class="card-subtitle mb-0">
            Many answers are already in the
            <a class="text-link" href="/guides">guides hub</a>,
            <a class="text-link" href="/about">about library</a>,
            <a class="text-link" href="/about/probe-demo">probe demo</a>, and
            <a class="text-link" href="/about/arduino-sketches">Arduino sketches</a>.
            Useful details for a reply: board, sensors, expected vs observed readings, and any feed URLs.
          </p>
        </section>
      </div>

      <ContactForm client:visible />
    </div>

    <FaqSection faqs={contactFaqs} />
  </div>
</Layout>
