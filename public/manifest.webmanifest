{
  "name": "ThermalTrace",
  "short_name": "ThermalTrace",
  "description": "Open-source dashboard to track, log, and analyze temperature probe curves — with live readings, freeze and flood/leak alerts, and history.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#090b0f",
  "theme_color": "#090b0f",
  "icons": [
