# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub sign-in (ThermalTrace OAuth app — bypasses Supabase GitHub provider)
# Callback URL in GitHub app settings: https://thermaltrace.dev/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public feed default (HTTPS JSON). Guest Home uses this when set.
GARAGE_TEMP_FEED_URL=

# OpenWeather (server-only: home weather, city search, map tile proxy)
OPENWEATHER_API_KEY=
OPENWEATHER_CITY_ID=

# Ambient Weather developer application key (operators) — users supply their own API key in Settings
AMBIENT_APPLICATION_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_TOKEN=

# Email (Cloudflare Email binding + from/to addresses)
SMTP_MAIL_FROM=noreply@thermaltrace.dev
SMTP_MAIL_TO=

# Stripe billing (member = CSV, pro = SMS/push/share/webhooks, portfolio = multi-property)
# Create monthly + annual prices in Stripe Dashboard, then paste IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_PORTFOLIO=
STRIPE_PRICE_ID_PORTFOLIO_ANNUAL=

# Display-only prices for /pricing (USD, no currency symbol).
# MUST match the unit amounts of STRIPE_PRICE_ID* in Stripe (see /dashboard/ops audit).
# Annual is ~17% off vs 12× monthly ($4/mo → $40/yr, $10/mo → $100/yr, $29/mo → $290/yr).
STRIPE_DISPLAY_MEMBER_MONTHLY=4
STRIPE_DISPLAY_MEMBER_ANNUAL=40
STRIPE_DISPLAY_PRO_MONTHLY=10
STRIPE_DISPLAY_PRO_ANNUAL=100
STRIPE_DISPLAY_PORTFOLIO_MONTHLY=29
STRIPE_DISPLAY_PORTFOLIO_ANNUAL=290

# Pricing page default billing interval (annual | monthly)
PRICING_DEFAULT_INTERVAL=annual

# Twilio SMS (Pro alerts) — https://console.twilio.com/
# After adding, run: pnpm secrets:push
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push (VAPID) — generate with: pnpm generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@thermaltrace.dev

# Firebase Cloud Messaging (native Android / iOS apps) — HTTP v1
# Prefer one JSON secret (service account with Firebase Cloud Messaging Admin):
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
# Or split fields (private key newlines as \n):
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Site URL (OAuth callbacks, Stripe redirects, schema, NWS User-Agent)
# Set to your public hostname — Worker name may still be garage-temp on Cloudflare.
SITE_URL=https://thermaltrace.dev
ORIGIN=https://thermaltrace.dev

# Optional Amazon Associates tag for kit / BOM buy links (tag= on amazon.com URLs)
# Adafruit does not run an affiliate program — leave those links untagged.
# PUBLIC_AMAZON_ASSOCIATE_TAG=yourtag-20

# Google Analytics 4 (public marketing pages only; set to "off" to disable)
GA_MEASUREMENT_ID=G-1TLGYJZEQ9

# Sentry (client + Worker). DSN is public by design; AUTH_TOKEN is build-only for source maps.
# Set SENTRY_PROJECT to your project slug from sentry.io (Settings → Projects).
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=thermaltracedev
SENTRY_PROJECT=
SENTRY_URL=https://us.sentry.io

# WhatsApp via Twilio (defaults to TWILIO_FROM_NUMBER with whatsapp: prefix)
TWILIO_WHATSAPP_FROM=

# Optional Nest / Ecobee thermostat OAuth (omit to hide connect UI)
# Production redirect URIs (thermaltrace.dev):
#   https://thermaltrace.dev/api/integrations/nest/callback
#   https://thermaltrace.dev/api/integrations/ecobee/callback
# Operator guide: pnpm operator:check · /about/thermostat-oauth
# NEST_PROJECT_ID = UUID at top of console.nest.google.com project page (not GCP project number)
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_PROJECT_ID=
ECOBEE_CLIENT_ID=
# Legacy/static tokens (optional; prefer per-household OAuth above)
NEST_ACCESS_TOKEN=
NEST_REFRESH_TOKEN=
ECOBEE_ACCESS_TOKEN=
ECOBEE_REFRESH_TOKEN=

# Background jobs + signed alert ack links (set in production)
# Shared HMAC secret for cron auth. Also used as fallback for MFA step-up,
# alert ack links, and companion OAuth exchange when dedicated secrets are unset.
# Required in production.
CRON_SECRET=

# Optional dedicated secrets (preferred over CRON_SECRET to limit blast radius).
# MFA_STEPUP_SECRET=
# ALERT_ACK_SECRET=
# MOBILE_EXCHANGE_SECRET=

# Encrypt recoverable push ingest keys for Reveal ingest key (32+ chars; openssl rand -base64 32)
INGEST_KEY_ENCRYPTION_SECRET=

# Optional ops alerts when cron jobs fail (email uses SMTP_MAIL_TO above)
OPS_DISCORD_WEBHOOK_URL=

# YubiKey OTP (YubiCloud validation) — get Client ID + Secret at https://upgrade.yubico.com/getapikey/
# The API key is base64-encoded; paste it exactly as shown by Yubico (including trailing =).
YUBICO_CLIENT_ID=
YUBICO_API_KEY=

# Playwright authenticated E2E (pnpm test:e2e:auth)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
# PLAYWRIGHT_BASE_URL=https://thermaltrace.dev
